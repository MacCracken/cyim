# plugin.cyr — Cyrius plugin ABI scaffold (v1.3.4)
#
# Per ADR 0003, cyim accepts AOT-compiled Cyrius plugins folded into
# the binary at build time (sandhi pattern). Plugins extend cyim's
# dispatch table — they do not extend the modal grammar.
#
# This file defines the public ABI surface. It is the contract a
# plugin author writes against. Function names listed here are
# stable across cyim minor versions per the freeze-on-first-real-
# consumer rule (ADR 0004 will pin the surface once cyim-lsp
# ships at v1.4.0).
#
# ABI surface — registration:
#   plugin_register_post_save_hook(fp)             # fp: fn(s, path) -> 0
#   plugin_register_post_change_hook(fp)           # fp: fn(s) -> 0
#   plugin_register_status_segment(fp)             # fp: fn(s) -> str_ptr (heap, NUL-term)
#   plugin_register_normal_key(key, fp)            # fp: fn(s) -> action_id
#   plugin_register_normal_prefix_key(prefix, key, fp)  # v1.4.2 — fp: fn(s) -> action_id
#   plugin_register_ex_command(name, fp)           # fp: fn(s) -> exit_code
#   plugin_register_diagnostic_provider(fp)        # fp: fn(s, b, out_vec) -> 0
#
# ABI surface — operations (called by plugins to drive cyim state):
#   plugin_buf_load_file(s, path)                  # v1.4.2 — load file into new
#                                                  #   buf + switch active; returns buf or 0
#   plugin_buf_load_file_split(s, path, direction) # v1.6.6 — load file into a new
#                                                  #   split window; SPLIT_HORIZONTAL (0)
#                                                  #   adds the pane below, SPLIT_VERTICAL (1)
#                                                  #   adds it to the right; focus moves to
#                                                  #   the new pane. Returns buf or 0.
#   plugin_list_display(s, items, count, on_select)  # v1.5.0 — popup picker;
#                                                    #   on_select(s, index)
#
# ABI surface — fire / lookup (called by cyim's core, not plugins):
#   _plugin_fire_post_save(s, path)
#   _plugin_fire_post_change(s)
#   _plugin_lookup_normal_key(key)                 # returns fp or 0
#   _plugin_lookup_normal_prefix_key(prefix, key)  # v1.4.2 — returns fp or 0
#   _plugin_lookup_ex_command(name)                # returns fp or 0
#   _plugin_collect_status_segments(s, out)        # appends each segment
#   _plugin_collect_diagnostics(s, b, out)         # appends each provider's diags
#
# Hook semantics:
#   - Simple fire-and-forget hooks (post_save, post_change) call every
#     registered fp in registration order; return value is ignored.
#   - Keyed hooks (normal_key, ex_command) walk for a name match;
#     first registered wins on duplicate keys.
#   - Producer hooks (status_segment, diagnostic_provider) call every
#     registered fp and accumulate output.
#
# Registry layout: 6 vec globals, each storing i64 slots. Simple +
# producer hooks store fp directly. Keyed hooks store a pointer to
# a 24 B record { name_ptr, name_len, fp }.
#
# All six hooks are wired into cyim's core dispatch. v1.3.4 landed
# post_save + post_change (the obviously-shaped two); v1.3.5 wired the
# remaining four — status_segment, normal_key, ex_command,
# diagnostic_provider — once cyim-lsp surfaced what it actually needed.
# (Through 1.8.4 this comment still said only two were wired and the rest
# "land at v1.3.5+"; corrected at 1.8.5.)

# Per-hook registries. Initialized lazily by plugin_init() so the
# global initializer phase doesn't run alloc().
var _plugin_post_save_hooks    = 0;
var _plugin_post_change_hooks  = 0;
var _plugin_status_segments    = 0;
var _plugin_normal_keys        = 0;
var _plugin_normal_prefix_keys = 0;   # v1.4.2 — vec<{prefix, key, fp}>
var _plugin_ex_commands        = 0;
var _plugin_diagnostic_provs   = 0;

# v1.3.5: most-recent diag vec, refreshed at every render frame by
# _plugin_render_collect_diagnostics. Tests + future render-side
# inline highlighting consume this.
var _plugin_last_diags         = 0;

# v1.5.0 — list-display state. When `plugin_list_display` is called,
# these globals capture the picker state; editor_dispatch intercepts
# at the top of every dispatch tick when active so j/k/Enter/Esc/q
# navigate the list rather than fall through to mode-specific
# handlers; render_frame draws the bottom-anchored popup overlay.
# Tests + the LSP refs-quickfix consumer (cyim-lsp 1.1.x or 1.2.0
# planned) read these.
var _plugin_list_active    = 0;   # 0 = not displayed, 1 = displayed
var _plugin_list_items     = 0;   # vec<cstring> labels (caller-owned)
var _plugin_list_count     = 0;   # number of items
var _plugin_list_index     = 0;   # 0-based current selection
var _plugin_list_on_select = 0;   # fp(s, index) -> 0; called on Enter

# v1.3.5: diag severity enum. Higher numerically = more severe.
# Mirrors LSP's DiagnosticSeverity (1=error..4=hint) inverted so
# numeric > comparisons line up with cyim's internal action ordering
# convention. Plugin authors match against these constants, never
# the literal numbers.
var DIAG_HINT    = 0;
var DIAG_INFO    = 1;
var DIAG_WARNING = 2;
var DIAG_ERROR   = 3;

# Initialize all six registries. Called once from main(), after
# alloc_init() / args_init() and before any plugin-init code runs.
# Idempotent — safe to call twice (defensive against future
# refactors).
fn plugin_init() {
    if (_plugin_post_save_hooks    == 0) { _plugin_post_save_hooks    = vec_new(); }
    if (_plugin_post_change_hooks  == 0) { _plugin_post_change_hooks  = vec_new(); }
    if (_plugin_status_segments    == 0) { _plugin_status_segments    = vec_new(); }
    if (_plugin_normal_keys        == 0) { _plugin_normal_keys        = vec_new(); }
    if (_plugin_normal_prefix_keys == 0) { _plugin_normal_prefix_keys = vec_new(); }
    if (_plugin_ex_commands        == 0) { _plugin_ex_commands        = vec_new(); }
    if (_plugin_diagnostic_provs   == 0) { _plugin_diagnostic_provs   = vec_new(); }
    return 0;
}

# === Registration API (called by plugins, typically at top-level
# init time inside the plugin's own `<plugin>_init()` setup
# function which is wired from cyim's main(). Production
# consumers since v1.4.0: trailing_ws (inline), cyim-lsp (sandhi-
# pattern external bundle). ===

# Register `fp` to fire after every successful `:w` / `:wq`. Signature:
# `(s, path) -> i64`. Returns -1 if the registry is uninitialized. Frozen ABI
# per ADR 0004 — additions allowed, shape changes are not.
fn plugin_register_post_save_hook(fp) {
    if (_plugin_post_save_hooks == 0) { return 0 - 1; }
    vec_push(_plugin_post_save_hooks, fp);
    return 0;
}

# Register `fp` to fire after every buffer-content change. Signature:
# `(s, b) -> i64`. ⚠ Fires on the EDIT path, so it runs per keystroke in
# INSERT — a hook that walks the whole buffer here is a per-keystroke cost.
fn plugin_register_post_change_hook(fp) {
    if (_plugin_post_change_hooks == 0) { return 0 - 1; }
    vec_push(_plugin_post_change_hooks, fp);
    return 0;
}

# Register `fp` to contribute a segment to the status row. Signature:
# `(s) -> cstring`; return 0 to contribute nothing this frame. Called once per
# render frame, so the callback must be cheap and must not allocate per call.
fn plugin_register_status_segment(fp) {
    if (_plugin_status_segments == 0) { return 0 - 1; }
    vec_push(_plugin_status_segments, fp);
    return 0;
}

# Register `fp` to supply diagnostics. Signature: `(s, b, out_vec) -> i64`;
# the callback pushes `diag_new(...)` records onto `out_vec`. Called once per
# render frame via `_plugin_collect_diags`; results are readable afterwards
# through `plugin_last_diags()`.
fn plugin_register_diagnostic_provider(fp) {
    if (_plugin_diagnostic_provs == 0) { return 0 - 1; }
    vec_push(_plugin_diagnostic_provs, fp);
    return 0;
}

# Keyed registrations allocate a 24 B record:
#   +0  key_or_name_ptr  (NUL-term cstring for ex_command; 1-byte
#                         key for normal_key, NUL-padded)
#   +8  name_len         (strlen for ex_command; 1 for normal_key)
#   +16 fp               function pointer
fn _plugin_keyed_record_new(name_ptr, name_len, fp) {
    var rec = alloc(24);
    if (rec == 0) { return 0; }
    store64(rec,      name_ptr);
    store64(rec + 8,  name_len);
    store64(rec + 16, fp);
    return rec;
}

# Register a NORMAL-mode key handler. `key` is a single-byte int
# (e.g. ascii 'F' for `F`-prefix-style sequences). Plugin keymaps
# coexist with cyim's built-in NORMAL keymap; built-ins win on
# conflict (cyim's modal grammar is the inheritance — plugins
# extend, never override).
fn plugin_register_normal_key(key, fp) {
    if (_plugin_normal_keys == 0) { return 0 - 1; }
    var rec = _plugin_keyed_record_new(key, 1, fp);
    if (rec == 0) { return 0 - 1; }
    vec_push(_plugin_normal_keys, rec);
    return 0;
}

# Register an ex-mode command (`:foo`, `:foo-bar`). `name` is a
# NUL-terminated cstring. Plugin commands coexist with cyim's
# built-ins; built-ins win on conflict, same as normal_key.
fn plugin_register_ex_command(name, fp) {
    if (_plugin_ex_commands == 0) { return 0 - 1; }
    var rec = _plugin_keyed_record_new(name, strlen(name), fp);
    if (rec == 0) { return 0 - 1; }
    vec_push(_plugin_ex_commands, rec);
    return 0;
}

# v1.4.2 — Register a NORMAL-mode prefix-key handler. Two-byte
# sequence: when the editor's pending prefix matches `prefix` and
# the next byte equals `key`, the registered fp is invoked with
# the editor state and its returned action id flows through cyim's
# motion / edit / mode-transition pipelines.
#
# Built-ins win on conflict. cyim 1.4.2 wires `KEY_G` (`g`) as a
# prefix at the dispatch layer; `gg` is built-in (ACT_MOVE_FILE_START).
# A plugin registering `(KEY_G, 'g', fp)` will be shadowed by the
# built-in; `(KEY_G, 'd', fp)` resolves to the plugin since `gd`
# isn't a built-in.
#
# Record layout (24 B):
#   +0   prefix       i64  prefix byte (e.g. KEY_G = 103)
#   +8   key          i64  follow-up byte (e.g. 'd' = 100)  #skip-lint: prefix-sequence noun
#   +16  fp           i64  callback function pointer
fn _plugin_prefix_record_new(prefix, key, fp) {
    var rec = alloc(24);
    if (rec == 0) { return 0; }
    store64(rec,      prefix);
    store64(rec + 8,  key);
    store64(rec + 16, fp);
    return rec;
}

# Register `fp` for the two-byte NORMAL-mode sequence `prefix` then `key`
# (e.g. KEY_G + 'd'). Signature: `(s) -> action_id`. Returns -1 if the
# registry is uninitialized.
#
# ⚠ Built-ins win on conflict (ADR 0003 §3): plugin lookup runs only after the
# built-in branch declines the second byte, so registering (KEY_G, 'g')
# silently never fires. Plugin prefix-keys also may NOT drive mode
# transitions — the prefix path returns before the mode-transition handling.
fn plugin_register_normal_prefix_key(prefix, key, fp) {
    if (_plugin_normal_prefix_keys == 0) { return 0 - 1; }
    var rec = _plugin_prefix_record_new(prefix, key, fp);
    if (rec == 0) { return 0 - 1; }
    vec_push(_plugin_normal_prefix_keys, rec);
    return 0;
}

# v1.4.2 — Load a file into a new buffer + switch the editor's
# active buffer to it. Wrapper around the same dedup + buflist +
# window-update bookkeeping `:e <file>` uses (see
# `_buf_load_file_into_active` in command.cyr).
#
# Arguments:
#   s     editor state pointer
#   path  NUL-terminated cstring; caller-owned, lifetime must
#         outlast the buflist entry that retains the path pointer
#         (typically a heap-alloc'd cstring or a literal).
#
# Returns:
#   buf ptr on success; 0 on failure (path == 0, file missing,
#   file too large, or read error). On failure the editor's
#   `last_error` is set so the caller can surface a typed error
#   via `editor_last_error(s)`.
#
# Use case: cyim-lsp 1.1.0+ cross-file goto-def — given a
# destination URI from `textDocument/definition`, the consumer
# strips the `file://` prefix and calls plugin_buf_load_file to
# open the destination, then `buf_move(b, dest_offset)` to jump.
fn plugin_buf_load_file(s, path) {
    return _buf_load_file_into_active(s, path);
}

# === plugin_buf_load_file_split (v1.6.6) ===
#
# Open a file in a new split window. Same dedup + load semantics
# as `plugin_buf_load_file` (re-uses the buflist when `path` is
# already loaded; loads from disk otherwise) but splits the
# active window first and moves focus to the new leaf.
#
# `direction`:
#   SPLIT_HORIZONTAL (0)  — new pane appears below the current one
#                           (matches `:sp` semantics).
#   SPLIT_VERTICAL   (1)  — new pane appears to the right
#                           (matches `:vsp` semantics).
#   Other values are treated as SPLIT_HORIZONTAL.
#
# Returns:
#   buf ptr on success; 0 on failure (path == 0, file missing,
#   file too large, read error). On failure the editor's
#   `last_error` is set, identical to `plugin_buf_load_file`.
#
# Edge: if `window_split_active` fails (degenerate window state —
# no active leaf, etc.), this falls back to the in-place load
# behaviour of `plugin_buf_load_file` so the call is never a
# silent no-op. The caller still gets a buf back; just no split.
#
# Use case: cyim-lsp 1.5.0+ "open reference in split" — given a
# destination URI from `textDocument/references` or
# `textDocument/definition`, the consumer passes a split hint to
# its on_select callback and routes through this ABI to keep the
# current buffer visible while the destination opens beside it.

var SPLIT_HORIZONTAL = 0;
var SPLIT_VERTICAL   = 1;

# Load `path` into a NEW window split from the active one. `direction` is
# SPLIT_HORIZONTAL or SPLIT_VERTICAL. Returns the buf ptr on success, 0 on
# failure (missing file, over the size cap, read error), with
# `editor_last_error` set. Dedups like `plugin_buf_load_file`: an already-open
# path is reused rather than re-read. Additive ABI, v1.6.6.
fn plugin_buf_load_file_split(s, path, direction) {
    if (path == 0) {
        editor_set_last_error(s, ERR_NO_FILE_NAME);
        return 0;
    }

    bl_init(s, editor_buf(s));

    # Resolve to a buflist index — dedup against existing entries
    # before loading from disk.
    var idx = _cmd_find_path(s, path);
    if (idx < 0) {
        var size = _cmd_file_size(path);
        if (size < 0) {
            editor_set_last_error(s, ERR_FILE_NOT_FOUND);
            return 0;
        }
        if (size > editor_cfg_max_filesize(s)) {
            editor_set_last_error(s, ERR_FILE_TOO_LARGE);
            return 0;
        }
        var nb = buf_new();
        var n = buf_load_file(nb, path);
        if (n < 0) {
            editor_set_last_error(s, ERR_FILE_NOT_FOUND);
            return 0;
        }
        buf_move(nb, 0);
        idx = bl_add(s, nb, path);
    }

    # Map the public direction constant to window.cyr's internal
    # split-type. Unknown values default to horizontal so a future
    # SPLIT_TAB / SPLIT_FLOAT etc. doesn't break this call site.
    #
    # Literal integers (1, 2) instead of the named WIN_SPLIT_H /
    # WIN_SPLIT_V constants — Cyrius is single-pass and the test
    # harnesses motion.tcyr / dispatch.tcyr include plugin.cyr
    # without window.cyr, so referencing the named constants
    # would break their compile. Function references defer to
    # link-time; var references must resolve at parse-time. The
    # mapping is asserted by `tests/plugin.tcyr`'s split tests
    # which DO include window.cyr.
    var split_type = 1;   # WIN_SPLIT_H
    if (direction == SPLIT_VERTICAL) {
        split_type = 2;   # WIN_SPLIT_V
    }

    var rc = window_split_active(s, split_type);
    if (rc < 0) {
        # Degenerate window state — fall back to in-place load so
        # the caller still gets a buf rather than a silent failure.
        bl_set_active(s, idx);
        var leaf_a = editor_active_leaf(s);
        if (leaf_a != 0) { window_set_buf_idx(leaf_a, idx); }
        return bl_buf(s, idx);
    }

    # Post-split state: original leaf stays as child_a of the new
    # split (focus unchanged); the freshly created sibling is
    # child_b, showing the same buf_idx as the original. Find the
    # sibling, point it at the loaded file, move focus there.
    var orig_leaf = editor_active_leaf(s);
    var parent = window_parent(orig_leaf);
    var sibling = window_child_b(parent);

    bl_set_active(s, idx);
    editor_set_active_leaf(s, sibling);
    window_set_buf_idx(sibling, idx);

    return bl_buf(s, idx);
}

# === Fire-points (called by cyim's core) ===

fn _plugin_fire_post_save(s, path) {
    if (_plugin_post_save_hooks == 0) { return 0; }
    var n = vec_len(_plugin_post_save_hooks);
    var i = 0;
    while (i < n) {
        var fp = vec_get(_plugin_post_save_hooks, i);
        if (fp != 0) { fncall2(fp, s, path); }
        i = i + 1;
    }
    return 0;
}

fn _plugin_fire_post_change(s) {
    if (_plugin_post_change_hooks == 0) { return 0; }
    var n = vec_len(_plugin_post_change_hooks);
    var i = 0;
    while (i < n) {
        var fp = vec_get(_plugin_post_change_hooks, i);
        if (fp != 0) { fncall1(fp, s); }
        i = i + 1;
    }
    return 0;
}

# === Lookup helpers for keyed hooks (returns fp or 0). ===

fn _plugin_lookup_normal_key(key) {
    if (_plugin_normal_keys == 0) { return 0; }
    var n = vec_len(_plugin_normal_keys);
    var i = 0;
    while (i < n) {
        var rec = vec_get(_plugin_normal_keys, i);
        if (rec != 0) {
            if (load64(rec) == key) { return load64(rec + 16); }
        }
        i = i + 1;
    }
    return 0;
}

# v1.4.2 — Two-byte prefix-key lookup. Returns fp or 0.
fn _plugin_lookup_normal_prefix_key(prefix, key) {
    if (_plugin_normal_prefix_keys == 0) { return 0; }
    var n = vec_len(_plugin_normal_prefix_keys);
    var i = 0;
    while (i < n) {
        var rec = vec_get(_plugin_normal_prefix_keys, i);
        if (rec != 0) {
            if (load64(rec) == prefix) {
                if (load64(rec + 8) == key) { return load64(rec + 16); }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Byte-compare a registered ex-command name (rec+0, rec+8) against
# `name` (NUL-term). Returns 1 on match, 0 otherwise.
fn _plugin_ex_name_eq(rec, name) {
    var rec_ptr = load64(rec);
    var rec_len = load64(rec + 8);
    var name_len = strlen(name);
    if (rec_len != name_len) { return 0; }
    var i = 0;
    while (i < rec_len) {
        if (load8(rec_ptr + i) != load8(name + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _plugin_lookup_ex_command(name) {
    if (_plugin_ex_commands == 0) { return 0; }
    var n = vec_len(_plugin_ex_commands);
    var i = 0;
    while (i < n) {
        var rec = vec_get(_plugin_ex_commands, i);
        if (rec != 0) {
            if (_plugin_ex_name_eq(rec, name) == 1) { return load64(rec + 16); }
        }
        i = i + 1;
    }
    return 0;
}

# === Producer hooks — collect outputs from each registered fp. ===

# Run every status-segment producer; each returns a NUL-term cstring
# whose bytes are appended to `out_buf` separated by " | ". Caller
# owns out_buf (e.g. render_status's right-aligned slot). Returns
# the count of segments emitted.
# Append a NUL-term cstring's bytes into a gap-buffer. cyim's
# buffer.cyr exposes buf_insert_byte for single bytes and buf_insert
# for byte-runs of known length; cstrings need a strlen pass first.
fn _plugin_buf_append_cstr(b, s) {
    if (s == 0) { return 0; }
    var len = strlen(s);
    if (len > 0) { buf_insert(b, s, len); }
    return 0;
}

fn _plugin_collect_status_segments(s, out_buf) {
    if (_plugin_status_segments == 0) { return 0; }
    var n = vec_len(_plugin_status_segments);
    var emitted = 0;
    var i = 0;
    while (i < n) {
        var fp = vec_get(_plugin_status_segments, i);
        if (fp != 0) {
            var seg = fncall1(fp, s);
            if (seg != 0) {
                if (emitted > 0) { _plugin_buf_append_cstr(out_buf, " | "); }
                _plugin_buf_append_cstr(out_buf, seg);
                emitted = emitted + 1;
            }
        }
        i = i + 1;
    }
    return emitted;
}

# Run every diagnostic provider; each appends entries to `out_vec`
# (a vec the caller owns). Diag record shape (pinned at v1.3.5):
#   +0  line       1-indexed line number
#   +8  severity   one of DIAG_HINT / DIAG_INFO / DIAG_WARNING / DIAG_ERROR
#   +16 msg_ptr    NUL-term cstring; provider owns lifetime (heap-alloc'd
#                  per-frame is fine since vec is rebuilt per frame)
fn _plugin_collect_diagnostics(s, b, out_vec) {
    if (_plugin_diagnostic_provs == 0) { return 0; }
    var n = vec_len(_plugin_diagnostic_provs);
    var i = 0;
    while (i < n) {
        var fp = vec_get(_plugin_diagnostic_provs, i);
        if (fp != 0) { fncall3(fp, s, b, out_vec); }
        i = i + 1;
    }
    return 0;
}

# Allocate a 24 B diag record. Called by diagnostic_provider plugins
# to build entries for the out_vec.
fn diag_new(line, severity, msg) {
    var rec = alloc(24);
    if (rec == 0) { return 0; }
    store64(rec,      line);
    store64(rec + 8,  severity);
    store64(rec + 16, msg);
    return rec;
}

# 1-indexed line the diagnostic applies to. Frozen ABI (ADR 0004).
fn diag_line(d)     { return load64(d); }

# DIAG_HINT / DIAG_INFO / DIAG_WARNING / DIAG_ERROR — ordered, so
# `diag_severity(d) >= DIAG_WARNING` is a portable filter. Frozen ABI.
fn diag_severity(d) { return load64(d + 8); }

# Message text (NUL-terminated cstr). Owned by whoever built the record —
# `diag_new` stores the pointer, it does not copy. Frozen ABI.
fn diag_msg(d)      { return load64(d + 16); }

# Called once per render frame from render_frame. Allocates a fresh
# diag vec, walks every registered provider, stashes the result for
# inspection. Inline diag painting is provider-specific: cyim-lsp's
# diagnostic_provider feeds publishDiagnostics tuples here; render
# layer surfaces them (gutter glyphs, inline marks, status counts
# via the parallel status_segment hook). Tests read
# `plugin_last_diags()` for assertions on the per-frame collection.
fn _plugin_render_collect_diagnostics(s) {
    var v = vec_new();
    var b = editor_buf(s);
    if (b != 0) { _plugin_collect_diagnostics(s, b, v); }
    _plugin_last_diags = v;
    return v;
}

# Public accessor for the most-recent per-frame diag vec.
fn plugin_last_diags() { return _plugin_last_diags; }

# === v1.5.0 — list-display ABI ===
#
# A bottom-anchored popup picker. Plugins call `plugin_list_display`
# with an items vec (cstring labels), a count, and an on_select
# callback `fn(s, index) -> 0`. cyim's editor_dispatch intercepts
# while the list is active: j/down → next, k/up → prev, Enter/LF →
# fire on_select(s, current_index) then dismiss, Esc/q → dismiss
# without firing.
#
# Storage is module-global, not per-editor — only one list can be
# displayed at a time. Calling plugin_list_display while another
# list is active replaces the old list (the on_select for the old
# list is dropped without firing). v1.5.x can layer state if a real
# stacked-picker need surfaces.
#
# Items are NOT copied. The plugin owns the items vec and the
# cstring labels for the lifetime of the picker. Reasonable since
# picker sessions are short and the plugin holds the data anyway
# (e.g. cyim-lsp's per-URI tuple list).
#
# on_select runs AFTER dismiss so it can call plugin_list_display
# again for chained pickers without leaking active state.
#
# Use case: `:lsp-find-refs` quickfix list — items = vec of
# "FILE:LINE:COL — preview" cstrings, on_select dispatches to
# `plugin_buf_load_file` + `buf_move`.

# Put up a bottom-anchored popup picker over `items` (a vec of cstrs).
# `on_select` fires with the chosen index; j/k move, Enter selects, Esc/q
# dismiss. One list at a time — a second call replaces the first.
#
# While a list is up, `editor_dispatch` intercepts those keys at the very top,
# so the buffer stays untouched. Additive ABI, v1.5.0.
fn plugin_list_display(s, items, count, on_select) {
    # v1.5.3 (F-CO-3 closeout finding) — defensively clear any
    # latched prefix (e.g. KEY_G after a `g` keystroke). Otherwise
    # if a plugin synchronously called plugin_list_display from a
    # prefix-keymap fp before the user's next byte, the prefix
    # would survive the picker and resolve against whatever the
    # user typed after dismiss. Unreachable today (the only call
    # sites — :lsp-find-refs / gr — complete dispatch before
    # yielding to next-key) but the guard is patch-sized and
    # closes the corner case once.
    if (s != 0) { editor_set_prefix(s, 0); }
    _plugin_list_items     = items;
    _plugin_list_count     = count;
    _plugin_list_index     = 0;
    _plugin_list_on_select = on_select;
    _plugin_list_active    = 1;
    return 0;
}

# Public accessors so tests + render code don't reach into globals.
fn plugin_list_active()    { return _plugin_list_active; }
# The item vec of the active picker, or 0 when no list is up.
fn plugin_list_items()     { return _plugin_list_items; }

# Number of items in the active picker; 0 when no list is up.
fn plugin_list_count()     { return _plugin_list_count; }

# Zero-based index of the highlighted row in the active picker.
fn plugin_list_index()     { return _plugin_list_index; }

# Internal helpers — driven by editor_dispatch's list-mode
# interception path. Plugins normally don't call these; they're
# invoked indirectly via the user's keystrokes.

fn _plugin_list_dismiss() {
    _plugin_list_items     = 0;
    _plugin_list_count     = 0;
    _plugin_list_index     = 0;
    _plugin_list_on_select = 0;
    _plugin_list_active    = 0;
    return 0;
}

fn _plugin_list_next() {
    if (_plugin_list_active == 0) { return 0; }
    if (_plugin_list_index + 1 < _plugin_list_count) {
        _plugin_list_index = _plugin_list_index + 1;
    }
    return 0;
}

fn _plugin_list_prev() {
    if (_plugin_list_active == 0) { return 0; }
    if (_plugin_list_index > 0) {
        _plugin_list_index = _plugin_list_index - 1;
    }
    return 0;
}

# Fire on_select(s, index) and dismiss. Order matters: dismiss
# first so the on_select callback can call plugin_list_display
# again (chained picker) without leaking active state.
fn _plugin_list_select(s) {
    if (_plugin_list_active == 0) { return 0; }
    var fp = _plugin_list_on_select;
    var idx = _plugin_list_index;
    _plugin_list_dismiss();
    if (fp != 0) { fncall2(fp, s, idx); }
    return 0;
}
