# lang.cyr — language detection from file path
#
# Maps a path to one of vyakarana's bundled grammar names via two
# probes (1.6.4):
#
#   1. Basename match (case-sensitive) — `Dockerfile`, `Makefile`,
#      `.bashrc`, etc. For grammars where vyakarana ships a
#      tokenizer keyed on filename, not extension. Runs first so a
#      `Dockerfile` doesn't accidentally fall through.
#   2. Extension match (case-insensitive suffix) — the original
#      M2 probe. Order matters: longer extensions are checked
#      first so `.cyml` beats `.toml`'s superset, and
#      `.cyr`/`.tcyr`/`.bcyr`/`.fcyr` all route to `cyrius`.
#
# `detect_language_from_path("foo.py")`        → `"python"`.
# `detect_language_from_path("Dockerfile")`    → `"dockerfile"`.
# `detect_language_from_path("subdir/.bashrc")`→ `"shell"`.
# Unknown / extension-less paths return `"plain"` — callers can pass
# that to `highlight_buf` and get back 0 (no highlighting), which the
# render path treats as "draw uncolored bytes".
#
# Future: shebang sniff (e.g. "#!/usr/bin/env python3" → python) and
# content-based detection for JSON/YAML/Markdown openings. Owl has
# both; we'll port them when basename + extension detection's
# failure modes start to bite.
#
# Requires: stdlib (strlen, load8) only.

var LANG_COUNT = 46;

# Indexed 0..LANG_COUNT-1. "plain" at index 0 is the no-grammar
# fallback — its `lang_exts` is empty so the table-walk skips it.
#
# Indices 1..10 preserved from the v1.6.0 shape so existing tests
# and external callers that index by name (via `lang_index`) keep
# matching the same numeric slot. New entries (1.6.2) appended
# 11..44 to keep churn local; index 45 (`openqasm`, 1.8.2) follows
# the same append-only rule.
#
# Conflict resolution decisions (1.6.2):
#   - `.cyml` moves from "toml" (legacy until 1.6.1) to the
#     dedicated "cyml" grammar shipped in vyakarana 2.x.
#   - `.s` / `.S` / `.asm` default to `asm_x86_64` (primary dev
#     arch); aarch64 routing waits for content-sniff or a future
#     `.cyimrc` filetype override.
#   - `dockerfile` / `makefile` are present in `lang_name` with an
#     empty `lang_exts`: vyakarana's grammars match by basename, not
#     extension. They are reached through `lang_basenames` instead,
#     which v1.6.4 added and `detect_language_from_path` probes
#     *before* the extension table. (This note previously said they
#     routed to "plain" — true only up to v1.6.3.)
#
# 46 entries makes the if-chain noisy. If we add more in 1.9+ this
# will earn a refactor (parallel global string arrays or a vyakarana
# metadata query); document the decision in an ADR before going.
fn lang_name(i) {
    if (i == 0)  { return "plain"; }
    if (i == 1)  { return "shell"; }
    if (i == 2)  { return "python"; }
    if (i == 3)  { return "javascript"; }
    if (i == 4)  { return "typescript"; }
    if (i == 5)  { return "rust"; }
    if (i == 6)  { return "cyrius"; }
    if (i == 7)  { return "c"; }
    if (i == 8)  { return "toml"; }
    if (i == 9)  { return "json"; }
    if (i == 10) { return "yaml"; }
    if (i == 11) { return "cyml"; }
    if (i == 12) { return "markdown"; }
    if (i == 13) { return "cpp"; }
    if (i == 14) { return "csharp"; }
    if (i == 15) { return "css"; }
    if (i == 16) { return "scss"; }
    if (i == 17) { return "html"; }
    if (i == 18) { return "xml"; }
    if (i == 19) { return "go"; }
    if (i == 20) { return "java"; }
    if (i == 21) { return "kotlin"; }
    if (i == 22) { return "swift"; }
    if (i == 23) { return "ruby"; }
    if (i == 24) { return "php"; }
    if (i == 25) { return "lua"; }
    if (i == 26) { return "haskell"; }
    if (i == 27) { return "ocaml"; }
    if (i == 28) { return "elixir"; }
    if (i == 29) { return "crystal"; }
    if (i == 30) { return "julia"; }
    if (i == 31) { return "zig"; }
    if (i == 32) { return "nix"; }
    if (i == 33) { return "vue"; }
    if (i == 34) { return "svelte"; }
    if (i == 35) { return "powershell"; }
    if (i == 36) { return "sql"; }
    if (i == 37) { return "ini"; }
    if (i == 38) { return "graphql"; }
    if (i == 39) { return "protobuf"; }
    if (i == 40) { return "terraform"; }
    if (i == 41) { return "asm_x86_64"; }
    if (i == 42) { return "llvm_ir"; }
    if (i == 43) { return "dockerfile"; }
    if (i == 44) { return "makefile"; }
    if (i == 45) { return "openqasm"; }
    return "plain";
}

# Space-separated lowercase extensions per language. Leading dot is
# part of the token. cyim grew up with `.cyr`, so its grammar covers
# `.cyr` (sources), `.tcyr` (tests), `.bcyr` (bench harnesses), and
# `.fcyr` (fuzz harnesses) — vyakarana's `cyrius` grammar only knows
# `.cyr` / `.cyml`, but cyim wants the bench/test harness extensions
# routed through it. cyim's local routing wins.
fn lang_exts(i) {
    if (i == 0)  { return ""; }
    if (i == 1)  { return ".sh .bash .zsh"; }
    if (i == 2)  { return ".py"; }
    if (i == 3)  { return ".js .mjs .cjs"; }
    if (i == 4)  { return ".ts"; }
    if (i == 5)  { return ".rs"; }
    if (i == 6)  { return ".cyr .tcyr .bcyr .fcyr"; }
    if (i == 7)  { return ".c .h"; }
    if (i == 8)  { return ".toml"; }
    if (i == 9)  { return ".json"; }
    if (i == 10) { return ".yaml .yml"; }
    if (i == 11) { return ".cyml"; }
    if (i == 12) { return ".md .markdown"; }
    if (i == 13) { return ".cpp .cc .cxx .hpp .hh .hxx"; }
    if (i == 14) { return ".cs .csx"; }
    if (i == 15) { return ".css"; }
    if (i == 16) { return ".scss .sass"; }
    if (i == 17) { return ".html .htm"; }
    if (i == 18) { return ".xml .xsl .xsd .svg"; }
    if (i == 19) { return ".go"; }
    if (i == 20) { return ".java"; }
    if (i == 21) { return ".kt .kts"; }
    if (i == 22) { return ".swift"; }
    if (i == 23) { return ".rb"; }
    if (i == 24) { return ".php .phtml"; }
    if (i == 25) { return ".lua"; }
    if (i == 26) { return ".hs .lhs"; }
    if (i == 27) { return ".ml .mli"; }
    if (i == 28) { return ".ex .exs"; }
    if (i == 29) { return ".cr"; }
    if (i == 30) { return ".jl"; }
    if (i == 31) { return ".zig"; }
    if (i == 32) { return ".nix"; }
    if (i == 33) { return ".vue"; }
    if (i == 34) { return ".svelte"; }
    if (i == 35) { return ".ps1 .psm1 .psd1"; }
    if (i == 36) { return ".sql"; }
    if (i == 37) { return ".ini .conf .cfg .properties"; }
    if (i == 38) { return ".graphql .gql"; }
    if (i == 39) { return ".proto"; }
    if (i == 40) { return ".tf .tfvars .hcl"; }
    if (i == 41) { return ".s .asm"; }
    if (i == 42) { return ".ll"; }
    if (i == 43) { return ""; }
    if (i == 44) { return ""; }
    if (i == 45) { return ".qasm"; }
    return "";
}

# Space-separated **case-sensitive** basenames per language.
# Used for files with no conventional extension (Dockerfile,
# Makefile, GNUmakefile, …) or shell rc dotfiles where the
# convention is the literal filename, not a suffix. Probed
# *before* the extension table in `detect_language_from_path`,
# so a path like `subdir/Makefile` routes to `makefile`
# without first trying `_lang_path_ends_with_lower(".makefile")`
# (which wouldn't match the canonical capitalization anyway).
#
# Conventions encoded:
#   shell      — `.bashrc` / `.zshrc` / `.profile` family.
#                 Case-sensitive lowercase per shell convention.
#   dockerfile — `Dockerfile` (Docker spec canonical) plus
#                 lowercase + Podman's `Containerfile` alias.
#   makefile   — GNU Make's documented lookup order:
#                 `GNUmakefile` > `makefile` > `Makefile`.
#
# All other indices return "" — no basename match.
fn lang_basenames(i) {
    # Shell init dotfiles users actually edit. `.bash_logout`,
    # `.zlogin`, `.zlogout` excluded — rarely customized; can be
    # added later if asked. Line-length cap (120 chars) shapes
    # this list more than user research.
    if (i == 1)  { return ".bashrc .bash_profile .bash_aliases .zshrc .zprofile .zshenv .profile"; }
    if (i == 43) { return "Dockerfile dockerfile Containerfile containerfile"; }
    if (i == 44) { return "Makefile makefile GNUmakefile"; }
    return "";
}

# Case-folded suffix check: does `path` end with `ext` (lowercase)?
# Letter compare uses the add-32-if-A-to-Z trick — branchless lower-case.
fn _lang_path_ends_with_lower(path, ext) {
    var plen = strlen(path);
    var elen = strlen(ext);
    if (elen > plen) { return 0; }
    var pi = plen - elen;
    var ei = 0;
    while (ei < elen) {
        var pc = load8(path + pi + ei);
        var ec = load8(ext + ei);
        if (pc >= 65) { if (pc <= 90) { pc = pc + 32; } }
        if (pc != ec) { return 0; }
        ei = ei + 1;
    }
    return 1;
}

# Walk a space-separated extension list, return 1 if any extension
# matches `path`. Extensions are tokenized inline rather than split
# upfront — list strings are static lits, no allocation needed.
fn _lang_path_has_any_ext(path, list) {
    var llen = strlen(list);
    var i = 0;
    while (i < llen) {
        # Skip leading spaces.
        var skip = 1;
        while (skip == 1) {
            if (i >= llen) { skip = 0; }
            if (skip == 1) {
                if (load8(list + i) != 32) { skip = 0; }
                if (skip == 1) { i = i + 1; }
            }
        }
        if (i >= llen) { return 0; }

        var ebuf[32];
        var ei = 0;
        var collecting = 1;
        while (collecting == 1) {
            if (i >= llen) { collecting = 0; }
            if (collecting == 1) {
                if (load8(list + i) == 32) { collecting = 0; }
                if (collecting == 1) {
                    if (ei < 31) {
                        store8(&ebuf + ei, load8(list + i));
                        ei = ei + 1;
                    }
                    i = i + 1;
                }
            }
        }
        store8(&ebuf + ei, 0);
        if (_lang_path_ends_with_lower(path, &ebuf) == 1) { return 1; }
    }
    return 0;
}

# Case-sensitive basename equality with directory-boundary check.
# Returns 1 iff path's last segment (after the final '/' or path
# start) equals `name` byte-for-byte. Examples:
#   _lang_path_basename_eq("/etc/Dockerfile", "Dockerfile")   -> 1
#   _lang_path_basename_eq("Dockerfile",       "Dockerfile")   -> 1
#   _lang_path_basename_eq("foo.Dockerfile",   "Dockerfile")   -> 0  (preceded by '.', not '/')
#   _lang_path_basename_eq("dockerfile",       "Dockerfile")   -> 0  (case-sensitive)
fn _lang_path_basename_eq(path, name) {
    var plen = strlen(path);
    var nlen = strlen(name);
    if (nlen > plen) { return 0; }
    var bstart = plen - nlen;
    # Boundary: char before the basename must be '/' (47), or
    # the basename starts at position 0.
    if (bstart > 0) {
        if (load8(path + bstart - 1) != 47) { return 0; }
    }
    var i = 0;
    while (i < nlen) {
        if (load8(path + bstart + i) != load8(name + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Walk a space-separated **case-sensitive** basename list, return 1
# if any basename matches `path`. Mirrors `_lang_path_has_any_ext`'s
# inline-tokenization shape — no allocation, list is a static literal.
fn _lang_path_has_any_basename(path, list) {
    var llen = strlen(list);
    var i = 0;
    while (i < llen) {
        var skip = 1;
        while (skip == 1) {
            if (i >= llen) { skip = 0; }
            if (skip == 1) {
                if (load8(list + i) != 32) { skip = 0; }
                if (skip == 1) { i = i + 1; }
            }
        }
        if (i >= llen) { return 0; }

        var nbuf[64];
        var ni = 0;
        var collecting = 1;
        while (collecting == 1) {
            if (i >= llen) { collecting = 0; }
            if (collecting == 1) {
                if (load8(list + i) == 32) { collecting = 0; }
                if (collecting == 1) {
                    if (ni < 63) {
                        store8(&nbuf + ni, load8(list + i));
                        ni = ni + 1;
                    }
                    i = i + 1;
                }
            }
        }
        store8(&nbuf + ni, 0);
        if (_lang_path_basename_eq(path, &nbuf) == 1) { return 1; }
    }
    return 0;
}

# Look up a language by name. Returns the table index or -1.
fn lang_index(name) {
    var i = 0;
    while (i < LANG_COUNT) {
        if (streq(lang_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Is `name` one of the languages cyim routes? 1 / 0. A thin predicate over
# `lang_index` for callers that do not need the index.
fn lang_is_valid(name) {
    if (lang_index(name) >= 0) { return 1; }
    return 0;
}

# Map path → language name. Returns "plain" on no match.
#
# Two probes, in order:
#   1. Basename match (case-sensitive). Catches Dockerfile-class
#      filenames where the convention is the literal name, not
#      a suffix. Runs first so `Dockerfile` doesn't get tested
#      against (and miss) `.dockerfile`-as-extension.
#   2. Extension match (case-insensitive suffix). The original
#      probe; covers the bulk of the table.
#
# Index 0 is "plain" with empty basenames + exts, so the walks
# start at 1.
fn detect_language_from_path(path) {
    if (path == 0) { return "plain"; }
    # Probe 1: basenames.
    var bi = 1;
    while (bi < LANG_COUNT) {
        if (_lang_path_has_any_basename(path, lang_basenames(bi)) == 1) {
            return lang_name(bi);
        }
        bi = bi + 1;
    }
    # Probe 2: extensions.
    var i = 1;
    while (i < LANG_COUNT) {
        if (_lang_path_has_any_ext(path, lang_exts(i)) == 1) {
            return lang_name(i);
        }
        i = i + 1;
    }
    return "plain";
}
