# agnos_kbd.cyr — full-screen raw keyboard input for the agnos target
#
# agnos's blocking read(fd 0) is line-disciplined (canonical-lite): it cooks a
# whole line and echoes it, which is fatal for a full-screen modal editor. The
# kernel's real per-key channel is kbscan(#42): a NON-BLOCKING drain of the raw
# Set-1 scancode ring (make + break, 0xE0 extended prefixes preserved — the same
# primitive cyrius-doom's input_poll uses). This module turns that scancode
# stream into the exact byte stream a raw terminal would deliver — printable
# ASCII (shift/caps aware), ESC for Escape, CR for Enter, DEL for Backspace, TAB,
# Ctrl-letter control bytes, and ESC[A/B/C/D for the arrows — so cyim's existing
# editor_feed (src/mode.cyr) drives full-screen on agnos with no changes.
#
# The kernel keeps NO key-state (kbscan is a pure byte pipe), so modifier state
# (shift / ctrl / caps) is maintained HERE from make/break codes. Output bytes
# are produced only on make (key-down), matching a terminal's edge behaviour.
#
# WHOLE file is guarded by CYRIUS_TARGET_AGNOS — compiles to nothing elsewhere.

#ifdef CYRIUS_TARGET_AGNOS

# US-QWERTY Set-1 make-code → ASCII tables (index = scancode, 0 = unmapped),
# built once on first read. `_kbd_normal` is the unmodified glyph, `_kbd_shift`
# the shifted glyph. Letters live in _kbd_normal as lowercase; caps/shift upper-
# casing is derived at translate time so Caps Lock XOR Shift works.
var _kbd_normal = 0;
var _kbd_shift = 0;
var _kbd_inited = 0;

# Modifier + output-carry state.
var _kbd_shift_down = 0;
var _kbd_ctrl_down = 0;
var _kbd_caps = 0;
var _kbd_out = 0;         # heap carry buffer for translated bytes
var _kbd_out_cap = 256;
var _kbd_out_len = 0;
var _kbd_out_pos = 0;

fn _kb_map(sc, n, s) {
    store8(_kbd_normal + sc, n);
    store8(_kbd_shift + sc, s);
    return 0;
}

fn _kbd_init() {
    if (_kbd_inited == 1) { return 0; }
    _kbd_normal = alloc(128);
    _kbd_shift = alloc(128);
    _kbd_out = alloc(_kbd_out_cap);
    if (_kbd_normal == 0 || _kbd_shift == 0 || _kbd_out == 0) { return 0 - 1; }
    var i = 0;
    while (i < 128) { store8(_kbd_normal + i, 0); store8(_kbd_shift + i, 0); i = i + 1; }
    # number row
    _kb_map(0x02, 49, 33);  _kb_map(0x03, 50, 64);  _kb_map(0x04, 51, 35);
    _kb_map(0x05, 52, 36);  _kb_map(0x06, 53, 37);  _kb_map(0x07, 54, 94);
    _kb_map(0x08, 55, 38);  _kb_map(0x09, 56, 42);  _kb_map(0x0A, 57, 40);
    _kb_map(0x0B, 48, 41);  _kb_map(0x0C, 45, 95);  _kb_map(0x0D, 61, 43);
    # qwerty row
    _kb_map(0x10, 113, 81); _kb_map(0x11, 119, 87); _kb_map(0x12, 101, 69);
    _kb_map(0x13, 114, 82); _kb_map(0x14, 116, 84); _kb_map(0x15, 121, 89);
    _kb_map(0x16, 117, 85); _kb_map(0x17, 105, 73); _kb_map(0x18, 111, 79);
    _kb_map(0x19, 112, 80); _kb_map(0x1A, 91, 123); _kb_map(0x1B, 93, 125);
    # asdf row
    _kb_map(0x1E, 97, 65);  _kb_map(0x1F, 115, 83); _kb_map(0x20, 100, 68);
    _kb_map(0x21, 102, 70); _kb_map(0x22, 103, 71); _kb_map(0x23, 104, 72);
    _kb_map(0x24, 106, 74); _kb_map(0x25, 107, 75); _kb_map(0x26, 108, 76);
    _kb_map(0x27, 59, 58);  _kb_map(0x28, 39, 34);  _kb_map(0x29, 96, 126);
    _kb_map(0x2B, 92, 124);
    # zxcv row
    _kb_map(0x2C, 122, 90); _kb_map(0x2D, 120, 88); _kb_map(0x2E, 99, 67);
    _kb_map(0x2F, 118, 86); _kb_map(0x30, 98, 66);  _kb_map(0x31, 110, 78);
    _kb_map(0x32, 109, 77); _kb_map(0x33, 44, 60);  _kb_map(0x34, 46, 62);
    _kb_map(0x35, 47, 63);
    # space
    _kb_map(0x39, 32, 32);
    _kbd_inited = 1;
    return 0;
}

# Append one byte to the output carry buffer (drops silently if full — a 256-byte
# buffer holds a full 64-scancode batch even at 3 bytes/arrow).
fn _kbd_emit(ch) {
    if (_kbd_out_len < _kbd_out_cap) {
        store8(_kbd_out + _kbd_out_len, ch);
        _kbd_out_len = _kbd_out_len + 1;
    }
    return 0;
}

# Translate one MAKE scancode (`sc` masked to 7 bits; `ext`=1 if 0xE0-prefixed)
# into output bytes. Modifier keys update state and emit nothing.
fn _kbd_translate_make(sc, ext) {
    if (ext == 1) {
        if (sc == 0x1D) { _kbd_ctrl_down = 1; return 0; }   # right Ctrl
        if (sc == 0x48) { _kbd_emit(27); _kbd_emit(91); _kbd_emit(65); return 0; }  # up    -> ESC[A
        if (sc == 0x50) { _kbd_emit(27); _kbd_emit(91); _kbd_emit(66); return 0; }  # down  -> ESC[B
        if (sc == 0x4D) { _kbd_emit(27); _kbd_emit(91); _kbd_emit(67); return 0; }  # right -> ESC[C
        if (sc == 0x4B) { _kbd_emit(27); _kbd_emit(91); _kbd_emit(68); return 0; }  # left  -> ESC[D
        if (sc == 0x53) { _kbd_emit(127); return 0; }        # Delete -> DEL
        return 0;
    }
    if (sc == 0x2A || sc == 0x36) { _kbd_shift_down = 1; return 0; }   # Shift
    if (sc == 0x1D)               { _kbd_ctrl_down = 1; return 0; }    # left Ctrl
    if (sc == 0x3A)               { _kbd_caps = 1 - _kbd_caps; return 0; }  # CapsLock toggle
    if (sc == 0x01) { _kbd_emit(27);  return 0; }   # Esc
    if (sc == 0x1C) { _kbd_emit(13);  return 0; }   # Enter -> CR
    if (sc == 0x0E) { _kbd_emit(127); return 0; }   # Backspace -> DEL
    if (sc == 0x0F) { _kbd_emit(9);   return 0; }   # Tab

    var base = load8(_kbd_normal + sc);
    if (base == 0) { return 0; }
    # Ctrl + letter -> control byte (Ctrl-A = 1 ... Ctrl-Z = 26).
    if (_kbd_ctrl_down == 1) {
        if (base >= 97 && base <= 122) { _kbd_emit(base - 96); return 0; }
    }
    var ch = base;
    if (base >= 97 && base <= 122) {                # letter: caps XOR shift uppercases
        var up = _kbd_shift_down;
        if (_kbd_caps == 1) { up = 1 - up; }
        if (up == 1) { ch = base - 32; }
    } else {
        if (_kbd_shift_down == 1) {
            var sh = load8(_kbd_shift + sc);
            if (sh != 0) { ch = sh; }
        }
    }
    _kbd_emit(ch);
    return 0;
}

# Update modifier state on a BREAK (key-up). Only shift / ctrl matter; letters
# are edge-emitted on make, so their release is ignored.
fn _kbd_translate_break(sc, ext) {
    if (ext == 1) {
        if (sc == 0x1D) { _kbd_ctrl_down = 0; }     # right Ctrl up
        return 0;
    }
    if (sc == 0x2A || sc == 0x36) { _kbd_shift_down = 0; }   # Shift up
    if (sc == 0x1D)               { _kbd_ctrl_down = 0; }    # left Ctrl up
    return 0;
}

# Blocking per-key read, drop-in for `file_read(0, out, max)` in the editor loop.
# Drains kbscan#42, decodes make/break + modifiers into the carry buffer, and
# returns up to `max` translated bytes. Blocks (yielding a tick between empty
# polls) until at least one byte is produced — so the caller never busy-spins.
fn _agnos_kbd_read(out, max) {
    _kbd_init();
    # Drain any bytes still carried from the previous batch first.
    while (1 == 1) {
        if (_kbd_out_pos < _kbd_out_len) {
            var avail = _kbd_out_len - _kbd_out_pos;
            var take = avail;
            if (take > max) { take = max; }
            var k = 0;
            while (k < take) { store8(out + k, load8(_kbd_out + _kbd_out_pos + k)); k = k + 1; }
            _kbd_out_pos = _kbd_out_pos + take;
            if (_kbd_out_pos >= _kbd_out_len) { _kbd_out_len = 0; _kbd_out_pos = 0; }
            return take;
        }
        # Carry empty — poll the scancode ring.
        var scbuf[64];
        var n = syscall(42, &scbuf, 64);               # kbscan#42 (non-blocking)
        if (n <= 0) {
            syscall(41, 10);                           # sleep_ms#41 ~1 tick, then retry
        } else {
            _kbd_out_len = 0;
            _kbd_out_pos = 0;
            var i = 0;
            var ext = 0;
            while (i < n) {
                var sc = load8(&scbuf + i);
                i = i + 1;
                if (sc == 0xE0) { ext = 1; } else {
                    if (sc > 0x7F) { _kbd_translate_break(sc & 0x7F, ext); }
                    else { _kbd_translate_make(sc, ext); }
                    ext = 0;
                }
            }
            # If the whole batch was modifiers/breaks (no bytes), loop and poll again.
        }
    }
    return 0;
}

#endif
