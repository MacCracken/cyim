# main.cyr — cyim entry point
#
# Three command-line shapes:
#   cyim                — open scratch buffer
#   cyim <file>         — open <file>
#   cyim --probe        — TTY round-trip diagnostic (raw on / sleep / cooked off)
#   cyim --version      — print version and exit
#   cyim --help         — print usage and exit
#
# Main loop:
#   1. Render the frame (buffer + status + cursor).
#   2. Block on read(stdin, 1) — VMIN=1 / VTIME=0 from tty_raw.
#   3. editor_step(s, byte) dispatches + applies.
#   4. Exit when editor_quit(s) == 1 or stdin EOF.
#
# All TTY state changes wrap the loop: alt-screen on / raw on at start;
# alt-screen off / cooked on at exit. EOF and quit both fall through to
# the same teardown path.

include "lib/vyakarana.cyr"
include "src/buffer.cyr"
include "src/highlight.cyr"
include "src/lang.cyr"
include "src/cyimrc.cyr"
include "src/mode.cyr"
include "src/buflist.cyr"
include "src/window.cyr"
include "src/motion.cyr"
include "src/insert.cyr"
include "src/edit.cyr"
include "src/command.cyr"
include "src/search.cyr"
include "src/undo.cyr"
include "src/visual.cyr"
include "src/driver.cyr"
include "src/tty.cyr"
include "src/render.cyr"
include "src/cli.cyr"

var DEFAULT_ROWS = 24;
var DEFAULT_COLS = 80;

fn print_version() {
    syscall(1, 1, "cyim 1.1.4\n", 11);
    return 0;
}

fn print_help() {
    syscall(1, 1, "usage: cyim [<file>]                         (interactive)\n", 59);
    syscall(1, 1, "       cyim --version\n", 22);
    syscall(1, 1, "       cyim --help\n", 19);
    syscall(1, 1, "       cyim --probe                          (TTY round-trip diagnostic)\n", 73);
    syscall(1, 1, "       cyim --headless [<file>]              (read keystrokes from stdin; no TTY)\n", 82);
    syscall(1, 1, "       cyim --write <file>                   (replace <file> with stdin)\n", 73);
    syscall(1, 1, "       cyim --replace <old> <new> <file>     (substitute first; OLD must be unique)\n", 84);
    syscall(1, 1, "       cyim --replace-all <old> <new> <file> (substitute every occurrence)\n", 75);
    syscall(1, 1, "       cyim --replace-files <old-file> <new-file> <file>     (substitute first; OLD/NEW read from files; OLD must be unique)\n", 125);
    syscall(1, 1, "       cyim --replace-files-all <old-file> <new-file> <file> (substitute every occurrence; OLD/NEW read from files)\n", 116);
    syscall(1, 1, "       cyim --grep <pattern> <file>          (read-only; literal substring, not regex; emit FILE:N:LINE)\n", 105);
    syscall(1, 1, "       cyim --grepfiles <pattern> <file...> (read-only multi-file grep; same FILE:N:LINE shape)\n", 96);
    syscall(1, 1, "       cyim --batch <file>                   (apply NUL-separated OLD/NEW pairs from stdin; atomic)\n", 100);
    syscall(1, 1, "       --wc[=l|=long]      on --write/--replace[-all]/--batch: print wc(1) on success\n", 86);
    syscall(1, 1, "       --expect=<pat>      on --write/--batch: post-save assertion (exit 6 on miss)\n", 84);
    syscall(1, 1, "       --expect-not=<pat>  on --write/--batch: post-save assertion (exit 6 on hit)\n", 83);
    syscall(1, 1, "       --expect-N=<n>      on --replace[-all]: pre-sub count must equal N\n", 74);
    syscall(1, 1, "       --expect-1          on --replace[-all]: alias for --expect-N=1\n", 70);
    syscall(1, 1, "       --all               on --batch: each pair runs --replace-all\n", 68);
    syscall(1, 1, "       --context=<n>       on --grep/--grepfiles: emit N lines before+after each match (grep -C)\n", 97);
    return 0;
}

# Headless drive — non-interactive entry point. Reads keystroke bytes
# from stdin until EOF or `editor_quit` fires, runs the same dispatch
# + apply chain a TTY consumer takes, then exits. No `tty_raw`, no
# alt-screen, no per-frame render. The roadmap's "daimon-orchestrated
# agents" consumer plus any shell-driven editing harness lives here.
#
# Recipe:
#   printf 'iEDIT\x1b:wq\r' | cyim --headless file.cyr
#
# Notes:
#   - The buffer mutates in memory; `:w` is what persists to disk.
#     Forget the `:wq` and your edits stay only in the (now exited)
#     process.
#   - Exit code is 0 on graceful exit (either editor_quit fired or
#     stdin closed cleanly), non-zero only on file-load failure.
#   - Same dispatch chain as the TTY path — search / undo / dot /
#     visual / multi-window / multi-buffer all available.
fn run_headless(file_path) {
    var b = buf_new();
    var lang = "plain";
    if (file_path != 0) {
        if (file_exists(file_path) == 1) {
            buf_load_file(b, file_path);
            buf_move(b, 0);
        }
        lang = detect_language_from_path(file_path);
    }
    highlight_init();
    cyimrc_load();

    var s = editor_new(b);
    if (file_path != 0) {
        editor_set_file_path(s, file_path);
    }
    editor_set_modified(s, 0);
    if (cyimrc_cfg_ignorecase()   != 0 - 1) { editor_set_cfg_ignorecase(s, cyimrc_cfg_ignorecase()); }
    if (cyimrc_cfg_line_numbers() != 0 - 1) { editor_set_cfg_line_numbers(s, cyimrc_cfg_line_numbers()); }
    if (cyimrc_cfg_tabstop()      != 0 - 1) { editor_set_cfg_tabstop(s, cyimrc_cfg_tabstop()); }
    bl_init(s, b);
    window_init(s);

    var quit = 0;
    while (quit == 0) {
        var key_buf[1];
        var n = file_read(0, &key_buf, 1);
        if (n <= 0) {
            quit = 1;
        }
        if (quit == 0) {
            editor_step(s, load8(&key_buf));
            if (editor_quit(s) == 1) { quit = 1; }
        }
    }
    return 0;
}

fn run_editor(file_path) {
    var b = buf_new();
    var lang = "plain";
    if (file_path != 0) {
        if (file_exists(file_path) == 1) {
            buf_load_file(b, file_path);
            buf_move(b, 0);
        }
        lang = detect_language_from_path(file_path);
    }
    # Pre-load grammars from <exe-dir>/grammars/ (or ../grammars/) so the
    # tokenizer's lazy cwd-relative bootstrap doesn't depend on where the
    # user invoked cyim from.
    highlight_init();
    # Load `./.cyimrc` if it exists. Missing or empty file is a silent
    # no-op — bundled defaults apply.
    cyimrc_load();

    var s = editor_new(b);
    if (file_path != 0) {
        editor_set_file_path(s, file_path);
    }
    editor_set_modified(s, 0);
    # Copy any explicitly-set config keys from cyimrc into editor state.
    # Sentinel -1 means "not configured in file" — leave the default.
    if (cyimrc_cfg_ignorecase()   != 0 - 1) { editor_set_cfg_ignorecase(s, cyimrc_cfg_ignorecase()); }
    if (cyimrc_cfg_line_numbers() != 0 - 1) { editor_set_cfg_line_numbers(s, cyimrc_cfg_line_numbers()); }
    if (cyimrc_cfg_tabstop()      != 0 - 1) { editor_set_cfg_tabstop(s, cyimrc_cfg_tabstop()); }
    bl_init(s, b);
    window_init(s);

    if (tty_raw(0) < 0) {
        syscall(1, 2, "cyim: stdin is not a TTY\n", 25);
        return 1;
    }
    tty_alt_enter();

    var quit = 0;
    while (quit == 0) {
        # M2 cost note: full-buffer retokenize per frame. Acceptable for
        # M2 per the roadmap; an incremental retokenize lands when the
        # M5 perf pass surfaces a real workload that complains.
        var tb = highlight_buf(b, lang);
        render_frame(s, DEFAULT_ROWS, DEFAULT_COLS, tb);
        var key_buf[1];
        var n = file_read(0, &key_buf, 1);
        if (n <= 0) {
            quit = 1;
        }
        if (quit == 0) {
            editor_step(s, load8(&key_buf));
            if (editor_quit(s) == 1) { quit = 1; }
        }
    }

    tty_alt_leave();
    tty_cooked(0);
    return 0;
}

fn main() {
    alloc_init();
    args_init();
    _cli_args_reload_big();

    var ac = argc();
    var fpath = 0;
    if (ac > 1) {
        var a1 = argv(1);
        if (streq(a1, "--version")  == 1) { return print_version(); }
        if (streq(a1, "--help")     == 1) { return print_help(); }
        if (streq(a1, "--probe")    == 1) { return tty_probe(); }
        if (streq(a1, "--headless") == 1) {
            var hfp = 0;
            if (ac > 2) { hfp = argv(2); }
            return run_headless(hfp);
        }
        if (streq(a1, "--grep") == 1) {
            # Modifier-parsing dispatch (v1.1.4): --context=<n> is the
            # only modifier today; default 0 (no context) preserves the
            # v1.1.0–v1.1.3 single-line-per-match output bytes-for-bytes.
            var g_ctx = 0;
            var g_p0 = 0;
            var g_p1 = 0;
            var g_npos = 0;
            var g_ctx_seen = 0;
            var g_idx = 2;
            while (g_idx < ac) {
                var arg = argv(g_idx);
                var consumed = 0;
                if (consumed == 0) {
                    var sc = _cli_argprefix(arg, "--context=");
                    if (sc != 0) {
                        var nc = _cli_atoi_nn(sc);
                        if (nc < 0) {
                            syscall(1, 2, "cyim --grep: --context requires a non-negative integer\n", 56);
                            return 2;
                        }
                        if (g_ctx_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --context\n", 32); return 2; }
                        g_ctx = nc;
                        g_ctx_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    if (g_npos == 0) { g_p0 = arg; }
                    if (g_npos == 1) { g_p1 = arg; }
                    if (g_npos >= 2) {
                        syscall(1, 2, "cyim --grep: unexpected extra argument\n", 40);
                        return 2;
                    }
                    g_npos = g_npos + 1;
                }
                g_idx = g_idx + 1;
            }
            if (g_npos < 2) {
                syscall(1, 2, "usage: cyim --grep [--context=<n>] <pattern> <file>\n", 53);
                return 2;
            }
            return run_grep(g_p0, g_p1, g_ctx);
        }
        if (streq(a1, "--grepfiles") == 1) {
            # Multi-file grep. PATTERN is the first non-flag positional;
            # every subsequent non-flag arg is a FILE. --context=<n>
            # threads through to _cli_grep_one with cross-file separator
            # handling (matches `grep -n -C N` output for two+ files).
            var gf_ctx = 0;
            var gf_pat = 0;
            var gf_pat_seen = 0;
            var gf_ctx_seen = 0;
            var gf_alloc_n = (ac - 2) * 8;
            if (gf_alloc_n < 8) { gf_alloc_n = 8; }
            var gf_files = alloc(gf_alloc_n);
            var gf_fcount = 0;
            var gf_idx = 2;
            while (gf_idx < ac) {
                var arg = argv(gf_idx);
                var consumed = 0;
                if (consumed == 0) {
                    var sc = _cli_argprefix(arg, "--context=");
                    if (sc != 0) {
                        var nc = _cli_atoi_nn(sc);
                        if (nc < 0) {
                            syscall(1, 2, "cyim --grepfiles: --context requires a non-negative integer\n", 61);
                            return 2;
                        }
                        if (gf_ctx_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --context\n", 32); return 2; }
                        gf_ctx = nc;
                        gf_ctx_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    if (gf_pat_seen == 0) {
                        gf_pat = arg;
                        gf_pat_seen = 1;
                    } else {
                        store64(gf_files + gf_fcount * 8, arg);
                        gf_fcount = gf_fcount + 1;
                    }
                }
                gf_idx = gf_idx + 1;
            }
            if (gf_pat_seen == 0) {
                syscall(1, 2, "usage: cyim --grepfiles [--context=<n>] <pattern> <file...>\n", 61);
                return 2;
            }
            if (gf_fcount == 0) {
                syscall(1, 2, "usage: cyim --grepfiles [--context=<n>] <pattern> <file...>\n", 61);
                return 2;
            }
            return run_grepfiles(gf_pat, gf_files, gf_fcount, gf_ctx);
        }
        if (streq(a1, "--write") == 1) {
            # Modifiers (--wc[=l|=long], --expect=<pat>, --expect-not=<pat>)
            # and the FILE positional may interleave in any order after the
            # verb. v1.1.0 only consumed modifiers from the front of argv,
            # so `cyim --write FILE --wc=l` silently dropped the trailing
            # flag (treated as a stray after-positional arg).
            var w_wc = 0;
            var w_expect = 0;
            var w_expect_pol = 0;
            var w_pos0 = 0;
            var w_npos = 0;
            var w_wc_seen = 0;
            var w_expect_seen = 0;
            var w_idx = 2;
            while (w_idx < ac) {
                var arg = argv(w_idx);
                var consumed = 0;
                if (streq(arg, "--wc")      == 1) {
                    if (w_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    w_wc = 1; w_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=l")    == 1) {
                    if (w_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    w_wc = 2; w_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=long") == 1) {
                    if (w_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    w_wc = 2; w_wc_seen = 1; consumed = 1;
                }
                if (consumed == 0) {
                    var s1 = _cli_argprefix(arg, "--expect=");
                    if (s1 != 0) {
                        if (strlen(s1) == 0) {
                            syscall(1, 2, "cyim --write: --expect requires a non-empty pattern\n", 52);
                            return 2;
                        }
                        if (w_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect\n", 31); return 2; }
                        w_expect = s1;
                        w_expect_pol = 1;
                        w_expect_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    var s2 = _cli_argprefix(arg, "--expect-not=");
                    if (s2 != 0) {
                        if (strlen(s2) == 0) {
                            syscall(1, 2, "cyim --write: --expect-not requires a non-empty pattern\n", 56);
                            return 2;
                        }
                        if (w_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-not\n", 35); return 2; }
                        w_expect = s2;
                        w_expect_pol = 2;
                        w_expect_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    if (w_npos > 0) {
                        syscall(1, 2, "cyim --write: unexpected extra argument\n", 40);
                        return 2;
                    }
                    w_pos0 = arg;
                    w_npos = 1;
                }
                w_idx = w_idx + 1;
            }
            return run_write(w_pos0, w_wc, w_expect, w_expect_pol);
        }
        if (streq(a1, "--replace") == 1) {
            # Modifiers and the OLD/NEW/FILE positionals may interleave in
            # any order after the verb. v1.1.0 bailed at the first non-flag
            # arg, so a trailing modifier (e.g. `--replace OLD NEW
            # --expect-1 FILE`) was misread as FILE, and the actual FILE
            # was dropped — surfacing as exit-3 "file not found".
            var r_wc = 0;
            var r_expect_n = 0 - 1;
            var r_p0 = 0;
            var r_p1 = 0;
            var r_p2 = 0;
            var r_npos = 0;
            var r_wc_seen = 0;
            var r_expect_seen = 0;
            var r_idx = 2;
            while (r_idx < ac) {
                var arg = argv(r_idx);
                var consumed = 0;
                if (streq(arg, "--wc")        == 1) {
                    if (r_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    r_wc = 1; r_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=l")      == 1) {
                    if (r_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    r_wc = 2; r_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=long")   == 1) {
                    if (r_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    r_wc = 2; r_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--expect-1")  == 1) {
                    if (r_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-1\n", 33); return 2; }
                    r_expect_n = 1; r_expect_seen = 1; consumed = 1;
                }
                if (consumed == 0) {
                    var s = _cli_argprefix(arg, "--expect-N=");
                    if (s != 0) {
                        var n = _cli_atoi_nn(s);
                        if (n < 0) {
                            syscall(1, 2, "cyim --replace: --expect-N requires a non-negative integer\n", 59);
                            return 2;
                        }
                        if (r_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-N\n", 33); return 2; }
                        r_expect_n = n;
                        r_expect_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    if (r_npos == 0) { r_p0 = arg; }
                    if (r_npos == 1) { r_p1 = arg; }
                    if (r_npos == 2) { r_p2 = arg; }
                    if (r_npos >= 3) {
                        syscall(1, 2, "cyim --replace: unexpected extra argument\n", 42);
                        return 2;
                    }
                    r_npos = r_npos + 1;
                }
                r_idx = r_idx + 1;
            }
            if (r_npos < 3) {
                syscall(1, 2, "usage: cyim --replace [--wc[=l]] [--expect-N=<n>|--expect-1] <old> <new> <file>\n", 80);
                return 2;
            }
            return run_replace(r_p0, r_p1, r_p2, 0, r_wc, r_expect_n);
        }
        if (streq(a1, "--replace-all") == 1) {
            # Same interspersed-modifier semantics as --replace.
            var ra_wc = 0;
            var ra_expect_n = 0 - 1;
            var ra_p0 = 0;
            var ra_p1 = 0;
            var ra_p2 = 0;
            var ra_npos = 0;
            var ra_wc_seen = 0;
            var ra_expect_seen = 0;
            var ra_idx = 2;
            while (ra_idx < ac) {
                var arg = argv(ra_idx);
                var consumed = 0;
                if (streq(arg, "--wc")        == 1) {
                    if (ra_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    ra_wc = 1; ra_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=l")      == 1) {
                    if (ra_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    ra_wc = 2; ra_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=long")   == 1) {
                    if (ra_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    ra_wc = 2; ra_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--expect-1")  == 1) {
                    if (ra_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-1\n", 33); return 2; }
                    ra_expect_n = 1; ra_expect_seen = 1; consumed = 1;
                }
                if (consumed == 0) {
                    var s = _cli_argprefix(arg, "--expect-N=");
                    if (s != 0) {
                        var n = _cli_atoi_nn(s);
                        if (n < 0) {
                            syscall(1, 2, "cyim --replace-all: --expect-N requires a non-negative integer\n", 63);
                            return 2;
                        }
                        if (ra_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-N\n", 33); return 2; }
                        ra_expect_n = n;
                        ra_expect_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    if (ra_npos == 0) { ra_p0 = arg; }
                    if (ra_npos == 1) { ra_p1 = arg; }
                    if (ra_npos == 2) { ra_p2 = arg; }
                    if (ra_npos >= 3) {
                        syscall(1, 2, "cyim --replace-all: unexpected extra argument\n", 46);
                        return 2;
                    }
                    ra_npos = ra_npos + 1;
                }
                ra_idx = ra_idx + 1;
            }
            if (ra_npos < 3) {
                syscall(1, 2, "usage: cyim --replace-all [--wc[=l]] [--expect-N=<n>|--expect-1] <old> <new> <file>\n", 84);
                return 2;
            }
            return run_replace(ra_p0, ra_p1, ra_p2, 1, ra_wc, ra_expect_n);
        }
        if (streq(a1, "--replace-files") == 1) {
            # OLD/NEW are FILE PATHS, not byte strings — content is
            # slurped by run_replace_files. Modifier shape and
            # positional order match --replace exactly so callers can
            # one-line port a `--replace OLD NEW FILE` invocation by
            # writing OLD/NEW to disk and switching the verb.
            var rf_wc = 0;
            var rf_expect_n = 0 - 1;
            var rf_p0 = 0;
            var rf_p1 = 0;
            var rf_p2 = 0;
            var rf_npos = 0;
            var rf_wc_seen = 0;
            var rf_expect_seen = 0;
            var rf_idx = 2;
            while (rf_idx < ac) {
                var arg = argv(rf_idx);
                var consumed = 0;
                if (streq(arg, "--wc")        == 1) {
                    if (rf_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    rf_wc = 1; rf_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=l")      == 1) {
                    if (rf_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    rf_wc = 2; rf_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=long")   == 1) {
                    if (rf_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    rf_wc = 2; rf_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--expect-1")  == 1) {
                    if (rf_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-1\n", 33); return 2; }
                    rf_expect_n = 1; rf_expect_seen = 1; consumed = 1;
                }
                if (consumed == 0) {
                    var s = _cli_argprefix(arg, "--expect-N=");
                    if (s != 0) {
                        var n = _cli_atoi_nn(s);
                        if (n < 0) {
                            syscall(1, 2, "cyim --replace-files: --expect-N requires a non-negative integer\n", 65);
                            return 2;
                        }
                        if (rf_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-N\n", 33); return 2; }
                        rf_expect_n = n;
                        rf_expect_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    if (rf_npos == 0) { rf_p0 = arg; }
                    if (rf_npos == 1) { rf_p1 = arg; }
                    if (rf_npos == 2) { rf_p2 = arg; }
                    if (rf_npos >= 3) {
                        syscall(1, 2, "cyim --replace-files: unexpected extra argument\n", 48);
                        return 2;
                    }
                    rf_npos = rf_npos + 1;
                }
                rf_idx = rf_idx + 1;
            }
            if (rf_npos < 3) {
                syscall(1, 2, "usage: cyim --replace-files [--wc[=l]] [--expect-N=<n>|--expect-1] <old-file> <new-file> <file>\n", 96);
                return 2;
            }
            return run_replace_files(rf_p0, rf_p1, rf_p2, 0, rf_wc, rf_expect_n);
        }
        if (streq(a1, "--replace-files-all") == 1) {
            # Same shape as --replace-files, mode = REPLACE_ALL.
            var rfa_wc = 0;
            var rfa_expect_n = 0 - 1;
            var rfa_p0 = 0;
            var rfa_p1 = 0;
            var rfa_p2 = 0;
            var rfa_npos = 0;
            var rfa_wc_seen = 0;
            var rfa_expect_seen = 0;
            var rfa_idx = 2;
            while (rfa_idx < ac) {
                var arg = argv(rfa_idx);
                var consumed = 0;
                if (streq(arg, "--wc")        == 1) {
                    if (rfa_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    rfa_wc = 1; rfa_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=l")      == 1) {
                    if (rfa_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    rfa_wc = 2; rfa_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=long")   == 1) {
                    if (rfa_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    rfa_wc = 2; rfa_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--expect-1")  == 1) {
                    if (rfa_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-1\n", 33); return 2; }
                    rfa_expect_n = 1; rfa_expect_seen = 1; consumed = 1;
                }
                if (consumed == 0) {
                    var s = _cli_argprefix(arg, "--expect-N=");
                    if (s != 0) {
                        var n = _cli_atoi_nn(s);
                        if (n < 0) {
                            syscall(1, 2, "cyim --replace-files-all: --expect-N requires a non-negative integer\n", 69);
                            return 2;
                        }
                        if (rfa_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-N\n", 33); return 2; }
                        rfa_expect_n = n;
                        rfa_expect_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    if (rfa_npos == 0) { rfa_p0 = arg; }
                    if (rfa_npos == 1) { rfa_p1 = arg; }
                    if (rfa_npos == 2) { rfa_p2 = arg; }
                    if (rfa_npos >= 3) {
                        syscall(1, 2, "cyim --replace-files-all: unexpected extra argument\n", 52);
                        return 2;
                    }
                    rfa_npos = rfa_npos + 1;
                }
                rfa_idx = rfa_idx + 1;
            }
            if (rfa_npos < 3) {
                syscall(1, 2, "usage: cyim --replace-files-all [--wc[=l]] [--expect-N=<n>|--expect-1] <old-file> <new-file> <file>\n", 100);
                return 2;
            }
            return run_replace_files(rfa_p0, rfa_p1, rfa_p2, 1, rfa_wc, rfa_expect_n);
        }
        if (streq(a1, "--batch") == 1) {
            # Modifiers and the FILE positional may interleave in any
            # order after the verb (same parser shape as --write).
            var ba_wc = 0;
            var ba_expect = 0;
            var ba_expect_pol = 0;
            var ba_mode = 0;
            var ba_pos0 = 0;
            var ba_npos = 0;
            var ba_wc_seen = 0;
            var ba_expect_seen = 0;
            var ba_all_seen = 0;
            var ba_idx = 2;
            while (ba_idx < ac) {
                var arg = argv(ba_idx);
                var consumed = 0;
                if (streq(arg, "--wc")      == 1) {
                    if (ba_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    ba_wc = 1; ba_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=l")    == 1) {
                    if (ba_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    ba_wc = 2; ba_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=long") == 1) {
                    if (ba_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    ba_wc = 2; ba_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--all")     == 1) {
                    if (ba_all_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --all\n", 28); return 2; }
                    ba_mode = 1; ba_all_seen = 1; consumed = 1;
                }
                if (consumed == 0) {
                    var s1 = _cli_argprefix(arg, "--expect=");
                    if (s1 != 0) {
                        if (strlen(s1) == 0) {
                            syscall(1, 2, "cyim --batch: --expect requires a non-empty pattern\n", 52);
                            return 2;
                        }
                        if (ba_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect\n", 31); return 2; }
                        ba_expect = s1;
                        ba_expect_pol = 1;
                        ba_expect_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    var s2 = _cli_argprefix(arg, "--expect-not=");
                    if (s2 != 0) {
                        if (strlen(s2) == 0) {
                            syscall(1, 2, "cyim --batch: --expect-not requires a non-empty pattern\n", 56);
                            return 2;
                        }
                        if (ba_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-not\n", 35); return 2; }
                        ba_expect = s2;
                        ba_expect_pol = 2;
                        ba_expect_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    if (ba_npos > 0) {
                        syscall(1, 2, "cyim --batch: unexpected extra argument\n", 40);
                        return 2;
                    }
                    ba_pos0 = arg;
                    ba_npos = 1;
                }
                ba_idx = ba_idx + 1;
            }
            if (ba_npos < 1) {
                syscall(1, 2, "usage: cyim --batch [--wc[=l]] [--expect=<pat>|--expect-not=<pat>] [--all] <file>\n", 82);
                return 2;
            }
            return run_batch(ba_pos0, ba_mode, ba_wc, ba_expect, ba_expect_pol);
        }
        fpath = a1;
    }
    return run_editor(fpath);
}

var exit_code = main();
syscall(60, exit_code);
