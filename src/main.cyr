# main.cyr — cyim entry point
#
# Three command-line shapes:
#   cyim                — open scratch buffer
#   cyim <file>         — open <file>
#   cyim --probe        — TTY round-trip diagnostic (raw on / sleep / cooked off)
#   cyim --version      — print version and exit
#   cyim --help         — print usage and exit
#
# Main loop:
#   1. Render the frame (buffer + status + cursor).
#   2. Block on read(stdin, 1) — VMIN=1 / VTIME=0 from tty_raw.
#   3. editor_step(s, byte) dispatches + applies.
#   4. Exit when editor_quit(s) == 1 or stdin EOF.
#
# All TTY state changes wrap the loop: alt-screen on / raw on at start;
# alt-screen off / cooked on at exit. EOF and quit both fall through to
# the same teardown path.

include "lib/vyakarana.cyr"
include "src/buffer.cyr"
include "src/highlight.cyr"
include "src/lang.cyr"
include "src/cyimrc.cyr"
include "src/mode.cyr"
include "src/buflist.cyr"
include "src/window.cyr"
include "src/motion.cyr"
include "src/insert.cyr"
include "src/edit.cyr"
include "src/command.cyr"
include "src/search.cyr"
include "src/undo.cyr"
include "src/visual.cyr"
include "src/driver.cyr"
include "src/tty.cyr"
include "src/render.cyr"
include "src/cli.cyr"

var DEFAULT_ROWS = 24;
var DEFAULT_COLS = 80;

fn print_version() {
    syscall(1, 1, "cyim 1.2.0\n", 11);
    return 0;
}

fn print_help() {
    syscall(1, 1, "usage: cyim [<file>]                         (interactive)\n", 59);
    syscall(1, 1, "       cyim --version\n", 22);
    syscall(1, 1, "       cyim --help\n", 19);
    syscall(1, 1, "       cyim --probe                          (TTY round-trip diagnostic)\n", 73);
    syscall(1, 1, "       cyim --headless [<file>]              (read keystrokes from stdin; no TTY)\n", 82);
    syscall(1, 1, "       cyim --write <file>                   (replace <file> with stdin)\n", 73);
    syscall(1, 1, "       cyim --replace <old> <new> <file>     (substitute first; OLD must be unique)\n", 84);
    syscall(1, 1, "       cyim --replace-all <old> <new> <file> (substitute every occurrence)\n", 75);
    syscall(1, 1, "       cyim --replace-files <old-file> <new-file> <file>     ", 61);
    syscall(1, 1, "(substitute first; OLD/NEW read from files; OLD must be unique)\n", 64);
    syscall(1, 1, "       cyim --replace-files-all <old-file> <new-file> <file> ", 61);
    syscall(1, 1, "(substitute every occurrence; OLD/NEW read from files)\n", 55);
    syscall(1, 1, "       cyim --grep <pattern> <file>          (read-only; ", 57);
    syscall(1, 1, "literal substring by default; --regex=<flavor> for regex; emit FILE:N:LINE)\n", 76);
    syscall(1, 1, "       cyim --grepfiles <pattern> <file...> (read-only multi-file ", 66);
    syscall(1, 1, "grep; same FILE:N:LINE shape)\n", 30);
    syscall(1, 1, "       cyim --batch <file>                   (apply NUL-separated ", 66);
    syscall(1, 1, "OLD/NEW pairs from stdin; atomic)\n", 34);
    syscall(1, 1, "       --wc[=l|=long]      on --write/--replace[-all]/--batch: print wc(1) on success\n", 86);
    syscall(1, 1, "       --expect=<pat>      on --write/--batch: post-save assertion (exit 6 on miss)\n", 84);
    syscall(1, 1, "       --expect-not=<pat>  on --write/--batch: post-save assertion (exit 6 on hit)\n", 83);
    syscall(1, 1, "       --expect-N=<n>      on --replace[-all]: pre-sub count must equal N\n", 74);
    syscall(1, 1, "       --expect-1          on --replace[-all]: alias for --expect-N=1\n", 70);
    syscall(1, 1, "       --all               on --batch: each pair runs --replace-all\n", 68);
    syscall(1, 1, "       --context=<n>       on --grep/--grepfiles: ", 50);
    syscall(1, 1, "emit N lines before+after each match (grep -C)\n", 47);
    syscall(1, 1, "       --regex=<flavor>    on ", 30);
    syscall(1, 1, "--grep/--grepfiles/--replace[-all]/--replace-files[-all]: ", 58);
    syscall(1, 1, "pattern is a regex (only flavor supported today: ere)\n", 54);
    return 0;
}

# Headless drive — non-interactive entry point. Reads keystroke bytes
# from stdin until EOF or `editor_quit` fires, runs the same dispatch
# + apply chain a TTY consumer takes, then exits. No `tty_raw`, no
# alt-screen, no per-frame render. The roadmap's "daimon-orchestrated
# agents" consumer plus any shell-driven editing harness lives here.
#
# Recipe:
#   printf 'iEDIT\x1b:wq\r' | cyim --headless file.cyr
#
# Notes:
#   - The buffer mutates in memory; `:w` is what persists to disk.
#     Forget the `:wq` and your edits stay only in the (now exited)
#     process.
#   - Exit code is 0 on graceful exit (either editor_quit fired or
#     stdin closed cleanly), non-zero only on file-load failure.
#   - Same dispatch chain as the TTY path — search / undo / dot /
#     visual / multi-window / multi-buffer all available.
fn run_headless(file_path) {
    var b = buf_new();
    var lang = "plain";
    if (file_path != 0) {
        if (file_exists(file_path) == 1) {
            buf_load_file(b, file_path);
            buf_move(b, 0);
        }
        lang = detect_language_from_path(file_path);
    }
    highlight_init();
    cyimrc_load();

    var s = editor_new(b);
    if (file_path != 0) {
        editor_set_file_path(s, file_path);
    }
    editor_set_modified(s, 0);
    if (cyimrc_cfg_ignorecase()   != 0 - 1) { editor_set_cfg_ignorecase(s, cyimrc_cfg_ignorecase()); }
    if (cyimrc_cfg_line_numbers() != 0 - 1) { editor_set_cfg_line_numbers(s, cyimrc_cfg_line_numbers()); }
    if (cyimrc_cfg_tabstop()      != 0 - 1) { editor_set_cfg_tabstop(s, cyimrc_cfg_tabstop()); }
    bl_init(s, b);
    window_init(s);

    var quit = 0;
    while (quit == 0) {
        var key_buf[1];
        var n = file_read(0, &key_buf, 1);
        if (n <= 0) {
            quit = 1;
        }
        if (quit == 0) {
            editor_step(s, load8(&key_buf));
            if (editor_quit(s) == 1) { quit = 1; }
        }
    }
    return 0;
}

fn run_editor(file_path) {
    var b = buf_new();
    var lang = "plain";
    if (file_path != 0) {
        if (file_exists(file_path) == 1) {
            buf_load_file(b, file_path);
            buf_move(b, 0);
        }
        lang = detect_language_from_path(file_path);
    }
    # Pre-load grammars from <exe-dir>/grammars/ (or ../grammars/) so the
    # tokenizer's lazy cwd-relative bootstrap doesn't depend on where the
    # user invoked cyim from.
    highlight_init();
    # Load `./.cyimrc` if it exists. Missing or empty file is a silent
    # no-op — bundled defaults apply.
    cyimrc_load();

    var s = editor_new(b);
    if (file_path != 0) {
        editor_set_file_path(s, file_path);
    }
    editor_set_modified(s, 0);
    # Copy any explicitly-set config keys from cyimrc into editor state.
    # Sentinel -1 means "not configured in file" — leave the default.
    if (cyimrc_cfg_ignorecase()   != 0 - 1) { editor_set_cfg_ignorecase(s, cyimrc_cfg_ignorecase()); }
    if (cyimrc_cfg_line_numbers() != 0 - 1) { editor_set_cfg_line_numbers(s, cyimrc_cfg_line_numbers()); }
    if (cyimrc_cfg_tabstop()      != 0 - 1) { editor_set_cfg_tabstop(s, cyimrc_cfg_tabstop()); }
    bl_init(s, b);
    window_init(s);

    if (tty_raw(0) < 0) {
        syscall(1, 2, "cyim: stdin is not a TTY\n", 25);
        return 1;
    }
    tty_alt_enter();

    var quit = 0;
    while (quit == 0) {
        # M2 cost note: full-buffer retokenize per frame. Acceptable for
        # M2 per the roadmap; an incremental retokenize lands when the
        # M5 perf pass surfaces a real workload that complains.
        var tb = highlight_buf(b, lang);
        render_frame(s, DEFAULT_ROWS, DEFAULT_COLS, tb);
        var key_buf[1];
        var n = file_read(0, &key_buf, 1);
        if (n <= 0) {
            quit = 1;
        }
        if (quit == 0) {
            editor_step(s, load8(&key_buf));
            if (editor_quit(s) == 1) { quit = 1; }
        }
    }

    tty_alt_leave();
    tty_cooked(0);
    return 0;
}

fn main() {
    alloc_init();
    args_init();
    _cli_args_reload_big();

    var ac = argc();
    var fpath = 0;
    if (ac > 1) {
        var a1 = argv(1);
        if (streq(a1, "--version")  == 1) { return print_version(); }
        if (streq(a1, "--help")     == 1) { return print_help(); }
        if (streq(a1, "--probe")    == 1) { return tty_probe(); }
        if (streq(a1, "--headless") == 1) {
            var hfp = 0;
            if (ac > 2) { hfp = argv(2); }
            return run_headless(hfp);
        }
        if (streq(a1, "--grep") == 1) {
            return _dispatch_grep(ac);
        }
        if (streq(a1, "--grepfiles") == 1) {
            return _dispatch_grepfiles(ac);
        }
        if (streq(a1, "--write") == 1) {
            # Modifiers (--wc[=l|=long], --expect=<pat>, --expect-not=<pat>)
            # and the FILE positional may interleave in any order after the
            # verb. v1.1.0 only consumed modifiers from the front of argv,
            # so `cyim --write FILE --wc=l` silently dropped the trailing
            # flag (treated as a stray after-positional arg).
            var w_wc = 0;
            var w_expect = 0;
            var w_expect_pol = 0;
            var w_pos0 = 0;
            var w_npos = 0;
            var w_wc_seen = 0;
            var w_expect_seen = 0;
            var w_idx = 2;
            while (w_idx < ac) {
                var arg = argv(w_idx);
                var consumed = 0;
                if (streq(arg, "--wc")      == 1) {
                    if (w_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    w_wc = 1; w_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=l")    == 1) {
                    if (w_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    w_wc = 2; w_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=long") == 1) {
                    if (w_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    w_wc = 2; w_wc_seen = 1; consumed = 1;
                }
                if (consumed == 0) {
                    var s1 = _cli_argprefix(arg, "--expect=");
                    if (s1 != 0) {
                        if (strlen(s1) == 0) {
                            syscall(1, 2, "cyim --write: --expect requires a non-empty pattern\n", 52);
                            return 2;
                        }
                        if (w_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect\n", 31); return 2; }
                        w_expect = s1;
                        w_expect_pol = 1;
                        w_expect_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    var s2 = _cli_argprefix(arg, "--expect-not=");
                    if (s2 != 0) {
                        if (strlen(s2) == 0) {
                            syscall(1, 2, "cyim --write: --expect-not requires a non-empty pattern\n", 56);
                            return 2;
                        }
                        if (w_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-not\n", 35); return 2; }
                        w_expect = s2;
                        w_expect_pol = 2;
                        w_expect_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    if (w_npos > 0) {
                        syscall(1, 2, "cyim --write: unexpected extra argument\n", 40);
                        return 2;
                    }
                    w_pos0 = arg;
                    w_npos = 1;
                }
                w_idx = w_idx + 1;
            }
            return run_write(w_pos0, w_wc, w_expect, w_expect_pol);
        }
        if (streq(a1, "--replace") == 1) {
            return _dispatch_replace(ac);
        }
        if (streq(a1, "--replace-all") == 1) {
            return _dispatch_replace_all(ac);
        }
        if (streq(a1, "--replace-files") == 1) {
            return _dispatch_replace_files(ac);
        }
        if (streq(a1, "--replace-files-all") == 1) {
            return _dispatch_replace_files_all(ac);
        }
        if (streq(a1, "--batch") == 1) {
            # Modifiers and the FILE positional may interleave in any
            # order after the verb (same parser shape as --write).
            var ba_wc = 0;
            var ba_expect = 0;
            var ba_expect_pol = 0;
            var ba_mode = 0;
            var ba_pos0 = 0;
            var ba_npos = 0;
            var ba_wc_seen = 0;
            var ba_expect_seen = 0;
            var ba_all_seen = 0;
            var ba_idx = 2;
            while (ba_idx < ac) {
                var arg = argv(ba_idx);
                var consumed = 0;
                if (streq(arg, "--wc")      == 1) {
                    if (ba_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    ba_wc = 1; ba_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=l")    == 1) {
                    if (ba_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    ba_wc = 2; ba_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--wc=long") == 1) {
                    if (ba_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                    ba_wc = 2; ba_wc_seen = 1; consumed = 1;
                }
                if (streq(arg, "--all")     == 1) {
                    if (ba_all_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --all\n", 28); return 2; }
                    ba_mode = 1; ba_all_seen = 1; consumed = 1;
                }
                if (consumed == 0) {
                    var s1 = _cli_argprefix(arg, "--expect=");
                    if (s1 != 0) {
                        if (strlen(s1) == 0) {
                            syscall(1, 2, "cyim --batch: --expect requires a non-empty pattern\n", 52);
                            return 2;
                        }
                        if (ba_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect\n", 31); return 2; }
                        ba_expect = s1;
                        ba_expect_pol = 1;
                        ba_expect_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    var s2 = _cli_argprefix(arg, "--expect-not=");
                    if (s2 != 0) {
                        if (strlen(s2) == 0) {
                            syscall(1, 2, "cyim --batch: --expect-not requires a non-empty pattern\n", 56);
                            return 2;
                        }
                        if (ba_expect_seen == 1) {
                            syscall(1, 2, "cyim: duplicate flag: --expect-not\n", 35);
                            return 2;
                        }
                        ba_expect = s2;
                        ba_expect_pol = 2;
                        ba_expect_seen = 1;
                        consumed = 1;
                    }
                }
                if (consumed == 0) {
                    if (ba_npos > 0) {
                        syscall(1, 2, "cyim --batch: unexpected extra argument\n", 40);
                        return 2;
                    }
                    ba_pos0 = arg;
                    ba_npos = 1;
                }
                ba_idx = ba_idx + 1;
            }
            if (ba_npos < 1) {
                syscall(1, 2, "usage: cyim --batch [--wc[=l]] [--expect=<pat>|--expect-not=<pat>] ", 67);
                syscall(1, 2, "[--all] <file>\n", 15);
                return 2;
            }
            return run_batch(ba_pos0, ba_mode, ba_wc, ba_expect, ba_expect_pol);
        }
        fpath = a1;
    }
    return run_editor(fpath);
}

var exit_code = main();
syscall(60, exit_code);
