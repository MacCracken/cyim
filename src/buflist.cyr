# buflist.cyr — buffer registry (per-editor list of open buffers)
#
# A "buffer entry" bundles the gap-buffer plus its file path and modified
# state. The editor holds a vec of these and an active index. Switching
# buffers snapshots the editor's per-buffer fields into the previous
# active slot and loads the new slot's fields back into the editor.
#
# Editor-global fields (mode, keymap, cmdbuf, quit, last_error) stay on
# the editor; they don't follow buffers. Per-buffer fields (buf,
# file_path, modified) live in slot records and the editor's matching
# offsets are kept in sync as a fast-path mirror — most code keeps
# calling `editor_buf(s)` etc. and never has to know there's a
# registry behind it.
#
# Required include order: alloc / vec stdlib → src/mode.cyr → this file
# (this file uses editor_buf / editor_modified / editor_file_path).

# ── Buffer record (40 B)
#   off  0  buf          gap-buffer ptr (or 0)
#   off  8  file_path    cstr or 0
#   off 16  modified     i64
#   off 24  undo_stack   vec of Snapshot records (or 0 = not init'd)
#   off 32  redo_stack   vec of Snapshot records (or 0 = not init'd)
#
# undo / redo stacks are populated by src/undo.cyr — buflist owns the
# storage slots, undo.cyr owns the snapshot semantics.

# Size of one buffer-registry record: five 8-byte slots (offsets 0..32).
# ⭐ USED by the allocator below, deliberately. Declared-but-unreferenced was
# the 1.8.5 finding: a named size sitting beside a literal `alloc(40)` lets the
# two drift the moment a sixth slot is added, and the layout comment above
# would still read correctly while the record came back one slot short.
var BUFFER_REC_SIZE = 40;

fn _bl_record_new(buf, path) {
    var r = alloc(BUFFER_REC_SIZE);
    store64(r,      buf);
    store64(r + 8,  path);
    store64(r + 16, 0);
    store64(r + 24, 0);
    store64(r + 32, 0);
    return r;
}

fn _bl_rec_buf(r)           { return load64(r); }
fn _bl_rec_path(r)          { return load64(r + 8); }
fn _bl_rec_modified(r)      { return load64(r + 16); }
fn _bl_rec_undo(r)          { return load64(r + 24); }
fn _bl_rec_redo(r)          { return load64(r + 32); }
fn _bl_rec_set_buf(r, b)        { store64(r, b);      return 0; }
fn _bl_rec_set_path(r, p)       { store64(r + 8, p);  return 0; }
fn _bl_rec_set_modified(r, m)   { store64(r + 16, m); return 0; }
fn _bl_rec_set_undo(r, v)       { store64(r + 24, v); return 0; }
fn _bl_rec_set_redo(r, v)       { store64(r + 32, v); return 0; }

# Editor-state offsets for the buffer-list pair. Editor state grew from
# 64 → 80 bytes when the registry landed; the new tail is:
#   off 64  buffer_list      vec of Buffer records (or 0 = uninitialized)
#   off 72  active_buf_idx   i64 (0 .. bl_count - 1)
fn _bl_list(s)              { return load64(s + 64); }
fn _bl_set_list(s, v)       { store64(s + 64, v); return 0; }
fn _bl_active_offset(s)     { return load64(s + 72); }
fn _bl_set_active_offset(s, i) { store64(s + 72, i); return 0; }

# Initialize the registry with a single entry from the editor's current
# `buf` / `file_path` / `modified` fields. Idempotent: a second call is
# a no-op so it's safe to invoke from multiple entry points.
fn bl_init(s, buf) {
    if (_bl_list(s) != 0) { return 0; }
    var v = vec_new();
    var r = _bl_record_new(buf, editor_file_path(s));
    _bl_rec_set_modified(r, editor_modified(s));
    vec_push(v, r);
    _bl_set_list(s, v);
    _bl_set_active_offset(s, 0);
    return 0;
}

# Number of buffers in the registry. 0 before `bl_init`.
fn bl_count(s) {
    var v = _bl_list(s);
    if (v == 0) { return 0; }
    return vec_len(v);
}

# Registry index of the active buffer, or 0 when the list is uninitialized.
# Pairs with `bl_set_active`; `:ls` marks this slot with `*`.
fn bl_active_index(s) {
    if (_bl_list(s) == 0) { return 0; }
    return _bl_active_offset(s);
}

# The record at registry index `i`, or 0 if the list is uninitialized or `i`
# is out of range. Callers get the record, not the buffer — use `_bl_rec_*`
# or the `bl_path` / `bl_modified` wrappers to read fields.
fn bl_get(s, i) {
    var v = _bl_list(s);
    if (v == 0)            { return 0; }
    if (i < 0)             { return 0; }
    if (i >= vec_len(v))   { return 0; }
    return vec_get(v, i);
}

# The active buffer's record, or 0 if the list is uninitialized.
fn bl_active(s) {
    return bl_get(s, bl_active_index(s));
}

# Buffer/path/modified pass-throughs for the active slot. Useful for
# UI code that wants to peek at any slot, not just the active one.
fn bl_buf(s, i)       { var r = bl_get(s, i); if (r == 0) { return 0; } return _bl_rec_buf(r); }
# File path of the buffer at index `i` (NUL-terminated cstr), or 0 for a
# scratch buffer or an out-of-range index. ⚠ The two are indistinguishable
# here: callers that need to tell "no such slot" from "slot with no file"
# must check `bl_get` first.
fn bl_path(s, i)      { var r = bl_get(s, i); if (r == 0) { return 0; } return _bl_rec_path(r); }

# Modified flag of the buffer at index `i`; 0 for an out-of-range index.
# ⚠ For the ACTIVE slot this record can lag: the editor mirrors the live flag
# on its own state, so `:ls` and the window status read `editor_modified(s)`
# for that one slot rather than trusting the record.
fn bl_modified(s, i)  { var r = bl_get(s, i); if (r == 0) { return 0; } return _bl_rec_modified(r); }

# v1.6.0 — reverse lookup: find the buflist index whose record's
# buf_ptr matches `b`. Used by global-mark cross-buffer jumps to
# resolve `bl_set_active` from a stored buf pointer. Returns -1 if
# `b` isn't in the buflist (e.g. was closed).
fn bl_find_by_buf(s, b) {
    if (b == 0) { return 0 - 1; }
    var n = bl_count(s);
    var i = 0;
    while (i < n) {
        if (bl_buf(s, i) == b) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Append a new entry. Returns the new index. Does NOT switch active.
fn bl_add(s, buf, path) {
    bl_init(s, editor_buf(s));   # late-init guard for callers who skip the explicit init
    var v = _bl_list(s);
    var idx = vec_len(v);
    var r = _bl_record_new(buf, path);
    vec_push(v, r);
    return idx;
}

# Snapshot the editor's current per-buffer fields into the active slot.
fn _bl_snapshot_active(s) {
    var r = bl_active(s);
    if (r == 0) { return 0; }
    _bl_rec_set_buf(r, editor_buf(s));
    _bl_rec_set_path(r, editor_file_path(s));
    _bl_rec_set_modified(r, editor_modified(s));
    return 0;
}

# Load slot `idx` into the editor's per-buffer fields (the fast-path
# mirror). The mode.cyr offsets are: buf @ 8, modified @ 32, file_path @ 56.
fn _bl_load_into_editor(s, idx) {
    var r = bl_get(s, idx);
    if (r == 0) { return 0; }
    store64(s + 8,  _bl_rec_buf(r));
    store64(s + 32, _bl_rec_modified(r));
    store64(s + 56, _bl_rec_path(r));
    return 0;
}

# Switch active buffer. Snapshot the current state into the old slot,
# then load the new slot. Returns 0 on success, -1 on out-of-range.
# A noop-switch (i == active) is a fast 0 return.
fn bl_set_active(s, i) {
    if (i < 0)             { return 0 - 1; }
    if (i >= bl_count(s))  { return 0 - 1; }
    if (i == bl_active_index(s)) { return 0; }
    _bl_snapshot_active(s);
    _bl_set_active_offset(s, i);
    _bl_load_into_editor(s, i);
    return 0;
}

# Switch to next / previous buffer (vim's :bn / :bp). Wraps around the
# end of the list. No-op when there's only one buffer.
fn bl_next(s) {
    var n = bl_count(s);
    if (n <= 1) { return 0; }
    var i = bl_active_index(s) + 1;
    if (i >= n) { i = 0; }
    return bl_set_active(s, i);
}

# Switch to the previous buffer in the registry, wrapping at index 0.
# No-op returning 0 when fewer than two buffers are open.
fn bl_prev(s) {
    var n = bl_count(s);
    if (n <= 1) { return 0; }
    var i = bl_active_index(s) - 1;
    if (i < 0) { i = n - 1; }
    return bl_set_active(s, i);
}
