# mode.cyr — modal dispatch for cyim
#
# A vi-style modal editor is a state machine: the same byte means different
# things depending on what mode you're in. This module owns that state
# machine and the keymap tables that drive it.
#
# Two consumer classes share this surface:
#   - Humans at a TTY — the byte stream comes from stdin in raw mode.
#   - Agents driving programmatically — the byte stream comes from a buffer.
# Both call the same `editor_dispatch(s, key)`. The headless driver
# (`editor_drive`) is the API surface for the second case; per the roadmap
# it lands inside M1 rather than as a post-v1.0 retrofit.
#
# Action IDs are a stable enum. Mode-transitioning actions (ACT_TO_*) update
# `state.mode` inside dispatch as a side effect — the caller doesn't need
# to special-case them. Motions, edits, and other in-mode actions leave
# the mode unchanged; the caller is expected to apply them to the buffer.
#
# Multi-byte sequences (gg, dd, di(, escape codes for arrow keys, ...) are
# NOT handled here yet. They need a small parsing state on top of the byte
# stream; deferred to a later bite. This module does single-byte mappings
# and the three mode-state defaults (literal-insert, cmdline-append).

# ──── Modes ────────────────────────────────────────────────────────────
var MODE_NORMAL      = 0;
var MODE_INSERT      = 1;
var MODE_COMMAND     = 2;
var MODE_SEARCH      = 3;   # `/pattern` — forward
var MODE_SEARCH_BACK = 4;   # `?pattern` — backward
var MODE_VISUAL      = 5;   # `v` — character-wise selection
var MODE_VISUAL_LINE = 6;   # `V` — line-wise selection

# ──── Action IDs ──────────────────────────────────────────────────────
# 0 is reserved for "no-op / unmapped". Numeric gaps left between groups
# so future actions can land without renumbering.
var ACT_NONE              = 0;

# Mode-default actions (the dispatcher returns these for unmapped bytes
# in INSERT / COMMAND so the caller knows to consume the byte).
var ACT_INSERT_LITERAL    = 1;
var ACT_DELETE_LEFT       = 2;
var ACT_CMDLINE_APPEND    = 3;
var ACT_CMDLINE_BACKSPACE = 4;

# Mode transitions — the dispatcher updates `state.mode` itself.
var ACT_TO_NORMAL         = 10;
var ACT_TO_INSERT         = 11;
var ACT_TO_INSERT_AFTER   = 12;
var ACT_TO_INSERT_LINE_END = 13;
var ACT_TO_VISUAL         = 14;
var ACT_TO_VISUAL_LINE    = 15;
var ACT_TO_COMMAND        = 20;
var ACT_CMDLINE_EXECUTE   = 21;
var ACT_CMDLINE_CANCEL    = 22;

# Search mode transitions + execution.
var ACT_TO_SEARCH         = 25;
var ACT_TO_SEARCH_BACK    = 26;
var ACT_SEARCH_EXECUTE    = 27;   # Enter inside SEARCH/SEARCH_BACK
var ACT_SEARCH_CANCEL     = 28;   # Esc inside SEARCH/SEARCH_BACK
var ACT_SEARCH_REPEAT     = 29;   # `n` in NORMAL — repeat last in same direction
var ACT_SEARCH_REPEAT_BACK = 30;  # `N` in NORMAL — repeat last in opposite direction
var ACT_SEARCH_WORD_FWD   = 31;   # `*` — find word under cursor, forward
var ACT_SEARCH_WORD_BACK  = 32;   # `#` — find word under cursor, backward

# NORMAL-mode motions (single-byte for now).
var ACT_MOVE_LEFT         = 100;
var ACT_MOVE_DOWN         = 101;
var ACT_MOVE_UP           = 102;
var ACT_MOVE_RIGHT        = 103;
var ACT_MOVE_LINE_START   = 104;
var ACT_MOVE_LINE_END     = 105;
var ACT_MOVE_WORD_FWD     = 106;
var ACT_MOVE_WORD_BACK    = 107;
var ACT_MOVE_FILE_END     = 108;

# NORMAL-mode edits.
var ACT_DELETE_RIGHT      = 200;

# Undo / redo.
var ACT_UNDO              = 210;
var ACT_REDO              = 211;

# Yank / paste.
var ACT_PASTE_AFTER       = 220;   # `p` in NORMAL
var ACT_PASTE_BEFORE      = 221;   # `P` in NORMAL
var ACT_VISUAL_YANK       = 230;   # `y` in VISUAL or VISUAL_LINE
var ACT_VISUAL_DELETE     = 231;   # `d` in VISUAL or VISUAL_LINE

# Repeat-last-edit.
var ACT_DOT_REPEAT        = 240;   # `.` — replay last insert session

# Window navigation (Ctrl-w h/j/k/l).
var ACT_WIN_LEFT          = 400;
var ACT_WIN_DOWN          = 401;
var ACT_WIN_UP            = 402;
var ACT_WIN_RIGHT         = 403;

# ──── Key codes (ASCII / control) ─────────────────────────────────────
var KEY_ESC       = 27;
var KEY_ENTER     = 13;
var KEY_LF        = 10;
var KEY_BACKSPACE = 8;
var KEY_DEL       = 127;
var KEY_CTRL_W    = 23;
var KEY_CTRL_R    = 18;

# ──── Error codes (set into state.last_error) ────────────────────────
var ERR_NONE            = 0;
var ERR_DIRTY           = 1;  # E37 — no write since last change
var ERR_NO_FILE_NAME    = 2;  # E32 — :w with no path and no current file
var ERR_FILE_NOT_FOUND  = 3;
var ERR_SAVE_FAILED     = 4;
var ERR_UNKNOWN_CMD     = 5;
var ERR_FILE_TOO_LARGE  = 6;  # M7 audit F-2 — :e refused because file > maxfilesize

# ──── EditorState layout (128 bytes) ──────────────────────────────────
#   off   0  mode             i64  current mode (MODE_*)
#   off   8  buf              i64  ACTIVE buffer's gap-buffer (mirror of
#                                   buf-list slot; updated by bl_set_active)
#   off  16  nmap             i64  NORMAL-mode keymap (map_u64)
#   off  24  cmdbuf           i64  gap-buffer for the `:cmd` line
#   off  32  modified         i64  1 if active buffer has unsaved changes
#   off  40  quit             i64  1 if the main loop should exit
#   off  48  last_error       i64  most recent ERR_* code
#   off  56  file_path        i64  cstr of current file, or 0
#   off  64  buffer_list      i64  vec of Buffer records (or 0 = not init'd)
#   off  72  active_buf_idx   i64  index into buffer_list
#   off  80  status_message   i64  cstr to display in the status row, or 0
#   off  88  window_root      i64  Window* tree root (or 0 = not init'd)
#   off  96  active_leaf      i64  Window* — the LEAF currently focused
#   off 104  prefix_pending   i64  pending key prefix (KEY_CTRL_W after a
#                                   Ctrl-w byte; cleared after the next
#                                   dispatched byte). 0 = no pending prefix.
#   off 112  search_pattern   i64  cstr of last-typed search pattern, or 0
#   off 120  search_direction i64  0 = forward (`/`), 1 = back (`?`).
#   off 128  visual_anchor    i64  byte position recorded on entering
#                                   VISUAL/VISUAL_LINE; selection range
#                                   is [min(anchor, cursor), max(...)]
#                                   (line-clamped for VISUAL_LINE).
#   off 136  yank_register    i64  heap ptr to last-yanked bytes (or 0).
#                                   Single-register model (no a-z named
#                                   registers yet).
#   off 144  yank_register_len i64  length in bytes (handles NUL-content).
#   off 152  dot_entry_key    i64  the byte that opened the recorded
#                                   insert session (typically 105 = 'i',
#                                   97 = 'a', 65 = 'A'). Used to re-fire
#                                   the right ACT_TO_INSERT_* on `.`.
#   off 160  dot_buf          i64  gap-buffer holding the bytes typed
#                                   inside the recorded session (or 0).
#   off 168  dot_recording    i64  1 while inside an insert session
#                                   that's being captured.
#   off 176  cfg_ignorecase   i64  0 = case-sensitive (default), 1 = fold
#                                   case in / and ? scans.
#   off 184  cfg_line_numbers i64  display gutter w/ line numbers (0/1).
#                                   Wiring into render is deferred to M5
#                                   perf pass; the config slot exists so
#                                   `:set number` and `.cyimrc` agree.
#   off 192  cfg_tabstop      i64  display width of TAB (default 4).
#   off 200  cfg_max_filesize i64  M7 F-2 fix — `:e` refuses files
#                                   larger than this. Default 100 MB.

fn editor_new(buf) {
    var s = alloc(208);
    store64(s, MODE_NORMAL);
    store64(s + 8, buf);
    var nmap = map_u64_new();
    _seed_normal_keymap(nmap);
    store64(s + 16, nmap);
    store64(s + 24, buf_new());
    store64(s + 32, 0);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 56, 0);
    store64(s + 64, 0);    # buffer_list — lazy-inited by buflist.cyr
    store64(s + 72, 0);
    store64(s + 80, 0);
    store64(s + 88, 0);    # window_root — lazy-inited by window.cyr
    store64(s + 96, 0);
    store64(s + 104, 0);
    store64(s + 112, 0);   # search_pattern
    store64(s + 120, 0);   # search_direction (forward by default)
    store64(s + 128, 0);   # visual_anchor
    store64(s + 136, 0);   # yank_register
    store64(s + 144, 0);   # yank_register_len
    store64(s + 152, 0);   # dot_entry_key
    store64(s + 160, 0);   # dot_buf — lazy
    store64(s + 168, 0);   # dot_recording
    store64(s + 176, 0);   # cfg_ignorecase
    store64(s + 184, 0);   # cfg_line_numbers
    store64(s + 192, 4);   # cfg_tabstop (vim default)
    store64(s + 200, 104857600);  # cfg_max_filesize (100 MB default)
    return s;
}

fn editor_mode(s)       { return load64(s); }
fn editor_buf(s)        { return load64(s + 8); }
fn editor_cmdbuf(s)     { return load64(s + 24); }
fn editor_modified(s)   { return load64(s + 32); }
fn editor_quit(s)       { return load64(s + 40); }
fn editor_last_error(s) { return load64(s + 48); }
fn editor_file_path(s)  { return load64(s + 56); }

fn editor_set_mode(s, m)        { store64(s, m);       return 0; }
fn editor_set_modified(s, v)    { store64(s + 32, v);  return 0; }
fn editor_set_quit(s, v)        { store64(s + 40, v);  return 0; }
fn editor_set_last_error(s, v)  { store64(s + 48, v);  return 0; }
fn editor_set_file_path(s, p)   { store64(s + 56, p);  return 0; }
fn editor_status(s)             { return load64(s + 80); }
fn editor_set_status(s, msg)    { store64(s + 80, msg); return 0; }
fn editor_prefix(s)             { return load64(s + 104); }
fn editor_set_prefix(s, p)      { store64(s + 104, p); return 0; }
fn editor_search_pattern(s)     { return load64(s + 112); }
fn editor_set_search_pattern(s, p)   { store64(s + 112, p); return 0; }
fn editor_search_direction(s)   { return load64(s + 120); }
fn editor_set_search_direction(s, d) { store64(s + 120, d); return 0; }
fn editor_visual_anchor(s)      { return load64(s + 128); }
fn editor_set_visual_anchor(s, a) { store64(s + 128, a); return 0; }
fn editor_yank_register(s)      { return load64(s + 136); }
fn editor_yank_register_len(s)  { return load64(s + 144); }
fn editor_set_yank_register(s, p, n) {
    store64(s + 136, p);
    store64(s + 144, n);
    return 0;
}
fn editor_dot_entry_key(s)         { return load64(s + 152); }
fn editor_set_dot_entry_key(s, k)  { store64(s + 152, k); return 0; }
fn editor_dot_buf(s)               { return load64(s + 160); }
fn editor_set_dot_buf(s, b)        { store64(s + 160, b); return 0; }
fn editor_dot_recording(s)         { return load64(s + 168); }
fn editor_set_dot_recording(s, v)  { store64(s + 168, v); return 0; }
fn editor_cfg_ignorecase(s)        { return load64(s + 176); }
fn editor_set_cfg_ignorecase(s, v) { store64(s + 176, v); return 0; }
fn editor_cfg_line_numbers(s)      { return load64(s + 184); }
fn editor_set_cfg_line_numbers(s, v) { store64(s + 184, v); return 0; }
fn editor_cfg_tabstop(s)           { return load64(s + 192); }
fn editor_set_cfg_tabstop(s, v)    { store64(s + 192, v); return 0; }
fn editor_cfg_max_filesize(s)      { return load64(s + 200); }
fn editor_set_cfg_max_filesize(s, v) { store64(s + 200, v); return 0; }

# Seed NORMAL-mode keymap with the canonical single-byte vi mappings.
fn _seed_normal_keymap(m) {
    map_u64_set(m, 104, ACT_MOVE_LEFT);        # h
    map_u64_set(m, 106, ACT_MOVE_DOWN);        # j
    map_u64_set(m, 107, ACT_MOVE_UP);          # k
    map_u64_set(m, 108, ACT_MOVE_RIGHT);       # l
    map_u64_set(m, 48,  ACT_MOVE_LINE_START);  # 0
    map_u64_set(m, 36,  ACT_MOVE_LINE_END);    # $
    map_u64_set(m, 119, ACT_MOVE_WORD_FWD);    # w
    map_u64_set(m, 98,  ACT_MOVE_WORD_BACK);   # b
    map_u64_set(m, 71,  ACT_MOVE_FILE_END);    # G
    map_u64_set(m, 120, ACT_DELETE_RIGHT);     # x
    map_u64_set(m, 105, ACT_TO_INSERT);        # i
    map_u64_set(m, 97,  ACT_TO_INSERT_AFTER);  # a
    map_u64_set(m, 65,  ACT_TO_INSERT_LINE_END); # A
    map_u64_set(m, 58,  ACT_TO_COMMAND);       # :
    map_u64_set(m, 47,  ACT_TO_SEARCH);        # /
    map_u64_set(m, 63,  ACT_TO_SEARCH_BACK);   # ?
    map_u64_set(m, 110, ACT_SEARCH_REPEAT);      # n
    map_u64_set(m, 78,  ACT_SEARCH_REPEAT_BACK); # N
    map_u64_set(m, 42,  ACT_SEARCH_WORD_FWD);    # *
    map_u64_set(m, 35,  ACT_SEARCH_WORD_BACK);   # #
    map_u64_set(m, 117, ACT_UNDO);               # u
    map_u64_set(m, 18,  ACT_REDO);               # Ctrl-r (0x12)
    map_u64_set(m, 118, ACT_TO_VISUAL);          # v
    map_u64_set(m, 86,  ACT_TO_VISUAL_LINE);     # V
    map_u64_set(m, 112, ACT_PASTE_AFTER);        # p
    map_u64_set(m, 80,  ACT_PASTE_BEFORE);       # P
    map_u64_set(m, 46,  ACT_DOT_REPEAT);         # .
    return 0;
}

# Translate one input byte into an action and update mode-state if the action
# is a mode transition. Returns the action id; the caller is responsible for
# applying its semantics (motion, insert, command-line append, ...) using
# the `key` argument when the action is a literal-byte default.
fn editor_dispatch(s, key) {
    var mode = load64(s);

    # Multi-byte sequence: a previous keystroke set a prefix that the
    # current byte resolves. Today only Ctrl-w (window navigation) uses
    # this; clearing the prefix is unconditional so an unmapped follow-up
    # is silently swallowed (prefix consumed → ACT_NONE).
    if (editor_prefix(s) == KEY_CTRL_W) {
        editor_set_prefix(s, 0);
        if (key == 104) { return ACT_WIN_LEFT; }
        if (key == 106) { return ACT_WIN_DOWN; }
        if (key == 107) { return ACT_WIN_UP; }
        if (key == 108) { return ACT_WIN_RIGHT; }
        return ACT_NONE;
    }

    if (mode == MODE_NORMAL) {
        if (key == KEY_CTRL_W) {
            editor_set_prefix(s, KEY_CTRL_W);
            return ACT_NONE;
        }
        var act = map_u64_get(load64(s + 16), key);
        if (act == ACT_TO_INSERT)         { store64(s, MODE_INSERT);  return act; }
        if (act == ACT_TO_INSERT_AFTER)   { store64(s, MODE_INSERT);  return act; }
        if (act == ACT_TO_INSERT_LINE_END) { store64(s, MODE_INSERT); return act; }
        if (act == ACT_TO_COMMAND)        { store64(s, MODE_COMMAND); return act; }
        if (act == ACT_TO_SEARCH)         { store64(s, MODE_SEARCH);      return act; }
        if (act == ACT_TO_SEARCH_BACK)    { store64(s, MODE_SEARCH_BACK); return act; }
        if (act == ACT_TO_VISUAL)         { store64(s, MODE_VISUAL);      return act; }
        if (act == ACT_TO_VISUAL_LINE)    { store64(s, MODE_VISUAL_LINE); return act; }
        return act;
    }

    if (mode == MODE_VISUAL) {
        if (key == KEY_ESC) { store64(s, MODE_NORMAL); return ACT_TO_NORMAL; }
        if (key == 118)     { store64(s, MODE_NORMAL); return ACT_TO_NORMAL; }   # v toggles off
        if (key == 86)      { store64(s, MODE_VISUAL_LINE); return ACT_NONE; }    # V swap
        if (key == 121)     { store64(s, MODE_NORMAL); return ACT_VISUAL_YANK; }  # y
        if (key == 100)     { store64(s, MODE_NORMAL); return ACT_VISUAL_DELETE; } # d
        # Motions allowed; everything else is swallowed so dispatch
        # doesn't trigger inserts / commands while a selection is open.
        var act = map_u64_get(load64(s + 16), key);
        if (act >= ACT_MOVE_LEFT) {
            if (act <= ACT_MOVE_FILE_END) { return act; }
        }
        return ACT_NONE;
    }
    if (mode == MODE_VISUAL_LINE) {
        if (key == KEY_ESC) { store64(s, MODE_NORMAL); return ACT_TO_NORMAL; }
        if (key == 86)      { store64(s, MODE_NORMAL); return ACT_TO_NORMAL; }   # V toggles off
        if (key == 118)     { store64(s, MODE_VISUAL); return ACT_NONE; }         # v swap
        if (key == 121)     { store64(s, MODE_NORMAL); return ACT_VISUAL_YANK; }
        if (key == 100)     { store64(s, MODE_NORMAL); return ACT_VISUAL_DELETE; }
        var act = map_u64_get(load64(s + 16), key);
        if (act >= ACT_MOVE_LEFT) {
            if (act <= ACT_MOVE_FILE_END) { return act; }
        }
        return ACT_NONE;
    }

    if (mode == MODE_INSERT) {
        if (key == KEY_ESC)       { store64(s, MODE_NORMAL); return ACT_TO_NORMAL; }
        if (key == KEY_DEL)       { return ACT_DELETE_LEFT; }
        if (key == KEY_BACKSPACE) { return ACT_DELETE_LEFT; }
        return ACT_INSERT_LITERAL;
    }

    if (mode == MODE_COMMAND) {
        if (key == KEY_ESC)       { store64(s, MODE_NORMAL); return ACT_CMDLINE_CANCEL; }
        if (key == KEY_ENTER)     { store64(s, MODE_NORMAL); return ACT_CMDLINE_EXECUTE; }
        if (key == KEY_LF)        { store64(s, MODE_NORMAL); return ACT_CMDLINE_EXECUTE; }
        if (key == KEY_DEL)       { return ACT_CMDLINE_BACKSPACE; }
        if (key == KEY_BACKSPACE) { return ACT_CMDLINE_BACKSPACE; }
        return ACT_CMDLINE_APPEND;
    }

    # SEARCH and SEARCH_BACK share dispatch logic byte-for-byte —
    # the difference is purely the direction recorded by search.cyr's
    # ACT_TO_SEARCH / ACT_TO_SEARCH_BACK transitions earlier.
    if (mode == MODE_SEARCH || mode == MODE_SEARCH_BACK) {
        if (key == KEY_ESC)       { store64(s, MODE_NORMAL); return ACT_SEARCH_CANCEL; }
        if (key == KEY_ENTER)     { store64(s, MODE_NORMAL); return ACT_SEARCH_EXECUTE; }
        if (key == KEY_LF)        { store64(s, MODE_NORMAL); return ACT_SEARCH_EXECUTE; }
        if (key == KEY_DEL)       { return ACT_CMDLINE_BACKSPACE; }
        if (key == KEY_BACKSPACE) { return ACT_CMDLINE_BACKSPACE; }
        return ACT_CMDLINE_APPEND;
    }

    return ACT_NONE;
}

# Headless drive: walk a byte array of length `n` through the dispatcher,
# writing the action id produced by each byte into `out_actions[i]`.
# Returns `n`. This is the agent-drive API surface — the same code path
# a TTY consumer takes, just fed from a buffer instead of stdin.
fn editor_drive(s, keys, n, out_actions) {
    var i = 0;
    while (i < n) {
        var act = editor_dispatch(s, load8(keys + i));
        store64(out_actions + i * 8, act);
        i = i + 1;
    }
    return n;
}
