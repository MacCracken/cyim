        if (pm < 0) { return 2; }
        if (pm == 1) { consumed = 1; }
        if (consumed == 0) {
            var ef = _cli_argprefix(arg, "--expect-first=");
            if (ef != 0) {
                if (rl_first_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-first\n", 37); return 2; }
                rl_first = ef;
                rl_first_seen = 1;
                consumed = 1;
            }
        }
        if (consumed == 0) {
            if (rl_npos == 0) { rl_p0 = arg; }
            if (rl_npos == 1) { rl_p1 = arg; }
            if (rl_npos == 2) { rl_p2 = arg; }
            if (rl_npos >= 3) {
                syscall(1, 2, "cyim --replace-lines: unexpected extra argument\n", 48);
                return 2;
