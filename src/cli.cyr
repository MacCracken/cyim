    if (bl_npos < 1) {
        syscall(1, 2, "usage: cyim --batch-lines [--wc[=l]|--dry-run] ", 47);
        syscall(1, 2, "[--expect=<pat>|--expect-not=<pat>] <file>\n", 43);
        return 2;
    }
    if (_cli_dry_wc("--batch-lines", &bl_mods) != 0) { return 2; }
    return run_batch_lines(bl_p0, _cli_mods_wc(&bl_mods), _cli_mods_pat(&bl_mods), _cli_mods_pol(&bl_mods),
      _cli_mods_dry(&bl_mods));
}
