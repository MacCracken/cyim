# cli.cyr — non-interactive CLI surfaces for agent-drive workflows.
#
# `cyim --write FILE`               — read stdin, replace FILE with it.
# `cyim --replace OLD NEW FILE`     — first occurrence; OLD must be unique.
# `cyim --replace-all OLD NEW FILE` — every occurrence.
# `cyim --grep PATTERN FILE`        — read-only; emit `FILE:N:LINE` for
#                                     every line containing PATTERN
#                                     (literal substring; same matching
#                                     semantics as --replace's OLD).
# `cyim --batch FILE`               — apply N substitutions from stdin,
#                                     save once. Stdin: NUL-separated
#                                     alternating tokens
#                                     OLD1\\0NEW1\\0OLD2\\0NEW2\\0…\\0.
#                                     Each pair runs --replace semantics
#                                     (OLD unique at apply time); --all
#                                     switches every pair to
#                                     --replace-all. Atomic: failure
#                                     mid-batch leaves FILE untouched.
#
# Modifiers (consumed in any order, between the verb and its positionals):
#   --wc[=l|=long]      on --write/--replace[-all]/--batch: print wc(1) on success
#   --expect=<pat>      on --write/--batch: post-save assertion (must contain)
#   --expect-not=<pat>  on --write/--batch: post-save assertion (must not contain)
#   --expect-N=<n>      on --replace[-all]: assert OLD occurs exactly N
#                       times (pre-substitution); --expect-1 is sugar
#                       for --expect-N=1.
#   --all               on --batch: every pair runs --replace-all
#                       (default is --replace's unique-required mode).
#
# These are direct buffer ops — they don't go through the dispatch +
# apply chain because there's no edit-history / undo / mode state to
# care about. They're tools, not models of user edits. The dispatch
# chain is still available via `cyim --headless` for cases where you
# want the full editor semantics from a script.
#
# Exit codes (per-verb where noted):
#   0 — success (or, for --grep, ≥1 match)
#   1 — save failed (--write/--replace[-all]/--batch) | no match (--grep)
#   2 — bad CLI args (missing OLD/NEW/FILE/PATTERN, empty OLD/PATTERN,
#       malformed --expect-N value, malformed --batch stdin)
#   3 — file not found
#   4 — OLD not found in FILE (--replace[-all]/--batch; suppressed
#       on --replace[-all] when --expect-N=0 explicitly asserts the
#       no-op case)
#   5 — OLD occurs more than once and --replace-all/--all wasn't passed
#   6 — assertion failed (--expect / --expect-not / --expect-N mismatch)
#
# Requires: src/buffer.cyr (buf_*), stdlib (file_read / file_save_*
# / strlen / load8 / store8).

# `mode` argument for run_replace.
var REPLACE_FIRST_UNIQUE = 0;
var REPLACE_ALL          = 1;

# === regex / matcher dispatch (v1.2.0) =============================
# Unified literal-or-regex matcher abstraction for the four pattern
# verbs (--grep, --grepfiles, --replace, --replace-all) and the two
# file-sourced variants (--replace-files[-all]). All six route through
# a Matcher; the matcher kind selects literal byte-scan or compiled
# engine.
#
# Two flat heap structs keep the dispatch / option surfaces separate:
#
#   Matcher (24 B):
#     +0   kind            0=literal, 1=regex
#     +8   needle / nfa    literal: NUL-term ptr; regex: regex_compile handle
#     +16  needle_len      literal: byte count; regex: 0
#
#   RegexOpts (24 B):
#     +0   flavor_id       FLAVOR_ERE today; future: BRE/RE2/PCRE/fuzzy/vim
#     +8   reserved_flags  future bit field (icase, multiline, dotall, ungreedy)
#     +16  reserved_aux    future ptr (kv pairs, named-flavor data)
#
# Why two structs: Matcher abstracts the per-call dispatch; RegexOpts
# holds engine-config slots that grow without changing Matcher. New
# options land in RegexOpts; new flavors land in `_regex_flavor_id`
# and the `_matcher_regex` dispatch arm. See ADR 0002.

var MATCHER_LITERAL = 0;
var MATCHER_REGEX   = 1;

# FLAVOR_LITERAL is the parser sentinel meaning "no --regex= seen on
# cmdline" — distinct from any real flavor_id (>= 0) so the parser
# code reads cleanly.
#
# v1.2.0: ERE only (cyrius stdlib `lib/regex.cyr` Pike NFA).
# v1.3.0: BRE / RE2 / PCRE / VIM (niyama 1.0.1 vendored stdlib at
#   cyrius 5.9.0; all four engines expose the full
#   `<engine>_compile` / `_search_at` / `_group_end` ABI cyim's
#   hot path requires).
# v1.3.1 (planned): FUZZY. Deferred because niyama_fuzzy lacks
#   `_search_at` (per niyama 1.0 state.md "v1.0 known asymmetries")
#   so iteration over multiple matches needs a wrapper layer or
#   per-verb gating. Reserved here so the parser can recognize
#   "fuzzy" and emit a "v1.3.1" diagnostic instead of the generic
#   unknown-flavor message.
#
# Caveats surfaced in --help (not enforced in cyim — engine-side):
#   - Backreferences (`\1`-style) deferred per niyama's long-term
#     security-against-misuse plan; not yet supported in any
#     v1.3.0 flavor.
#   - vim mode-aware syntax (`\v` / `\V` / `\m` / `\M`) compiles
#     via niyama_vim_compile; default is "magic" (vim's `\m`).
var FLAVOR_LITERAL = 0;
var FLAVOR_ERE     = 1;
var FLAVOR_BRE     = 2;
var FLAVOR_RE2     = 3;
var FLAVOR_PCRE    = 4;
var FLAVOR_VIM     = 5;
var FLAVOR_FUZZY   = 6;

# Resolve a flavor name to its FLAVOR_* id. Unknown flavor returns
# FLAVOR_LITERAL — the parser turns that into exit-2 with the
# supported-flavor list. FLAVOR_FUZZY recognized but parsers reject
# it with a "v1.3.1" diagnostic until the iteration wrapper lands.
fn _regex_flavor_id(name) {
    if (streq(name, "ere")   == 1) { return FLAVOR_ERE;   }
    if (streq(name, "bre")   == 1) { return FLAVOR_BRE;   }
    if (streq(name, "re2")   == 1) { return FLAVOR_RE2;   }
    if (streq(name, "pcre")  == 1) { return FLAVOR_PCRE;  }
    if (streq(name, "vim")   == 1) { return FLAVOR_VIM;   }
    if (streq(name, "fuzzy") == 1) { return FLAVOR_FUZZY; }
    return FLAVOR_LITERAL;
}

# Per-flavor dispatch wrappers. Single source of truth so flavor
# additions touch ONE site (here) instead of every hot-path call.
# Returns -1 on unknown flavor (defensive — the parser already
# rejects FLAVOR_LITERAL paths before reaching these).
fn _re_search_at(flavor, nfa, s, slen, from) {
    if (flavor == FLAVOR_ERE)  { return regex_search_at(nfa, s, slen, from); }
    if (flavor == FLAVOR_BRE)  { return niyama_bre_search_at(nfa, s, slen, from); }
    if (flavor == FLAVOR_RE2)  { return niyama_re2_search_at(nfa, s, slen, from); }
    if (flavor == FLAVOR_PCRE) { return niyama_pcre_search_at(nfa, s, slen, from); }
    if (flavor == FLAVOR_VIM)  { return niyama_vim_search_at(nfa, s, slen, from); }
    # v1.3.1: niyama_fuzzy lacks `_search_at`. Fake it via cstring
    # pointer arithmetic — niyama_fuzzy_search reads NUL-terminated,
    # so advancing the base pointer is equivalent to starting from
    # `from`. The hit it returns is relative to the substring start;
    # we add `from` to convert back to absolute offset.
    if (flavor == FLAVOR_FUZZY) {
        if (from >= slen) { return 0 - 1; }
        var hit = niyama_fuzzy_search(nfa, s + from);
        if (hit < 0) { return 0 - 1; }
        return from + hit;
    }
    return 0 - 1;
}

fn _re_search(flavor, nfa, s) {
    if (flavor == FLAVOR_ERE)   { return regex_search(nfa, s); }
    if (flavor == FLAVOR_BRE)   { return niyama_bre_search(nfa, s); }
    if (flavor == FLAVOR_RE2)   { return niyama_re2_search(nfa, s); }
    if (flavor == FLAVOR_PCRE)  { return niyama_pcre_search(nfa, s); }
    if (flavor == FLAVOR_VIM)   { return niyama_vim_search(nfa, s); }
    if (flavor == FLAVOR_FUZZY) { return niyama_fuzzy_search(nfa, s); }
    return 0 - 1;
}

fn _re_group_end(flavor, nfa, n) {
    if (flavor == FLAVOR_ERE)  { return regex_group_end(nfa, n); }
    if (flavor == FLAVOR_BRE)  { return niyama_bre_group_end(nfa, n); }
    if (flavor == FLAVOR_RE2)  { return niyama_re2_group_end(nfa, n); }
    if (flavor == FLAVOR_PCRE) { return niyama_pcre_group_end(nfa, n); }
    if (flavor == FLAVOR_VIM)  { return niyama_vim_group_end(nfa, n); }
    return 0 - 1;
}

# v1.3.2: tight match-end recovery for FLAVOR_FUZZY. niyama_fuzzy
# doesn't expose `_group_end`; v1.3.1 used `hit + plen` as a coarse
# approximation, which overshoots on deletion edits and undershoots
# on insertion edits. This walks candidate end positions in
# [hit + max(0, plen - max_edits), hit + plen + max_edits] and
# picks the one with minimum Levenshtein distance to the pattern.
#
# Tie-break: smaller L wins. Never eat more source bytes than
# strictly necessary — preserves line boundaries on deletion edits
# (e.g. `fo` matching pattern `foo`: L=2 d=1 and L=3 d=1 tie, but
# L=2 doesn't cross the trailing newline). The alternative tie-break
# "L closer to plen" was tried first and produced exactly the
# newline-crossing failure mode that motivated this work.
#
# Cost: O(2 * max_edits + 1) substring materialisations per match,
# each driving an O(plen × candidate_len) DP inside niyama. For
# default k=2 and small patterns this is negligible; for large
# patterns + k it's still bounded and called once per match.
#
# Returns absolute end offset, clamped to [hit, slen]. Falls back
# to the v1.3.1 plen-approximation only if no candidate verifies
# (shouldn't happen if `hit` is a real fuzzy match offset).
fn _fuzzy_span_end(nfa, s, slen, hit, plen, max_edits) {
    var lo_len = plen - max_edits;
    if (lo_len < 0) { lo_len = 0; }
    var hi_len = plen + max_edits;

    var best_end = hit + plen;
    if (best_end > slen) { best_end = slen; }
    var best_dist = 0 - 1;
    var best_len = 0 - 1;

    var cap = hi_len + 1;
    var sub = alloc(cap);
    if (sub == 0) { return best_end; }

    var L = lo_len;
    while (L <= hi_len) {
        var end_candidate = hit + L;
        if (end_candidate <= slen) {
            var i = 0;
            while (i < L) {
                store8(sub + i, load8(s + hit + i));
                i = i + 1;
            }
            store8(sub + L, 0);
            var d = niyama_fuzzy_distance(nfa, sub);
            if (d <= max_edits) {
                var take = 0;
                if (best_dist < 0) {
                    take = 1;
                } else {
                    if (d < best_dist) { take = 1; }
                    if (d == best_dist) {
                        if (L < best_len) { take = 1; }
                    }
                }
                if (take == 1) {
                    best_dist = d;
                    best_len = L;
                    best_end = end_candidate;
                }
            }
        }
        L = L + 1;
    }
    return best_end;
}

# Validate a parsed --regex=<flavor> id against what cyim ships
# today. Returns 1 on accept, 0 on reject (caller returns exit 2).
# Centralises the per-verb diagnostic so all six parser sites
# emit a uniform supported-list message. `verb` is the short verb
# prefix ("--grep", "--replace-all", etc.) — included in the
# message so a wrapped script user sees which surface refused.
fn _flavor_validate(verb, fid) {
    if (fid == FLAVOR_LITERAL) {
        syscall(1, 2, "cyim ", 5);
        syscall(1, 2, verb, strlen(verb));
        syscall(1, 2, ": unknown --regex flavor (supported: bre, ere, fuzzy, pcre, re2, vim)\n", 70);
        return 0;
    }
    return 1;
}

# Allocate a RegexOpts with `flavor_id` and zeroed reserved slots.
# Reserved slots are the load-bearing extensibility seam — future
# icase / multiline / etc. set bits in reserved_flags without
# changing the Matcher signature or the run_* shape.
#
# v1.3.2: +8 reserved_flags repurposed as `fuzzy_edits` (only
# meaningful when flavor_id == FLAVOR_FUZZY). 0 means "use niyama's
# default k=2"; positive means "compile fuzzy with this max_edits".
# Other flavors ignore the slot. Reserved name kept in comments
# above for future bit-field reuse on non-fuzzy engines.
fn _regex_opts_new(flavor_id) {
    var opts = alloc(24);
    if (opts == 0) { return 0; }
    store64(opts,      flavor_id);
    store64(opts + 8,  0);
    store64(opts + 16, 0);
    return opts;
}

# Set the fuzzy_edits override on a RegexOpts. Only effective when
# the opts' flavor is FLAVOR_FUZZY; otherwise the slot is ignored
# at compile time. Caller (parser) emits the per-verb diagnostic
# if a non-fuzzy verb tries to set this.
#
# Encoding: opts +8 stores `k + 1` when explicitly set, `0` when
# unset (use niyama default of 2). This lets `--fuzzy-edits=0`
# (exact-match-only fuzzy, useful for "match the pattern verbatim
# but go through the fuzzy code path") differ from "user didn't
# pass --fuzzy-edits at all" — passing -1 as `k` here means
# "unset, leave the slot at 0 → niyama default".
fn _regex_opts_set_fuzzy_edits(opts, k) {
    if (opts == 0) { return 0; }
    if (k < 0) { return 0; }
    store64(opts + 8, k + 1);
    return 0;
}

fn _matcher_kind(m)   { return load64(m); }
fn _matcher_needle(m) { return load64(m + 8); }
fn _matcher_nfa(m)    { return load64(m + 8); }
fn _matcher_nlen(m)   { return load64(m + 16); }
# v1.3.0: regex matchers store FLAVOR_* in +16 (literal matchers
# use +16 for nlen — the field is interpreted by kind). Hot-path
# helpers read this to dispatch to the right engine without
# re-resolving from a passed-in opts struct.
fn _matcher_flavor(m) { return load64(m + 16); }
# v1.3.1: regex matchers also store the pattern length in +24,
# used by FLAVOR_FUZZY's span computation. v1.3.2: max_edits in
# +32 (for fuzzy only — other flavors leave it 0). The fuzzy
# substitute path uses (plen, max_edits) as the bounds for
# `_fuzzy_span_end`'s candidate-length walk: the match span is
# in [plen - max_edits, plen + max_edits], picked by minimum
# Levenshtein distance. Replaces v1.3.1's plain `hit + plen`
# approximation — exact for substitution edits, now also tight
# for insertion / deletion edits within max_edits.
fn _matcher_plen(m)      { return load64(m + 24); }
fn _matcher_max_edits(m) { return load64(m + 32); }

# Build a literal Matcher around a NUL-terminated `needle`.
# v1.3.2: 40B (was 32B) — added +32 max_edits slot for FLAVOR_FUZZY's
# span search. Literal matchers leave +24 / +32 zero.
fn _matcher_literal(needle) {
    var m = alloc(40);
    if (m == 0) { return 0; }
    store64(m,      MATCHER_LITERAL);
    store64(m + 8,  needle);
    store64(m + 16, strlen(needle));
    store64(m + 24, 0);
    store64(m + 32, 0);
    return m;
}

# Build a regex Matcher by compiling `pattern` per `opts`. Returns 0
# on engine compile failure (caller emits exit-2 + a parse-error
# message) or alloc failure. The flavor is stashed in the matcher's
# +16 slot so hot-path helpers (count_matches, substitute, run_grep)
# dispatch via `_matcher_flavor` + `_re_search_at` without re-passing
# opts. v1.3.1: pattern length stored in +24 for FLAVOR_FUZZY's
# span approximation (niyama_fuzzy lacks `_group_end` so callers
# approximate match end as `hit + plen`).
fn _matcher_regex(pattern, opts) {
    var flavor = load64(opts);
    var encoded_k = load64(opts + 8);
    var nfa = 0;
    if (flavor == FLAVOR_ERE)   { nfa = regex_compile(pattern); }
    if (flavor == FLAVOR_BRE)   { nfa = niyama_bre_compile(pattern); }
    if (flavor == FLAVOR_RE2)   { nfa = niyama_re2_compile(pattern); }
    if (flavor == FLAVOR_PCRE)  { nfa = niyama_pcre_compile(pattern); }
    if (flavor == FLAVOR_VIM)   { nfa = niyama_vim_compile(pattern); }
    if (flavor == FLAVOR_FUZZY) {
        # v1.3.2: honor --fuzzy-edits=N override (opts +8 stores k+1
        # when set, 0 when unset). Unset → niyama default (k=2).
        if (encoded_k > 0) {
            nfa = niyama_fuzzy_compile_opts(pattern, encoded_k - 1, 0);
        } else {
            nfa = niyama_fuzzy_compile(pattern);
        }
    }
    if (nfa == 0) { return 0; }
    var m = alloc(40);
    if (m == 0) { return 0; }
    store64(m,      MATCHER_REGEX);
    store64(m + 8,  nfa);
    store64(m + 16, flavor);
    store64(m + 24, strlen(pattern));
    # v1.3.2: stash effective max_edits for fuzzy span search. For
    # non-fuzzy flavors we leave 0 (unused — _re_group_end is exact).
    var eff_k = 0;
    if (flavor == FLAVOR_FUZZY) {
        if (encoded_k > 0) {
            eff_k = encoded_k - 1;
        } else {
            eff_k = 2;
        }
    }
    store64(m + 32, eff_k);
    return m;
}

# Materialize gap-buffer `b` as a NUL-terminated heap C-string.
# Returns ptr (caller owns; lives until process exit per cyim's
# bump-alloc model) and writes byte-length to `len_out`. Returns 0
# on alloc failure.
fn _matcher_buf_to_cstr(b, len_out) {
    var blen = buf_len(b);
    var s = alloc(blen + 1);
    if (s == 0) { store64(len_out, 0); return 0; }
    var i = 0;
    while (i < blen) {
        store8(s + i, buf_get(b, i));
        i = i + 1;
    }
    store8(s + blen, 0);
    store64(len_out, blen);
    return s;
}

# Count non-overlapping matches of `m` in gap-buffer `b`. Used by
# run_replace's --expect-N pre-substitution count assertion and the
# REPLACE_FIRST_UNIQUE uniqueness check. Literal path delegates to
# the existing _cli_count_matches; regex path materializes once and
# walks regex_search_at.
fn _cli_count_matches_m(b, m) {
    if (_matcher_kind(m) == MATCHER_LITERAL) {
        return _cli_count_matches(b, _matcher_needle(m));
    }
    var len_slot[8];
    store64(&len_slot, 0);
    var s = _matcher_buf_to_cstr(b, &len_slot);
    if (s == 0) { return 0; }
    var slen = load64(&len_slot);
    var nfa = _matcher_nfa(m);
    var flavor = _matcher_flavor(m);
    var plen = _matcher_plen(m);
    var max_edits = _matcher_max_edits(m);
    var count = 0;
    var from = 0;
    var go = 1;
    while (go == 1) {
        if (from > slen) { go = 0; }
        if (go == 1) {
            var hit = _re_search_at(flavor, nfa, s, slen, from);
            if (hit < 0) {
                go = 0;
            } else {
                count = count + 1;
                # v1.3.2: tight fuzzy span via min-distance walk;
                # other engines exact via _re_group_end.
                var span_end = 0;
                if (flavor == FLAVOR_FUZZY) {
                    span_end = _fuzzy_span_end(nfa, s, slen, hit, plen, max_edits);
                } else {
                    span_end = _re_group_end(flavor, nfa, 0);
                }
                if (span_end == hit) {
                    from = hit + 1;
                } else {
                    from = span_end;
                }
            }
        }
    }
    return count;
}

# Build a fresh gap-buffer copy of `src` with regex matches of `nfa`
# replaced by NUL-terminated `new`. mode == REPLACE_ALL substitutes
# every occurrence; otherwise just the first. `flavor` selects which
# engine's `search_at` / `group_end` ABI to drive (FLAVOR_ERE through
# the cyrius stdlib; FLAVOR_BRE / RE2 / PCRE / VIM through niyama).
# v1.3.2: FLAVOR_FUZZY uses `_fuzzy_span_end` for tight match-span
# recovery (was: `hit + plen` approximation in v1.3.1). `max_edits`
# is the engine's k from compile time; threaded here because the
# span search needs it as the candidate-length window bound.
fn _cli_substitute_regex(src, flavor, nfa, plen, max_edits, new, mode) {
    var nlen = strlen(new);
    var len_slot[8];
    store64(&len_slot, 0);
    var s = _matcher_buf_to_cstr(src, &len_slot);
    var out = buf_new();
    if (s == 0) { return out; }
    var slen = load64(&len_slot);
    var from = 0;
    var done_first = 0;
    var go = 1;
    while (go == 1) {
        if (from > slen) { go = 0; }
        if (go == 1) {
            var hit = _re_search_at(flavor, nfa, s, slen, from);
            if (hit < 0) {
                # Emit tail [from..slen) and finish.
                var t = from;
                while (t < slen) {
                    buf_insert_byte(out, load8(s + t));
                    t = t + 1;
                }
                go = 0;
            } else {
                # Emit pre-match [from..hit).
                var p = from;
                while (p < hit) {
                    buf_insert_byte(out, load8(s + p));
                    p = p + 1;
                }
                var span_end = 0;
                if (flavor == FLAVOR_FUZZY) {
                    span_end = _fuzzy_span_end(nfa, s, slen, hit, plen, max_edits);
                } else {
                    span_end = _re_group_end(flavor, nfa, 0);
                }
                var span_len = span_end - hit;
                var emit_replace = 1;
                if (mode == REPLACE_FIRST_UNIQUE) {
                    if (done_first == 1) { emit_replace = 0; }
                }
                if (emit_replace == 1) {
                    var j = 0;
                    while (j < nlen) {
                        buf_insert_byte(out, load8(new + j));
                        j = j + 1;
                    }
                    done_first = 1;
                } else {
                    # FIRST_UNIQUE mode, already replaced — emit the
                    # source bytes the matcher hit verbatim so output
                    # preserves remaining occurrences.
                    var k = hit;
                    while (k < span_end) {
                        buf_insert_byte(out, load8(s + k));
                        k = k + 1;
                    }
                }
                # Zero-width match: advance by 1 source byte (and
                # pass it through) so the loop terminates. This is
                # the standard regex idiom for empty-match patterns.
                if (span_len == 0) {
                    if (hit < slen) { buf_insert_byte(out, load8(s + hit)); }
                    from = hit + 1;
                } else {
                    from = span_end;
                }
            }
        }
    }
    return out;
}

# Matcher-dispatching variant of _cli_substitute. Literal path
# delegates to the v1.1.x byte-by-byte loop unchanged (no regression
# risk for the literal case); regex path materializes once and walks
# regex_search_at.
fn _cli_substitute_m(src, m, new, mode) {
    if (_matcher_kind(m) == MATCHER_LITERAL) {
        return _cli_substitute(src, _matcher_needle(m), new, mode);
    }
    return _cli_substitute_regex(src, _matcher_flavor(m), _matcher_nfa(m),
                                 _matcher_plen(m), _matcher_max_edits(m),
                                 new, mode);
}

# Read all of stdin into `b`. Returns total bytes read.
fn _cli_drain_stdin(b) {
    var chunk[4096];
    var total = 0;
    var go = 1;
    while (go == 1) {
        var n = file_read(0, &chunk, 4096);
        if (n <= 0) { go = 0; }
        if (n > 0) {
            buf_insert(b, &chunk, n);
            total = total + n;
        }
    }
    return total;
}

# Byte-wise compare needle (length nlen) against b at pos.
fn _cli_match_at(b, pos, needle, nlen) {
    var blen = buf_len(b);
    if (pos + nlen > blen) { return 0; }
    var i = 0;
    while (i < nlen) {
        if (buf_get(b, pos + i) != load8(needle + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Count non-overlapping occurrences of `needle` in `b`.
fn _cli_count_matches(b, needle) {
    var nlen = strlen(needle);
    if (nlen == 0) { return 0; }
    var blen = buf_len(b);
    var i = 0;
    var count = 0;
    while (i + nlen <= blen) {
        if (_cli_match_at(b, i, needle, nlen) == 1) {
            count = count + 1;
            i = i + nlen;
        } else {
            i = i + 1;
        }
    }
    return count;
}

# Build a fresh gap-buffer copy of `src` with `old` replaced by `new`.
# `mode` = REPLACE_ALL substitutes every occurrence; otherwise just the
# first. Caller takes ownership of the returned buffer; `src` untouched.
fn _cli_substitute(src, old, new, mode) {
    var olen = strlen(old);
    var nlen = strlen(new);
    var slen = buf_len(src);
    var out = buf_new();
    var i = 0;
    var done_first = 0;
    while (i < slen) {
        var hit = 0;
        if (i + olen <= slen) {
            if (_cli_match_at(src, i, old, olen) == 1) { hit = 1; }
        }
        if (hit == 1) {
            if (mode == 0) {
                if (done_first == 1) { hit = 0; }
            }
        }
        if (hit == 1) {
            var j = 0;
            while (j < nlen) {
                buf_insert_byte(out, load8(new + j));
                j = j + 1;
            }
            i = i + olen;
            done_first = 1;
        } else {
            buf_insert_byte(out, buf_get(src, i));
            i = i + 1;
        }
    }
    return out;
}

# Count newline bytes in `b` (matches `wc -l`).
fn _cli_count_lines(b) {
    var n = buf_len(b);
    var i = 0;
    var lines = 0;
    while (i < n) {
        if (buf_get(b, i) == 10) { lines = lines + 1; }
        i = i + 1;
    }
    return lines;
}

# Count POSIX-style words: maximal runs of non-whitespace bytes.
# Whitespace = space (32), tab (9), LF (10), VT (11), FF (12), CR (13).
fn _cli_count_words(b) {
    var n = buf_len(b);
    var i = 0;
    var words = 0;
    var in_word = 0;
    while (i < n) {
        var c = buf_get(b, i);
        var is_ws = 0;
        if (c == 32) { is_ws = 1; }
        if (c == 9)  { is_ws = 1; }
        if (c == 10) { is_ws = 1; }
        if (c == 11) { is_ws = 1; }
        if (c == 12) { is_ws = 1; }
        if (c == 13) { is_ws = 1; }
        if (is_ws == 1) {
            in_word = 0;
        } else {
            if (in_word == 0) {
                words = words + 1;
                in_word = 1;
            }
        }
        i = i + 1;
    }
    return words;
}

# Print wc(1) output for `b` to stdout. Mirrors GNU wc field order.
#   mode 0 — silent (no-op)
#   mode 1 — full:   "<lines> <words> <bytes> <file>\n"  (matches `wc <file>`)
#   mode 2 — lines:  "<lines> <file>\n"                  (matches `wc -l <file>`)
fn _cli_print_wc(b, file_path, mode) {
    if (mode == 0) { return 0; }
    var lines = _cli_count_lines(b);
    if (mode == 1) {
        fmt_int(lines);
        syscall(1, 1, " ", 1);
        fmt_int(_cli_count_words(b));
        syscall(1, 1, " ", 1);
        fmt_int(buf_len(b));
        syscall(1, 1, " ", 1);
        syscall(1, 1, file_path, strlen(file_path));
        syscall(1, 1, "\n", 1);
    }
    if (mode == 2) {
        fmt_int(lines);
        syscall(1, 1, " ", 1);
        syscall(1, 1, file_path, strlen(file_path));
        syscall(1, 1, "\n", 1);
    }
    return 0;
}

# Returns pointer to the byte after `prefix` in `arg` if `arg` starts
# with `prefix`; returns 0 otherwise. Both args are null-terminated
# C strings. Used by the modifier parser to split `--expect=PAT` etc.
fn _cli_argprefix(arg, prefix) {
    var plen = strlen(prefix);
    var alen = strlen(arg);
    if (alen < plen) { return 0; }
    var i = 0;
    var matched = 1;
    while (i < plen) {
        if (load8(arg + i) != load8(prefix + i)) {
            matched = 0;
            i = plen;
        } else {
            i = i + 1;
        }
    }
    if (matched == 0) { return 0; }
    return arg + plen;
}

# Parse a non-negative decimal integer from C string `s`. Returns the
# value on success, or -1 on parse failure (empty, non-digit byte, etc.).
# Used by --expect-N=<n>.
fn _cli_atoi_nn(s) {
    if (s == 0) { return 0 - 1; }
    var i = 0;
    var n = 0;
    var any = 0;
    var bad = 0;
    var done = 0;
    while (done == 0) {
        var c = load8(s + i);
        if (c == 0) { done = 1; }
        if (done == 0) {
            if (c < 48) {
                bad = 1;
                done = 1;
            } else {
                if (c > 57) {
                    bad = 1;
                    done = 1;
                } else {
                    n = n * 10 + (c - 48);
                    any = 1;
                    i = i + 1;
                }
            }
        }
    }
    if (bad == 1) { return 0 - 1; }
    if (any == 0) { return 0 - 1; }
    return n;
}

# Write the byte range [start, end) of buffer `b` to stdout, batching
# through `chunk` (capacity `cap`) so we issue O(N/cap) write syscalls
# instead of one per byte. Used by run_grep to emit matching lines.
fn _cli_write_buf_range(b, start, end, chunk, cap) {
    var ci = 0;
    var i = start;
    while (i < end) {
        store8(chunk + ci, buf_get(b, i));
        ci = ci + 1;
        if (ci == cap) {
            syscall(1, 1, chunk, cap);
            ci = 0;
        }
        i = i + 1;
    }
    if (ci > 0) {
        syscall(1, 1, chunk, ci);
    }
    return 0;
}

# Build a per-line byte-offset index for buffer `b`.
# Returns: pointer to an array of (L+1) i64 entries where:
#   arr[k-1] = byte offset of the start of line k (1-indexed)
#   arr[L]   = blen (sentinel: byte just past the end of the last line)
# Stores the line count L into *count_out. Returns 0 on alloc failure.
#
# Trailing-\n convention matches grep(1): a file ending in \n has its
# `\n` count == line count; a file not ending in \n still counts the
# final partial line. An empty file has 0 lines.
fn _cli_build_line_index(b, count_out) {
    var blen = buf_len(b);
    var L = 0;
    if (blen > 0) {
        var nl = 0;
        var ic = 0;
        while (ic < blen) {
            if (buf_get(b, ic) == 10) { nl = nl + 1; }
            ic = ic + 1;
        }
        if (buf_get(b, blen - 1) == 10) {
            L = nl;
        } else {
            L = nl + 1;
        }
    }
    var alloc_n = (L + 1) * 8;
    if (alloc_n < 8) { alloc_n = 8; }
    var arr = alloc(alloc_n);
    if (arr == 0) { store64(count_out, 0); return 0; }
    if (L > 0) {
        store64(arr, 0);
        var line_idx = 1;
        var ix = 0;
        while (ix < blen) {
            if (buf_get(b, ix) == 10) {
                if (line_idx <= L) {
                    store64(arr + line_idx * 8, ix + 1);
                }
                line_idx = line_idx + 1;
            }
            ix = ix + 1;
        }
        store64(arr + L * 8, blen);
    }
    store64(count_out, L);
    return arr;
}

# Emit one grep result line. `is_match=1` uses ":" separators (canonical
# `FILE:N:LINE` match form); `is_match=0` uses "-" (`FILE-N-LINE`,
# context-line form per grep -C). Trailing \n in line content is
# stripped before emit (we add our own).
fn _cli_print_grep_line(b, file_path, fp_len, arr, lineno, is_match, chunk, chunk_cap) {
    var s = load64(arr + (lineno - 1) * 8);
    var e = load64(arr + lineno * 8);
    if (e > s) {
        if (buf_get(b, e - 1) == 10) { e = e - 1; }
    }
    syscall(1, 1, file_path, fp_len);
    if (is_match == 1) {
        syscall(1, 1, ":", 1);
    } else {
        syscall(1, 1, "-", 1);
    }
    fmt_int(lineno);
    if (is_match == 1) {
        syscall(1, 1, ":", 1);
    } else {
        syscall(1, 1, "-", 1);
    }
    _cli_write_buf_range(b, s, e, chunk, chunk_cap);
    syscall(1, 1, "\n", 1);
    return 0;
}

# Run a single-file grep with optional context. Used by both run_grep
# (single FILE) and run_grepfiles (multi-FILE).
#
# `context_n`: 0 = no context (just match lines, no `--` separators);
#              N>0 = N lines before+after each match, overlapping
#              windows merged, `--` between non-adjacent groups.
# `emitted_inout` (i64*): cross-file "did any prior file emit?" flag.
#   Used to emit a leading `--` separator between files when context_n>0
#   and a prior file already emitted. _cli_grep_one sets *emitted_inout
#   = 1 the first time it emits anything itself.
#
# Returns: 1 if any line matched, 0 if none, -1 on alloc failure.
fn _cli_grep_one(b, file_path, m, context_n, emitted_inout) {
    var fp_len = strlen(file_path);
    var L_slot[8];
    store64(&L_slot, 0);
    var arr = _cli_build_line_index(b, &L_slot);
    if (arr == 0) { return 0 - 1; }
    var L = load64(&L_slot);

    var chunk_cap = 4096;
    var chunk = alloc(chunk_cap);
    if (chunk == 0) { return 0 - 1; }

    # Hoist matcher kind + per-flavor handles so the per-line branch
    # is a single indexed compare, not a struct re-load per iter.
    var m_kind = _matcher_kind(m);
    var lit_needle = 0;
    var lit_nlen = 0;
    var nfa = 0;
    var flavor = 0;
    if (m_kind == MATCHER_LITERAL) {
        lit_needle = _matcher_needle(m);
        lit_nlen = _matcher_nlen(m);
    } else {
        nfa = _matcher_nfa(m);
        flavor = _matcher_flavor(m);
    }

    var any_hit = 0;
    var last_emitted = 0;
    var pending_post = 0;
    var k = 1;
    while (k <= L) {
        var s = load64(arr + (k - 1) * 8);
        var e = load64(arr + k * 8);
        var ce = e;
        if (ce > s) {
            if (buf_get(b, ce - 1) == 10) { ce = ce - 1; }
        }
        var line_len = ce - s;
        var hit = 0;
        if (m_kind == MATCHER_LITERAL) {
            if (line_len >= lit_nlen) {
                var pos = s;
                var stop = ce - lit_nlen;
                while (pos <= stop) {
                    if (_cli_match_at(b, pos, lit_needle, lit_nlen) == 1) {
                        hit = 1;
                        pos = stop + 1;
                    } else {
                        pos = pos + 1;
                    }
                }
            }
        } else {
            # Regex: materialize the line bytes into a NUL-terminated
            # scratch buffer and call regex_search. Per-line alloc is
            # cheap at cyim's single-file CLI scale.
            var line_buf = alloc(line_len + 1);
            if (line_buf != 0) {
                var c = 0;
                while (c < line_len) {
                    store8(line_buf + c, buf_get(b, s + c));
                    c = c + 1;
                }
                store8(line_buf + line_len, 0);
                if (_re_search(flavor, nfa, line_buf) >= 0) { hit = 1; }
            }
        }
        if (hit == 1) {
            var first_pre = k - context_n;
            if (first_pre < 1) { first_pre = 1; }
            if (last_emitted >= first_pre) { first_pre = last_emitted + 1; }

            var need_sep = 0;
            if (context_n > 0) {
                if (load64(emitted_inout) == 1) {
                    if (last_emitted == 0) {
                        need_sep = 1;
                    } else {
                        if (last_emitted + 1 < first_pre) { need_sep = 1; }
                    }
                }
            }
            if (need_sep == 1) { syscall(1, 1, "--\n", 3); }

            var ctx = first_pre;
            while (ctx < k) {
                _cli_print_grep_line(b, file_path, fp_len, arr, ctx, 0, chunk, chunk_cap);
                ctx = ctx + 1;
            }
            _cli_print_grep_line(b, file_path, fp_len, arr, k, 1, chunk, chunk_cap);
            last_emitted = k;
            pending_post = context_n;
            store64(emitted_inout, 1);
            any_hit = 1;
        } else {
            if (pending_post > 0) {
                _cli_print_grep_line(b, file_path, fp_len, arr, k, 0, chunk, chunk_cap);
                last_emitted = k;
                pending_post = pending_post - 1;
            }
        }
        k = k + 1;
    }
    return any_hit;
}

# Slurp FILE_PATH into a freshly-allocated, NUL-terminated heap
# buffer. Returns ptr (length stored at len_out) on success, 0 on
# any failure (file missing or alloc fail). Used by run_replace_files
# to read OLD and NEW contents from disk instead of taking them as
# argv strings — the agent-drive surface friction surfaced in the
# v1.1.4 dogfood loop (multi-line / large OLD/NEW are awkward through
# argv, especially via shell). Treats content as a NUL-terminated C
# string, consistent with the rest of the CLI surface; embedded NULs
# in source files (rare for cyim's text-editor scope) would terminate
# strlen early.
fn _cli_slurp_file(file_path, len_out) {
    var b = buf_new();
    var loaded = buf_load_file(b, file_path);
    if (loaded < 0) {
        store64(len_out, 0);
        return 0;
    }
    var n = buf_len(b);
    var out = alloc(n + 1);
    if (out == 0) {
        store64(len_out, 0);
        return 0;
    }
    var i = 0;
    while (i < n) {
        store8(out + i, buf_get(b, i));
        i = i + 1;
    }
    store8(out + n, 0);
    store64(len_out, n);
    return out;
}

# `cyim --replace-files OLD_FILE NEW_FILE FILE` (mode = REPLACE_FIRST_UNIQUE) or
# `cyim --replace-files-all OLD_FILE NEW_FILE FILE` (mode = REPLACE_ALL).
# OLD and NEW are read from the named files (not argv); FILE is the
# target. Modifier surface and exit codes match --replace[-all] —
# this is run_replace with the I/O source for OLD/NEW swapped from
# argv to disk. Naming note: "files" means OLD/NEW come from file
# contents, NOT "replace across multiple files" (use a shell loop or
# wait for that to land if demand surfaces).
#
# Exit codes:
#   0 — success
#   1 — save failed
#   2 — bad CLI args (missing OLD_FILE/NEW_FILE/FILE)
#   3 — OLD_FILE / NEW_FILE / FILE not found (read or load failure;
#       same code as --replace's missing-FILE)
#   4 — OLD content not found in FILE
#   5 — OLD content occurs more than once and not --replace-files-all
#   6 — --expect-N / --expect-1 mismatch
fn run_replace_files(old_file, new_file, file_path, mode, wc_mode, expect_n, regex_flavor, fuzzy_edits) {
    if (old_file == 0)  { syscall(1, 2, "cyim --replace-files: missing OLD_FILE\n", 39); return 2; }
    if (new_file == 0)  { syscall(1, 2, "cyim --replace-files: missing NEW_FILE\n", 39); return 2; }
    if (file_path == 0) { syscall(1, 2, "cyim --replace-files: missing FILE\n",     35); return 2; }

    var olen[8];
    store64(&olen, 0);
    var old_str = _cli_slurp_file(old_file, &olen);
    if (old_str == 0) {
        syscall(1, 2, "cyim --replace-files: cannot read OLD_FILE\n", 43);
        return 3;
    }
    if (load64(&olen) == 0) {
        syscall(1, 2, "cyim --replace-files: OLD_FILE is empty\n", 40);
        return 2;
    }

    var nlen[8];
    store64(&nlen, 0);
    var new_str = _cli_slurp_file(new_file, &nlen);
    if (new_str == 0) {
        syscall(1, 2, "cyim --replace-files: cannot read NEW_FILE\n", 43);
        return 3;
    }

    return run_replace(old_str, new_str, file_path, mode, wc_mode, expect_n, regex_flavor, fuzzy_edits);
}

# `cyim --grep [--context=N] PATTERN FILE` — emit `FILE:N:LINE` for
# every matching line in FILE (literal substring). With --context=N,
# also emit N lines before+after each match as `FILE-N-LINE`, with
# `--` separators between non-adjacent groups (grep -C N shape).
# Matches grep(1) exit conventions: 0 if any match, 1 if none, 2 on
# usage error, 3 if FILE is missing.
fn run_grep(pattern, file_path, context_n, regex_flavor, fuzzy_edits) {
    if (pattern == 0)   { syscall(1, 2, "cyim --grep: missing PATTERN\n", 29); return 2; }
    if (file_path == 0) { syscall(1, 2, "cyim --grep: missing FILE\n",    26); return 2; }
    if (strlen(pattern) == 0) {
        syscall(1, 2, "cyim --grep: PATTERN must be non-empty\n", 39);
        return 2;
    }

    var b = buf_new();
    var loaded = buf_load_file(b, file_path);
    if (loaded < 0) {
        syscall(1, 2, "cyim --grep: file not found\n", 28);
        return 3;
    }

    var m = 0;
    if (regex_flavor == FLAVOR_LITERAL) {
        m = _matcher_literal(pattern);
    } else {
        var opts = _regex_opts_new(regex_flavor);
        if (opts == 0) { syscall(1, 2, "cyim --grep: alloc failed\n", 26); return 1; }
        _regex_opts_set_fuzzy_edits(opts, fuzzy_edits);
        m = _matcher_regex(pattern, opts);
        if (m == 0) {
            syscall(1, 2, "cyim --grep: invalid regex pattern\n", 35);
            return 2;
        }
    }
    if (m == 0) { syscall(1, 2, "cyim --grep: alloc failed\n", 26); return 1; }

    var emitted[8];
    store64(&emitted, 0);
    var rc = _cli_grep_one(b, file_path, m, context_n, &emitted);
    if (rc < 0) {
        syscall(1, 2, "cyim --grep: alloc failed\n", 26);
        return 1;
    }
    if (rc == 0) { return 1; }
    return 0;
}

# `cyim --grepfiles [--context=N] PATTERN FILE [FILE...]` — multi-file
# grep variant. `files_arr` is an array of `file_count` C-string ptrs
# to file paths. Output stays `FILE:N:LINE` per-match (`grep -n` shape
# already disambiguates by filename). With --context=N, `--` separators
# appear both within a file (between non-adjacent groups) and between
# files (matches `grep -n -C N` cross-file behavior).
#
# Exit codes: 0 = at least one match across all files, 1 = no matches
# in any file, 2 = bad args, 3 = first missing FILE (early-exit so the
# caller learns about typos before partial output diverges).
fn run_grepfiles(pattern, files_arr, file_count, context_n, regex_flavor, fuzzy_edits) {
    if (pattern == 0) {
        syscall(1, 2, "cyim --grepfiles: missing PATTERN\n", 35);
        return 2;
    }
    if (file_count <= 0) {
        syscall(1, 2, "cyim --grepfiles: missing FILE\n", 32);
        return 2;
    }
    if (strlen(pattern) == 0) {
        syscall(1, 2, "cyim --grepfiles: PATTERN must be non-empty\n", 45);
        return 2;
    }

    # Build the matcher once; same pattern applies to every FILE.
    var m = 0;
    if (regex_flavor == FLAVOR_LITERAL) {
        m = _matcher_literal(pattern);
    } else {
        var opts = _regex_opts_new(regex_flavor);
        if (opts == 0) { syscall(1, 2, "cyim --grepfiles: alloc failed\n", 32); return 1; }
        _regex_opts_set_fuzzy_edits(opts, fuzzy_edits);
        m = _matcher_regex(pattern, opts);
        if (m == 0) {
            syscall(1, 2, "cyim --grepfiles: invalid regex pattern\n", 40);
            return 2;
        }
    }
    if (m == 0) { syscall(1, 2, "cyim --grepfiles: alloc failed\n", 32); return 1; }

    var emitted[8];
    store64(&emitted, 0);
    var any_hit = 0;
    var i = 0;
    while (i < file_count) {
        var fp = load64(files_arr + i * 8);
        var b = buf_new();
        var loaded = buf_load_file(b, fp);
        if (loaded < 0) {
            syscall(1, 2, "cyim --grepfiles: file not found: ", 34);
            syscall(1, 2, fp, strlen(fp));
            syscall(1, 2, "\n", 1);
            return 3;
        }
        var rc = _cli_grep_one(b, fp, m, context_n, &emitted);
        if (rc < 0) {
            syscall(1, 2, "cyim --grepfiles: alloc failed\n", 32);
            return 1;
        }
        if (rc == 1) { any_hit = 1; }
        i = i + 1;
    }
    if (any_hit == 0) { return 1; }
    return 0;
}

# `cyim --write FILE` — read stdin, replace FILE's contents with it.
# `wc_mode`:    0 silent, 1 full wc, 2 wc -l (printed to stdout on success).
# `expect_pat`: 0 = no assertion; otherwise C-string pattern to check
#               in the post-save buffer.
# `expect_pol`: 0 none, 1 must contain (--expect), 2 must not contain
#               (--expect-not). On mismatch, returns 6 (file is already
#               saved — the assertion is a contract on the result).
fn run_write(file_path, wc_mode, expect_pat, expect_pol) {
    if (file_path == 0) {
        syscall(1, 2, "cyim --write: missing FILE argument\n", 36);
        return 2;
    }
    var b = buf_new();
    _cli_drain_stdin(b);
    var n = buf_save_file(b, file_path);
    if (n < 0) {
        syscall(1, 2, "cyim --write: save failed\n", 26);
        return 1;
    }
    if (expect_pol != 0) {
        var ec = _cli_count_matches(b, expect_pat);
        if (expect_pol == 1) {
            if (ec == 0) {
                syscall(1, 2, "cyim --write: --expect pattern not found in result\n", 51);
                return 6;
            }
        }
        if (expect_pol == 2) {
            if (ec > 0) {
                syscall(1, 2, "cyim --write: --expect-not pattern present in result\n", 53);
                return 6;
            }
        }
    }
    _cli_print_wc(b, file_path, wc_mode);
    return 0;
}

# `cyim --replace OLD NEW FILE` (mode = REPLACE_FIRST_UNIQUE) or
# `cyim --replace-all OLD NEW FILE` (mode = REPLACE_ALL).
# `wc_mode`:  0 silent, 1 full wc, 2 wc -l (printed to stdout on success).
# `expect_n`: -1 = no assertion; otherwise the required count of OLD
#             occurrences in FILE (pre-substitution). On mismatch we
#             return 6 *before* touching the file. --expect-N=0 is the
#             "must be a no-op" idiom: success without writing, with
#             --wc still honored if requested.
fn run_replace(old_str, new_str, file_path, mode, wc_mode, expect_n, regex_flavor, fuzzy_edits) {
    if (old_str == 0)   { syscall(1, 2, "cyim --replace: missing OLD\n", 28);  return 2; }
    if (new_str == 0)   { syscall(1, 2, "cyim --replace: missing NEW\n", 28);  return 2; }
    if (file_path == 0) { syscall(1, 2, "cyim --replace: missing FILE\n", 29); return 2; }
    if (strlen(old_str) == 0) {
        syscall(1, 2, "cyim --replace: OLD must be non-empty\n", 38);
        return 2;
    }

    var b = buf_new();
    var loaded = buf_load_file(b, file_path);
    if (loaded < 0) {
        syscall(1, 2, "cyim --replace: file not found\n", 31);
        return 3;
    }

    var m = 0;
    if (regex_flavor == FLAVOR_LITERAL) {
        m = _matcher_literal(old_str);
    } else {
        var opts = _regex_opts_new(regex_flavor);
        if (opts == 0) { syscall(1, 2, "cyim --replace: alloc failed\n", 29); return 1; }
        _regex_opts_set_fuzzy_edits(opts, fuzzy_edits);
        m = _matcher_regex(old_str, opts);
        if (m == 0) {
            syscall(1, 2, "cyim --replace: invalid regex pattern\n", 38);
            return 2;
        }
    }
    if (m == 0) { syscall(1, 2, "cyim --replace: alloc failed\n", 29); return 1; }

    var count = _cli_count_matches_m(b, m);

    # --expect-N comes first: an explicit count assertion is the
    # strongest contract the caller can express, and a mismatch is a
    # hard fail before any of the implicit checks fire.
    if (expect_n >= 0) {
        if (count != expect_n) {
            syscall(1, 2, "cyim --replace: --expect-N count mismatch\n", 42);
            return 6;
        }
    }

    if (count == 0) {
        # --expect-N=0 explicitly asserted "this file does not contain
        # OLD" — the caller is using us as a defensive check, not an
        # edit. Honor --wc on the unchanged file and exit clean.
        if (expect_n == 0) {
            _cli_print_wc(b, file_path, wc_mode);
            return 0;
        }
        syscall(1, 2, "cyim --replace: OLD not found in FILE\n", 38);
        return 4;
    }
    if (mode == 0) {
        if (count > 1) {
            syscall(1, 2, "cyim --replace: OLD occurs more than once — ", 46);
            syscall(1, 2, "not unique. Use --replace-all or pick a more specific OLD.\n", 59);
            return 5;
        }
    }

    var out = _cli_substitute_m(b, m, new_str, mode);
    var rc = buf_save_file(out, file_path);
    if (rc < 0) {
        syscall(1, 2, "cyim --replace: save failed\n", 28);
        return 1;
    }
    _cli_print_wc(out, file_path, wc_mode);
    return 0;
}

# Read all of stdin into a freshly allocated heap buffer. Returns the
# buffer pointer; writes the byte count into the 8-byte slot at
# `len_out`. Caller owns `buf` (cyim's freelist allocator can't reclaim
# arbitrary blocks; the buffer lives until process exit).
#
# Used by run_batch to slurp the NUL-separated pair stream — buf_insert
# (the --write path) is wrong here because we need raw byte access by
# offset for the token walk, not gap-buffer semantics.
fn _cli_drain_stdin_raw(len_out) {
    var cap = 4096;
    var buf = alloc(cap);
    var n = 0;
    var go = 1;
    while (go == 1) {
        if (n + 4096 > cap) {
            var new_cap = cap * 2;
            while (new_cap < n + 4096) { new_cap = new_cap * 2; }
            var nb = alloc(new_cap);
            var i = 0;
            while (i < n) {
                store8(nb + i, load8(buf + i));
                i = i + 1;
            }
            buf = nb;
            cap = new_cap;
        }
        var r = file_read(0, buf + n, 4096);
        if (r <= 0) { go = 0; }
        if (r > 0) { n = n + r; }
    }
    store64(len_out, n);
    return buf;
}

# `cyim --batch FILE` — apply N substitutions from stdin to FILE, save
# once. Stdin format: NUL-separated alternating tokens
# OLD1\0NEW1\0OLD2\0NEW2\0…\0. Token count must be even and ≥ 2; the
# stream must end with a NUL (closes the final NEW). Each pair applies
# in order to the in-memory buffer; the file is written once at the end.
# A failure mid-batch leaves FILE untouched on disk — atomic from the
# caller's perspective.
#
# `mode`:       0 = each pair runs --replace semantics (OLD unique at
#               apply time); 1 = each pair runs --replace-all.
# `wc_mode`:    0 silent, 1 full wc, 2 wc -l (printed to stdout on success).
# `expect_pat` / `expect_pol`: same shape as run_write — post-save
#               assertion on the final buffer; mismatch returns 6 (file
#               is already saved at that point — assertion is a contract
#               on the result).
fn run_batch(file_path, mode, wc_mode, expect_pat, expect_pol) {
    if (file_path == 0) {
        syscall(1, 2, "cyim --batch: missing FILE argument\n", 36);
        return 2;
    }

    var len_slot[8];
    store64(&len_slot, 0);
    var stdin_buf = _cli_drain_stdin_raw(&len_slot);
    var stdin_len = load64(&len_slot);

    if (stdin_len == 0) {
        syscall(1, 2, "cyim --batch: empty stdin\n", 26);
        return 2;
    }
    if (load8(stdin_buf + stdin_len - 1) != 0) {
        syscall(1, 2, "cyim --batch: stdin must end with NUL after final NEW\n", 54);
        return 2;
    }

    # Token count = number of NUL bytes in the stream. Must be even and
    # ≥ 2 (one OLD + one NEW = one pair).
    var num_tokens = 0;
    var p = 0;
    while (p < stdin_len) {
        if (load8(stdin_buf + p) == 0) { num_tokens = num_tokens + 1; }
        p = p + 1;
    }
    if (num_tokens < 2) {
        syscall(1, 2, "cyim --batch: need at least one OLD/NEW pair\n", 45);
        return 2;
    }
    if ((num_tokens / 2) * 2 != num_tokens) {
        syscall(1, 2, "cyim --batch: odd token count (each OLD needs a NEW)\n", 53);
        return 2;
    }

    var b = buf_new();
    var loaded = buf_load_file(b, file_path);
    if (loaded < 0) {
        syscall(1, 2, "cyim --batch: file not found\n", 29);
        return 3;
    }

    # Walk the stream pair-by-pair. Each token is already NUL-terminated
    # in-place by the separators, so strlen() works directly on token
    # pointers — _cli_count_matches / _cli_substitute use strlen on the
    # needle, which is what we want.
    var tok_start = 0;
    var on_old = 1;
    var old_ptr = 0;
    var t = 0;
    while (t < num_tokens) {
        var j = tok_start;
        while (load8(stdin_buf + j) != 0) { j = j + 1; }
        var tok_ptr = stdin_buf + tok_start;
        var tok_len = j - tok_start;
        if (on_old == 1) {
            if (tok_len == 0) {
                syscall(1, 2, "cyim --batch: empty OLD in pair\n", 32);
                return 2;
            }
            old_ptr = tok_ptr;
            on_old = 0;
        } else {
            var count = _cli_count_matches(b, old_ptr);
            if (count == 0) {
                syscall(1, 2, "cyim --batch: pair OLD not found in file\n", 41);
                return 4;
            }
            if (mode == 0) {
                if (count > 1) {
                    syscall(1, 2, "cyim --batch: pair OLD not unique — use --all or specify more\n", 64);
                    return 5;
                }
            }
            b = _cli_substitute(b, old_ptr, tok_ptr, mode);
            on_old = 1;
        }
        tok_start = j + 1;
        t = t + 1;
    }

    var rc = buf_save_file(b, file_path);
    if (rc < 0) {
        syscall(1, 2, "cyim --batch: save failed\n", 26);
        return 1;
    }
    if (expect_pol != 0) {
        var ec = _cli_count_matches(b, expect_pat);
        if (expect_pol == 1) {
            if (ec == 0) {
                syscall(1, 2, "cyim --batch: --expect pattern not found in result\n", 51);
                return 6;
            }
        }
        if (expect_pol == 2) {
            if (ec > 0) {
                syscall(1, 2, "cyim --batch: --expect-not pattern present in result\n", 53);
                return 6;
            }
        }
    }
    _cli_print_wc(b, file_path, wc_mode);
    return 0;
}

# === per-verb dispatch helpers (v1.2.0) =========================
# Extracted from main.cyr to keep main()'s return-statement count
# under Cyrius's 64-per-function cap. Each helper takes argc as `ac`
# and returns the process exit code, threading the new --regex=
# modifier where applicable.

fn _dispatch_grep(ac) {
        # Modifier-parsing dispatch (v1.1.4): --context=<n> is the
        # only modifier today; default 0 (no context) preserves the
        # v1.1.0–v1.1.3 single-line-per-match output bytes-for-bytes.
        var g_ctx = 0;
        var g_p0 = 0;
        var g_p1 = 0;
        var g_npos = 0;
        var g_ctx_seen = 0;
        var g_regex_flavor = FLAVOR_LITERAL;
        var g_regex_seen = 0;
        var g_fuzzy_edits = 0 - 1;
        var g_fz_seen = 0;
        var g_idx = 2;
        while (g_idx < ac) {
            var arg = argv(g_idx);
            var consumed = 0;
            if (consumed == 0) {
                var sf = _cli_argprefix(arg, "--regex=");
                if (sf != 0) {
                    if (strlen(sf) == 0) {
                        syscall(1, 2, "cyim --grep: --regex requires a flavor (e.g. --regex=ere)\n", 58);
                        return 2;
                    }
                    if (g_regex_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --regex\n", 30); return 2; }
                    var fid = _regex_flavor_id(sf);
                    if (_flavor_validate("--grep", fid) == 0) { return 2; }
                    g_regex_flavor = fid;
                    g_regex_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                var sfe = _cli_argprefix(arg, "--fuzzy-edits=");
                if (sfe != 0) {
                    var nfe = _cli_atoi_nn(sfe);
                    if (nfe < 0) {
                        syscall(1, 2, "cyim --grep: --fuzzy-edits requires a non-negative integer\n", 60);
                        return 2;
                    }
                    if (g_fz_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --fuzzy-edits\n", 36); return 2; }
                    g_fuzzy_edits = nfe;
                    g_fz_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                var sc = _cli_argprefix(arg, "--context=");
                if (sc != 0) {
                    var nc = _cli_atoi_nn(sc);
                    if (nc < 0) {
                        syscall(1, 2, "cyim --grep: --context requires a non-negative integer\n", 56);
                        return 2;
                    }
                    if (g_ctx_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --context\n", 32); return 2; }
                    g_ctx = nc;
                    g_ctx_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                if (g_npos == 0) { g_p0 = arg; }
                if (g_npos == 1) { g_p1 = arg; }
                if (g_npos >= 2) {
                    syscall(1, 2, "cyim --grep: unexpected extra argument\n", 40);
                    return 2;
                }
                g_npos = g_npos + 1;
            }
            g_idx = g_idx + 1;
        }
        if (g_npos < 2) {
            syscall(1, 2, "usage: cyim --grep [--context=<n>] <pattern> <file>\n", 53);
            return 2;
        }
        if (g_fz_seen == 1) {
            if (g_regex_flavor != FLAVOR_FUZZY) {
                syscall(1, 2, "cyim --grep: --fuzzy-edits requires --regex=fuzzy\n", 51);
                return 2;
            }
        }
        return run_grep(g_p0, g_p1, g_ctx, g_regex_flavor, g_fuzzy_edits);
}

fn _dispatch_grepfiles(ac) {
        # Multi-file grep. PATTERN is the first non-flag positional;
        # every subsequent non-flag arg is a FILE. --context=<n>
        # threads through to _cli_grep_one with cross-file separator
        # handling (matches `grep -n -C N` output for two+ files).
        var gf_ctx = 0;
        var gf_pat = 0;
        var gf_pat_seen = 0;
        var gf_ctx_seen = 0;
        var gf_regex_flavor = FLAVOR_LITERAL;
        var gf_regex_seen = 0;
        var gf_fuzzy_edits = 0 - 1;
        var gf_fz_seen = 0;
        var gf_alloc_n = (ac - 2) * 8;
        if (gf_alloc_n < 8) { gf_alloc_n = 8; }
        var gf_files = alloc(gf_alloc_n);
        var gf_fcount = 0;
        var gf_idx = 2;
        while (gf_idx < ac) {
            var arg = argv(gf_idx);
            var consumed = 0;
            if (consumed == 0) {
                var sf = _cli_argprefix(arg, "--regex=");
                if (sf != 0) {
                    if (strlen(sf) == 0) {
                        syscall(1, 2, "cyim --grepfiles: --regex requires a flavor (e.g. --regex=ere)\n", 63);
                        return 2;
                    }
                    if (gf_regex_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --regex\n", 30); return 2; }
                    var fid = _regex_flavor_id(sf);
                    if (_flavor_validate("--grepfiles", fid) == 0) { return 2; }
                    gf_regex_flavor = fid;
                    gf_regex_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                var sfe = _cli_argprefix(arg, "--fuzzy-edits=");
                if (sfe != 0) {
                    var nfe = _cli_atoi_nn(sfe);
                    if (nfe < 0) {
                        syscall(1, 2, "cyim --grepfiles: --fuzzy-edits requires a non-negative integer\n", 65);
                        return 2;
                    }
                    if (gf_fz_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --fuzzy-edits\n", 36); return 2; }
                    gf_fuzzy_edits = nfe;
                    gf_fz_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                var sc = _cli_argprefix(arg, "--context=");
                if (sc != 0) {
                    var nc = _cli_atoi_nn(sc);
                    if (nc < 0) {
                        syscall(1, 2, "cyim --grepfiles: --context requires a non-negative integer\n", 61);
                        return 2;
                    }
                    if (gf_ctx_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --context\n", 32); return 2; }
                    gf_ctx = nc;
                    gf_ctx_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                if (gf_pat_seen == 0) {
                    gf_pat = arg;
                    gf_pat_seen = 1;
                } else {
                    store64(gf_files + gf_fcount * 8, arg);
                    gf_fcount = gf_fcount + 1;
                }
            }
            gf_idx = gf_idx + 1;
        }
        if (gf_pat_seen == 0) {
            syscall(1, 2, "usage: cyim --grepfiles [--context=<n>] <pattern> <file...>\n", 61);
            return 2;
        }
        if (gf_fcount == 0) {
            syscall(1, 2, "usage: cyim --grepfiles [--context=<n>] <pattern> <file...>\n", 61);
            return 2;
        }
        if (gf_fz_seen == 1) {
            if (gf_regex_flavor != FLAVOR_FUZZY) {
                syscall(1, 2, "cyim --grepfiles: --fuzzy-edits requires --regex=fuzzy\n", 56);
                return 2;
            }
        }
        return run_grepfiles(gf_pat, gf_files, gf_fcount, gf_ctx, gf_regex_flavor, gf_fuzzy_edits);
}

fn _dispatch_replace(ac) {
        # Modifiers and the OLD/NEW/FILE positionals may interleave in
        # any order after the verb. v1.1.0 bailed at the first non-flag
        # arg, so a trailing modifier (e.g. `--replace OLD NEW
        # --expect-1 FILE`) was misread as FILE, and the actual FILE
        # was dropped — surfacing as exit-3 "file not found".
        var r_wc = 0;
        var r_expect_n = 0 - 1;
        var r_p0 = 0;
        var r_p1 = 0;
        var r_p2 = 0;
        var r_npos = 0;
        var r_wc_seen = 0;
        var r_expect_seen = 0;
        var r_regex_flavor = FLAVOR_LITERAL;
        var r_regex_seen = 0;
        var r_fuzzy_edits = 0 - 1;
        var r_fz_seen = 0;
        var r_idx = 2;
        while (r_idx < ac) {
            var arg = argv(r_idx);
            var consumed = 0;
            if (streq(arg, "--wc")        == 1) {
                if (r_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                r_wc = 1; r_wc_seen = 1; consumed = 1;
            }
            if (streq(arg, "--wc=l")      == 1) {
                if (r_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                r_wc = 2; r_wc_seen = 1; consumed = 1;
            }
            if (streq(arg, "--wc=long")   == 1) {
                if (r_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                r_wc = 2; r_wc_seen = 1; consumed = 1;
            }
            if (streq(arg, "--expect-1")  == 1) {
                if (r_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-1\n", 33); return 2; }
                r_expect_n = 1; r_expect_seen = 1; consumed = 1;
            }
            if (consumed == 0) {
                var sf = _cli_argprefix(arg, "--regex=");
                if (sf != 0) {
                    if (strlen(sf) == 0) {
                        syscall(1, 2, "cyim --replace: --regex requires a flavor (e.g. --regex=ere)\n", 61);
                        return 2;
                    }
                    if (r_regex_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --regex\n", 30); return 2; }
                    var fid = _regex_flavor_id(sf);
                    if (_flavor_validate("--replace", fid) == 0) { return 2; }
                    r_regex_flavor = fid;
                    r_regex_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                var sfe = _cli_argprefix(arg, "--fuzzy-edits=");
                if (sfe != 0) {
                    var nfe = _cli_atoi_nn(sfe);
                    if (nfe < 0) {
                        syscall(1, 2, "cyim --replace: --fuzzy-edits requires a non-negative integer\n", 63);
                        return 2;
                    }
                    if (r_fz_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --fuzzy-edits\n", 36); return 2; }
                    r_fuzzy_edits = nfe;
                    r_fz_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                var s = _cli_argprefix(arg, "--expect-N=");
                if (s != 0) {
                    var n = _cli_atoi_nn(s);
                    if (n < 0) {
                        syscall(1, 2, "cyim --replace: --expect-N requires a non-negative integer\n", 59);
                        return 2;
                    }
                    if (r_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-N\n", 33); return 2; }
                    r_expect_n = n;
                    r_expect_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                if (r_npos == 0) { r_p0 = arg; }
                if (r_npos == 1) { r_p1 = arg; }
                if (r_npos == 2) { r_p2 = arg; }
                if (r_npos >= 3) {
                    syscall(1, 2, "cyim --replace: unexpected extra argument\n", 42);
                    return 2;
                }
                r_npos = r_npos + 1;
            }
            r_idx = r_idx + 1;
        }
        if (r_npos < 3) {
            syscall(1, 2, "usage: cyim --replace [--wc[=l]] [--expect-N=<n>|--expect-1] <old> <new> <file>\n", 80);
            return 2;
        }
        if (r_fz_seen == 1) {
            if (r_regex_flavor != FLAVOR_FUZZY) {
                syscall(1, 2, "cyim --replace: --fuzzy-edits requires --regex=fuzzy\n", 54);
                return 2;
            }
        }
        return run_replace(r_p0, r_p1, r_p2, 0, r_wc, r_expect_n, r_regex_flavor, r_fuzzy_edits);
}

fn _dispatch_replace_all(ac) {
        # Same interspersed-modifier semantics as --replace.
        var ra_wc = 0;
        var ra_expect_n = 0 - 1;
        var ra_p0 = 0;
        var ra_p1 = 0;
        var ra_p2 = 0;
        var ra_npos = 0;
        var ra_wc_seen = 0;
        var ra_expect_seen = 0;
        var ra_regex_flavor = FLAVOR_LITERAL;
        var ra_regex_seen = 0;
        var ra_fuzzy_edits = 0 - 1;
        var ra_fz_seen = 0;
        var ra_idx = 2;
        while (ra_idx < ac) {
            var arg = argv(ra_idx);
            var consumed = 0;
            if (streq(arg, "--wc")        == 1) {
                if (ra_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                ra_wc = 1; ra_wc_seen = 1; consumed = 1;
            }
            if (streq(arg, "--wc=l")      == 1) {
                if (ra_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                ra_wc = 2; ra_wc_seen = 1; consumed = 1;
            }
            if (streq(arg, "--wc=long")   == 1) {
                if (ra_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                ra_wc = 2; ra_wc_seen = 1; consumed = 1;
            }
            if (streq(arg, "--expect-1")  == 1) {
                if (ra_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-1\n", 33); return 2; }
                ra_expect_n = 1; ra_expect_seen = 1; consumed = 1;
            }
            if (consumed == 0) {
                var sf = _cli_argprefix(arg, "--regex=");
                if (sf != 0) {
                    if (strlen(sf) == 0) {
                        syscall(1, 2, "cyim --replace-all: --regex requires a flavor (e.g. --regex=ere)\n", 65);
                        return 2;
                    }
                    if (ra_regex_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --regex\n", 30); return 2; }
                    var fid = _regex_flavor_id(sf);
                    if (_flavor_validate("--replace-all", fid) == 0) { return 2; }
                    ra_regex_flavor = fid;
                    ra_regex_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                var sfe = _cli_argprefix(arg, "--fuzzy-edits=");
                if (sfe != 0) {
                    var nfe = _cli_atoi_nn(sfe);
                    if (nfe < 0) {
                        syscall(1, 2, "cyim --replace-all: --fuzzy-edits requires a non-negative integer\n", 67);
                        return 2;
                    }
                    if (ra_fz_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --fuzzy-edits\n", 36); return 2; }
                    ra_fuzzy_edits = nfe;
                    ra_fz_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                var s = _cli_argprefix(arg, "--expect-N=");
                if (s != 0) {
                    var n = _cli_atoi_nn(s);
                    if (n < 0) {
                        syscall(1, 2, "cyim --replace-all: --expect-N requires a non-negative integer\n", 63);
                        return 2;
                    }
                    if (ra_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-N\n", 33); return 2; }
                    ra_expect_n = n;
                    ra_expect_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                if (ra_npos == 0) { ra_p0 = arg; }
                if (ra_npos == 1) { ra_p1 = arg; }
                if (ra_npos == 2) { ra_p2 = arg; }
                if (ra_npos >= 3) {
                    syscall(1, 2, "cyim --replace-all: unexpected extra argument\n", 46);
                    return 2;
                }
                ra_npos = ra_npos + 1;
            }
            ra_idx = ra_idx + 1;
        }
        if (ra_npos < 3) {
            syscall(1, 2, "usage: cyim --replace-all [--wc[=l]] [--expect-N=<n>|--expect-1] <old> <new> <file>\n", 84);
            return 2;
        }
        if (ra_fz_seen == 1) {
            if (ra_regex_flavor != FLAVOR_FUZZY) {
                syscall(1, 2, "cyim --replace-all: --fuzzy-edits requires --regex=fuzzy\n", 58);
                return 2;
            }
        }
        return run_replace(ra_p0, ra_p1, ra_p2, 1, ra_wc, ra_expect_n, ra_regex_flavor, ra_fuzzy_edits);
}

fn _dispatch_replace_files(ac) {
        # OLD/NEW are FILE PATHS, not byte strings — content is
        # slurped by run_replace_files. Modifier shape and
        # positional order match --replace exactly so callers can
        # one-line port a `--replace OLD NEW FILE` invocation by
        # writing OLD/NEW to disk and switching the verb.
        var rf_wc = 0;
        var rf_expect_n = 0 - 1;
        var rf_p0 = 0;
        var rf_p1 = 0;
        var rf_p2 = 0;
        var rf_npos = 0;
        var rf_wc_seen = 0;
        var rf_expect_seen = 0;
        var rf_regex_flavor = FLAVOR_LITERAL;
        var rf_regex_seen = 0;
        var rf_fuzzy_edits = 0 - 1;
        var rf_fz_seen = 0;
        var rf_idx = 2;
        while (rf_idx < ac) {
            var arg = argv(rf_idx);
            var consumed = 0;
            if (streq(arg, "--wc")        == 1) {
                if (rf_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                rf_wc = 1; rf_wc_seen = 1; consumed = 1;
            }
            if (streq(arg, "--wc=l")      == 1) {
                if (rf_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                rf_wc = 2; rf_wc_seen = 1; consumed = 1;
            }
            if (streq(arg, "--wc=long")   == 1) {
                if (rf_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                rf_wc = 2; rf_wc_seen = 1; consumed = 1;
            }
            if (streq(arg, "--expect-1")  == 1) {
                if (rf_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-1\n", 33); return 2; }
                rf_expect_n = 1; rf_expect_seen = 1; consumed = 1;
            }
            if (consumed == 0) {
                var sf = _cli_argprefix(arg, "--regex=");
                if (sf != 0) {
                    if (strlen(sf) == 0) {
                        syscall(1, 2, "cyim --replace-files: --regex requires a flavor (e.g. --regex=ere)\n", 67);
                        return 2;
                    }
                    if (rf_regex_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --regex\n", 30); return 2; }
                    var fid = _regex_flavor_id(sf);
                    if (_flavor_validate("--replace-files", fid) == 0) { return 2; }
                    rf_regex_flavor = fid;
                    rf_regex_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                var sfe = _cli_argprefix(arg, "--fuzzy-edits=");
                if (sfe != 0) {
                    var nfe = _cli_atoi_nn(sfe);
                    if (nfe < 0) {
                        syscall(1, 2, "cyim --replace-files: --fuzzy-edits requires a non-negative integer\n", 69);
                        return 2;
                    }
                    if (rf_fz_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --fuzzy-edits\n", 36); return 2; }
                    rf_fuzzy_edits = nfe;
                    rf_fz_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                var s = _cli_argprefix(arg, "--expect-N=");
                if (s != 0) {
                    var n = _cli_atoi_nn(s);
                    if (n < 0) {
                        syscall(1, 2, "cyim --replace-files: --expect-N requires a non-negative integer\n", 65);
                        return 2;
                    }
                    if (rf_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-N\n", 33); return 2; }
                    rf_expect_n = n;
                    rf_expect_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                if (rf_npos == 0) { rf_p0 = arg; }
                if (rf_npos == 1) { rf_p1 = arg; }
                if (rf_npos == 2) { rf_p2 = arg; }
                if (rf_npos >= 3) {
                    syscall(1, 2, "cyim --replace-files: unexpected extra argument\n", 48);
                    return 2;
                }
                rf_npos = rf_npos + 1;
            }
            rf_idx = rf_idx + 1;
        }
        if (rf_npos < 3) {
            syscall(1, 2, "usage: cyim --replace-files [--wc[=l]] [--expect-N=<n>|--expect-1] ", 67);
            syscall(1, 2, "<old-file> <new-file> <file>\n", 29);
            return 2;
        }
        if (rf_fz_seen == 1) {
            if (rf_regex_flavor != FLAVOR_FUZZY) {
                syscall(1, 2, "cyim --replace-files: --fuzzy-edits requires --regex=fuzzy\n", 60);
                return 2;
            }
        }
        return run_replace_files(rf_p0, rf_p1, rf_p2, 0, rf_wc, rf_expect_n, rf_regex_flavor, rf_fuzzy_edits);
}

fn _dispatch_replace_files_all(ac) {
        # Same shape as --replace-files, mode = REPLACE_ALL.
        var rfa_wc = 0;
        var rfa_expect_n = 0 - 1;
        var rfa_p0 = 0;
        var rfa_p1 = 0;
        var rfa_p2 = 0;
        var rfa_npos = 0;
        var rfa_wc_seen = 0;
        var rfa_expect_seen = 0;
        var rfa_regex_flavor = FLAVOR_LITERAL;
        var rfa_regex_seen = 0;
        var rfa_fuzzy_edits = 0 - 1;
        var rfa_fz_seen = 0;
        var rfa_idx = 2;
        while (rfa_idx < ac) {
            var arg = argv(rfa_idx);
            var consumed = 0;
            if (streq(arg, "--wc")        == 1) {
                if (rfa_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                rfa_wc = 1; rfa_wc_seen = 1; consumed = 1;
            }
            if (streq(arg, "--wc=l")      == 1) {
                if (rfa_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                rfa_wc = 2; rfa_wc_seen = 1; consumed = 1;
            }
            if (streq(arg, "--wc=long")   == 1) {
                if (rfa_wc_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --wc\n", 27); return 2; }
                rfa_wc = 2; rfa_wc_seen = 1; consumed = 1;
            }
            if (streq(arg, "--expect-1")  == 1) {
                if (rfa_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-1\n", 33); return 2; }
                rfa_expect_n = 1; rfa_expect_seen = 1; consumed = 1;
            }
            if (consumed == 0) {
                var sf = _cli_argprefix(arg, "--regex=");
                if (sf != 0) {
                    if (strlen(sf) == 0) {
                        syscall(1, 2, "cyim --replace-files-all: --regex requires a flavor (e.g. --regex=ere)\n", 71);
                        return 2;
                    }
                    if (rfa_regex_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --regex\n", 30); return 2; }
                    var fid = _regex_flavor_id(sf);
                    if (_flavor_validate("--replace-files-all", fid) == 0) { return 2; }
                    rfa_regex_flavor = fid;
                    rfa_regex_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                var sfe = _cli_argprefix(arg, "--fuzzy-edits=");
                if (sfe != 0) {
                    var nfe = _cli_atoi_nn(sfe);
                    if (nfe < 0) {
                        syscall(1, 2, "cyim --replace-files-all: --fuzzy-edits requires a non-negative integer\n", 73);
                        return 2;
                    }
                    if (rfa_fz_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --fuzzy-edits\n", 36); return 2; }
                    rfa_fuzzy_edits = nfe;
                    rfa_fz_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                var s = _cli_argprefix(arg, "--expect-N=");
                if (s != 0) {
                    var n = _cli_atoi_nn(s);
                    if (n < 0) {
                        syscall(1, 2, "cyim --replace-files-all: --expect-N requires a non-negative integer\n", 69);
                        return 2;
                    }
                    if (rfa_expect_seen == 1) { syscall(1, 2, "cyim: duplicate flag: --expect-N\n", 33); return 2; }
                    rfa_expect_n = n;
                    rfa_expect_seen = 1;
                    consumed = 1;
                }
            }
            if (consumed == 0) {
                if (rfa_npos == 0) { rfa_p0 = arg; }
                if (rfa_npos == 1) { rfa_p1 = arg; }
                if (rfa_npos == 2) { rfa_p2 = arg; }
                if (rfa_npos >= 3) {
                    syscall(1, 2, "cyim --replace-files-all: unexpected extra argument\n", 52);
                    return 2;
                }
                rfa_npos = rfa_npos + 1;
            }
            rfa_idx = rfa_idx + 1;
        }
        if (rfa_npos < 3) {
            syscall(1, 2, "usage: cyim --replace-files-all [--wc[=l]] ", 43);
            syscall(1, 2, "[--expect-N=<n>|--expect-1] <old-file> <new-file> <file>\n", 57);
            return 2;
        }
        if (rfa_fz_seen == 1) {
            if (rfa_regex_flavor != FLAVOR_FUZZY) {
                syscall(1, 2, "cyim --replace-files-all: --fuzzy-edits requires --regex=fuzzy\n", 64);
                return 2;
            }
        }
        return run_replace_files(rfa_p0, rfa_p1, rfa_p2, 1, rfa_wc, rfa_expect_n, rfa_regex_flavor, rfa_fuzzy_edits);
}

