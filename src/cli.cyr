        }
        rl_idx = rl_idx + 1;
    }
    if (rl_npos < 3) {
        syscall(1, 2, "usage: cyim --replace-lines A:B <new-file|-> <file> --expect-first=<line A> ", 76);
        syscall(1, 2, "[--wc[=l]|--dry-run] [--expect=<pat>|--expect-not=<pat>]\n", 57);
        return 2;
    }
    if (rl_first_seen == 0) {
        syscall(1, 2, "cyim --replace-lines: --expect-first=<the text of line A> is required\n", 70);
        return 2;
    }
    if (_cli_dry_wc("--replace-lines", &rl_mods) != 0) { return 2; }
    return run_replace_lines(rl_p0, rl_p1, rl_p2, rl_first, _cli_mods_wc(&rl_mods), _cli_mods_pat(&rl_mods),
      _cli_mods_pol(&rl_mods), _cli_mods_dry(&rl_mods));
}

