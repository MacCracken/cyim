fn _dispatch_replace_files(ac) {
    # OLD/NEW are FILE PATHS, not byte strings — content is
    # slurped by run_replace_files. Modifier shape and
    # positional order match --replace exactly so callers can
    # one-line port a `--replace OLD NEW FILE` invocation by
