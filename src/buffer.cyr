# buffer.cyr — gap-buffer primitive for cyim
#
# A gap-buffer is a contiguous byte buffer split into three regions:
# pre-gap content, the gap (uninitialized scratch), and post-gap content.
# The gap sits at the cursor; insertion and deletion at the cursor are
# O(1) byte writes plus a head/tail pointer bump. Cursor movement is the
# only O(n) op (it shifts bytes across the gap).
#
# Layout (32 B header on the heap):
#   off  0: data       i64  pointer to the byte buffer (capacity = `cap`)
#   off  8: gap_start  i64  byte offset where the gap begins (== cursor)
#   off 16: gap_end    i64  byte offset of the first byte after the gap
#   off 24: cap        i64  total bytes allocated for `data`
#
# Logical length:  cap - (gap_end - gap_start)
# Logical index i maps to physical byte:
#   i < gap_start          -> data[i]
#   i >= gap_start          -> data[gap_end + (i - gap_start)]
#
# Invariants (must hold after every public op):
#   0 <= gap_start <= gap_end <= cap
#   data points to a heap allocation of `cap` bytes

var BUF_INIT_CAP = 64;

# Header layout: 64 bytes
#   0  data       8  gap_start    16 gap_end       24 cap
#   32 version    40 cached_tb    48 cached_ver    56 cached_lang
#
# version is bumped on every CONTENT mutation (insert / delete / clear).
# Cursor moves don't change content and don't bump it. The cached_tb
# slot lets `highlight_buf` skip retokenizing when version + lang are
# unchanged — closes the M5 perf hot-path note (3.7 MB/s tokenize on
# 1 MB → instant cache hit on the next render).

# Create a new empty gap-buffer with initial capacity.
fn buf_new() {
    var b = alloc(64);
    var data = alloc(BUF_INIT_CAP);
    store64(b, data);
    store64(b + 8, 0);
    store64(b + 16, BUF_INIT_CAP);
    store64(b + 24, BUF_INIT_CAP);
    store64(b + 32, 0);    # version
    store64(b + 40, 0);    # cached_tb
    store64(b + 48, 0);    # cached_version
    store64(b + 56, 0);    # cached_lang
    return b;
}

# ──── Version + tokenbuf-cache accessors
# Public; called from highlight.cyr and from anywhere that needs to
# notice mutation without parsing the buffer.

fn buf_version(b)            { return load64(b + 32); }
fn buf_bump_version(b)       { store64(b + 32, load64(b + 32) + 1); return 0; }
fn buf_cached_tb(b)          { return load64(b + 40); }
fn buf_cached_version(b)     { return load64(b + 48); }
fn buf_cached_lang(b)        { return load64(b + 56); }
fn buf_set_cache(b, tb, ver, lang) {
    store64(b + 40, tb);
    store64(b + 48, ver);
    store64(b + 56, lang);
    return 0;
}

# Logical length (bytes of content; excludes the gap).
fn buf_len(b) {
    return load64(b + 24) - (load64(b + 16) - load64(b + 8));
}

# Total allocated capacity (gap + content combined).
fn buf_cap(b) {
    return load64(b + 24);
}

# Current gap size.
fn buf_gap(b) {
    return load64(b + 16) - load64(b + 8);
}

# Cursor position == start of the gap, in logical coords.
fn buf_cursor(b) {
    return load64(b + 8);
}

# Read the byte at logical position i. Caller must ensure 0 <= i < buf_len(b).
fn buf_get(b, i) {
    var data = load64(b);
    var gs = load64(b + 8);
    if (i < gs) { return load8(data + i); }
    var ge = load64(b + 16);
    return load8(data + ge + (i - gs));
}

# Move the gap (and cursor) to logical position pos. O(distance).
fn buf_move(b, pos) {
    var data = load64(b);
    var gs = load64(b + 8);
    var ge = load64(b + 16);
    if (pos < gs) {
        # Shift bytes [pos, gs) rightward into [pos + (ge - gs), ge).
        # Walk from the right end so source/dest don't alias destructively.
        var n = gs - pos;
        var i = 0;
        while (i < n) {
            store8(data + ge - 1 - i, load8(data + gs - 1 - i));
            i = i + 1;
        }
        store64(b + 8, pos);
        store64(b + 16, ge - n);
        return 0;
    }
    if (pos > gs) {
        # Shift bytes [ge, ge + (pos - gs)) leftward into [gs, pos).
        var n = pos - gs;
        var i = 0;
        while (i < n) {
            store8(data + gs + i, load8(data + ge + i));
            i = i + 1;
        }
        store64(b + 8, pos);
        store64(b + 16, ge + n);
        return 0;
    }
    return 0;
}

# Grow capacity to at least min_cap. Doubles repeatedly until satisfied.
fn buf_grow(b, min_cap) {
    var old_data = load64(b);
    var old_gs = load64(b + 8);
    var old_ge = load64(b + 16);
    var old_cap = load64(b + 24);
    var new_cap = old_cap * 2;
    while (new_cap < min_cap) { new_cap = new_cap * 2; }
    var new_data = alloc(new_cap);
    # Copy pre-gap content unchanged.
    var i = 0;
    while (i < old_gs) {
        store8(new_data + i, load8(old_data + i));
        i = i + 1;
    }
    # Copy post-gap content to the new tail; the gap absorbs the growth.
    var post_len = old_cap - old_ge;
    var new_ge = new_cap - post_len;
    i = 0;
    while (i < post_len) {
        store8(new_data + new_ge + i, load8(old_data + old_ge + i));
        i = i + 1;
    }
    store64(b, new_data);
    store64(b + 16, new_ge);
    store64(b + 24, new_cap);
    return 0;
}

# Insert one byte at the cursor. Grows on demand. Bumps version.
fn buf_insert_byte(b, ch) {
    var gs = load64(b + 8);
    var ge = load64(b + 16);
    if (gs >= ge) {
        buf_grow(b, load64(b + 24) + 1);
        gs = load64(b + 8);
        ge = load64(b + 16);
    }
    store8(load64(b) + gs, ch);
    store64(b + 8, gs + 1);
    buf_bump_version(b);
    return 0;
}

# Insert n bytes from src at the cursor. Returns the number written.
fn buf_insert(b, src, n) {
    var i = 0;
    while (i < n) {
        buf_insert_byte(b, load8(src + i));
        i = i + 1;
    }
    return n;
}

# Delete one byte to the LEFT of the cursor (backspace). Returns 1 if deleted, 0 if at start.
fn buf_delete_left(b) {
    var gs = load64(b + 8);
    if (gs == 0) { return 0; }
    store64(b + 8, gs - 1);
    buf_bump_version(b);
    return 1;
}

# Delete one byte to the RIGHT of the cursor (vim 'x'). Returns 1 if deleted, 0 if at end.
fn buf_delete_right(b) {
    var ge = load64(b + 16);
    var cap = load64(b + 24);
    if (ge >= cap) { return 0; }
    store64(b + 16, ge + 1);
    buf_bump_version(b);
    return 1;
}

# Drop all logical content. Allocation is preserved (the freelist allocator
# can't reclaim arbitrary blocks anyway); we just collapse the live region
# into the gap. Cursor returns to 0. Version bumps so cached tokenbufs
# invalidate.
fn buf_clear(b) {
    store64(b + 8, 0);
    store64(b + 16, load64(b + 24));
    buf_bump_version(b);
    return 0;
}

# Read entire file at `path` into the buffer at the current cursor.
# Returns bytes loaded on success, -1 if the file could not be opened.
# The buffer auto-grows; cursor advances past the inserted region.
fn buf_load_file(b, path) {
    var fd = file_open(path, O_RDONLY, 0);
    if (fd < 0) { return 0 - 1; }
    var chunk[4096];
    var total = 0;
    var go = 1;
    while (go == 1) {
        var n = file_read(fd, &chunk, 4096);
        if (n <= 0) { go = 0; }
        if (n > 0) {
            buf_insert(b, &chunk, n);
            total = total + n;
        }
    }
    file_close(fd);
    return total;
}

# ──── Line / column queries
# All positions are byte offsets into the logical buffer (0..buf_len).
# Lines are separated by '\n'; the trailing '\n' (if any) is the line
# terminator, not the start of a new line. An empty buffer has 1 line.

# Byte offset of the first byte of the line containing `pos`.
# Walks backward to the previous '\n' (exclusive) or 0.
fn buf_line_start(b, pos) {
    var i = pos;
    var done = 0;
    while (done == 0) {
        if (i == 0) { done = 1; }
        if (done == 0) {
            if (buf_get(b, i - 1) == 10) { done = 1; }
        }
        if (done == 0) { i = i - 1; }
    }
    return i;
}

# Byte offset of the last printable byte of the line containing `pos`,
# i.e. the byte just before the next '\n' or end-of-buffer. For an empty
# line (just '\n'), this equals `buf_line_start` — cursor stays put on $.
fn buf_line_end(b, pos) {
    var len = buf_len(b);
    var i = buf_line_start(b, pos);
    var end = i;
    var done = 0;
    while (done == 0) {
        if (end >= len) { done = 1; }
        if (done == 0) {
            if (buf_get(b, end) == 10) { done = 1; }
        }
        if (done == 0) { end = end + 1; }
    }
    if (end == i) { return i; }
    return end - 1;
}

# 0-indexed line number of the line containing `pos`. Counts '\n' bytes
# strictly before `pos`.
fn buf_line_of(b, pos) {
    var i = 0;
    var n = 0;
    while (i < pos) {
        if (buf_get(b, i) == 10) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# Total line count. Empty buffer == 1 line. Trailing '\n' is a terminator,
# not a new empty line.
fn buf_line_count(b) {
    var len = buf_len(b);
    if (len == 0) { return 1; }
    var i = 0;
    var n = 0;
    while (i < len) {
        if (buf_get(b, i) == 10) { n = n + 1; }
        i = i + 1;
    }
    if (buf_get(b, len - 1) == 10) {
        if (n == 0) { return 1; }
        return n;
    }
    return n + 1;
}

# Byte offset of the first byte of 0-indexed `line`. Clamps to the start
# of the last actual line if `line` exceeds `buf_line_count - 1`.
#
# Single forward pass: every '\n' marks the end of a line; the byte right
# after it is the start of the next line — but only if there *is* a byte
# right after it (otherwise that '\n' is just the terminator). We track
# the most recent valid line-start, return early on a match, and fall
# through to the tracked value if `line` is out of range.
fn buf_pos_of_line(b, line) {
    if (line <= 0) { return 0; }
    var len = buf_len(b);
    var i = 0;
    var seen = 0;
    var last_line_start = 0;
    while (i < len) {
        if (buf_get(b, i) == 10) {
            seen = seen + 1;
            if (i + 1 < len) {
                if (seen == line) { return i + 1; }
                last_line_start = i + 1;
            }
        }
        i = i + 1;
    }
    return last_line_start;
}

# Column of `pos` within its line (== pos - buf_line_start(pos)).
fn buf_col_of(b, pos) {
    return pos - buf_line_start(b, pos);
}

# Write exactly `len` bytes from `ptr` to `fd`, looping until done.
# Returns `len` on success, or a negative errno.
#
# ⭐ A bare `file_write` is NOT enough, and assuming otherwise cost cyim a
# silent-data-loss bug through v1.8.2 (audit F-1). write(2) is permitted to
# transfer FEWER bytes than asked and report that count as SUCCESS — under
# `ENOSPC`, under `RLIMIT_FSIZE`, or when a signal lands after a partial
# transfer. The pre-1.8.3 `buf_save_file` recorded the short count as
# `total` and returned it POSITIVE, so `:w` cleared the modified flag and
# `cyim --write` exited 0 while the file on disk had been truncated.
# Measured: a 575-byte `--batch` under `RLIMIT_FSIZE=100` exited 0 having
# destroyed 475 bytes.
#
# `w == 0` is treated as an error rather than retried: for a regular file
# with `len > 0` it means no forward progress, and looping on it hangs.
fn _buf_write_all(fd, ptr, len) {
    var off = 0;
    while (off < len) {
        var w = file_write(fd, ptr + off, len - off);
        if (w < 0)  { return w; }
        if (w == 0) { return 0 - 5; }   # -EIO: no forward progress
        off = off + w;
    }
    return off;
}

# ── Saving (ADR 0006: atomic by default, enumerated in-place fallback) ──
#
# 1.8.3 made a failing save REPORT the failure. It did not stop the failure
# destroying the file: the target was opened `O_TRUNC`, so by the time a write
# failed the original was already gone. 1.8.4 closes that (audit residual R-1).
#
# The default path writes a sibling temp and `rename(2)`s it over the target,
# which is atomic within a filesystem — a reader sees the whole old file or the
# whole new one, and a failure leaves the original untouched.
#
# It is NOT unconditional, because rename changes the inode, and for several
# ordinary files that is worse than the problem it solves.
# `_buf_save_can_rename` enumerates when to write in place instead; every
# condition is there because removing it breaks something a user relies on.
# See ADR 0006 for the reasoning and the rejected alternatives.

# Did the most recent `buf_save_file` take the atomic path?
#
# Exists because the two paths are indistinguishable from outside — same
# return value, same bytes on disk — so a test cannot otherwise assert WHICH
# one ran, and a silent fallback to the non-atomic path is exactly the kind of
# thing that rots unobserved. Not plugin ABI.
var _buf_save_atomic_last = 0;

fn buf_save_was_atomic() { return _buf_save_atomic_last; }

# Sibling temp path: "<path>.cyimtmp.<pid>.<counter>".
#
# A SIBLING, not something under /tmp: `rename` only works within one
# filesystem, and the target's own directory is the only place guaranteed to
# be on the same one.
#
# cyim grows its own rather than calling the stdlib's `_io_tmp_name`: that is
# an underscore-private of `lib/io.cyr`, and cyim has already paid once for
# depending on a neighbour's internals (darshana 0.7.0 renamed `tty_itoa` out
# from under `src/render.cyr`). The distinct `.cyimtmp.` infix also makes any
# temp left behind by a crash attributable at a glance.
var _buf_tmp_ctr = 0;

fn _buf_append_dec(buf, pos, val) {
    if (val < 0) { val = 0; }
    if (val == 0) {
        store8(buf + pos, 48);
        return pos + 1;
    }
    var tmp[24];
    var d = 0;
    while (val > 0) {
        store8(&tmp + d, 48 + val % 10);
        val = val / 10;
        d = d + 1;
    }
    var i = 0;
    while (i < d) {
        store8(buf + pos + i, load8(&tmp + d - 1 - i));
        i = i + 1;
    }
    return pos + d;
}

fn _buf_tmp_name(path) {
    var plen = strlen(path);
    var out = alloc(plen + 48);
    var i = 0;
    while (i < plen) { store8(out + i, load8(path + i)); i = i + 1; }
    var suffix = ".cyimtmp.";
    var j = 0;
    while (j < 9) { store8(out + plen + j, load8(suffix + j)); j = j + 1; }
    var pos = plen + 9;
    pos = _buf_append_dec(out, pos, sys_getpid());
    store8(out + pos, 46);   # '.'
    pos = pos + 1;
    _buf_tmp_ctr = _buf_tmp_ctr + 1;
    pos = _buf_append_dec(out, pos, _buf_tmp_ctr);
    store8(out + pos, 0);
    return out;
}

# Is `path` a symlink?
#
# `readlink(2)` answers -EINVAL for anything that is not one, and a byte count
# for one that is — so an 8-byte probe buffer is enough to ask the question
# without caring about the answer's content. Preferred over an lstat + S_IFLNK
# test because `xreadlink` is portable across every target cyim builds for,
# whereas bare `lstat` is x86_64-Linux-only (aarch64 has to go through
# `fstatat` + `AT_SYMLINK_NOFOLLOW`).
fn _buf_is_symlink(path) {
    var probe[8];
    if (xreadlink(path, &probe, 8) >= 0) { return 1; }
    return 0;
}

# May `path` be saved by rename? 1 = yes, 0 = write in place.
# The conditions, in ADR 0006's order.
fn _buf_save_can_rename(path) {
    # (6) agnos: no `fchmod`, no uid in its stat, and `xfsync` is a
    # whole-system `sync()`. A platform that cannot preserve the mode should
    # not be quietly resetting it.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # (1) Symlink — rename replaces the LINK, not its target. Editing a
    # dotfile that points into a dotfiles repo must not delete the link.
    if (_buf_is_symlink(path) == 1) { return 0; }

    var st[144];
    # No such file: nothing to preserve and nothing to destroy. Atomic is
    # strictly better — a failed create leaves no partial file behind.
    if (xstat(path, &st) != 0) { return 1; }

    # (3) Not a regular file — FIFO, device, /dev/stdout. Renaming over one
    # is meaningless at best.
    var mode = load32(&st + STAT_MODE);
    if ((mode & 0xF000) != 0x8000) { return 0; }

    # (2) Hardlinked — rename breaks the set and every other name silently
    # keeps the old content.
    if (load32(&st + STAT_NLINK) > 1) { return 0; }

    # (4) Owned by someone else — rename hands ownership to the writer.
    # Effective uid, because that is what the kernel stamps on a file this
    # process creates. Matters most under `sudo`, which is when it is least
    # welcome.
    if (load32(&st + STAT_UID) != sys_geteuid()) { return 0; }

    return 1;
    #endif
}

# Write both gap segments of `b` to an already-open `fd`. Returns the byte
# count, or a negative errno. Shared by both save paths.
fn _buf_write_segments(b, fd) {
    var data = load64(b);
    var gs = load64(b + 8);
    var ge = load64(b + 16);
    var cap = load64(b + 24);
    var total = 0;
    if (gs > 0) {
        var n1 = _buf_write_all(fd, data, gs);
        if (n1 < 0) { return n1; }
        total = total + n1;
    }
    var post_len = cap - ge;
    if (post_len > 0) {
        var n2 = _buf_write_all(fd, data + ge, post_len);
        if (n2 < 0) { return n2; }
        total = total + n2;
    }
    return total;
}

# fsync the directory containing `path`, so the rename itself survives a power
# loss rather than merely being atomic against concurrent readers.
#
# Best-effort by design: the caller ignores the result. The data is already
# fsynced and the rename has already happened, so failing an otherwise
# complete save because a directory could not be opened for fsync would trade
# a real success for a theoretical one. See ADR 0006 § Residuals.
fn _buf_fsync_parent(path) {
    var plen = strlen(path);
    var cut = 0 - 1;
    var i = 0;
    while (i < plen) {
        if (load8(path + i) == 47) { cut = i; }
        i = i + 1;
    }
    var dir = 0;
    if (cut < 0) {
        dir = ".";
    } else {
        var dlen = cut;
        if (dlen == 0) { dlen = 1; }        # "/foo" -> "/"
        dir = alloc(dlen + 1);
        var j = 0;
        while (j < dlen) { store8(dir + j, load8(path + j)); j = j + 1; }
        store8(dir + dlen, 0);
    }
    var dfd = file_open(dir, O_RDONLY, 0);
    if (dfd < 0) { return 0; }
    xfsync(dfd);
    file_close(dfd);
    return 0;
}

# Write in place: open O_TRUNC, write, fsync, close. 1.8.3's body.
#
# ⚠ A failure here leaves a TRUNCATED file — that is the whole reason
# `_buf_save_can_rename` exists to avoid this path when it can. The caller is
# told (negative return), but the damage is done. Reached only when renaming
# would break something the user cares about more; ADR 0006 § in-place
# conditions.
fn _buf_save_in_place(b, path) {
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    if (fd < 0) { return 0 - 1; }
    var total = _buf_write_segments(b, fd);
    if (total < 0) { file_close(fd); return total; }
    # Some filesystems (NFS most visibly) only surface a write error at fsync
    # or close, so reporting success before both have returned cleanly is
    # reporting a guess.
    if (xfsync(fd) < 0) { file_close(fd); return 0 - 5; }
    var cr = file_close(fd);
    if (cr < 0) { return cr; }
    return total;
}

# Write a sibling temp, then rename it over `path`.
#
# On ANY failure the temp is unlinked and the error returned — `path` is never
# opened for writing, so the original is bit-for-bit untouched.
#
# Takes the temp path and its ALREADY-OPEN fd, because the caller has to be
# the one that sees the create fail: a failed create is in-place condition (5)
# and must fall back, while every failure AFTER the create must report and
# leave the original alone. Folding both into one return value here is how the
# first draft of this function got it wrong — see `buf_save_file`.
fn _buf_save_atomic(b, path, tmp, fd) {
    # Carry the target's permission bits onto the temp BEFORE the rename, so
    # the file the user ends up with has the mode it started with rather than
    # the 0644 the create asked for. A brand-new file has no mode to inherit.
    #ifndef CYRIUS_TARGET_AGNOS
    var st[144];
    if (xstat(path, &st) == 0) {
        sys_fchmod(fd, load32(&st + STAT_MODE) & 0xFFF);
    }
    #endif

    var total = _buf_write_segments(b, fd);
    if (total < 0) { file_close(fd); xunlink(tmp); return total; }
    if (xfsync(fd) < 0) { file_close(fd); xunlink(tmp); return 0 - 5; }
    var cr = file_close(fd);
    if (cr < 0) { xunlink(tmp); return cr; }

    var rr = file_rename(tmp, path);
    if (rr < 0) { xunlink(tmp); return rr; }

    _buf_fsync_parent(path);
    return total;
}

# Write the buffer's logical content to `path`. Returns bytes written on
# success, or a NEGATIVE value on any failure — open, short/failed write,
# fsync, close, or rename.
#
# Every caller (`:w`, `:wq`, `cyim --write` / `--replace[-all]` / `--batch` /
# `--replace-files[-all]`, and the agnos line editor) tests `< 0`, so a
# failure here is what keeps the editor's modified flag set and makes the CLI
# exit non-zero. The return contract did not change at 1.8.4; no call site
# needed touching.
#
# Atomic by default (ADR 0006). `buf_save_was_atomic()` reports which path the
# last call took.
fn buf_save_file(b, path) {
    var go_atomic = _buf_save_can_rename(path);
    var tmp = 0;
    var fd = 0 - 1;

    if (go_atomic == 1) {
        tmp = _buf_tmp_name(path);
        # `O_EXCL` is load-bearing twice: it refuses to follow a pre-existing
        # temp (a stale one from a crashed run, or a planted symlink), and its
        # failure IS in-place condition (5) — a writable file in a
        # non-writable directory. Discovered by attempting the create rather
        # than by pre-checking the directory, because the pre-check would be
        # its own TOCTOU.
        fd = file_open(tmp, O_WRONLY | O_CREAT | O_EXCL, 0x1A4);
        if (fd < 0) { go_atomic = 0; }
    }

    if (go_atomic == 1) {
        _buf_save_atomic_last = 1;
        return _buf_save_atomic(b, path, tmp, fd);
    }

    # ⚠ ONLY a failed temp create reaches here from the atomic branch.
    # Falling back after a failed WRITE would be catastrophic — it would
    # re-open the target `O_TRUNC` and destroy exactly the content the atomic
    # path had just preserved. The first draft of this function did that.
    _buf_save_atomic_last = 0;
    return _buf_save_in_place(b, path);
}
