# window.cyr — window tree (leaf or split)
#
# A `Window` is either a LEAF (renders one buffer in its rect) or a
# SPLIT (two child Windows + a ratio dividing the rect). The shape is a
# binary tree; every interior node is either horizontal (top/bottom) or
# vertical (left/right). Splits never overlap and always cover their
# parent rect exactly — the layout pass computes each node's rect from
# the root rect and the per-node ratio in one recursive descent.
#
# Layout (88 B per Window):
#   off  0  type      i64  WIN_LEAF / WIN_SPLIT_H / WIN_SPLIT_V
#   off  8  buf_idx   i64  registry slot (LEAF) or unused (SPLIT)
#   off 16  child_a   i64  Window ptr — top (H-split) or left (V-split)
#   off 24  child_b   i64  Window ptr — bottom or right
#   off 32  ratio     i64  child_a's share, scaled out of 1000 (so 500 = 50/50)
#   off 40  rect_row  i64  populated by window_layout
#   off 48  rect_col  i64
#   off 56  rect_h    i64
#   off 64  rect_w    i64
#   off 72  parent    i64  parent Window* or 0 if root
#   off 80  top       i64  1.13.1 — first buffer line the leaf draws (its
#                          view). Kept in step with the cursor by the
#                          renderer and moved by the scroll keys. Unused on
#                          a split.
#
# Leaves have child_a / child_b == 0. Splits have buf_idx == -1 by
# convention (callers never read it on a split). Parent ptr lets
# `window_split_active` rewire a leaf into a split in O(1).

var WIN_LEAF    = 0;
var WIN_SPLIT_H = 1;
var WIN_SPLIT_V = 2;

var WIN_RATIO_FULL = 1000;     # denominator for split ratios

# ── Allocation

# Allocate a LEAF window showing buflist slot `buf_idx`. Children are 0, the
# rect is zeroed until `window_layout` runs, and the parent is 0 until the
# node is spliced into a split.
fn window_new_leaf(buf_idx) {
    var w = alloc(88);
    store64(w + 0,  WIN_LEAF);
    store64(w + 8,  buf_idx);
    store64(w + 16, 0);
    store64(w + 24, 0);
    store64(w + 32, 0);
    store64(w + 40, 0);
    store64(w + 48, 0);
    store64(w + 56, 0);
    store64(w + 64, 0);
    store64(w + 72, 0);
    store64(w + 80, 0);    # top — the view starts at line 0
    return w;
}

# Build a split holding `a` and `b` with `ratio_a` parts to the first
# child (out of WIN_RATIO_FULL). `type` is WIN_SPLIT_H or WIN_SPLIT_V.
# Sets the parent pointer on both children so subsequent rewires
# (further splits, leaf removal) can climb without a full tree search.
fn window_new_split(type, a, b, ratio_a) {
    var w = alloc(88);
    store64(w + 0,  type);
    store64(w + 8,  0 - 1);
    store64(w + 16, a);
    store64(w + 24, b);
    store64(w + 32, ratio_a);
    store64(w + 40, 0);
    store64(w + 48, 0);
    store64(w + 56, 0);
    store64(w + 64, 0);
    store64(w + 72, 0);
    store64(w + 80, 0);
    if (a != 0) { store64(a + 72, w); }
    if (b != 0) { store64(b + 72, w); }
    return w;
}

# ── Accessors

# ── Field accessors over the 80-byte Window record documented above.
# Rect fields are meaningless until `window_layout` has walked the tree.

# WIN_LEAF / WIN_SPLIT_H / WIN_SPLIT_V.
fn window_type(w)     { return load64(w + 0); }

# Buflist slot this leaf shows. ⚠ Meaningless on a SPLIT (-1 by convention).
fn window_buf_idx(w)  { return load64(w + 8); }

# First child of a split (top for H, left for V); 0 on a leaf.
fn window_child_a(w)  { return load64(w + 16); }

# Second child of a split (bottom for H, right for V); 0 on a leaf.
fn window_child_b(w)  { return load64(w + 24); }

# child_a's share of the split, out of WIN_RATIO_FULL (500 = 50/50).
fn window_ratio(w)    { return load64(w + 32); }

# Top row of this node's rect, 0-indexed. Set by `window_layout`.
fn window_rect_row(w) { return load64(w + 40); }

# Left column of this node's rect, 0-indexed. Set by `window_layout`.
fn window_rect_col(w) { return load64(w + 48); }

# Height of this node's rect in rows, status row included.
fn window_rect_h(w)   { return load64(w + 56); }

# Width of this node's rect in columns.
fn window_rect_w(w)   { return load64(w + 64); }

# Is `w` a leaf (as opposed to a split)? 1 / 0.
fn window_is_leaf(w)  {
    if (window_type(w) == WIN_LEAF) { return 1; }
    return 0;
}

# Point a leaf at a different buflist slot. Used by `:b` / `:e` to retarget
# the focused window without rebuilding the tree. A leaf that changes buffer
# starts its view at line 0; the next frame scrolls it to the cursor.
fn window_set_buf_idx(w, idx) {
    if (load64(w + 8) != idx) { store64(w + 80, 0); }
    store64(w + 8, idx);
    return 0;
}

# First buffer line this leaf draws. 0 on a fresh leaf.
fn window_view_top(w)         { return load64(w + 80); }

# Set the leaf's first drawn line. Callers keep it >= 0; the renderer
# re-clamps it to the cursor every frame.
fn window_set_view_top(w, t)  { store64(w + 80, t); return 0; }

# Text rows the leaf shows: its rect less the per-leaf status row, or the
# whole rect when it is a single row (as `_render_leaf` draws it). 0 before
# `window_layout` has run.
fn window_view_rows(w) {
    var h = window_rect_h(w);
    if (h >= 2) { return h - 1; }
    return h;
}

# Parent Window*, or 0 at the root. This is what lets `window_split_active`
# rewire a leaf into a split in O(1) instead of re-walking from the root.
fn window_parent(w)           { return load64(w + 72); }

# Set the parent pointer. Maintained by the split / close paths; a stale
# parent silently breaks upward navigation.
fn window_set_parent(w, p)    { store64(w + 72, p); return 0; }

# Rewire `parent`'s old child pointer (must be `old`) to `new`. Used
# when growing the tree by splitting a leaf in place.
fn window_replace_child(parent, old, new) {
    if (parent == 0) { return 0; }
    if (window_child_a(parent) == old) {
        store64(parent + 16, new);
        if (new != 0) { window_set_parent(new, parent); }
        return 0;
    }
    if (window_child_b(parent) == old) {
        store64(parent + 24, new);
        if (new != 0) { window_set_parent(new, parent); }
        return 0;
    }
    return 0 - 1;
}

# ── Layout pass

fn _window_set_rect(w, row, col, h, wd) {
    store64(w + 40, row);
    store64(w + 48, col);
    store64(w + 56, h);
    store64(w + 64, wd);
    return 0;
}

# Assign rects to every node in the subtree rooted at `w`. The supplied
# (row, col, h, wd) is the parent's allocation; for a leaf this is the
# whole rect, for a split it gets divided by `ratio` along the split axis.
#
# Splits clamp to a minimum of 1 row/col per side so a degenerate ratio
# never produces a zero-sized child — a child needing more space ends
# up with at least one row/col of display, which the render path can
# truncate gracefully.
fn window_layout(w, row, col, h, wd) {
    _window_set_rect(w, row, col, h, wd);
    var t = window_type(w);
    if (t == WIN_LEAF) { return 0; }

    var a = window_child_a(w);
    var b = window_child_b(w);
    var r = window_ratio(w);

    if (t == WIN_SPLIT_H) {
        var a_h = h * r / WIN_RATIO_FULL;
        if (a_h < 1)        { a_h = 1; }
        if (a_h > h - 1)    { a_h = h - 1; }
        window_layout(a, row,         col, a_h,     wd);
        window_layout(b, row + a_h,   col, h - a_h, wd);
        return 0;
    }
    if (t == WIN_SPLIT_V) {
        var a_w = wd * r / WIN_RATIO_FULL;
        if (a_w < 1)         { a_w = 1; }
        if (a_w > wd - 1)    { a_w = wd - 1; }
        window_layout(a, row, col,         h, a_w);
        window_layout(b, row, col + a_w,   h, wd - a_w);
        return 0;
    }
    return 0;
}

# ── Leaf iteration
# `out_leaves` is a vec to push leaf pointers into in left-to-right /
# top-to-bottom order (the natural depth-first traversal). Callers walk
# the result with vec_get / vec_len.

# Append every leaf under `w` to `out_leaves` in depth-first order, which is
# also the visual top-to-bottom / left-to-right order the window-nav commands
# and the render loop both rely on.
fn window_collect_leaves(w, out_leaves) {
    if (window_is_leaf(w) == 1) {
        vec_push(out_leaves, w);
        return 1;
    }
    window_collect_leaves(window_child_a(w), out_leaves);
    window_collect_leaves(window_child_b(w), out_leaves);
    return vec_len(out_leaves);
}

# Number of leaves under `w`. Recursive; used by the close path to decide
# whether the last window is being closed (which quits instead).
fn window_count_leaves(w) {
    if (window_is_leaf(w) == 1) { return 1; }
    return window_count_leaves(window_child_a(w))
    + window_count_leaves(window_child_b(w));
}

# Find the leaf containing the given (row, col). Returns 0 when the
# point falls outside `w`'s rect — useful when navigating with Ctrl-w
# h/j/k/l, which uses the active leaf's rect to compute a probe point.
fn window_leaf_at(w, row, col) {
    var rr = window_rect_row(w);
    var rc = window_rect_col(w);
    var rh = window_rect_h(w);
    var rw = window_rect_w(w);
    if (row < rr)         { return 0; }
    if (row >= rr + rh)   { return 0; }
    if (col < rc)         { return 0; }
    if (col >= rc + rw)   { return 0; }
    if (window_is_leaf(w) == 1) { return w; }
    var a = window_leaf_at(window_child_a(w), row, col);
    if (a != 0) { return a; }
    return window_leaf_at(window_child_b(w), row, col);
}

# ── Editor-state integration
# window_root and active_leaf live at editor offsets 88 / 96. These
# helpers keep the surface tidy and let buflist / command / render
# treat the tree as opaque.

# Root of the window tree, or 0 before `window_init` has run.
fn editor_window_root(s)        { return load64(s + 88); }

# The focused leaf. Rendered in reverse video; `:w` / motions apply to its
# buffer. Always a LEAF, never a split.
fn editor_active_leaf(s)        { return load64(s + 96); }

# Install the window-tree root. Callers are responsible for the tree being
# well-formed — nothing here validates it.
fn editor_set_window_root(s, w) { store64(s + 88, w); return 0; }

# Move focus to `w`. ⚠ Must be a leaf: the render and dispatch paths read
# `window_buf_idx` off it, which is meaningless on a split.
fn editor_set_active_leaf(s, w) { store64(s + 96, w); return 0; }

# Lazy-init: create a single LEAF root showing whatever buffer the
# editor's bl_active_index points at. Idempotent.
fn window_init(s) {
    if (editor_window_root(s) != 0) { return 0; }
    bl_init(s, editor_buf(s));
    var leaf = window_new_leaf(bl_active_index(s));
    editor_set_window_root(s, leaf);
    editor_set_active_leaf(s, leaf);
    return 0;
}

# Split the active leaf in place. Both halves show the same buf_idx;
# focus stays on the original leaf (now `child_a` of the new split).
# `type` is WIN_SPLIT_H or WIN_SPLIT_V; ratio defaults to a 50/50.
fn window_split_active(s, type) {
    window_init(s);
    var leaf = editor_active_leaf(s);
    if (leaf == 0)                       { return 0 - 1; }
    if (window_is_leaf(leaf) == 0)       { return 0 - 1; }
    var bidx = window_buf_idx(leaf);
    var sibling = window_new_leaf(bidx);
    # Both halves open on the same view; the renderer then clamps each to
    # its own, smaller, height.
    window_set_view_top(sibling, window_view_top(leaf));
    var parent = window_parent(leaf);
    var split = window_new_split(type, leaf, sibling, 500);
    if (parent == 0) {
        editor_set_window_root(s, split);
    } else {
        window_replace_child(parent, leaf, split);
    }
    return 0;
}

# Default rect used by window_apply when navigating before a render
# fires. Re-running layout on every navigation step is cheap (recursive
# pointer walk over a tree of <= a few dozen nodes) and keeps rects
# fresh after a fresh `:sp` / `:vsp` even if the user navigates before
# the next render.
var WIN_NAV_DEFAULT_ROWS = 23;   # term_rows - status row
var WIN_NAV_DEFAULT_COLS = 80;

# Move active focus to the leaf adjacent to the current one in the
# direction (dx, dy). Probe point = midpoint of the active leaf's
# rect side touching that direction. No-op if the probe falls outside
# the tree's rect (= we're at the edge with no neighbor).
fn window_navigate(s, dx, dy) {
    var root = editor_window_root(s);
    if (root == 0) { return 0; }
    window_layout(root, 0, 0, WIN_NAV_DEFAULT_ROWS, WIN_NAV_DEFAULT_COLS);
    var leaf = editor_active_leaf(s);
    if (leaf == 0) { return 0; }
    var rr = window_rect_row(leaf);
    var rc = window_rect_col(leaf);
    var rh = window_rect_h(leaf);
    var rw = window_rect_w(leaf);
    var probe_row = rr + rh / 2;
    var probe_col = rc + rw / 2;
    if (dx < 0) { probe_col = rc - 1; }
    if (dx > 0) { probe_col = rc + rw; }
    if (dy < 0) { probe_row = rr - 1; }
    if (dy > 0) { probe_row = rr + rh; }
    var target = window_leaf_at(root, probe_row, probe_col);
    if (target == 0)    { return 0; }
    if (target == leaf) { return 0; }
    bl_set_active(s, window_buf_idx(target));
    editor_set_active_leaf(s, target);
    return 0;
}

# ── Views (1.13.1)
#
# Through 1.13.0 there were none: every frame drew the buffer from line 0, and
# the cursor row was clamped to the last text row, so a cursor moved below the
# first screenful went on moving through the file while the screen stayed put.
# Nothing past the first screen of a file could be seen, with `j`, `G`, the
# arrows, or a mouse wheel (which terminals turn into arrow keys on the
# alternate screen).
#
# A view is a first line, `top`. Each window leaf has one, and so does the
# editor itself for the tree-less `render_frame` path. The renderer brings it
# into step with the cursor every frame (`view_follow`), and the scroll keys
# move it (`view_scroll`).

# How many text rows a view is assumed to have before one has been drawn:
# what a single window shows on a 24-row terminal (23 rows, less its status
# row). `--headless` never draws, so its Ctrl-d / Ctrl-f use this.
var VIEW_DEFAULT_ROWS = 22;

# The first line to draw so that cursor line `cur` is on screen, in a view of
# `h` rows whose first line was `top`. The view moves only when it must: up to
# the cursor's line when the cursor is above it, and just far enough to put
# the cursor on the bottom row when it is below. Vim's behaviour with
# `scrolloff=0`. Pure; `h` below 1 is taken as 1.
fn view_follow(top, cur, h) {
    var rows = h;
    if (rows < 1) { rows = 1; }
    var t = top;
    if (t < 0) { t = 0; }
    if (cur < t) { t = cur; }
    if (cur >= t + rows) { t = cur - rows + 1; }
    if (t < 0) { t = 0; }
    return t;
}

# The view the cursor is in: the active leaf's when a window tree exists,
# otherwise the editor's own single view.
fn editor_view_top(s) {
    var leaf = editor_active_leaf(s);
    if (leaf != 0) { return window_view_top(leaf); }
    return _editor_solo_top(s);
}

# Set the first line of the view `editor_view_top` reads.
fn editor_set_view_top(s, t) {
    var leaf = editor_active_leaf(s);
    if (leaf != 0) { return window_set_view_top(leaf, t); }
    return _editor_set_solo_top(s, t);
}

# Text rows of that view as last laid out, or VIEW_DEFAULT_ROWS when it has
# never been (no frame drawn yet, or `--headless`).
fn editor_view_rows(s) {
    var rows = 0;
    var leaf = editor_active_leaf(s);
    if (leaf != 0) { rows = window_view_rows(leaf); }
    if (leaf == 0) { rows = _editor_solo_rows(s); }
    if (rows < 1) { rows = VIEW_DEFAULT_ROWS; }
    return rows;
}

# Byte offset on line `line` at byte column `col`, clamped to the line's
# last byte, as `j` / `k` place the cursor.
fn _view_pos_on_line(b, line, col) {
    var ls = buf_pos_of_line(b, line);
    var le = buf_line_end(b, ls);
    var target = ls + col;
    if (target > le) { target = le; }
    return target;
}

# Apply one ACT_SCROLL_* action to the active view. Returns 1 if `action` was
# a scroll, 0 otherwise. The rules (keymap guide § Scrolling):
#   - Ctrl-e / Ctrl-y move the view one line. The view can scroll until the
#     last line is at the top.
#   - Ctrl-d / Ctrl-u move the view half its height and the cursor as far.
#     Ctrl-d stops scrolling once the last line is on the bottom row; the
#     cursor keeps going, so it always reaches the last line.
#   - Ctrl-f / Ctrl-b (and PgDn / PgUp) move the view its height less two
#     lines, so two lines of context stay on screen. Once the view cannot
#     move further, they take the cursor to the last or first line.
#   - Then the cursor is moved onto the screen if the scroll left it off,
#     keeping its byte column as `j` / `k` do.
# Forward scrolls never move the view backward, even after Ctrl-e has taken
# it past the point where the last line sits on the bottom row.
fn view_scroll(s, action) {
    if (_is_scroll_action(action) == 0) { return 0; }
    var b = editor_buf(s);
    if (b == 0) { return 1; }
    var h = editor_view_rows(s);
    var n = buf_line_count(b);
    var pos = buf_cursor(b);
    var cur = buf_line_of(b, pos);
    # The view as the next frame would draw it: no frame may have been drawn
    # since the cursor last moved (several keys in one read, `--headless`).
    var top = view_follow(editor_view_top(s), cur, h);
    var half = h / 2;
    if (half < 1) { half = 1; }
    var page = h - 2;
    if (page < 1) { page = 1; }

    var dt = 0;
    var dc = 0;
    var lim = n - 1;                      # Ctrl-e: until the last line is at the top
    if (action == ACT_SCROLL_LINE_DOWN) { dt = 1; }
    if (action == ACT_SCROLL_LINE_UP)   { dt = 0 - 1; }
    if (action == ACT_SCROLL_HALF_DOWN) { dt = half; dc = half; lim = n - h; }
    if (action == ACT_SCROLL_HALF_UP)   { dt = 0 - half; dc = 0 - half; }
    if (action == ACT_SCROLL_PAGE_DOWN) { dt = page; lim = n - h; }
    if (action == ACT_SCROLL_PAGE_UP)   { dt = 0 - page; }

    var nt = top + dt;
    if (dt > 0) {
        if (lim < top) { lim = top; }
        if (nt > lim) { nt = lim; }
    }
    if (nt < 0) { nt = 0; }

    var nc = cur + dc;
    if (nt == top) {
        if (action == ACT_SCROLL_PAGE_DOWN) { nc = n - 1; }
        if (action == ACT_SCROLL_PAGE_UP)   { nc = 0; }
    }
    # The cursor can sit one line past the last (INSERT after a final
    # newline); never pull it back up from there.
    var last = n - 1;
    if (cur > last) { last = cur; }
    if (nc > last) { nc = last; }
    if (nc < 0) { nc = 0; }
    if (nc < nt) { nc = nt; }
    if (nc > nt + h - 1) { nc = nt + h - 1; }

    editor_set_view_top(s, nt);
    if (nc != cur) {
        buf_move(b, _view_pos_on_line(b, nc, buf_col_of(b, pos)));
    }
    return 1;
}

# Top-level window-action handler. Returns 1 if the action was a window
# navigation or a scroll (so callers know it was consumed), 0 otherwise.
fn window_apply(s, action) {
    if (action == ACT_WIN_LEFT)  { window_navigate(s, 0 - 1, 0);     return 1; }
    if (action == ACT_WIN_RIGHT) { window_navigate(s,     1, 0);     return 1; }
    if (action == ACT_WIN_UP)    { window_navigate(s, 0, 0 - 1);     return 1; }
    if (action == ACT_WIN_DOWN)  { window_navigate(s, 0,     1);     return 1; }
    if (view_scroll(s, action) == 1) { return 1; }
    return 0;
}

# Descend a subtree to its first leaf via the child_a chain. Used to
# pick a focus target when a non-leaf becomes the new content of a
# slot — the user lands on the topmost / leftmost leaf of the subtree.
fn _window_first_leaf(w) {
    var cur = w;
    var done = 0;
    while (done == 0) {
        if (window_is_leaf(cur) == 1) { done = 1; }
        if (done == 0) { cur = window_child_a(cur); }
    }
    return cur;
}

# Close the active leaf. If it is the only leaf in the tree, set
# editor_quit so the main loop exits. Otherwise the leaf's parent
# split is replaced by the leaf's sibling, and active focus moves to
# the first leaf of that sibling subtree. The buffer registry is not
# touched — closed buffers remain accessible via :ls and :b N.
fn window_close_active(s) {
    var leaf = editor_active_leaf(s);
    if (leaf == 0) {
        editor_set_quit(s, 1);
        return 0;
    }
    var root = editor_window_root(s);
    if (leaf == root) {
        editor_set_quit(s, 1);
        return 0;
    }
    var parent = window_parent(leaf);
    var sibling = window_child_a(parent);
    if (sibling == leaf) { sibling = window_child_b(parent); }

    var grandparent = window_parent(parent);
    if (grandparent == 0) {
        editor_set_window_root(s, sibling);
        window_set_parent(sibling, 0);
    } else {
        window_replace_child(grandparent, parent, sibling);
    }

    var new_active = _window_first_leaf(sibling);
    bl_set_active(s, window_buf_idx(new_active));
    editor_set_active_leaf(s, new_active);
    return 0;
}
