# cyimrc.cyr — `.cyimrc` palette overrides (M2 surface)
#
# Parses a flat CYML file at `./.cyimrc` (cwd-relative for M2; XDG search
# paths come at M4 when the config surface widens to keymaps + tab width
# + line numbers per the roadmap).
#
# Recognised keys (one per line, `palette.<kind> = <ansi_code>`):
#   palette.ident
#   palette.keyword
#   palette.string
#   palette.number
#   palette.comment
#   palette.operator
#   palette.punctuation
#   palette.whitespace
#   palette.preprocessor
#   palette.error
#
# `<ansi_code>` is a 0..255 256-color index, or -1 to mean "no color"
# (terminal default). Unknown keys are silently ignored (forward-compat), and
# so are malformed values — which since 1.8.3 includes values OUTSIDE that
# range, not merely non-numeric ones. Through 1.8.2 the range was documented
# but unenforced, and the unchecked value reached the render escape writer;
# see `_cyimrc_palette_valid`. Comments start with `#`; blank lines OK.
#
# Lookup order in render.cyr:
#   1. cyimrc_palette(kind) — returns user override if loaded, else -1.
#   2. theme_token_color falls through to the bundled palette when (1)
#      returns -1, EXCEPT it can't tell apart "no override" from
#      "user explicitly set -1". Both surface as -1, which is the
#      same behaviour as the default for unstyled kinds — fine.
#
# Requires: stdlib (file_open / file_read / file_close / strlen / load8 /
#           store8 / store64 / alloc).

# Per-kind override storage: one slot per vyakarana TK_* kind.
#
# ⭐ 1.8.5: the COUNT is the load-bearing number and it now has a name.
# `_CYIMRC_PALETTE_SLOTS = 80` (the byte size) was declared and never
# referenced, while `_cyimrc_init` and `cyimrc_palette` both open-coded the
# literal `10` — so the bound that keeps `kind * 8` inside the array was a
# magic number in two places, and an eleventh token kind would have needed
# three separate edits to land safely. The byte-size constant is gone (a
# `var [N]` declaration needs a literal, so it could never be used); the
# COUNT is named and both bounds derive from it.
var _CYIMRC_PALETTE_COUNT = 10;
var _cyimrc_palette[80];   # == _CYIMRC_PALETTE_COUNT * 8
var _cyimrc_loaded = 0;

# Editor config values parsed from .cyimrc. -1 = not set in file (caller
# falls back to editor defaults). main.cyr reads these after `cyimrc_load()`
# and copies non-sentinel values into the editor state.
var _cyimrc_cfg_ignorecase   = 0 - 1;
var _cyimrc_cfg_line_numbers = 0 - 1;
var _cyimrc_cfg_tabstop      = 0 - 1;

fn _cyimrc_init() {
    if (_cyimrc_loaded == 1) { return 0; }
    var i = 0;
    while (i < _CYIMRC_PALETTE_COUNT) {
        store64(&_cyimrc_palette + i * 8, 0 - 1);
        i = i + 1;
    }
    _cyimrc_loaded = 1;
    return 0;
}

fn _cyimrc_is_ws(c) {
    if (c == 32) { return 1; }
    if (c == 9)  { return 1; }
    if (c == 13) { return 1; }
    return 0;
}

# Parse a signed integer from buf[s..e). Sentinel return -99999 on bad input.
#
# Digits are capped at 9 (audit F-5). Without the cap, `v = v * 10 + d` over a
# 25-digit run silently wraps i64 and lands on an arbitrary value — including
# one inside the range the caller then range-checks and accepts. A config value
# nobody could type on purpose should be REJECTED, not wrapped into a plausible
# one. 9 digits covers every value any cyimrc key can legitimately take by
# several orders of magnitude.
var _CYIMRC_MAX_DIGITS = 9;

fn _cyimrc_parse_int(buf, s, e) {
    if (s >= e) { return 0 - 99999; }
    var sign = 1;
    var p = s;
    if (load8(buf + p) == 45) { sign = 0 - 1; p = p + 1; }
    if (p >= e) { return 0 - 99999; }
    if (e - p > _CYIMRC_MAX_DIGITS) { return 0 - 99999; }
    var v = 0;
    while (p < e) {
        var c = load8(buf + p);
        if (c < 48) { return 0 - 99999; }
        if (c > 57) { return 0 - 99999; }
        v = v * 10 + (c - 48);
        p = p + 1;
    }
    return v * sign;
}

# Is `v` a legal 256-color palette code? `-1` means "no override / terminal
# default"; `0..255` is the xterm-256 index space. Anything else is rejected.
#
# ⭐ Audit F-2. This range check did not exist through v1.8.2, and the value
# flows to `_render_u16_ascii`, whose documented domain is 0..999 and whose
# 8-byte scratch is indexed DOWNWARD from 7 — so a 15-digit code drove the
# index to -8 (a stack write below the buffer) and made
# `_render_emit_fg` write 23 bytes where `render_build_line` had reserved 12,
# putting the render past the caller's `out_max`. Measured before the fix:
# `render_build_line(..., out_max=120)` returned pos=122.
#
# The value is attacker-influenced in a way ADR 0001 does not cover: `.cyimrc`
# is loaded from the CURRENT DIRECTORY, so it is the directory's input, not the
# invoking user's. See the 1.8.3 audit § ADR gap.
fn _cyimrc_palette_valid(v) {
    if (v == 0 - 1) { return 1; }
    if (v < 0)      { return 0; }
    if (v > 255)    { return 0; }
    return 1;
}

# Compare buf[ks..ke) byte-for-byte against a NUL-terminated literal.
fn _cyimrc_keyeq(buf, ks, ke, lit) {
    var n = ke - ks;
    var lit_len = strlen(lit);
    if (n != lit_len) { return 0; }
    var i = 0;
    while (i < n) {
        if (load8(buf + ks + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Does buf[ks..ke) name one of the ten `palette.*` keys? Used to decide
# whether the 256-color range check applies before the key dispatch below.
fn _cyimrc_key_is_palette(buf, ks, ke) {
    var n = ke - ks;
    var pre = "palette.";
    if (n <= 8) { return 0; }
    var i = 0;
    while (i < 8) {
        if (load8(buf + ks + i) != load8(pre + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Apply one parsed key=value pair into the palette slots. Unknown
# keys are silently ignored; bad values too (we already returned
# from _cyimrc_parse_int with the sentinel).
fn _cyimrc_apply(buf, ks, ke, vs, ve) {
    var v = _cyimrc_parse_int(buf, vs, ve);
    if (v == 0 - 99999) { return 0; }

    # Palette keys carry a 256-color index; out-of-range is dropped like any
    # other malformed value (audit F-2). Checked before the key dispatch so a
    # single guard covers all ten keys and cannot be forgotten when an
    # eleventh is added.
    if (_cyimrc_key_is_palette(buf, ks, ke) == 1) {
        if (_cyimrc_palette_valid(v) == 0) { return 0; }
    }

    if (_cyimrc_keyeq(buf, ks, ke, "palette.ident")        == 1) { store64(&_cyimrc_palette + 0 * 8, v); return 0; }
    if (_cyimrc_keyeq(buf, ks, ke, "palette.keyword")      == 1) { store64(&_cyimrc_palette + 1 * 8, v); return 0; }
    if (_cyimrc_keyeq(buf, ks, ke, "palette.string")       == 1) { store64(&_cyimrc_palette + 2 * 8, v); return 0; }
    if (_cyimrc_keyeq(buf, ks, ke, "palette.number")       == 1) { store64(&_cyimrc_palette + 3 * 8, v); return 0; }
    if (_cyimrc_keyeq(buf, ks, ke, "palette.comment")      == 1) { store64(&_cyimrc_palette + 4 * 8, v); return 0; }
    if (_cyimrc_keyeq(buf, ks, ke, "palette.operator")     == 1) { store64(&_cyimrc_palette + 5 * 8, v); return 0; }
    if (_cyimrc_keyeq(buf, ks, ke, "palette.punctuation")  == 1) { store64(&_cyimrc_palette + 6 * 8, v); return 0; }
    if (_cyimrc_keyeq(buf, ks, ke, "palette.whitespace")   == 1) { store64(&_cyimrc_palette + 7 * 8, v); return 0; }
    if (_cyimrc_keyeq(buf, ks, ke, "palette.preprocessor") == 1) { store64(&_cyimrc_palette + 8 * 8, v); return 0; }
    if (_cyimrc_keyeq(buf, ks, ke, "palette.error")        == 1) { store64(&_cyimrc_palette + 9 * 8, v); return 0; }

    # Editor config keys.
    if (_cyimrc_keyeq(buf, ks, ke, "ignorecase")   == 1) { _cyimrc_cfg_ignorecase   = v; return 0; }
    if (_cyimrc_keyeq(buf, ks, ke, "line_numbers") == 1) { _cyimrc_cfg_line_numbers = v; return 0; }
    if (_cyimrc_keyeq(buf, ks, ke, "tabstop")      == 1) { _cyimrc_cfg_tabstop      = v; return 0; }
    return 0;
}

# Public accessors for the config block. main.cyr applies these to
# the editor state right after `cyimrc_load()` returns; -1 means
# "not configured — leave the editor default in place".
fn cyimrc_cfg_ignorecase()   { return _cyimrc_cfg_ignorecase; }
fn cyimrc_cfg_line_numbers() { return _cyimrc_cfg_line_numbers; }
fn cyimrc_cfg_tabstop()      { return _cyimrc_cfg_tabstop; }

# Trim leading + trailing whitespace from buf[s..e), then split on the first
# `=`. Comment lines (`#` after trim) and lines without `=` are ignored.
fn _cyimrc_parse_line(buf, s, e) {
    while (s < e) {
        if (_cyimrc_is_ws(load8(buf + s)) == 0) { break; }
        s = s + 1;
    }
    while (e > s) {
        if (_cyimrc_is_ws(load8(buf + e - 1)) == 0) { break; }
        e = e - 1;
    }
    if (s >= e) { return 0; }
    if (load8(buf + s) == 35) { return 0; }   # '#' comment

    var eq = s;
    while (eq < e) {
        if (load8(buf + eq) == 61) { break; }
        eq = eq + 1;
    }
    if (eq >= e) { return 0; }

    var ke = eq;
    while (ke > s) {
        if (_cyimrc_is_ws(load8(buf + ke - 1)) == 0) { break; }
        ke = ke - 1;
    }
    if (ke <= s) { return 0; }

    var vs = eq + 1;
    while (vs < e) {
        if (_cyimrc_is_ws(load8(buf + vs)) == 0) { break; }
        vs = vs + 1;
    }
    if (vs >= e) { return 0; }

    _cyimrc_apply(buf, s, ke, vs, e);
    return 0;
}

# Load `.cyimrc` from `path`. Returns 1 on success (file existed and was
# parsed), 0 if the file is missing or empty. Idempotent on the slot
# table — re-loading just overwrites the previous values.
fn cyimrc_load_path(path) {
    _cyimrc_init();
    var fd = file_open(path, O_RDONLY, 0);
    if (fd < 0) { return 0; }
    var cap = 8192;
    var buf = alloc(cap);
    var total = 0;
    var go = 1;
    while (go == 1) {
        var got = file_read(fd, buf + total, cap - total);
        if (got <= 0) { go = 0; }
        if (got > 0) {
            total = total + got;
            if (total >= cap) { go = 0; }
        }
    }
    file_close(fd);
    if (total == 0) { return 0; }

    var ls = 0;
    var i = 0;
    while (i < total) {
        if (load8(buf + i) == 10) {
            _cyimrc_parse_line(buf, ls, i);
            ls = i + 1;
        }
        i = i + 1;
    }
    if (ls < total) { _cyimrc_parse_line(buf, ls, total); }
    return 1;
}

# Convenience: try `./.cyimrc`. (XDG paths come at M4 when the
# config surface broadens.)
fn cyimrc_load() {
    return cyimrc_load_path(".cyimrc");
}

# Look up the user-configured palette code for `kind`. Returns the
# stored value (-1 sentinel == "not overridden"). Render.cyr consults
# this first and falls back to the bundled default.
fn cyimrc_palette(kind) {
    if (_cyimrc_loaded == 0) { return 0 - 1; }
    if (kind < 0)                        { return 0 - 1; }
    if (kind >= _CYIMRC_PALETTE_COUNT)   { return 0 - 1; }
    return load64(&_cyimrc_palette + kind * 8);
}
