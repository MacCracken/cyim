# tty.cyr — cyim-internal raw-mode smoke
#
# v1.7.0: the bulk of this file's surface (termios bit-twiddling,
# `tty_raw` / `tty_cooked`, ANSI helpers, `tty_move` / `tty_dec_buf`) was
# extracted into the darshana TUI library — cyim was the primary
# donor. Consumers of those symbols continue to call them by their
# original names; the definitions just live in `lib/darshana.cyr`
# now (resolved by `[deps.darshana]` at build time, included before
# this file in `src/main.cyr`).
#
# What stays here: `tty_probe()` — a cyim-specific raw-mode round-
# trip that prints a banner, waits 50 ms via nanosleep, and restores
# cooked mode. Wired to `cyim --probe` so a developer can confirm
# the TTY module works end-to-end on the host. The probe message
# strings name "cyim" explicitly, so it isn't a fit for darshana
# (which is host-agnostic).

#ifdef CYRIUS_TARGET_LINUX

# Diagnostic probe: enter raw on stdin, write a banner, sleep ~50 ms
# via nanosleep, leave raw, restore cursor. Returns 0 on success or
# -1 if stdin is not a TTY. Calls `tty_raw` / `tty_cooked` from
# darshana's termios module.
fn tty_probe() {
    var rc = tty_raw(0);
    if (rc < 0) { return 0 - 1; }
    syscall(1, 1, "[cyim tty probe: raw mode active]\r\n", 35);
    # nanosleep(&{tv_sec=0, tv_nsec=50_000_000}, NULL)
    var ts[16];
    store64(&ts, 0);
    store64(&ts + 8, 50000000);
    syscall(35, &ts, 0);
    tty_cooked();
    syscall(1, 1, "[cyim tty probe: restored]\n", 27);
    return 0;
}

#endif

#ifdef CYRIUS_TARGET_AGNOS

# agnos peer. agnos has no termios raw mode — darshana's agnos `tty_raw`
# returns -1 because the kernel console runs its own line discipline, so
# the enter-raw / restore round-trip the Linux probe performs has nothing
# to toggle. Report the honest verdict (`syscall #1` = write on agnos too)
# and return -1, at parity with the Linux "stdin is not a TTY" failure
# path. When agnos grows a raw-input mechanism this becomes its real peer.
fn tty_probe() {
    syscall(1, 1, "[cyim tty probe: raw mode unavailable on agnos]\n", 48);
    return 0 - 1;
}

#endif
