# tty.cyr — raw-mode TTY for cyim (Linux kernel termios)
#
# Termios on/off via TCGETS/TCSETS ioctl. Alt-screen, cursor positioning,
# ANSI helpers. The cooked-mode termios captured at `tty_raw()` is held in
# a 60-byte module-global so any exit path can restore via `tty_cooked()`.
#
# Linux kernel termios layout (sizeof = 60 with trailing pad; 36 active
# bytes used). x86_64 and aarch64 Linux share this layout via
# asm-generic/termbits.h:
#
#   off  0  c_iflag   i32   input modes
#   off  4  c_oflag   i32   output modes
#   off  8  c_cflag   i32   control modes
#   off 12  c_lflag   i32   local modes
#   off 16  c_line     u8   line discipline
#   off 17  c_cc[19]   u8   special chars (VTIME @ 22, VMIN @ 23)
#
# macOS (BSD) termios is a different struct and is not yet supported —
# the ioctl wrappers gate to CYRIUS_TARGET_LINUX. The ANSI / cursor
# helpers below work on any vt100-compatible terminal, including macOS
# ttys, so the platform gate sits at the syscall boundary, not the file.

# Termios bit flags (asm-generic/termbits.h; matches x86_64 and aarch64 Linux).
var TIO_ECHO   = 0x008;
var TIO_ICANON = 0x002;
var TIO_ISIG   = 0x001;
var TIO_IEXTEN = 0x8000;
var TIO_ICRNL  = 0x100;
var TIO_IXON   = 0x400;
var TIO_OPOST  = 0x001;
var TIO_CSIZE  = 0x030;
var TIO_CS8    = 0x030;
var TIO_BRKINT = 0x002;
var TIO_INPCK  = 0x010;
var TIO_ISTRIP = 0x020;

# Special-char indices into c_cc[] (relative to start of c_cc, which sits at offset 17).
var TIO_CC_BASE  = 17;
var TIO_VTIME    = 5;
var TIO_VMIN     = 6;

# Termios buffer size. The kernel struct is 36 bytes active, but the ioctl
# write tolerates any size >= 36; 60 covers the historically padded variants
# without straddling a stack red-zone.
var TIO_BUF_SIZE = 60;

# Read 32-bit little-endian field at `off` inside `buf`.
fn tio_load32(buf, off) {
    var b0 = load8(buf + off);
    var b1 = load8(buf + off + 1);
    var b2 = load8(buf + off + 2);
    var b3 = load8(buf + off + 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

# Write 32-bit little-endian field at `off` inside `buf`.
fn tio_store32(buf, off, val) {
    store8(buf + off,     val & 0xFF);
    store8(buf + off + 1, (val >> 8) & 0xFF);
    store8(buf + off + 2, (val >> 16) & 0xFF);
    store8(buf + off + 3, (val >> 24) & 0xFF);
    return 0;
}

# Apply cyim's raw-mode flag mask in place to a 60-byte termios buffer.
# This is the bit-twiddling half of `tty_raw` extracted as a pure function
# so it can be unit-tested without owning a real TTY fd.
#
# Cleared:
#   c_iflag: BRKINT | ICRNL | INPCK | ISTRIP | IXON
#   c_oflag: OPOST              (post-processing off — \n stays \n)
#   c_lflag: ECHO | ICANON | IEXTEN | ISIG    (key-by-key, no signals)
# Set:
#   c_cflag: CS8                 (8-bit chars; CSIZE cleared first)
#   c_cc[VMIN]  = 1              (read returns after one byte)
#   c_cc[VTIME] = 0              (no read timeout)
#
# ISIG is cleared so Ctrl-C / Ctrl-Z reach cyim as bytes. Same convention vim uses.
fn tty_apply_raw_flags(buf) {
    var iflag = tio_load32(buf, 0);
    iflag = iflag & ~(TIO_BRKINT | TIO_ICRNL | TIO_INPCK | TIO_ISTRIP | TIO_IXON);
    tio_store32(buf, 0, iflag);

    var oflag = tio_load32(buf, 4);
    oflag = oflag & ~TIO_OPOST;
    tio_store32(buf, 4, oflag);

    var cflag = tio_load32(buf, 8);
    cflag = (cflag & ~TIO_CSIZE) | TIO_CS8;
    tio_store32(buf, 8, cflag);

    var lflag = tio_load32(buf, 12);
    lflag = lflag & ~(TIO_ECHO | TIO_ICANON | TIO_IEXTEN | TIO_ISIG);
    tio_store32(buf, 12, lflag);

    store8(buf + TIO_CC_BASE + TIO_VMIN, 1);
    store8(buf + TIO_CC_BASE + TIO_VTIME, 0);
    return 0;
}

#ifdef CYRIUS_TARGET_LINUX

var SYS_IOCTL = 16;
var TCGETS = 0x5401;
var TCSETS = 0x5402;

# Saved cooked-mode termios. Populated on `tty_raw`; consumed by `tty_cooked`.
var _tty_saved[60];
var _tty_in_raw = 0;

# Enter raw mode on `fd`. Saves the current termios for `tty_cooked` to restore.
# Returns 0 on success, -1 on ioctl failure (most often: fd is not a TTY).
# Idempotent: a second call while already raw is a no-op success.
fn tty_raw(fd) {
    if (_tty_in_raw == 1) { return 0; }
    var rc = syscall(SYS_IOCTL, fd, TCGETS, &_tty_saved);
    if (rc < 0) { return 0 - 1; }

    var work[60];
    var i = 0;
    while (i < 60) {
        store8(&work + i, load8(&_tty_saved + i));
        i = i + 1;
    }
    tty_apply_raw_flags(&work);

    var rc2 = syscall(SYS_IOCTL, fd, TCSETS, &work);
    if (rc2 < 0) { return 0 - 1; }
    _tty_in_raw = 1;
    return 0;
}

# Restore cooked mode from the saved termios. Idempotent.
fn tty_cooked(fd) {
    if (_tty_in_raw == 0) { return 0; }
    var rc = syscall(SYS_IOCTL, fd, TCSETS, &_tty_saved);
    if (rc < 0) { return 0 - 1; }
    _tty_in_raw = 0;
    return 0;
}

# Diagnostic probe: enter raw on stdin, write a banner, sleep ~50ms via a busy
# nanosleep, leave raw, restore cursor. Returns 0 on success or -1 if stdin is
# not a TTY. Wired to `cyim --probe` so a developer can confirm the module
# round-trips a real terminal end-to-end.
fn tty_probe() {
    var rc = tty_raw(0);
    if (rc < 0) { return 0 - 1; }
    syscall(1, 1, "[cyim tty probe: raw mode active]\r\n", 35);
    # nanosleep(&{tv_sec=0, tv_nsec=50_000_000}, NULL)
    var ts[16];
    store64(&ts, 0);
    store64(&ts + 8, 50000000);
    syscall(35, &ts, 0);
    tty_cooked(0);
    syscall(1, 1, "[cyim tty probe: restored]\n", 27);
    return 0;
}

#endif

# ANSI escape helpers — vt100-compatible, work on any modern terminal.
fn tty_alt_enter()   { syscall(1, 1, "\x1b[?1049h", 8); return 0; }
fn tty_alt_leave()   { syscall(1, 1, "\x1b[?1049l", 8); return 0; }
fn tty_clear()       { syscall(1, 1, "\x1b[2J", 4);     return 0; }
fn tty_cursor_hide() { syscall(1, 1, "\x1b[?25l", 6);   return 0; }
fn tty_cursor_show() { syscall(1, 1, "\x1b[?25h", 6);   return 0; }
fn tty_cursor_home() { syscall(1, 1, "\x1b[H", 3);      return 0; }

# Helper: write decimal `val` (>= 0) into `buf` at `pos`. Returns digits written.
# Single-digit zero is the only zero case; otherwise we collect digits in reverse
# and copy them back in order.
fn tty_itoa(buf, pos, val) {
    if (val <= 0) {
        store8(buf + pos, 0x30);
        return 1;
    }
    var tmp[20];
    var d = 0;
    while (val > 0) {
        store8(&tmp + d, 0x30 + (val % 10));
        val = val / 10;
        d = d + 1;
    }
    var i = 0;
    while (i < d) {
        store8(buf + pos + i, load8(&tmp + d - 1 - i));
        i = i + 1;
    }
    return d;
}

# Move cursor to (row, col), 1-indexed, via CSI row;colH.
fn tty_move(row, col) {
    var buf[32];
    store8(&buf, 0x1b);
    store8(&buf + 1, 0x5b);
    var pos = 2;
    pos = pos + tty_itoa(&buf, pos, row);
    store8(&buf + pos, 0x3b);
    pos = pos + 1;
    pos = pos + tty_itoa(&buf, pos, col);
    store8(&buf + pos, 0x48);
    pos = pos + 1;
    syscall(1, 1, &buf, pos);
    return 0;
}
