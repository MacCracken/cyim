# command.cyr — `:cmd` line: the COMMAND mode
#
# When `:` fires in NORMAL mode, the dispatcher emits ACT_TO_COMMAND. This
# module owns the cmdbuf (a separate gap-buffer hanging off the editor
# state) and grows it byte-by-byte as the user types. Enter parses + runs
# the command; Esc discards.
#
# Supported commands (M1 surface):
#   q        — quit if not modified, else last_error = ERR_DIRTY
#   q!       — quit unconditionally
#   w        — save to current file_path (last_error = ERR_NO_FILE_NAME if unset)
#   w <path> — save to <path>; updates current file_path
#   wq       — w then q
#   e <path> — load <path> into the main buffer (last_error = ERR_DIRTY if modified)
#
# Multi-byte ranges (`:1,5d`), search-replace (`:%s/x/y/`), tab-completion,
# and shell-out (`:!cmd`) are all out of scope for M1.
#
# Requires: src/buffer.cyr, src/mode.cyr (and stdlib alloc / io / strlen).

# Reset cmdbuf to empty. Called on entry to COMMAND mode and on cancel.
fn command_reset(s) {
    buf_clear(editor_cmdbuf(s));
    return 0;
}

# Hard cap on cmdbuf length. Audit F-3: prevents an attacker (or
# stuck key) from growing cmdbuf without bound, exhausting the
# bump allocator. 4 KB is well above any reasonable command line
# (longest realistic: `:w /very/long/path` < 256 bytes).
var COMMAND_MAX_LEN = 4096;

# Append one typed byte to the cmdbuf. Drops the byte (and emits a
# bell-equivalent status) once the cap is reached.
fn command_append(s, key) {
    var cb = editor_cmdbuf(s);
    if (buf_len(cb) >= COMMAND_MAX_LEN) {
        editor_set_status(s, "cmdline at max length (4 KB) — input dropped");
        return 0;
    }
    buf_insert_byte(cb, key);
    return 0;
}

# Backspace one byte from the cmdbuf. No-op if empty.
fn command_backspace(s) {
    var cb = editor_cmdbuf(s);
    if (buf_len(cb) > 0) { buf_delete_left(cb); }
    return 0;
}

# Compare bytes [start, end) of the cmdbuf against a NUL-terminated literal.
fn _cmd_eq(cb, start, end, lit) {
    var n = end - start;
    var lit_len = strlen(lit);
    if (n != lit_len) { return 0; }
    var i = 0;
    while (i < n) {
        if (buf_get(cb, start + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Copy cmdbuf bytes [start, start+len) into a freshly-allocated NUL-terminated
# heap cstr. Used to extract the path argument from the command line.
fn _cmd_arg_dup(cb, start, len) {
    var p = alloc(len + 1);
    var i = 0;
    while (i < len) {
        store8(p + i, buf_get(cb, start + i));
        i = i + 1;
    }
    store8(p + len, 0);
    return p;
}

# ─── Command implementations ─────────────────────────────────────────

fn _cmd_q(s) {
    if (editor_modified(s) == 1) {
        editor_set_last_error(s, ERR_DIRTY);
        return 0 - 1;
    }
    window_close_active(s);
    return 0;
}

fn _cmd_q_force(s) {
    window_close_active(s);
    return 0;
}

fn _cmd_w(s, cb, arg_start, arg_len) {
    var path = 0;
    if (arg_len > 0) {
        path = _cmd_arg_dup(cb, arg_start, arg_len);
        editor_set_file_path(s, path);
    } else {
        path = editor_file_path(s);
        if (path == 0) {
            editor_set_last_error(s, ERR_NO_FILE_NAME);
            return 0 - 1;
        }
    }
    var n = buf_save_file(editor_buf(s), path);
    if (n < 0) {
        editor_set_last_error(s, ERR_SAVE_FAILED);
        return 0 - 1;
    }
    editor_set_modified(s, 0);
    return 0;
}

fn _cmd_wq(s, cb, arg_start, arg_len) {
    var rc = _cmd_w(s, cb, arg_start, arg_len);
    if (rc < 0) { return rc; }
    window_close_active(s);
    return 0;
}

# Parse a non-negative decimal from cmdbuf[start..start+len). Returns
# the value, or -1 on empty / non-digit. Used by `:b N`.
fn _cmd_parse_uint(cb, start, len) {
    if (len <= 0) { return 0 - 1; }
    var v = 0;
    var i = 0;
    while (i < len) {
        var c = buf_get(cb, start + i);
        if (c < 48) { return 0 - 1; }
        if (c > 57) { return 0 - 1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

fn _cmd_bn(s) { bl_next(s); return 0; }
fn _cmd_bp(s) { bl_prev(s); return 0; }

fn _cmd_sp(s)  { window_split_active(s, WIN_SPLIT_H); return 0; }
fn _cmd_vsp(s) { window_split_active(s, WIN_SPLIT_V); return 0; }

# Match a NUL-terminated literal against cmdbuf bytes [start..start+len).
fn _cmd_arg_eq(cb, start, len, lit) {
    var lit_len = strlen(lit);
    if (len != lit_len) { return 0; }
    var i = 0;
    while (i < len) {
        if (buf_get(cb, start + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Parse a non-negative decimal from cmdbuf bytes [start..start+len).
# Returns -1 on empty / non-digit.
fn _cmd_arg_uint(cb, start, len) {
    if (len <= 0) { return 0 - 1; }
    var v = 0;
    var i = 0;
    while (i < len) {
        var c = buf_get(cb, start + i);
        if (c < 48) { return 0 - 1; }
        if (c > 57) { return 0 - 1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

# `:set <option>` — runtime config toggle. Recognised tokens:
#   ic / noic              ignorecase on/off (search case-fold)
#   number / nonumber      line_numbers on/off
#   tabstop=N              integer width
# Unknown options return ERR_UNKNOWN_CMD without changing state.
fn _cmd_set(s, cb, arg_start, arg_len) {
    if (arg_len <= 0) {
        editor_set_last_error(s, ERR_UNKNOWN_CMD);
        return 0 - 1;
    }
    if (_cmd_arg_eq(cb, arg_start, arg_len, "ic")        == 1) { editor_set_cfg_ignorecase(s, 1);   return 0; }
    if (_cmd_arg_eq(cb, arg_start, arg_len, "noic")      == 1) { editor_set_cfg_ignorecase(s, 0);   return 0; }
    if (_cmd_arg_eq(cb, arg_start, arg_len, "number")    == 1) { editor_set_cfg_line_numbers(s, 1); return 0; }
    if (_cmd_arg_eq(cb, arg_start, arg_len, "nonumber")  == 1) { editor_set_cfg_line_numbers(s, 0); return 0; }

    # tabstop=N
    if (arg_len >= 9) {
        if (buf_get(cb, arg_start + 0) == 116) {  # 't'
            if (buf_get(cb, arg_start + 1) == 97) {   # 'a'
                if (buf_get(cb, arg_start + 2) == 98) {   # 'b'
                    if (buf_get(cb, arg_start + 3) == 115) { # 's'
                        if (buf_get(cb, arg_start + 4) == 116) { # 't'
                            if (buf_get(cb, arg_start + 5) == 111) { # 'o'
                                if (buf_get(cb, arg_start + 6) == 112) { # 'p'
                                    if (buf_get(cb, arg_start + 7) == 61) {  # '='
                                        var n = _cmd_arg_uint(cb, arg_start + 8, arg_len - 8);
                                        if (n < 0) {
                                            editor_set_last_error(s, ERR_UNKNOWN_CMD);
                                            return 0 - 1;
                                        }
                                        editor_set_cfg_tabstop(s, n);
                                        return 0;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    editor_set_last_error(s, ERR_UNKNOWN_CMD);
    return 0 - 1;
}

# Static scratch for the :ls status string. Reused across calls so we
# don't leak a 4KB buffer per invocation. NUL-terminated.
var _CMD_LS_BUF_SIZE = 4096;
var _cmd_ls_buf[4096];

# Append a NUL-terminated cstr to _cmd_ls_buf at `pos`. Returns new pos.
fn _cmd_ls_put_cstr(pos, s) {
    var n = strlen(s);
    var i = 0;
    while (i < n) {
        if (pos + i + 1 < _CMD_LS_BUF_SIZE) {
            store8(&_cmd_ls_buf + pos + i, load8(s + i));
        }
        i = i + 1;
    }
    return pos + n;
}

fn _cmd_ls_put_byte(pos, c) {
    if (pos + 1 < _CMD_LS_BUF_SIZE) {
        store8(&_cmd_ls_buf + pos, c);
    }
    return pos + 1;
}

# Append decimal `val` (0..999, plenty for buffer indexes).
fn _cmd_ls_put_int(pos, val) {
    if (val <= 0) { return _cmd_ls_put_byte(pos, 48); }
    var tmp[16];
    var d = 0;
    while (val > 0) {
        store8(&tmp + d, 48 + val % 10);
        val = val / 10;
        d = d + 1;
    }
    var i = 0;
    while (i < d) {
        pos = _cmd_ls_put_byte(pos, load8(&tmp + d - 1 - i));
        i = i + 1;
    }
    return pos;
}

# `:ls` — render the buffer registry into _cmd_ls_buf and pin it as the
# editor's status message. Format per entry:
#     N[*]: path-or-[scratch] [+]?
# Active buffer marked with `*`; modified flag rendered as ` [+]`.
# Entries separated by ` | `. The active slot is consulted via the
# editor's live fields so the modified flag is fresh.
fn _cmd_ls(s) {
    bl_init(s, editor_buf(s));
    var n = bl_count(s);
    var active = bl_active_index(s);
    var pos = 0;
    var i = 0;
    while (i < n) {
        if (i > 0) {
            pos = _cmd_ls_put_cstr(pos, " | ");
        }
        pos = _cmd_ls_put_int(pos, i);
        if (i == active) {
            pos = _cmd_ls_put_byte(pos, 42);   # '*'
        }
        pos = _cmd_ls_put_cstr(pos, ": ");
        # Path (use live editor field for the active slot).
        var path = bl_path(s, i);
        if (i == active) { path = editor_file_path(s); }
        if (path == 0) {
            pos = _cmd_ls_put_cstr(pos, "[scratch]");
        } else {
            pos = _cmd_ls_put_cstr(pos, path);
        }
        # Modified flag (live for active slot).
        var modified = bl_modified(s, i);
        if (i == active) { modified = editor_modified(s); }
        if (modified == 1) {
            pos = _cmd_ls_put_cstr(pos, " [+]");
        }
        i = i + 1;
    }
    if (pos >= _CMD_LS_BUF_SIZE) { pos = _CMD_LS_BUF_SIZE - 1; }
    store8(&_cmd_ls_buf + pos, 0);
    editor_set_status(s, &_cmd_ls_buf);
    return 0;
}

fn _cmd_b(s, cb, arg_start, arg_len) {
    var n = _cmd_parse_uint(cb, arg_start, arg_len);
    if (n < 0) {
        editor_set_last_error(s, ERR_UNKNOWN_CMD);
        return 0 - 1;
    }
    var rc = bl_set_active(s, n);
    if (rc < 0) {
        editor_set_last_error(s, ERR_UNKNOWN_CMD);
        return 0 - 1;
    }
    return 0;
}

# Find an existing registry slot whose file_path matches `path`. Returns
# the slot index, or -1 if none. Used by `:e` to switch to an already-
# open file rather than re-loading.
fn _cmd_find_path(s, path) {
    var n = bl_count(s);
    var i = 0;
    while (i < n) {
        var p = bl_path(s, i);
        if (p != 0) {
            if (streq(p, path) == 1) { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# `:e <path>` — load `<path>` as a new buffer entry and switch the
# active window to it. Previous buffers stay in the registry; their
# modified state is preserved in their slot. If `<path>` is already
# open, switches to that slot without re-reading.
fn _cmd_e(s, cb, arg_start, arg_len) {
    if (arg_len <= 0) {
        editor_set_last_error(s, ERR_NO_FILE_NAME);
        return 0 - 1;
    }
    var path = _cmd_arg_dup(cb, arg_start, arg_len);

    bl_init(s, editor_buf(s));
    var existing = _cmd_find_path(s, path);
    if (existing >= 0) {
        bl_set_active(s, existing);
        var leaf_a = editor_active_leaf(s);
        if (leaf_a != 0) { window_set_buf_idx(leaf_a, existing); }
        return 0;
    }

    var nb = buf_new();
    var n = buf_load_file(nb, path);
    if (n < 0) {
        editor_set_last_error(s, ERR_FILE_NOT_FOUND);
        return 0 - 1;
    }
    buf_move(nb, 0);
    var idx = bl_add(s, nb, path);
    bl_set_active(s, idx);
    var leaf_b = editor_active_leaf(s);
    if (leaf_b != 0) { window_set_buf_idx(leaf_b, idx); }
    return 0;
}

# Parse the cmdbuf and run. Clears last_error on entry. Returns 0 on
# success, -1 on parse / execution failure (last_error is set in that case).
fn command_execute(s) {
    editor_set_last_error(s, ERR_NONE);
    var cb = editor_cmdbuf(s);
    var len = buf_len(cb);
    if (len == 0) { return 0; }

    # Split on first space: name = bytes before; args = bytes after.
    var name_end = len;
    var found = 0;
    var i = 0;
    while (i < len) {
        if (found == 0) {
            if (buf_get(cb, i) == 32) {
                name_end = i;
                found = 1;
            }
        }
        i = i + 1;
    }
    var arg_start = name_end;
    if (found == 1) { arg_start = name_end + 1; }
    var arg_len = len - arg_start;

    if (_cmd_eq(cb, 0, name_end, "q")  == 1) { return _cmd_q(s); }
    if (_cmd_eq(cb, 0, name_end, "q!") == 1) { return _cmd_q_force(s); }
    if (_cmd_eq(cb, 0, name_end, "w")  == 1) { return _cmd_w(s, cb, arg_start, arg_len); }
    if (_cmd_eq(cb, 0, name_end, "wq") == 1) { return _cmd_wq(s, cb, arg_start, arg_len); }
    if (_cmd_eq(cb, 0, name_end, "e")  == 1) { return _cmd_e(s, cb, arg_start, arg_len); }
    if (_cmd_eq(cb, 0, name_end, "bn")  == 1) { return _cmd_bn(s); }
    if (_cmd_eq(cb, 0, name_end, "bp")  == 1) { return _cmd_bp(s); }
    if (_cmd_eq(cb, 0, name_end, "b")   == 1) { return _cmd_b(s, cb, arg_start, arg_len); }
    if (_cmd_eq(cb, 0, name_end, "ls")  == 1) { return _cmd_ls(s); }
    if (_cmd_eq(cb, 0, name_end, "sp")  == 1) { return _cmd_sp(s); }
    if (_cmd_eq(cb, 0, name_end, "vsp") == 1) { return _cmd_vsp(s); }
    if (_cmd_eq(cb, 0, name_end, "set") == 1) { return _cmd_set(s, cb, arg_start, arg_len); }

    editor_set_last_error(s, ERR_UNKNOWN_CMD);
    return 0 - 1;
}

# Top-level COMMAND-action handler. Returns 1 if it consumed the action.
# ACT_TO_COMMAND fires the entry hook (clears cmdbuf); ACT_CMDLINE_*
# fires the corresponding cmdbuf op or the parser.
fn command_apply(s, action, key) {
    if (action == ACT_TO_COMMAND)        { command_reset(s);       return 1; }
    if (action == ACT_CMDLINE_APPEND)    { command_append(s, key); return 1; }
    if (action == ACT_CMDLINE_BACKSPACE) { command_backspace(s);   return 1; }
    if (action == ACT_CMDLINE_EXECUTE)   { command_execute(s);     return 1; }
    if (action == ACT_CMDLINE_CANCEL)    { command_reset(s);       return 1; }
    return 0;
}
