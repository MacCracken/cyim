# command.cyr — `:cmd` line: the COMMAND mode
#
# When `:` fires in NORMAL mode, the dispatcher emits ACT_TO_COMMAND. This
# module owns the cmdbuf (a separate gap-buffer hanging off the editor
# state) and grows it byte-by-byte as the user types. Enter parses + runs
# the command; Esc discards.
#
# Supported commands (M1 surface):
#   q        — quit if not modified, else last_error = ERR_DIRTY
#   q!       — quit unconditionally
#   w        — save to current file_path (last_error = ERR_NO_FILE_NAME if unset)
#   w <path> — save to <path>; updates current file_path
#   wq       — w then q
#   e <path> — load <path> into the main buffer (last_error = ERR_DIRTY if modified)
#
# Multi-byte ranges (`:1,5d`), search-replace (`:%s/x/y/`), tab-completion,
# and shell-out (`:!cmd`) are all out of scope for M1.
#
# Requires: src/buffer.cyr, src/mode.cyr (and stdlib alloc / io / strlen).

# Reset cmdbuf to empty. Called on entry to COMMAND mode and on cancel.
fn command_reset(s) {
    buf_clear(editor_cmdbuf(s));
    return 0;
}

# Append one typed byte to the cmdbuf.
fn command_append(s, key) {
    buf_insert_byte(editor_cmdbuf(s), key);
    return 0;
}

# Backspace one byte from the cmdbuf. No-op if empty.
fn command_backspace(s) {
    var cb = editor_cmdbuf(s);
    if (buf_len(cb) > 0) { buf_delete_left(cb); }
    return 0;
}

# Compare bytes [start, end) of the cmdbuf against a NUL-terminated literal.
fn _cmd_eq(cb, start, end, lit) {
    var n = end - start;
    var lit_len = strlen(lit);
    if (n != lit_len) { return 0; }
    var i = 0;
    while (i < n) {
        if (buf_get(cb, start + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Copy cmdbuf bytes [start, start+len) into a freshly-allocated NUL-terminated
# heap cstr. Used to extract the path argument from the command line.
fn _cmd_arg_dup(cb, start, len) {
    var p = alloc(len + 1);
    var i = 0;
    while (i < len) {
        store8(p + i, buf_get(cb, start + i));
        i = i + 1;
    }
    store8(p + len, 0);
    return p;
}

# ─── Command implementations ─────────────────────────────────────────

fn _cmd_q(s) {
    if (editor_modified(s) == 1) {
        editor_set_last_error(s, ERR_DIRTY);
        return 0 - 1;
    }
    editor_set_quit(s, 1);
    return 0;
}

fn _cmd_q_force(s) {
    editor_set_quit(s, 1);
    return 0;
}

fn _cmd_w(s, cb, arg_start, arg_len) {
    var path = 0;
    if (arg_len > 0) {
        path = _cmd_arg_dup(cb, arg_start, arg_len);
        editor_set_file_path(s, path);
    } else {
        path = editor_file_path(s);
        if (path == 0) {
            editor_set_last_error(s, ERR_NO_FILE_NAME);
            return 0 - 1;
        }
    }
    var n = buf_save_file(editor_buf(s), path);
    if (n < 0) {
        editor_set_last_error(s, ERR_SAVE_FAILED);
        return 0 - 1;
    }
    editor_set_modified(s, 0);
    return 0;
}

fn _cmd_wq(s, cb, arg_start, arg_len) {
    var rc = _cmd_w(s, cb, arg_start, arg_len);
    if (rc < 0) { return rc; }
    editor_set_quit(s, 1);
    return 0;
}

fn _cmd_e(s, cb, arg_start, arg_len) {
    if (arg_len <= 0) {
        editor_set_last_error(s, ERR_NO_FILE_NAME);
        return 0 - 1;
    }
    if (editor_modified(s) == 1) {
        editor_set_last_error(s, ERR_DIRTY);
        return 0 - 1;
    }
    var path = _cmd_arg_dup(cb, arg_start, arg_len);
    var b = editor_buf(s);
    buf_clear(b);
    var n = buf_load_file(b, path);
    if (n < 0) {
        editor_set_last_error(s, ERR_FILE_NOT_FOUND);
        return 0 - 1;
    }
    buf_move(b, 0);
    editor_set_file_path(s, path);
    editor_set_modified(s, 0);
    return 0;
}

# Parse the cmdbuf and run. Clears last_error on entry. Returns 0 on
# success, -1 on parse / execution failure (last_error is set in that case).
fn command_execute(s) {
    editor_set_last_error(s, ERR_NONE);
    var cb = editor_cmdbuf(s);
    var len = buf_len(cb);
    if (len == 0) { return 0; }

    # Split on first space: name = bytes before; args = bytes after.
    var name_end = len;
    var found = 0;
    var i = 0;
    while (i < len) {
        if (found == 0) {
            if (buf_get(cb, i) == 32) {
                name_end = i;
                found = 1;
            }
        }
        i = i + 1;
    }
    var arg_start = name_end;
    if (found == 1) { arg_start = name_end + 1; }
    var arg_len = len - arg_start;

    if (_cmd_eq(cb, 0, name_end, "q")  == 1) { return _cmd_q(s); }
    if (_cmd_eq(cb, 0, name_end, "q!") == 1) { return _cmd_q_force(s); }
    if (_cmd_eq(cb, 0, name_end, "w")  == 1) { return _cmd_w(s, cb, arg_start, arg_len); }
    if (_cmd_eq(cb, 0, name_end, "wq") == 1) { return _cmd_wq(s, cb, arg_start, arg_len); }
    if (_cmd_eq(cb, 0, name_end, "e")  == 1) { return _cmd_e(s, cb, arg_start, arg_len); }

    editor_set_last_error(s, ERR_UNKNOWN_CMD);
    return 0 - 1;
}

# Top-level COMMAND-action handler. Returns 1 if it consumed the action.
# ACT_TO_COMMAND fires the entry hook (clears cmdbuf); ACT_CMDLINE_*
# fires the corresponding cmdbuf op or the parser.
fn command_apply(s, action, key) {
    if (action == ACT_TO_COMMAND)        { command_reset(s);       return 1; }
    if (action == ACT_CMDLINE_APPEND)    { command_append(s, key); return 1; }
    if (action == ACT_CMDLINE_BACKSPACE) { command_backspace(s);   return 1; }
    if (action == ACT_CMDLINE_EXECUTE)   { command_execute(s);     return 1; }
    if (action == ACT_CMDLINE_CANCEL)    { command_reset(s);       return 1; }
    return 0;
}
