# render.cyr — TTY rendering for cyim's main loop
#
# Bite 8 ships the minimum viable display: clear screen, draw lines into
# a scratch buffer, flush per line, draw a single status row at the
# bottom, position the cursor.
#
# M2 layer (this revision):
#   - Token-kind palette via `theme_token_color(kind)` — 256-color ANSI
#     index per vyakarana TK_* kind, or -1 for "no color".
#   - `render_build_line(b, line, cols, tb, out, max)` materializes one
#     line — colored when `tb != 0`, plain when `tb == 0` — into a
#     caller-provided buffer. Tests inspect the bytes directly.
#   - `render_line` is the syscall-flushing wrapper.
#   - `render_frame(s, rows, cols, tb)` threads the tokenbuf through.
#     The caller (main.cyr in M2.5) is responsible for retokenizing per
#     frame; this module assumes `tb` is already current.
#
# Requires: src/buffer.cyr, src/mode.cyr, src/tty.cyr, plus
#           src/highlight.cyr + dist/vyakarana.cyr when the caller
#           passes a non-null tokenbuf.

# Per-line output buffer. Sized to comfortably hold an 80-col line plus
# CR/LF. A line longer than this is truncated visually — content is
# unaffected, only the display is.
# ⚠ A `var buf[N]` declaration needs a literal, so the size is written twice:
# here, and at each declaration site. THIS constant is the one every *bound*
# must be expressed in — passing a bare `8192` as `out_max` was the 1.8.5
# finding, because it left `RENDER_LINE_BUF` unreferenced and let the
# declaration shrink without the bound following it.
var RENDER_LINE_BUF = 8192;

# Sizes of the two fixed render scratch buffers whose write bound used to be
# terminal geometry rather than the buffer itself (audit F-3). Declared as
# constants so the guard and the declaration cannot drift apart.
var RENDER_CMDLINE_BUF = 2048;
var RENDER_STATUS_BUF  = 1024;

# ── Token palette
# Maps a vyakarana TK_* kind to a 256-color ANSI index. Returns -1
# for "no color" — caller skips the foreground escape and (if a color
# was active) emits a reset on the transition.
#
# Resolution order:
#   1. .cyimrc override (cyimrc_palette) if loaded and the kind has a
#      user-set value (>= 0). User-set -1 falls through to default.
#   2. Bundled default below. Whitespace, ident, and punctuation stay
#      unstyled so plain text reads as plain text.
fn theme_token_color(kind) {
    var override = cyimrc_palette(kind);
    if (override >= 0) { return override; }
    if (kind == 0) { return 0 - 1; } # ident
    if (kind == 1) { return 141; }   # keyword      — purple
    if (kind == 2) { return 113; }   # string       — green
    if (kind == 3) { return 215; }   # number       — orange
    if (kind == 4) { return 245; }   # comment      — grey
    if (kind == 5) { return 110; }   # operator     — steel blue
    if (kind == 6) { return 0 - 1; } # punctuation
    if (kind == 7) { return 0 - 1; } # whitespace
    if (kind == 8) { return 221; }   # preprocessor — yellow
    if (kind == 9) { return 196; }   # error        — bright red
    return 0 - 1;
}

# Write the `\e[38;5;Nm` foreground escape for 256-colour index `code` into
# `buf` at `off`. Returns the bytes written: 9–11, or 0 — writing NOTHING —
# when `code` is outside [0, 255].
#
# ⭐ BUG-006, fixed at 1.11.0 by delegating to darshana's `tty_fg_256_buf`.
# Through 1.10.1 this composed the escape by hand, with `_render_u16_ascii`
# clamping the index to 999 — the clamp that made the 1.8.3 audit's F-2
# 12-byte reservation true, but not the domain: an index of 256–999 went out
# as `\e[38;5;999m`, a sequence no terminal defines. darshana validates
# [0, 255] and fails before emitting, so an invalid index now produces no
# escape at all and the caller draws that token uncoloured. 11 bytes is the
# most it writes, inside the 12 `render_build_line_naked` reserves. Latent: an
# out-of-range index needs a palette value `_cyimrc_palette_valid` already
# refuses, so this is the sink-side half of that check.
fn _render_emit_fg(buf, off, code) {
    var np = tty_fg_256_buf(buf, off, code);
    if (np < 0) { return 0; }
    return np - off;
}

# Materialize line `line` into `out` (caller-provided buffer of `out_max`
# bytes), CRLF-terminated. Returns total bytes written.
#
# ⭐ A thin wrapper over `render_build_line_naked` since 1.8.7. The two were
# 94% identical — 73 and 69 code lines differing only in the tail reservation
# and the two CRLF bytes — and that duplication was load-bearing in the worst
# way: the 1.8.3 audit had to apply the SAME bounds fix to both copies, and a
# future fix landing in only one would be invisible until something overran.
# The bounds arithmetic now exists once.
#
# The reservation still works out identically. `_naked` reserves 4 bytes for
# the colour reset out of whatever budget it is given; handing it `out_max - 2`
# reserves the CRLF on top, so its internal cap is `out_max - 6` — exactly what
# this function computed for itself before.
fn render_build_line(b, line, cols, tb, out, out_max) {
    var pos = render_build_line_naked(b, line, cols, tb, out, out_max - 2);
    if (pos < 0) { pos = 0; }
    # Guarded, unlike the pre-1.8.7 unconditional append: an `out_max` under 2
    # left no room for the terminator and wrote past the buffer anyway. Not
    # reachable from any caller (the two are 1024 and 8192), and cheaper to
    # close than to keep reasoning about.
    if (pos + 2 <= out_max) {
        store8(out + pos, 13);
        store8(out + pos + 1, 10);
        pos = pos + 2;
    }
    return pos;
}

# Decide whether `c` is a control byte that needs ^X substitution
# (security audit F-1: prevents terminal escape injection from
# buffer content). Returns:
#    0           — no substitution; emit `c` verbatim (1 col)
#    `b` (>0)    — substitute as `^b` (2 cols); caller writes '^' then b
# Tab (9) is preserved. LF (10) never reaches this path — the line
# iterator stops at line_end, before the terminator.
#
# C0 and DEL only. C1 controls (0x80–0x9F) cannot be decided one byte at a
# time — the same bytes are UTF-8 continuation bytes — so they are handled by
# `render_c1_at`, which reads the sequence around them.
fn render_ctrl_substitute(c) {
    if (c == 9)   { return 0; }                  # Tab — keep
    if (c < 32)   { return c + 64; }             # 0x00..0x1F (except Tab) -> ^@..^_
    if (c == 127) { return 63; }                 # DEL -> ^?
    return 0;
}

# Length of the well-formed UTF-8 sequence starting at buffer offset `i` of
# `b` (a byte >= 0x80), reading nothing past offset `le` — 2, 3 or 4 — or 0
# if the bytes there are not one. RFC 3629 §4, the table darshana's
# `tty_sanitize_buf` uses: each lead byte fixes the length AND the range of
# its second byte, which is what excludes overlong forms (E0 80–9F,
# F0 80–8F), surrogates (ED A0–BF) and code points past U+10FFFF (F4 90–BF,
# F5–FF). 80–BF are continuation bytes and C0 / C1 never valid leads.
fn _render_utf8_len(b, i, le) {
    var c = buf_get(b, i);
    var n = 0;
    var lo = 0x80;
    var hi = 0xBF;
    if (c >= 0xC2) { if (c <= 0xDF) { n = 2; } }
    if (c == 0xE0) { n = 3; lo = 0xA0; }
    if (c >= 0xE1) { if (c <= 0xEC) { n = 3; } }
    if (c == 0xED) { n = 3; hi = 0x9F; }
    if (c >= 0xEE) { if (c <= 0xEF) { n = 3; } }
    if (c == 0xF0) { n = 4; lo = 0x90; }
    if (c >= 0xF1) { if (c <= 0xF3) { n = 4; } }
    if (c == 0xF4) { n = 4; hi = 0x8F; }
    if (n == 0) { return 0; }
    if (i + n - 1 > le) { return 0; }            # cut off by the end of the line
    var c1 = buf_get(b, i + 1);
    if (c1 < lo) { return 0; }
    if (c1 > hi) { return 0; }
    var k = 2;
    while (k < n) {
        var ck = buf_get(b, i + k);
        if (ck < 0x80) { return 0; }
        if (ck > 0xBF) { return 0; }
        k = k + 1;
    }
    return n;
}

# Classify the byte at offset `i` of `b` (>= 0x80; the line ends at `le`) for
# display. Returns:
#    0     — part of well-formed, non-C1 UTF-8, or a malformed byte that is
#            not a C1 control: emit verbatim, as before 1.11.0
#    > 0   — the sequence is `n` bytes of well-formed UTF-8 to emit verbatim,
#            encoded as `n` (2–4) so the caller can pass the tail through
#    < 0   — a C1 CONTROL: `-(code)` for code 0x80–0x9F, and the caller shows
#            it as `<xx>`. Raw (one byte) when `code` is the byte itself;
#            UTF-8-encoded (`C2 80`–`C2 9F`, two bytes) otherwise.
#
# ⭐ BUG-005, fixed at 1.11.0. Through 1.10.1 every byte >= 0x80 went out
# verbatim, so a file could carry 8-bit C1 controls — CSI (0x9B), OSC
# (0x9D), DCS (0x90), ST (0x9C), raw or encoded — straight to the terminal:
# the escape-injection class audit F-1 closed for C0 only. Architecture note
# 003 explains why it was left open: 0x80–0x9F are also UTF-8 continuation
# bytes, so a byte-at-a-time check would mangle every non-ASCII file. This
# decides it by DECODING — the rule darshana's `tty_sanitize_buf` applies in
# TTY_SANITIZE_UTF8 mode — so well-formed text is untouched byte for byte.
fn render_c1_at(b, i, le) {
    var c = buf_get(b, i);
    var n = _render_utf8_len(b, i, le);
    if (n == 2) {
        if (c == 0xC2) {
            var c1 = buf_get(b, i + 1);
            if (c1 < 0xA0) { return 0 - c1; }    # encoded C1, U+0080–U+009F
        }
    }
    if (n >= 2) { return n; }
    if (c < 0xA0) { return 0 - c; }              # raw C1 / stray continuation 80–9F
    return 0;                                    # malformed A0–FF: not a control
}

# Lowercase hex digit for 0..15.
fn _render_hexdig(v) {
    if (v < 10) { return 48 + v; }
    return 87 + v;
}

# Same as render_build_line but WITHOUT the trailing CRLF. Multi-window
# rendering uses this so each leaf places its lines via tty_move rather
# than relying on terminal autowrap.
fn render_build_line_naked(b, line, cols, tb, out, out_max) {
    var ls = buf_pos_of_line(b, line);
    var le = buf_line_end(b, ls);
    var blen = buf_len(b);
    var pos = 0;
    var current_kind = 0 - 1;
    var has_active_color = 0;
    var byte_cap = out_max - 4;
    if (byte_cap < 0) { byte_cap = 0; }
    if (blen > 0) {
        var skip_line = 0;
        if (le == ls) {
            var c0 = buf_get(b, ls);
            if (c0 == 10) { skip_line = 1; }
        }
        if (skip_line == 0) {
            var i = ls;
            var col = 0;
            var u8_rem = 0;
            while (i <= le) {
                if (col < cols) {
                    var c = buf_get(b, i);
                    var kind = 7;
                    if (tb != 0) { kind = highlight_kind_at(tb, i); }
                    if (tb != 0) {
                        if (kind != current_kind) {
                            var color = theme_token_color(kind);
                            if (color >= 0) {
                                if (pos + 12 <= byte_cap) {
                                    var w = _render_emit_fg(out, pos, color);
                                    if (w > 0) {
                                        pos = pos + w;
                                        has_active_color = 1;
                                    }
                                    # w == 0: an index darshana refused
                                    # (BUG-006). Draw uncoloured — and drop
                                    # the previous token's colour rather than
                                    # let it run on into this one.
                                    if (w == 0) {
                                        if (has_active_color == 1) {
                                            pos = tty_sgr_reset_buf(out, pos);
                                            has_active_color = 0;
                                        }
                                    }
                                }
                            } else {
                                if (has_active_color == 1) {
                                    if (pos + 4 <= byte_cap) {
                                        pos = tty_sgr_reset_buf(out, pos);
                                        has_active_color = 0;
                                    }
                                }
                            }
                            current_kind = kind;
                        }
                    }
                    # BUG-005: classify bytes >= 0x80 by decoding. `u8_rem`
                    # counts the continuation bytes of a sequence already
                    # validated at its lead; they go out verbatim.
                    var c1 = 0;
                    if (u8_rem > 0) {
                        u8_rem = u8_rem - 1;
                    } else {
                        if (c >= 128) {
                            var cls = render_c1_at(b, i, le);
                            if (cls > 0) { u8_rem = cls - 1; }
                            if (cls < 0) { c1 = 0 - cls; }
                        }
                    }
                    var sub = render_ctrl_substitute(c);
                    if (c1 != 0) {
                        # A C1 control — shown as `<xx>`, vim's display for
                        # these code points: 4 visual cols, 4 bytes. The
                        # encoded form is two bytes; step past the second.
                        if (col + 3 < cols) {
                            if (pos + 4 <= byte_cap) {
                                store8(out + pos, 60);
                                store8(out + pos + 1, _render_hexdig(c1 >> 4));
                                store8(out + pos + 2, _render_hexdig(c1 & 15));
                                store8(out + pos + 3, 62);
                                pos = pos + 4;
                            }
                            col = col + 4;
                        }
                        if (c1 != c) { i = i + 1; }
                    }
                    if (c1 == 0) {
                        if (sub != 0) {
                            # ^X substitution — 2 visual cols, 2 bytes.
                            # Audit F-1 — prevents terminal escape injection
                            # from buffer bytes echoing as control sequences.
                            if (col + 1 < cols) {
                                if (pos + 2 <= byte_cap) {
                                    store8(out + pos, 94);
                                    store8(out + pos + 1, sub);
                                    pos = pos + 2;
                                }
                                col = col + 2;
                            }
                        } else {
                            if (pos < byte_cap) {
                                store8(out + pos, c);
                                pos = pos + 1;
                            }
                            col = col + 1;
                        }
                    }
                }
                i = i + 1;
            }
        }
    }
    if (has_active_color == 1) {
        pos = tty_sgr_reset_buf(out, pos);
    }
    return pos;
}

# Draw line `line` (0-indexed) into stdout. Plain when `tb == 0`,
# highlighted when `tb` is a vyakarana tokenbuf. Truncates visual width
# at `cols`.
fn render_line(b, line, cols, tb) {
    var out[8192];   # must equal RENDER_LINE_BUF — see its declaration
    var n = render_build_line(b, line, cols, tb, &out, RENDER_LINE_BUF);
    syscall(1, 1, &out, n);
    return 0;
}

# ── Untrusted text outside the buffer (v1.11.0) ────────────
#
# Audit F-1 and BUG-005 keep buffer CONTENT from reaching the terminal as
# control sequences. Everything else the status row and the picker print was
# written raw through 1.10.1, and most of it is not cyim's text either: the
# file path (argv, `:e`, an LSP URI), status messages that quote it, plugin
# status segments, and the `:lsp-find-refs` picker — whose rows carry a
# PREVIEW of a line from another file on disk. A file named
# `$'x\e]0;owned\a'`, or a referenced line holding `\e]52;…`, ran its escape.
#
# These go through darshana's `tty_sanitize_buf` in UTF-8 mode: every C0
# byte, DEL, C1 control (raw or UTF-8-encoded) and malformed UTF-8 byte
# becomes one `?`, and well-formed text passes unchanged. `?`, not the
# buffer's `^X` caret notation: these are labels, not text being edited, and
# the one-for-one replacement keeps the column arithmetic below exact.

# Chunk size for `_render_write_safe`'s stack scratch.
var RENDER_SAFE_CHUNK = 256;

# Write `len` bytes of untrusted text at `src` to fd 1, sanitized as above.
# Returns the number of bytes written (at most `len`).
fn _render_write_safe(src, len) {
    var out[256];                       # must equal RENDER_SAFE_CHUNK
    var off = 0;
    var total = 0;
    while (off < len) {
        var take = len - off;
        if (take > RENDER_SAFE_CHUNK) {
            take = RENDER_SAFE_CHUNK;
            # Never cut a UTF-8 sequence across two chunks — each half would
            # be malformed on its own and come out as `?`. Back up to the lead
            # byte (at most 3; a run of continuation bytes that long is
            # malformed anyway, so the cut stands).
            var back = 0;
            while (back < 3) {
                if ((load8(src + off + take) & 0xC0) == 0x80) {
                    take = take - 1;
                    back = back + 1;
                } else {
                    back = 3;
                }
            }
        }
        var n = tty_sanitize_buf(&out, 0, src + off, take, TTY_SANITIZE_UTF8, 0);
        if (n > 0) {
            syscall(1, 1, &out, n);
            total = total + n;
        }
        off = off + take;
    }
    return total;
}

# Render `<prefix><cmdbuf>` into the status row. Used by COMMAND, SEARCH,
# and SEARCH_BACK — all three have the same shape, only the prefix
# byte differs (`:` / `/` / `?`). Truncates the cmdbuf at `cols - 1`
# so the prefix always fits.
fn _render_cmdline(s, prefix_byte, cols) {
    var pbuf[1];
    store8(&pbuf, prefix_byte);
    syscall(1, 1, &pbuf, 1);
    var cb = editor_cmdbuf(s);
    var clen = buf_len(cb);
    var line[2048];
    # ⭐ Audit F-3. The write bound is min(terminal width, OUR buffer), not
    # the terminal width alone. `cols` is external data — on agnos it is
    # whatever `winsize#60` reports, and on Linux it becomes external the day
    # `tty_winsize` is wired for resize support (a roadmap item). `ws_col` is
    # a u16, so a terminal is free to claim 65535 columns; bounding a
    # 2048-byte stack buffer by that value alone is a ~63 KB stack overflow
    # waiting for the feature that supplies it. Latent, not live, at 1.8.3 —
    # `scr_cols` is a hardcoded 80 on Linux/macOS — and fixed here so it
    # cannot become live by accident.
    var cap = cols - 1;
    if (cap > RENDER_CMDLINE_BUF) { cap = RENDER_CMDLINE_BUF; }
    if (cap < 0) { cap = 0; }
    var pos = 0;
    var i = 0;
    while (i < clen) {
        if (pos < cap) {
            store8(&line + pos, buf_get(cb, i));
            pos = pos + 1;
        }
        i = i + 1;
    }
    # v1.11.0: what was typed — or PASTED — on the command line is not
    # trusted either. Sanitized in place (darshana allows `buf + pos == src`);
    # the output is never longer than the input.
    pos = tty_sanitize_buf(&line, 0, &line, pos, TTY_SANITIZE_UTF8, 0);
    if (pos > 0) { syscall(1, 1, &line, pos); }
    return 0;
}

# Bottom status row. In COMMAND/SEARCH modes shows `<prefix><cmdbuf>`;
# otherwise mode tag, filename, modified flag.
fn render_status(s, rows, cols) {
    tty_move(rows, 1);
    syscall(1, 1, "\x1b[2K", 4);  # clear current line first

    # COMMAND, SEARCH, and SEARCH_BACK all render as `<prefix><cmdbuf>`
    # in the status row. The prefix byte is the only thing that
    # differs (`:` / `/` / `?`); _render_cmdline factors the rest.
    var rm = editor_mode(s);
    if (rm == MODE_COMMAND)     { return _render_cmdline(s, 58, cols); }
    if (rm == MODE_SEARCH)      { return _render_cmdline(s, 47, cols); }
    if (rm == MODE_SEARCH_BACK) { return _render_cmdline(s, 63, cols); }

    # If a command set a status message in this step, show it (truncated
    # to cols) instead of the mode tag. The next keystroke clears it.
    var msg = editor_status(s);
    if (msg != 0) {
        var msg_len = strlen(msg);
        if (msg_len > cols) { msg_len = cols; }
        _render_write_safe(msg, msg_len);
        return 0;
    }

    var tag = "-- NORMAL --";
    if (editor_mode(s) == MODE_INSERT)      { tag = "-- INSERT --"; }
    if (editor_mode(s) == MODE_VISUAL)      { tag = "-- VISUAL --"; }
    if (editor_mode(s) == MODE_VISUAL_LINE) { tag = "-- VISUAL LINE --"; }
    syscall(1, 1, tag, strlen(tag));
    syscall(1, 1, "  ", 2);
    var path = editor_file_path(s);
    if (path == 0) {
        syscall(1, 1, "[scratch]", 9);
    } else {
        _render_write_safe(path, strlen(path));
    }
    if (editor_modified(s) == 1) {
        syscall(1, 1, " [+]", 4);
    }

    # v1.3.5: plugin status_segment hooks. Each registered provider
    # contributes a short segment (e.g. "TWS:3" from trailing_ws or
    # "E:1 W:2" from cyim-lsp's diagnostic count). Segments are
    # appended after the mode + path + dirty block, separated by
    # " | ". No-op when no plugin registers.
    var seg_buf = buf_new();
    var n_segs = _plugin_collect_status_segments(s, seg_buf);
    if (n_segs > 0) {
        syscall(1, 1, " | ", 3);
        # Plugin-supplied text — sanitized like the path. Gathered into one
        # scratch and written once; through 1.10.1 this was one write(2) per
        # BYTE, every frame. Capped at the scratch: a status row is one line.
        var blen = buf_len(seg_buf);
        if (blen > RENDER_STATUS_BUF) { blen = RENDER_STATUS_BUF; }
        var segtxt[1024];               # must equal RENDER_STATUS_BUF
        var i = 0;
        while (i < blen) {
            store8(&segtxt + i, buf_get(seg_buf, i));
            i = i + 1;
        }
        _render_write_safe(&segtxt, blen);
    }
    return 0;
}

# Per-leaf status row: " N: path [+]" left-aligned, padded to rect_w,
# rendered in reverse video (ESC[7m...ESC[0m) for the active leaf.
# Tells the user which file is in which window and where the focus is.
fn _render_leaf_status(s, leaf) {
    var rr = window_rect_row(leaf);
    var rc = window_rect_col(leaf);
    var rh = window_rect_h(leaf);
    var rw = window_rect_w(leaf);
    var status_row = rr + rh - 1;

    var bidx = window_buf_idx(leaf);
    var path = bl_path(s, bidx);
    var modified = bl_modified(s, bidx);
    var is_active = 0;
    if (leaf == editor_active_leaf(s)) {
        is_active = 1;
        # Use live editor mirror for active leaf so modified flag is fresh.
        path = editor_file_path(s);
        modified = editor_modified(s);
    }

    tty_move(status_row + 1, rc + 1);

    var sbuf[1024];
    # Same bound as the cmdline buffer above: the visible width `rw` comes
    # from the window layout, which is seeded from terminal geometry, so it
    # cannot be the only thing standing between this loop and the end of a
    # 1024-byte stack buffer. Reserve 8 bytes for the trailing SGR reset and
    # the NUL-free tail; every store below is guarded against `scap`.
    var scap = RENDER_STATUS_BUF - 8;
    var pos = 0;
    var visible = 0;

    if (is_active == 1) {
        pos = tty_sgr_buf(&sbuf, pos, TTY_SGR_REVERSE);   # ESC [ 7 m
    }

    # Marker: '*' active, ' ' otherwise.
    if (is_active == 1) { store8(&sbuf + pos, 42); } else { store8(&sbuf + pos, 32); }
    pos = pos + 1; visible = visible + 1;

    # Buffer idx (decimal). darshana 0.7.0 renamed tty_itoa ->
    # tty_dec_buf and changed its return from digit-count to the new
    # write position; subtract pos to recover the digit count both
    # `pos` and `visible` advance by.
    var nd = tty_dec_buf(&sbuf, pos, bidx) - pos;
    pos = pos + nd; visible = visible + nd;

    store8(&sbuf + pos, 58); pos = pos + 1; visible = visible + 1;
    store8(&sbuf + pos, 32); pos = pos + 1; visible = visible + 1;

    var name = "[scratch]";
    if (path != 0) { name = path; }
    var nlen = strlen(name);
    if (visible + nlen > rw) { nlen = rw - visible; }
    if (pos + nlen > scap)   { nlen = scap - pos; }
    if (nlen < 0) { nlen = 0; }
    # The path is not cyim's text (v1.11.0) — sanitized, see
    # `_render_write_safe`. Never longer than `nlen`, so the bound above holds.
    var np = tty_sanitize_buf(&sbuf, pos, name, nlen, TTY_SANITIZE_UTF8, 0);
    if (np < 0) { np = pos; }
    visible = visible + (np - pos);
    pos = np;

    if (modified == 1) {
        if (visible + 4 <= rw) {
            if (pos + 4 <= scap) {
                store8(&sbuf + pos + 0, 32);
                store8(&sbuf + pos + 1, 91);
                store8(&sbuf + pos + 2, 43);
                store8(&sbuf + pos + 3, 93);
                pos = pos + 4; visible = visible + 4;
            }
        }
    }

    while (visible < rw) {
        if (pos >= scap) { visible = rw; }
        if (pos < scap) {
            store8(&sbuf + pos, 32);
            pos = pos + 1; visible = visible + 1;
        }
    }

    if (is_active == 1) {
        pos = tty_sgr_reset_buf(&sbuf, pos);              # ESC [ 0 m
    }

    syscall(1, 1, &sbuf, pos);
    return 0;
}

# Render the contents of one leaf into its rect. Per-leaf retokenize
# (M3 cost note: O(buf_len) per leaf per frame; M5 perf can cache
# tokenbufs keyed by buffer + version). The bottom row is reserved
# for the per-leaf status line — rect_h must be >= 2 for that to
# fire; on a 1-row rect the content takes the whole leaf.
fn _render_leaf(s, leaf) {
    var bidx = window_buf_idx(leaf);
    var buf = bl_buf(s, bidx);
    if (buf == 0) { return 0; }
    var path = bl_path(s, bidx);
    var lang = "plain";
    if (path != 0) { lang = detect_language_from_path(path); }
    var tb = highlight_buf(buf, lang);

    var rr = window_rect_row(leaf);
    var rc = window_rect_col(leaf);
    var rh = window_rect_h(leaf);
    var rw = window_rect_w(leaf);

    var content_h = rh - 1;
    if (content_h < 1) { content_h = rh; }

    var n_lines = buf_line_count(buf);

    var out[8192];
    var line = 0;
    while (line < content_h) {
        tty_move(rr + line + 1, rc + 1);
        if (line < n_lines) {
            var n = render_build_line_naked(buf, line, rw, tb, &out, 8192);
            syscall(1, 1, &out, n);
        } else {
            syscall(1, 1, "~", 1);
        }
        line = line + 1;
    }

    if (content_h < rh) {
        _render_leaf_status(s, leaf);
    }
    return 0;
}

# Multi-window render path. Called when editor_window_root is non-null.
fn _render_frame_multi(s, rows, cols) {
    var root = editor_window_root(s);
    var content_h = rows - 1;
    window_layout(root, 0, 0, content_h, cols);

    tty_clear();
    var leaves = vec_new();
    window_collect_leaves(root, leaves);
    var i = 0;
    while (i < vec_len(leaves)) {
        _render_leaf(s, vec_get(leaves, i));
        i = i + 1;
    }

    render_status(s, rows, cols);

    # Cmdline modes park the cursor in the status row, one past the
    # `<prefix>` plus the typed bytes (1-indexed: +1 for the prefix,
    # +1 for 1-indexing).
    var m = editor_mode(s);
    if (m == MODE_COMMAND || m == MODE_SEARCH || m == MODE_SEARCH_BACK) {
        tty_move(rows, buf_len(editor_cmdbuf(s)) + 2);
        return 0;
    }

    var leaf = editor_active_leaf(s);
    if (leaf == 0) { return 0; }
    var b = bl_buf(s, window_buf_idx(leaf));
    if (b == 0) { return 0; }
    var cpos = buf_cursor(b);
    var crow = window_rect_row(leaf) + buf_line_of(b, cpos) + 1;
    var ccol = window_rect_col(leaf) + buf_col_of(b, cpos) + 1;
    # Clip to the leaf's content area (the last row is the per-leaf status).
    var leaf_content_h = window_rect_h(leaf) - 1;
    if (leaf_content_h < 1) { leaf_content_h = window_rect_h(leaf); }
    var max_row = window_rect_row(leaf) + leaf_content_h;
    if (crow > max_row) { crow = max_row; }
    tty_move(crow, ccol);
    return 0;
}

# Full-screen redraw. Dispatches by window tree state:
#   - window_root set → multi-window path (tb arg ignored; per-leaf
#     retokenize internally)
#   - window_root unset → legacy single-buffer path with passed `tb`
# Tests still call the single-buffer path with explicit `tb`; main.cyr
# initializes the window tree on startup so the binary always lands
# on the multi-window path.
# v1.5.0 — bottom-anchored list-display overlay. Drawn AFTER both
# buffer rows and the status row, so it visually overlays the
# bottom of the buffer area while leaving the status row visible.
# Cap at 10 visible rows; if the list is longer, scroll the window
# to keep the current selection in view.
fn _render_list_overlay(s, rows, cols) {
    if (_plugin_list_active == 0) { return 0; }
    var n = _plugin_list_count;
    if (n <= 0) { return 0; }
    var max_h = 10;
    if (n > max_h) { n = max_h; }

    # Window-start chosen to keep the current index visible. Simple
    # rule: anchor the current selection at the bottom of the visible
    # window when scrolling is needed.
    var win_start = _plugin_list_index - n + 1;
    if (win_start < 0) { win_start = 0; }
    if (win_start + n > _plugin_list_count) {
        win_start = _plugin_list_count - n;
    }
    if (win_start < 0) { win_start = 0; }

    var i = 0;
    while (i < n) {
        var row = rows - n + i;
        tty_move(row, 1);
        syscall(1, 1, "\x1b[2K", 4);
        var item_idx = win_start + i;
        var is_cur = 0;
        if (item_idx == _plugin_list_index) { is_cur = 1; }
        if (is_cur == 1) { tty_sgr(TTY_SGR_REVERSE); }
        var item = vec_get(_plugin_list_items, item_idx);
        if (item != 0) {
            var item_len = strlen(item);
            if (item_len > cols) { item_len = cols; }
            # Plugin rows — for `:lsp-find-refs`, a preview of a line from
            # ANOTHER file — are sanitized (v1.11.0; see _render_write_safe).
            var shown = _render_write_safe(item, item_len);
            # Pad to full width so reverse-video extends to the right edge.
            if (is_cur == 1) {
                var pad_n = cols - shown;
                while (pad_n > 0) {
                    syscall(1, 1, " ", 1);
                    pad_n = pad_n - 1;
                }
            }
        }
        if (is_cur == 1) { tty_sgr_reset(); }
        i = i + 1;
    }
    # Park the terminal cursor at the start of the current selection
    # row so the focus indicator matches the visible highlight.
    var cur_row = rows - n + (_plugin_list_index - win_start);
    tty_move(cur_row, 1);
    return 0;
}

# Draw one complete frame: every window's text region, each leaf's status
# row, the bottom status/command row, and finally the cursor. `tb` is the
# tokenbuf for the ACTIVE buffer, or 0 to render it uncoloured.
#
# Called once per iteration of the main loop, so everything it touches is on
# the per-keystroke path. It assumes `tb` is already current — retokenizing is
# the caller's job (`highlight_buf` handles the cache), and this function does
# not check the buffer version.
#
# Also the fire-point for the diagnostic_provider hook: providers run here,
# once per frame, and their results are readable afterwards via
# `plugin_last_diags()`.
fn render_frame(s, rows, cols, tb) {
    # v1.3.5: collect diagnostics once per frame from every registered
    # provider. Stashes the result for tests + future render-side
    # inline-paint integration (LSP at v1.4.0). No-op when no plugin
    # registers a diagnostic provider.
    _plugin_render_collect_diagnostics(s);

    if (editor_window_root(s) != 0) {
        var rc = _render_frame_multi(s, rows, cols);
        _render_list_overlay(s, rows, cols);
        return rc;
    }

    var b = editor_buf(s);
    tty_clear();
    tty_cursor_home();

    var n_lines = buf_line_count(b);
    var max_lines = rows - 1;
    if (n_lines > max_lines) { n_lines = max_lines; }

    var line = 0;
    while (line < n_lines) {
        render_line(b, line, cols, tb);
        line = line + 1;
    }
    while (line < max_lines) {
        syscall(1, 1, "~\r\n", 3);
        line = line + 1;
    }

    render_status(s, rows, cols);

    if (editor_mode(s) == MODE_COMMAND) {
        var clen = buf_len(editor_cmdbuf(s));
        tty_move(rows, clen + 2);
    } else {
        var cpos = buf_cursor(b);
        var crow = buf_line_of(b, cpos) + 1;
        var ccol = buf_col_of(b, cpos) + 1;
        if (crow > max_lines) { crow = max_lines; }
        tty_move(crow, ccol);
    }
    # v1.5.0: list overlay (drawn last; tty_move inside positions
    # the terminal cursor at the highlighted row, overriding the
    # buffer-cursor positioning above when active).
    _render_list_overlay(s, rows, cols);
    return 0;
}
