# tests/dot.tcyr — `.` (repeat last edit)
#
# Drives editor_step so the dot-recording state machine fires through
# the same code path the binary takes. Today's recording covers insert
# sessions (i/a/A → bytes → Esc); x / paste / visual edits aren't
# captured yet (deferred per M4.5 scope notes).

include "src/buffer.cyr"
include "src/mode.cyr"
include "src/buflist.cyr"
include "src/window.cyr"
include "src/motion.cyr"
include "src/insert.cyr"
include "src/edit.cyr"
include "src/plugin.cyr"
include "src/command.cyr"
include "src/search.cyr"
include "src/undo.cyr"
include "src/visual.cyr"
include "src/driver.cyr"

fn buf_eq(b, expected, n) {
    if (buf_len(b) != n) { return 0; }
    var i = 0;
    while (i < n) {
        if (buf_get(b, i) != load8(expected + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn main() {
    alloc_init();

    test_group("After iabc<Esc>, dot_buf holds 'abc' and entry_key = 'i'");
    var b1 = buf_new();
    var s1 = editor_new(b1);
    bl_init(s1, b1);
    editor_step(s1, 105); # i
    editor_step(s1, 97);
    editor_step(s1, 98);
    editor_step(s1, 99);
    editor_step(s1, 27);  # Esc
    assert_eq(editor_dot_recording(s1), 0, "recording finalized");
    assert_eq(editor_dot_entry_key(s1), 105, "entry key is 'i'");
    var db = editor_dot_buf(s1);
    assert_nonnull(db, "dot_buf allocated");
    assert_eq(buf_eq(db, "abc", 3), 1, "dot_buf == 'abc'");

    test_group(". replays the last insert at the current cursor");
    # Cursor is on 'c' (pos 2) after Esc step-back. Move to start.
    buf_move(b1, 0);
    editor_step(s1, 46);  # .
    # Replay: i (cursor stays 0) + 'a' (insert at 0) + 'b' + 'c' + Esc.
    # Expected: "abc" inserted before original "abc" → "abcabc". Cursor
    # post-Esc step-back: 2.
    assert_eq(buf_eq(b1, "abcabc", 6), 1, "buffer is 'abcabc' after .");

    test_group("multiple . replays accumulate");
    buf_move(b1, 0);
    editor_step(s1, 46);  # .
    # Now buffer should have another "abc" inserted at start: "abcabcabc"... wait
    # Actually the replay inserts at cursor 0, which produces "abc" prepended → "abcabcabc".
    assert_eq(buf_eq(b1, "abcabcabc", 9), 1, "second . prepends another 'abc'");

    test_group("a (append) is recorded with entry_key = 97");
    var b2 = buf_new();
    buf_insert(b2, "X", 1);
    buf_move(b2, 0);
    var s2 = editor_new(b2);
    bl_init(s2, b2);
    editor_step(s2, 97);  # a — cursor moves to 1, INSERT
    editor_step(s2, 89);  # Y
    editor_step(s2, 27);  # Esc
    assert_eq(buf_eq(b2, "XY", 2), 1, "buffer is 'XY' after aY<Esc>");
    assert_eq(editor_dot_entry_key(s2), 97, "entry key is 'a'");
    assert_eq(buf_eq(editor_dot_buf(s2), "Y", 1), 1, "dot_buf == 'Y'");
    # Replay at end: cursor was at 0 (Esc step-back), . will fire `a` (advance
    # cursor by 1 to 1, insert mode), then 'Y' (insert at 1), Esc.
    editor_step(s2, 46);
    # Expected: original "XY", `a` from cursor 0 → cursor 1 (on 'Y'),
    # 'Y' inserted at 1 → "XYYY"... wait let me re-trace.
    # After previous edit: buf = "XY", cursor = 0 (Esc step-back from 1).
    # `a` advances cursor to 1 (on 'Y'). `Y` inserts at 1 → "XYY", cursor=2.
    # Esc → cursor=1.
    assert_eq(buf_eq(b2, "XYY", 3), 1, "after . at start: 'XYY'");

    test_group(". with no prior edit is a safe no-op");
    var b3 = buf_new();
    buf_insert(b3, "abc", 3);
    buf_move(b3, 0);
    var s3 = editor_new(b3);
    bl_init(s3, b3);
    editor_step(s3, 46);  # . — no prior edit
    assert_eq(buf_eq(b3, "abc", 3), 1, "buffer unchanged");

    test_group("New insert overrides the dot_buf for next .");
    var b4 = buf_new();
    var s4 = editor_new(b4);
    bl_init(s4, b4);
    editor_step(s4, 105); editor_step(s4, 65); editor_step(s4, 27); # iA<Esc>
    assert_eq(buf_eq(editor_dot_buf(s4), "A", 1), 1, "dot_buf == 'A'");
    editor_step(s4, 105); editor_step(s4, 90); editor_step(s4, 27); # iZ<Esc>
    assert_eq(buf_eq(editor_dot_buf(s4), "Z", 1), 1, "dot_buf overwritten to 'Z'");
    # After iA<Esc>iZ<Esc>: buf is "ZA" (Z inserted at 0 in front of A),
    # cursor at 0. `.` replays "iZ<Esc>" at cursor 0 — inserts another Z
    # at the front: "ZZA".
    buf_move(b4, 0);
    editor_step(s4, 46);  # .
    assert_eq(buf_eq(b4, "ZZA", 3), 1, "after . at start: 'ZZA'");

    test_group(". on empty insert session (i<Esc>) replays nothing");
    var b5 = buf_new();
    buf_insert(b5, "x", 1);
    buf_move(b5, 0);
    var s5 = editor_new(b5);
    bl_init(s5, b5);
    editor_step(s5, 105); editor_step(s5, 27); # i<Esc> — empty session
    assert_eq(editor_dot_entry_key(s5), 105, "entry recorded");
    assert_eq(buf_len(editor_dot_buf(s5)), 0, "dot_buf empty");
    editor_step(s5, 46);  # .
    assert_eq(buf_eq(b5, "x", 1), 1, "buffer unchanged on empty replay");

    test_group("dot recording isolated per buffer");
    var b6a = buf_new();
    var s6 = editor_new(b6a);
    bl_init(s6, b6a);
    editor_step(s6, 105); editor_step(s6, 65); editor_step(s6, 27); # iA<Esc>
    var b6b = buf_new();
    bl_add(s6, b6b, "second");
    bl_set_active(s6, 1);
    # Switching buffers does not clear dot state — dot is editor-global,
    # not per-buffer. (Vim's behavior matches; the last edit can be
    # repeated in any buffer.)
    assert_eq(buf_eq(editor_dot_buf(s6), "A", 1), 1, "dot_buf preserved across buffer switch");
    editor_step(s6, 46);  # . in second buffer
    assert_eq(buf_eq(editor_buf(s6), "A", 1), 1, "second buffer received 'A'");

    test_group("editor_feed: CSI arrow sequences move cursor without mode toggle (v1.2.0 fix)");
    # Bug pre-1.2.0: terminals send arrow keys as 3-byte CSI sequences
    # (ESC [ A/B/C/D). The driver read 1 byte per syscall, so ESC exited
    # INSERT, [ was unmapped in NORMAL, and A/B/C/D triggered destructive
    # NORMAL-mode commands (vim's `A` = append-end-of-line, `D` = delete-
    # to-end-of-line, etc.). Fix: editor_feed parses CSI at the driver
    # layer and dispatches ACT_MOVE_* directly via motion_apply.
    var b7 = buf_new();
    buf_insert(b7, "line1\nline2\nline3\n", 18);
    buf_move(b7, 0);
    var s7 = editor_new(b7);
    bl_init(s7, b7);

    # ESC [ B = arrow down. From line1 col 0 → line2 col 0 (pos 6).
    var down_seq[3];
    store8(&down_seq + 0, 27);  # ESC
    store8(&down_seq + 1, 91);  # [
    store8(&down_seq + 2, 66);  # B
    editor_feed(s7, &down_seq, 3);
    assert_eq(buf_cursor(b7), 6, "ESC [ B moves cursor down to line2 start");
    assert_eq(editor_mode(s7), MODE_NORMAL, "arrow does not exit NORMAL");

    # ESC [ A = arrow up. line2 col 0 → line1 col 0 (pos 0).
    var up_seq[3];
    store8(&up_seq + 0, 27);
    store8(&up_seq + 1, 91);
    store8(&up_seq + 2, 65);  # A
    editor_feed(s7, &up_seq, 3);
    assert_eq(buf_cursor(b7), 0, "ESC [ A moves cursor up to line1 start");

    # ESC [ C = arrow right. pos 0 → pos 1.
    var right_seq[3];
    store8(&right_seq + 0, 27);
    store8(&right_seq + 1, 91);
    store8(&right_seq + 2, 67);  # C
    editor_feed(s7, &right_seq, 3);
    assert_eq(buf_cursor(b7), 1, "ESC [ C moves cursor right");

    # ESC [ D = arrow left. pos 1 → pos 0.
    var left_seq[3];
    store8(&left_seq + 0, 27);
    store8(&left_seq + 1, 91);
    store8(&left_seq + 2, 68);  # D
    editor_feed(s7, &left_seq, 3);
    assert_eq(buf_cursor(b7), 0, "ESC [ D moves cursor left");

    test_group("editor_feed: arrow keys work in INSERT mode without exiting (v1.2.0 fix)");
    # The pre-1.2.0 bug was especially nasty in INSERT: arrow up did
    # ESC + [ + A = exit INSERT + no-op + jump to end of line and
    # re-enter INSERT. Verify INSERT stays put and the cursor moves.
    var b8 = buf_new();
    buf_insert(b8, "abc\nxyz\n", 8);
    buf_move(b8, 0);
    var s8 = editor_new(b8);
    bl_init(s8, b8);
    editor_step(s8, 105);  # i — enter INSERT
    assert_eq(editor_mode(s8), MODE_INSERT, "in INSERT");
    var down_in_insert[3];
    store8(&down_in_insert + 0, 27);
    store8(&down_in_insert + 1, 91);
    store8(&down_in_insert + 2, 66);  # B
    editor_feed(s8, &down_in_insert, 3);
    assert_eq(editor_mode(s8), MODE_INSERT, "arrow does NOT exit INSERT");
    assert_eq(buf_cursor(b8), 4, "arrow down in INSERT moved cursor to line2 start");

    test_group("editor_feed: bare ESC still exits INSERT immediately");
    # Critical regression guard: the dispatch path is unchanged. ESC
    # alone (not followed by `[`) must still exit INSERT in one step.
    # editor_feed routes non-CSI bytes through editor_step unchanged.
    var bare_esc[1];
    store8(&bare_esc, 27);
    editor_feed(s8, &bare_esc, 1);
    assert_eq(editor_mode(s8), MODE_NORMAL, "bare ESC still exits INSERT");

    test_group("editor_feed: unknown CSI final byte gets swallowed");
    # ESC [ Z (Shift-Tab in some terminals) isn't mapped; should
    # consume 3 bytes silently rather than letting `Z` reach NORMAL
    # mode dispatch (where it might do something).
    var b9 = buf_new();
    buf_insert(b9, "hello", 5);
    buf_move(b9, 0);
    var s9 = editor_new(b9);
    bl_init(s9, b9);
    var unknown_csi[3];
    store8(&unknown_csi + 0, 27);
    store8(&unknown_csi + 1, 91);
    store8(&unknown_csi + 2, 90);  # Z
    editor_feed(s9, &unknown_csi, 3);
    assert_eq(editor_mode(s9), MODE_NORMAL, "unknown CSI does not change mode");
    assert_eq(buf_cursor(b9), 0, "unknown CSI does not move cursor");
    assert_eq(buf_eq(b9, "hello", 5), 1, "unknown CSI does not modify buffer");

    test_group("editor_feed: Enter (CR) splits the line in INSERT mode");
    # End-to-end verification of the Enter-key fix. Type `iAB<CR>CD<Esc>`
    # and confirm the buffer contains 'AB\nCD'.
    var b10 = buf_new();
    var s10 = editor_new(b10);
    bl_init(s10, b10);
    var enter_seq[7];
    store8(&enter_seq + 0, 105);  # i
    store8(&enter_seq + 1, 65);   # A
    store8(&enter_seq + 2, 66);   # B
    store8(&enter_seq + 3, 13);   # CR (terminal Enter)
    store8(&enter_seq + 4, 67);   # C
    store8(&enter_seq + 5, 68);   # D
    store8(&enter_seq + 6, 27);   # Esc
    editor_feed(s10, &enter_seq, 7);
    assert_eq(buf_eq(b10, "AB\nCD", 5), 1, "iAB<CR>CD<Esc> -> 'AB\\nCD'");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
