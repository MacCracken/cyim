# tests/command.tcyr — COMMAND-mode handlers, parser, and end-to-end drives
#
# Coverage:
#   - Command-buffer lifecycle (append / backspace / reset).
#   - Parser: bare commands, commands with paths, unknown commands.
#   - Each command's effect on the editor state.
#   - Modified-flag tracking (set by inserts, cleared by `:w`).
#   - End-to-end via editor_run for `:q!`, `:w`, `:wq`, `:e`.

include "src/buffer.cyr"
# marks.cyr must precede mode.cyr: mode's KEY_M / KEY_QUOTE prefix dispatch
# calls marks_set / marks_get / marks_set_global / marks_get_global, and the
# compiler is single-pass. Omitting it was warn-only until cyrius stopped
# emitting binaries with reachable undefined functions.
include "src/marks.cyr"
include "src/mode.cyr"
include "src/buflist.cyr"
include "src/window.cyr"
include "src/motion.cyr"
include "src/insert.cyr"
include "src/edit.cyr"
include "src/plugin.cyr"
include "src/command.cyr"
include "src/search.cyr"
include "src/undo.cyr"
include "src/visual.cyr"
include "src/driver.cyr"

var TMP_W   = "build/test-cmd-w.txt";
var TMP_E   = "build/test-cmd-e.txt";
var TMP_WQ  = "build/test-cmd-wq.txt";

fn buf_eq(b, expected, n) {
    if (buf_len(b) != n) { return 0; }
    var i = 0;
    while (i < n) {
        if (buf_get(b, i) != load8(expected + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Type a NUL-terminated cstr through editor_run and follow with Enter.
fn type_cmd(s, cstr) {
    var n = strlen(cstr);
    var i = 0;
    while (i < n) {
        editor_step(s, load8(cstr + i));
        i = i + 1;
    }
    editor_step(s, 13);  # Enter
    return n;
}

fn main() {
    alloc_init();

    test_group("command_reset / append / backspace cycle");
    var b = buf_new();
    var s = editor_new(b);
    var cb = editor_cmdbuf(s);
    assert_nonnull(cb, "cmdbuf allocated");
    assert_eq(buf_len(cb), 0, "cmdbuf starts empty");

    command_append(s, 119); # 'w'
    command_append(s, 32);  # ' '
    command_append(s, 102); # 'f'
    command_append(s, 111); # 'o'
    command_append(s, 111); # 'o'
    assert_eq(buf_len(cb), 5, "cmdbuf has 5 bytes");
    assert_eq(buf_get(cb, 0), 119, "[0] == 'w'");
    assert_eq(buf_get(cb, 4), 111, "[4] == 'o'");

    command_backspace(s);
    assert_eq(buf_len(cb), 4, "len after backspace");
    command_reset(s);
    assert_eq(buf_len(cb), 0, "cmdbuf empty after reset");

    test_group("modified flag set by inserts, cleared by save");
    var b2 = buf_new();
    var s2 = editor_new(b2);
    editor_set_file_path(s2, TMP_W);

    assert_eq(editor_modified(s2), 0, "fresh buffer not modified");
    insert_literal(s2, 65);
    assert_eq(editor_modified(s2), 1, "insert sets modified");

    # :w to current file
    command_reset(s2);
    command_append(s2, 119); # 'w'
    assert_eq(command_execute(s2), 0, "':w' returns 0");
    assert_eq(editor_modified(s2), 0, "modified cleared after :w");
    assert_eq(editor_last_error(s2), ERR_NONE, "no error");
    # File on disk should contain "A".
    var rb[8];
    var n = file_read_all(TMP_W, &rb, 8);
    assert_eq(n, 1, "saved file is 1 byte");
    assert_eq(load8(&rb), 65, "saved file is 'A'");

    test_group(":q on dirty buffer is refused with ERR_DIRTY");
    var b3 = buf_new();
    var s3 = editor_new(b3);
    insert_literal(s3, 88); # dirties
    command_reset(s3);
    command_append(s3, 113); # 'q'
    assert_eq(command_execute(s3), 0 - 1, "':q' returns -1 when dirty");
    assert_eq(editor_quit(s3), 0, "quit flag NOT set");
    assert_eq(editor_last_error(s3), ERR_DIRTY, "last_error == ERR_DIRTY");

    test_group(":q! quits unconditionally");
    var b4 = buf_new();
    var s4 = editor_new(b4);
    insert_literal(s4, 88);
    command_reset(s4);
    command_append(s4, 113); # 'q'
    command_append(s4, 33);  # '!'
    assert_eq(command_execute(s4), 0, "':q!' returns 0");
    assert_eq(editor_quit(s4), 1, "quit flag set");

    test_group(":q on clean buffer quits");
    var b5 = buf_new();
    var s5 = editor_new(b5);
    command_reset(s5);
    command_append(s5, 113); # 'q'
    assert_eq(command_execute(s5), 0, "':q' returns 0 when clean");
    assert_eq(editor_quit(s5), 1, "quit flag set");

    test_group(":w with no path and no current file -> ERR_NO_FILE_NAME");
    var b6 = buf_new();
    var s6 = editor_new(b6);
    insert_literal(s6, 65);
    command_reset(s6);
    command_append(s6, 119); # 'w'
    assert_eq(command_execute(s6), 0 - 1, "':w' returns -1");
    assert_eq(editor_last_error(s6), ERR_NO_FILE_NAME, "ERR_NO_FILE_NAME");
    assert_eq(editor_modified(s6), 1, "modified still set");

    test_group(":w <path> updates current file_path");
    var b7 = buf_new();
    var s7 = editor_new(b7);
    insert_literal(s7, 89); # 'Y'
    command_reset(s7);
    command_append(s7, 119); # 'w'
    command_append(s7, 32);  # ' '
    var p = TMP_W;
    var pi = 0;
    var pn = strlen(p);
    while (pi < pn) {
        command_append(s7, load8(p + pi));
        pi = pi + 1;
    }
    assert_eq(command_execute(s7), 0, "':w <path>' returns 0");
    assert_eq(editor_modified(s7), 0, "modified cleared");
    assert_nonnull(editor_file_path(s7), "file_path now set");
    # Content on disk is now "Y".
    var rb2[8];
    var n2 = file_read_all(TMP_W, &rb2, 8);
    assert_eq(n2, 1, "file is 1 byte");
    assert_eq(load8(&rb2), 89, "file is 'Y'");

    test_group(":wq saves then quits");
    var b8 = buf_new();
    var s8 = editor_new(b8);
    insert_literal(s8, 90); # 'Z'
    command_reset(s8);
    command_append(s8, 119);
    command_append(s8, 113);
    command_append(s8, 32);
    var pp = TMP_WQ;
    var ppi = 0;
    var ppn = strlen(pp);
    while (ppi < ppn) {
        command_append(s8, load8(pp + ppi));
        ppi = ppi + 1;
    }
    assert_eq(command_execute(s8), 0, "':wq <path>' returns 0");
    assert_eq(editor_modified(s8), 0, "modified cleared");
    assert_eq(editor_quit(s8), 1, "quit flag set");

    test_group(":e <path> registers + switches to a new buffer");
    # Pre-populate target file.
    file_write_all(TMP_E, "loaded content\n", 15);
    var b9 = buf_new();
    var s9 = editor_new(b9);
    command_reset(s9);
    command_append(s9, 101); # 'e'
    command_append(s9, 32);
    var ep = TMP_E;
    var epi = 0;
    var epn = strlen(ep);
    while (epi < epn) {
        command_append(s9, load8(ep + epi));
        epi = epi + 1;
    }
    assert_eq(command_execute(s9), 0, "':e <path>' returns 0");
    # Original b9 (slot 0) is untouched; new buffer is at slot 1 and active.
    assert_eq(bl_count(s9), 2, "registry has 2 entries");
    assert_eq(bl_active_index(s9), 1, "new buffer is active (slot 1)");
    var active_buf = editor_buf(s9);
    assert_nonnull(active_buf, "editor.buf points to new buffer");
    assert_eq(buf_len(active_buf), 15, "loaded buffer has 15 bytes");
    assert_eq(buf_eq(active_buf, "loaded content\n", 15), 1, "loaded content matches");
    assert_eq(buf_cursor(active_buf), 0, "cursor at 0 in loaded buffer");
    assert_eq(editor_modified(s9), 0, "fresh load is not modified");
    assert_nonnull(editor_file_path(s9), "file_path set on active");
    # Original buffer still in registry, untouched.
    assert_eq(buf_len(b9), 0, "original b9 untouched");

    test_group(":e on dirty buffer preserves it (registry-aware semantics)");
    var b10 = buf_new();
    var s10 = editor_new(b10);
    insert_literal(s10, 65);          # dirties b10
    assert_eq(editor_modified(s10), 1, "b10 is now dirty");
    file_write_all(TMP_E, "another content\n", 16);
    command_reset(s10);
    command_append(s10, 101);          # 'e'
    command_append(s10, 32);
    var ep10 = TMP_E;
    var ep10i = 0;
    var ep10n = strlen(ep10);
    while (ep10i < ep10n) {
        command_append(s10, load8(ep10 + ep10i));
        ep10i = ep10i + 1;
    }
    assert_eq(command_execute(s10), 0, "':e' on dirty returns 0 (no refusal)");
    # New active is the loaded file; old b10's modified state is preserved
    # in slot 0 of the registry.
    assert_eq(bl_active_index(s10), 1, "new buffer active");
    assert_eq(editor_modified(s10), 0, "active is fresh-loaded, not modified");
    assert_eq(bl_modified(s10, 0), 1, "slot 0 (original) keeps its modified flag");
    # Original buffer's contents preserved too.
    assert_eq(buf_get(bl_buf(s10, 0), 0), 65, "slot 0 has the 'A' we typed");

    test_group(":e on already-open path switches to existing slot (no reload)");
    # bl_count(s10) is 2; active is slot 1 (TMP_E). :e TMP_E again should
    # NOT add a third slot — it should be a no-op (or set active to that slot).
    command_reset(s10);
    command_append(s10, 101);
    command_append(s10, 32);
    var rp = TMP_E;
    var rpi = 0;
    var rpn = strlen(rp);
    while (rpi < rpn) {
        command_append(s10, load8(rp + rpi));
        rpi = rpi + 1;
    }
    assert_eq(command_execute(s10), 0, "':e <existing>' returns 0");
    assert_eq(bl_count(s10), 2, "no new slot added");
    assert_eq(bl_active_index(s10), 1, "still on slot 1");

    test_group(":e missing file -> ERR_FILE_NOT_FOUND");
    var b11 = buf_new();
    var s11 = editor_new(b11);
    command_reset(s11);
    command_append(s11, 101);
    command_append(s11, 32);
    command_append(s11, 47);  # '/'
    command_append(s11, 110); # 'n'
    command_append(s11, 47);  # '/'
    command_append(s11, 120); # 'x' — `/n/x` won't exist
    assert_eq(command_execute(s11), 0 - 1, "':e' returns -1");
    assert_eq(editor_last_error(s11), ERR_FILE_NOT_FOUND, "ERR_FILE_NOT_FOUND");

    test_group("unknown command -> ERR_UNKNOWN_CMD");
    var b12 = buf_new();
    var s12 = editor_new(b12);
    command_reset(s12);
    command_append(s12, 122); # 'z'
    command_append(s12, 122);
    assert_eq(command_execute(s12), 0 - 1, "'zz' returns -1");
    assert_eq(editor_last_error(s12), ERR_UNKNOWN_CMD, "ERR_UNKNOWN_CMD");

    test_group("editor_run: end-to-end ':q!' from INSERT");
    var b13 = buf_new();
    var s13 = editor_new(b13);
    var seq[5];
    store8(&seq + 0, 105); # i
    store8(&seq + 1, 88);  # X
    store8(&seq + 2, 27);  # Esc -> NORMAL
    store8(&seq + 3, 58);  # :   -> COMMAND
    store8(&seq + 4, 113); # q   ... continued below
    editor_run(s13, &seq, 5);
    assert_eq(editor_mode(s13), MODE_COMMAND, "in COMMAND after ':'");
    assert_eq(editor_modified(s13), 1, "buffer dirty");

    var seq2[3];
    store8(&seq2 + 0, 33);  # !
    store8(&seq2 + 1, 13);  # Enter
    store8(&seq2 + 2, 0);   # padding
    editor_run(s13, &seq2, 2);
    assert_eq(editor_quit(s13), 1, "quit flag set after ':q!\\n'");
    assert_eq(editor_mode(s13), MODE_NORMAL, "back to NORMAL after Enter");

    test_group("editor_run: ':w <path>' from INSERT clears modified");
    var b14 = buf_new();
    var s14 = editor_new(b14);
    # Type "iAB<Esc>:w build/test-cmd-w.txt<Enter>"
    var prefix[5];
    store8(&prefix + 0, 105); # i
    store8(&prefix + 1, 65);  # A
    store8(&prefix + 2, 66);  # B
    store8(&prefix + 3, 27);  # Esc
    store8(&prefix + 4, 58);  # :
    editor_run(s14, &prefix, 5);
    # "w "
    editor_step(s14, 119);
    editor_step(s14, 32);
    var pa = TMP_W;
    var pai = 0;
    var pan = strlen(pa);
    while (pai < pan) {
        editor_step(s14, load8(pa + pai));
        pai = pai + 1;
    }
    editor_step(s14, 13); # Enter
    assert_eq(editor_modified(s14), 0, "modified cleared");
    assert_eq(editor_mode(s14), MODE_NORMAL, "back to NORMAL after Enter");
    var rb3[8];
    var n3 = file_read_all(TMP_W, &rb3, 8);
    assert_eq(n3, 2, "saved 2 bytes");
    assert_eq(load8(&rb3), 65, "[0] == 'A'");
    assert_eq(load8(&rb3 + 1), 66, "[1] == 'B'");

    test_group("editor_run: backspace inside cmdline");
    var b15 = buf_new();
    var s15 = editor_new(b15);
    # Type "qx" then backspace then '!', then Enter — cmdbuf = "q!" -> q!
    insert_literal(s15, 90); # dirty
    editor_step(s15, 27);    # Esc
    editor_step(s15, 58);    # :
    editor_step(s15, 113);   # q
    editor_step(s15, 120);   # x
    editor_step(s15, 127);   # DEL — removes 'x'
    editor_step(s15, 33);    # !
    editor_step(s15, 13);    # Enter
    assert_eq(editor_quit(s15), 1, "quit set: cmdline parsed as 'q!'");

    test_group(":set ic / :set noic toggle ignorecase");
    var b_set = buf_new();
    var s_set = editor_new(b_set);
    bl_init(s_set, b_set);
    assert_eq(editor_cfg_ignorecase(s_set), 0, "default = 0 (case-sensitive)");
    command_reset(s_set);
    command_append(s_set, 115); # s
    command_append(s_set, 101); # e
    command_append(s_set, 116); # t
    command_append(s_set, 32);  # ' '
    command_append(s_set, 105); # i
    command_append(s_set, 99);  # c
    assert_eq(command_execute(s_set), 0, ":set ic returns 0");
    assert_eq(editor_cfg_ignorecase(s_set), 1, "ignorecase now 1");
    # noic
    command_reset(s_set);
    command_append(s_set, 115);
    command_append(s_set, 101);
    command_append(s_set, 116);
    command_append(s_set, 32);
    command_append(s_set, 110); # n
    command_append(s_set, 111); # o
    command_append(s_set, 105); # i
    command_append(s_set, 99);  # c
    assert_eq(command_execute(s_set), 0, ":set noic returns 0");
    assert_eq(editor_cfg_ignorecase(s_set), 0, "ignorecase back to 0");

    test_group(":set number / :set nonumber toggle line_numbers");
    command_reset(s_set);
    command_append(s_set, 115); command_append(s_set, 101); command_append(s_set, 116);
    command_append(s_set, 32);
    var num_str = "number";
    var ni = 0;
    while (ni < 6) { command_append(s_set, load8(num_str + ni)); ni = ni + 1; }
    command_execute(s_set);
    assert_eq(editor_cfg_line_numbers(s_set), 1, ":set number -> 1");

    command_reset(s_set);
    command_append(s_set, 115); command_append(s_set, 101); command_append(s_set, 116);
    command_append(s_set, 32);
    var nonum = "nonumber";
    var ni2 = 0;
    while (ni2 < 8) { command_append(s_set, load8(nonum + ni2)); ni2 = ni2 + 1; }
    command_execute(s_set);
    assert_eq(editor_cfg_line_numbers(s_set), 0, ":set nonumber -> 0");

    test_group(":set tabstop=N parses integer");
    assert_eq(editor_cfg_tabstop(s_set), 4, "default tabstop = 4");
    command_reset(s_set);
    command_append(s_set, 115); command_append(s_set, 101); command_append(s_set, 116);
    command_append(s_set, 32);
    var ts = "tabstop=8";
    var ti = 0;
    while (ti < 9) { command_append(s_set, load8(ts + ti)); ti = ti + 1; }
    assert_eq(command_execute(s_set), 0, ":set tabstop=8 returns 0");
    assert_eq(editor_cfg_tabstop(s_set), 8, "tabstop now 8");

    test_group("F-2 — :e refuses files larger than cfg_max_filesize");
    var f2_path = "build/test-cmd-f2-large.txt";
    # Write a 100-byte fixture file.
    # One literal, NOT two joined with `+`: cyrius has no string
    # concatenation, so `"a" + "b"` adds two POINTERS and yields garbage.
    # Shortened the variable name instead to bring the line under the
    # 120-char lint cap (1.8.5).
    var f2c = "ABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJ";
    file_write_all(f2_path, f2c, 100);

    var b_f2 = buf_new();
    var s_f2 = editor_new(b_f2);
    bl_init(s_f2, b_f2);

    # Set cap below file size, attempt :e — should refuse.
    editor_set_cfg_max_filesize(s_f2, 50);
    command_reset(s_f2);
    command_append(s_f2, 101); # e
    command_append(s_f2, 32);
    var f2pi = 0;
    var f2pn = strlen(f2_path);
    while (f2pi < f2pn) {
        command_append(s_f2, load8(f2_path + f2pi));
        f2pi = f2pi + 1;
    }
    assert_eq(command_execute(s_f2), 0 - 1, ":e returns -1 when file > cap");
    assert_eq(editor_last_error(s_f2), ERR_FILE_TOO_LARGE, "ERR_FILE_TOO_LARGE set");
    assert_eq(bl_count(s_f2), 1, "no new buffer added when refused");

    # Raise cap above file size, retry — should succeed.
    editor_set_cfg_max_filesize(s_f2, 1000);
    command_reset(s_f2);
    command_append(s_f2, 101);
    command_append(s_f2, 32);
    var f2pi2 = 0;
    while (f2pi2 < f2pn) {
        command_append(s_f2, load8(f2_path + f2pi2));
        f2pi2 = f2pi2 + 1;
    }
    assert_eq(command_execute(s_f2), 0, ":e succeeds when cap is raised");
    assert_eq(bl_count(s_f2), 2, "new buffer added");
    assert_eq(buf_len(editor_buf(s_f2)), 100, "loaded 100 bytes");

    test_group("F-2 — :set maxfilesize=N updates the cap at runtime");
    var b_f2b = buf_new();
    var s_f2b = editor_new(b_f2b);
    bl_init(s_f2b, b_f2b);
    assert_eq(editor_cfg_max_filesize(s_f2b), 104857600, "default 100 MB");
    command_reset(s_f2b);
    command_append(s_f2b, 115); command_append(s_f2b, 101); command_append(s_f2b, 116);
    command_append(s_f2b, 32);
    var mfs = "maxfilesize=42";
    var mfsi = 0;
    while (mfsi < 14) { command_append(s_f2b, load8(mfs + mfsi)); mfsi = mfsi + 1; }
    assert_eq(command_execute(s_f2b), 0, ":set maxfilesize=42 returns 0");
    assert_eq(editor_cfg_max_filesize(s_f2b), 42, "cap now 42");

    test_group("F-3 — command_append caps cmdbuf at COMMAND_MAX_LEN");
    var s_cap = editor_new(buf_new());
    bl_init(s_cap, editor_buf(s_cap));
    var cb_cap = editor_cmdbuf(s_cap);
    var ic = 0;
    while (ic < COMMAND_MAX_LEN) {
        command_append(s_cap, 65);  # 'A'
        ic = ic + 1;
    }
    assert_eq(buf_len(cb_cap), COMMAND_MAX_LEN, "cmdbuf at exactly the cap");
    # One more byte should be dropped + status set.
    command_append(s_cap, 66);
    assert_eq(buf_len(cb_cap), COMMAND_MAX_LEN, "byte past cap dropped");
    assert_nonnull(editor_status(s_cap), "overflow status message set");

    test_group(":set unknown -> ERR_UNKNOWN_CMD");
    command_reset(s_set);
    command_append(s_set, 115); command_append(s_set, 101); command_append(s_set, 116);
    command_append(s_set, 32);
    command_append(s_set, 122); command_append(s_set, 122); # 'zz'
    assert_eq(command_execute(s_set), 0 - 1, ":set zz returns -1");
    assert_eq(editor_last_error(s_set), ERR_UNKNOWN_CMD, "ERR_UNKNOWN_CMD set");

    test_group("editor_run: Esc cancels cmdline");
    var b16 = buf_new();
    var s16 = editor_new(b16);
    editor_step(s16, 58);  # :
    editor_step(s16, 113); # q
    editor_step(s16, 27);  # Esc -> CANCEL
    assert_eq(editor_mode(s16), MODE_NORMAL, "back to NORMAL after Esc");
    assert_eq(editor_quit(s16), 0, "quit NOT set");
    assert_eq(buf_len(editor_cmdbuf(s16)), 0, "cmdbuf cleared");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
