# tests/trailing_ws.tcyr — trailing-whitespace plugin (v1.3.5)
#
# Exercises the first inline cyim plugin end-to-end via the public
# ABI: post_change recomputes the line-set, diagnostic_provider
# emits one entry per line, status_segment renders "TWS:N".
# Together this proves three of the six hooks (post_change_hook,
# diagnostic_provider, status_segment) work in concert as a real
# consumer would use them.

include "src/buffer.cyr"
include "src/highlight.cyr"
include "src/lang.cyr"
include "src/cyimrc.cyr"
include "src/plugin.cyr"
include "src/mode.cyr"
include "src/buflist.cyr"
include "src/window.cyr"
include "src/motion.cyr"
include "src/insert.cyr"
include "src/edit.cyr"
include "src/command.cyr"
include "src/search.cyr"
include "src/undo.cyr"
include "src/visual.cyr"
include "src/driver.cyr"
include "src/plugins/trailing_ws.cyr"

# Compare a NUL-term cstring against a string literal.
fn _streq(a, b) {
    var i = 0;
    while (1 == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Insert a literal byte sequence into buffer b at the cursor.
fn _insert_str(b, s) {
    var i = 0;
    while (load8(s + i) != 0) {
        buf_insert_byte(b, load8(s + i));
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();
    plugin_init();
    trailing_ws_init();

    test_group("post_change recomputes line-set on insert");
    var b = buf_new();
    var s = editor_new(b);
    bl_init(s, b);
    window_init(s);
    editor_set_mode(s, MODE_INSERT);

    # Insert "foo \nbar\nbaz\t\nqux\n" — lines 1, 3 trail
    # whitespace (space, tab); lines 2, 4 don't.
    _insert_str(b, "foo \nbar\nbaz\t\nqux\n");
    # post_change fires per editor_step. We bypassed the step layer
    # via direct buf_insert; call the hook manually to simulate.
    _tws_on_change(s);
    assert_eq(vec_len(_tws_lines), 2, "2 trailing-ws lines");
    assert_eq(vec_get(_tws_lines, 0), 1, "line 1 (space-trailing)");
    assert_eq(vec_get(_tws_lines, 1), 3, "line 3 (tab-trailing)");

    test_group("diagnostic_provider emits one DIAG_HINT per line");
    var diags = vec_new();
    _tws_diags(s, b, diags);
    assert_eq(vec_len(diags), 2, "2 diagnostics emitted");
    var d0 = vec_get(diags, 0);
    assert_eq(diag_line(d0), 1, "diag[0] line == 1");
    assert_eq(diag_severity(d0), DIAG_HINT, "diag[0] severity == HINT");
    var d1 = vec_get(diags, 1);
    assert_eq(diag_line(d1), 3, "diag[1] line == 3");

    # 1.8.5: `diag_msg` is frozen plugin ABI (ADR 0004) but had no test —
    # `diag_line` and `diag_severity` were both covered and the third
    # accessor of the same record was not. That is why it showed up as the
    # only cyim-side symbol with no caller anywhere in the R-2 dead-code
    # sweep: it was a coverage hole wearing a dead-code costume. Deleting it
    # would have broken the ABI and left an incomplete accessor set.
    assert_neq(diag_msg(d0), 0, "diag[0] msg non-null");
    assert_eq(_streq(diag_msg(d0), "trailing whitespace"), 1,
      "diag[0] msg == 'trailing whitespace'");
    assert_eq(_streq(diag_msg(d1), "trailing whitespace"), 1,
      "diag[1] msg == 'trailing whitespace'");

    test_group("status_segment renders TWS:N");
    var seg = _tws_status(s);
    assert_neq(seg, 0, "segment non-null when N > 0");
    assert_eq(_streq(seg, "TWS:2"), 1, "exact 'TWS:2'");

    test_group("status_segment returns 0 when no trailing ws");
    var b2 = buf_new();
    var s2 = editor_new(b2);
    bl_init(s2, b2);
    window_init(s2);
    _insert_str(b2, "clean\nlines\n");
    _tws_on_change(s2);
    assert_eq(vec_len(_tws_lines), 0, "no trailing-ws lines");
    var seg2 = _tws_status(s2);
    assert_eq(seg2, 0, "segment null when N == 0");

    test_group("recompute is monotonic — adding ws bumps count");
    _insert_str(b2, "trailing  \n");
    # cursor advanced; recompute against the bigger buffer
    _tws_on_change(s2);
    assert_eq(vec_len(_tws_lines), 1, "1 trailing-ws after insert");
    var seg3 = _tws_status(s2);
    assert_eq(_streq(seg3, "TWS:1"), 1, "'TWS:1' after one insert");

    test_group("status_segment produces stable byte count for two-digit N");
    var b3 = buf_new();
    var s3 = editor_new(b3);
    bl_init(s3, b3);
    window_init(s3);
    # 12 trailing-ws lines, every line ends in space.
    var k = 0;
    while (k < 12) {
        _insert_str(b3, "x \n");
        k = k + 1;
    }
    _tws_on_change(s3);
    assert_eq(vec_len(_tws_lines), 12, "12 trailing-ws lines");
    var seg4 = _tws_status(s3);
    assert_eq(_streq(seg4, "TWS:12"), 1, "'TWS:12' (two-digit)");

    test_group("collect_status_segments emits TWS via the public path");
    # Re-prime _tws_lines with the 2-line case from group 1.
    _tws_on_change(s);
    var sb = buf_new();
    var n_segs = _plugin_collect_status_segments(s, sb);
    assert_eq(n_segs, 1, "1 segment emitted");
    assert_eq(buf_len(sb), 5, "5 bytes ('TWS:2')");
    # Verify byte content.
    assert_eq(buf_get(sb, 0), 84, "T");
    assert_eq(buf_get(sb, 1), 87, "W");
    assert_eq(buf_get(sb, 2), 83, "S");
    assert_eq(buf_get(sb, 3), 58, ":");
    assert_eq(buf_get(sb, 4), 50, "2");

    test_group("plugin_last_diags is populated by render-frame collect");
    _plugin_render_collect_diagnostics(s);
    var last = plugin_last_diags();
    assert_neq(last, 0, "last diags vec exists");
    assert_eq(vec_len(last), 2, "2 entries (matches _tws_lines)");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
