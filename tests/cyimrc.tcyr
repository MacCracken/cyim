# tests/cyimrc.tcyr — `.cyimrc` palette overrides
#
# Writes fixture configs under build/ (gitignored), loads them via
# cyimrc_load_path, asserts that cyimrc_palette returns the user's
# values and that theme_token_color picks them up.

include "lib/vyakarana.cyr"
include "src/buffer.cyr"
include "src/highlight.cyr"
include "src/lang.cyr"
include "src/cyimrc.cyr"
# v1.11.0: the full chain mode.cyr's and plugin.cyr's calls resolve
# against (marks before mode; command and its dependencies after window),
# so the suite compiles with ZERO "undefined function" warnings — through
# 1.10.1 it printed one per unresolved callee on every run.
include "src/plugin.cyr"
include "src/marks.cyr"
include "src/mode.cyr"
include "src/buflist.cyr"
include "src/window.cyr"
include "src/motion.cyr"
include "src/insert.cyr"
include "src/edit.cyr"
include "src/command.cyr"
include "src/search.cyr"
include "src/undo.cyr"
include "src/visual.cyr"
include "src/tty.cyr"
include "src/render.cyr"

var FIXTURE_BASIC   = "build/cyimrc-basic.txt";
var FIXTURE_COMMENT = "build/cyimrc-comments.txt";
var FIXTURE_BAD     = "build/cyimrc-bad.txt";
var FIXTURE_MISSING = "build/cyimrc-not-here.txt";

fn write_fixture(path, content) {
    return file_write_all(path, content, strlen(content));
}

fn main() {
    alloc_init();

    test_group("missing .cyimrc -> palette returns -1 for all kinds");
    var rc_missing = cyimrc_load_path(FIXTURE_MISSING);
    assert_eq(rc_missing, 0, "missing file -> 0");
    var i = 0;
    var all_minus_one = 1;
    while (i < 10) {
        if (cyimrc_palette(i) != 0 - 1) { all_minus_one = 0; }
        i = i + 1;
    }
    assert_eq(all_minus_one, 1, "every kind -> -1 (no overrides)");

    test_group("basic palette overrides apply");
    write_fixture(FIXTURE_BASIC,
      "palette.keyword = 200\npalette.string = 50\npalette.number = 99\n");
    var rc_basic = cyimrc_load_path(FIXTURE_BASIC);
    assert_eq(rc_basic, 1, "load returns 1 on existing file");
    assert_eq(cyimrc_palette(TK_KEYWORD), 200, "keyword override -> 200");
    assert_eq(cyimrc_palette(TK_STRING),   50, "string override  -> 50");
    assert_eq(cyimrc_palette(TK_NUMBER),   99, "number override  -> 99");
    # Unmentioned kinds remain -1.
    assert_eq(cyimrc_palette(TK_COMMENT), 0 - 1, "comment NOT overridden");
    assert_eq(cyimrc_palette(TK_OPERATOR), 0 - 1, "operator NOT overridden");

    test_group("theme_token_color uses overrides");
    # keyword override 200 should win over the bundled 141.
    assert_eq(theme_token_color(TK_KEYWORD), 200, "keyword -> 200 (override)");
    assert_eq(theme_token_color(TK_STRING),   50, "string -> 50 (override)");
    assert_eq(theme_token_color(TK_NUMBER),   99, "number -> 99 (override)");
    # Unoverridden kinds fall through to bundled defaults.
    assert_eq(theme_token_color(TK_COMMENT),  245, "comment -> 245 (bundled)");
    assert_eq(theme_token_color(TK_OPERATOR), 110, "operator -> 110 (bundled)");
    # User-set -1 should also fall through to bundled (we can't tell
    # apart "explicitly -1" from "not overridden" — both are sentinel).
    # That's an acceptable shortcut for M2; M4 can disambiguate.

    test_group("comments, blank lines, and whitespace tolerated");
    write_fixture(FIXTURE_COMMENT,
      "# Purple keyword theme\n\n   palette.keyword   =   88\n# trailing comment\npalette.error=42\n");
    var rc_c = cyimrc_load_path(FIXTURE_COMMENT);
    assert_eq(rc_c, 1, "load returns 1");
    assert_eq(cyimrc_palette(TK_KEYWORD), 88, "keyword respects whitespace around =");
    assert_eq(cyimrc_palette(TK_ERROR),   42, "error key with no spaces");

    test_group("malformed lines silently ignored");
    # Tests forward-compat shape: bad lines don't poison good ones.
    write_fixture(FIXTURE_BAD,
      "palette.keyword = abc\nnotakey = 5\n=valuewithoutkey\npalette.string = 77\n");
    cyimrc_load_path(FIXTURE_BAD);
    # palette.keyword had a non-numeric value — should remain whatever the
    # previous load left it (88 from the comment fixture above).
    assert_eq(cyimrc_palette(TK_KEYWORD), 88, "bad value doesn't overwrite previous good value");
    # palette.string was valid in this fixture.
    assert_eq(cyimrc_palette(TK_STRING), 77, "good line after bad still applies");

    test_group("palette.ident and palette.punctuation also accepted");
    write_fixture(FIXTURE_BASIC,
      "palette.ident = 150\npalette.punctuation = 160\n");
    cyimrc_load_path(FIXTURE_BASIC);
    assert_eq(cyimrc_palette(TK_IDENT),       150, "ident override");
    assert_eq(cyimrc_palette(TK_PUNCTUATION), 160, "punctuation override");
    assert_eq(theme_token_color(TK_IDENT),       150, "theme honors ident override");
    assert_eq(theme_token_color(TK_PUNCTUATION), 160, "theme honors punctuation override");

    test_group("editor config keys: ignorecase / line_numbers / tabstop");
    write_fixture(FIXTURE_BASIC,
      "ignorecase = 1\nline_numbers = 1\ntabstop = 8\n");
    cyimrc_load_path(FIXTURE_BASIC);
    assert_eq(cyimrc_cfg_ignorecase(),   1, "ignorecase = 1");
    assert_eq(cyimrc_cfg_line_numbers(), 1, "line_numbers = 1");
    assert_eq(cyimrc_cfg_tabstop(),      8, "tabstop = 8");

    # ── 1.8.3 audit F-2 / F-5 ──────────────────────────
    # A palette value outside 0..255 must be dropped like any other
    # malformed value, not stored. Through 1.8.2 it was stored and reached
    # `_render_u16_ascii`, whose 8-byte scratch is indexed DOWNWARD from 7:
    # a 15-digit code drove the index negative AND made the colour escape
    # overrun the 12 bytes `render_build_line` reserves for it.
    test_group("F-2 — palette values outside 0..255 are rejected");
    write_fixture(FIXTURE_BASIC, "palette.keyword = 141\n");
    cyimrc_load_path(FIXTURE_BASIC);
    assert_eq(cyimrc_palette(TK_KEYWORD), 141, "in-range value is stored");
    write_fixture(FIXTURE_BASIC, "palette.keyword = 141\npalette.keyword = 256\n");
    cyimrc_load_path(FIXTURE_BASIC);
    assert_eq(cyimrc_palette(TK_KEYWORD), 141, "256 rejected, prior value kept");
    write_fixture(FIXTURE_BASIC, "palette.keyword = 141\npalette.keyword = 999999999\n");
    cyimrc_load_path(FIXTURE_BASIC);
    assert_eq(cyimrc_palette(TK_KEYWORD), 141, "999999999 rejected");
    write_fixture(FIXTURE_BASIC, "palette.keyword = 141\npalette.keyword = -2\n");
    cyimrc_load_path(FIXTURE_BASIC);
    assert_eq(cyimrc_palette(TK_KEYWORD), 141, "-2 rejected (only -1 is legal)");
    write_fixture(FIXTURE_BASIC, "palette.keyword = 141\npalette.keyword = -1\n");
    cyimrc_load_path(FIXTURE_BASIC);
    assert_eq(cyimrc_palette(TK_KEYWORD), 0 - 1, "-1 accepted (no-colour sentinel)");
    write_fixture(FIXTURE_BASIC, "palette.keyword = 0\n");
    cyimrc_load_path(FIXTURE_BASIC);
    assert_eq(cyimrc_palette(TK_KEYWORD), 0, "0 accepted (range floor)");
    write_fixture(FIXTURE_BASIC, "palette.keyword = 255\n");
    cyimrc_load_path(FIXTURE_BASIC);
    assert_eq(cyimrc_palette(TK_KEYWORD), 255, "255 accepted (range ceiling)");

    # F-5: a digit run long enough to wrap i64 must be REJECTED, not wrapped
    # into a value that happens to pass the range check above.
    test_group("F-5 — over-long digit runs are rejected, not wrapped");
    write_fixture(FIXTURE_BASIC, "palette.keyword = 141\npalette.keyword = 12345678901234567890123\n");
    cyimrc_load_path(FIXTURE_BASIC);
    assert_eq(cyimrc_palette(TK_KEYWORD), 141, "23-digit value rejected");
    write_fixture(FIXTURE_BASIC, "tabstop = 4\ntabstop = 12345678901234567890123\n");
    cyimrc_load_path(FIXTURE_BASIC);
    assert_eq(cyimrc_cfg_tabstop(), 4, "23-digit tabstop rejected");

    # ── 1.8.3 audit F-2, sink side — and BUG-006 (v1.11.0) ──────────────
    # Asserted at `_render_emit_fg` rather than through render_build_line:
    # this is the function whose contract was violated, and whose 12-byte
    # reservation in the caller depends on what it writes. Driving it through
    # the full render pipeline instead makes the assertion depend on where
    # token boundaries happen to fall relative to `byte_cap`, which is
    # incidental — a fixture that merely *usually* overflows is a test that
    # merely usually catches the regression.
    #
    # Through 1.10.1 the digits came from `_render_u16_ascii`, which clamped
    # to 999 — enough for F-2's byte budget, not for the domain: 256..999
    # went out as `\e[38;5;999m` (BUG-006). The composer is now darshana's
    # `tty_fg_256_buf`, which validates [0, 255] and writes NOTHING on a
    # refusal, so `_render_emit_fg` returns 0 there. Mutation: restoring the
    # clamp-to-999 composer fails the five "refused" assertions below.
    test_group("F-2 / BUG-006 — _render_emit_fg writes exact escapes for 0..255");
    var CANARY = 170;                       # 0xAA
    var ubuf = alloc(64);
    var ui = 0;
    while (ui < 64) { store8(ubuf + ui, CANARY); ui = ui + 1; }
    assert_eq(_render_emit_fg(ubuf, 0, 0), 9, "0 -> 9 bytes");
    assert_eq(memeq(ubuf, "\x1b[38;5;0m", 9), 1, "0 -> ESC[38;5;0m");
    assert_eq(_render_emit_fg(ubuf, 0, 42), 10, "42 -> 10 bytes");
    assert_eq(memeq(ubuf, "\x1b[38;5;42m", 10), 1, "42 -> ESC[38;5;42m");
    assert_eq(_render_emit_fg(ubuf, 0, 141), 11, "141 -> 11 bytes");
    assert_eq(memeq(ubuf, "\x1b[38;5;141m", 11), 1, "141 -> ESC[38;5;141m (bytes unchanged from 1.10.1)");
    assert_eq(_render_emit_fg(ubuf, 0, 255), 11, "255 -> 11 bytes (palette ceiling)");
    assert_eq(memeq(ubuf, "\x1b[38;5;255m", 11), 1, "255 -> ESC[38;5;255m");
    assert_eq(load8(ubuf + 11), CANARY, "byte 11 untouched — the escape fits the 12-byte reservation");

    test_group("BUG-006 — an index outside 0..255 is refused and writes nothing");
    ui = 0;
    while (ui < 64) { store8(ubuf + ui, CANARY); ui = ui + 1; }
    assert_eq(_render_emit_fg(ubuf, 0, 256), 0, "256 refused (1.10.1 emitted ESC[38;5;256m)");
    assert_eq(_render_emit_fg(ubuf, 0, 999), 0, "999 refused");
    assert_eq(_render_emit_fg(ubuf, 0, 1000), 0, "1000 refused (1.10.1 clamped it to 999)");
    assert_eq(_render_emit_fg(ubuf, 0, 999999999999999), 0, "15-digit refused");
    assert_eq(_render_emit_fg(ubuf, 0, 0 - 5), 0, "negative refused");
    assert_eq(load8(ubuf), CANARY, "byte 0 untouched — a refusal writes nothing at all");

    # Pipeline-level invariant, kept as a coarse backstop: whatever the
    # palette says, render must not report a position past the caller's cap.
    test_group("F-2 — render_build_line reports no position past out_max");
    var rb = buf_new();
    var rsrc = "var a = 1 ; var b = 2 ; var c = 3 ; var d = 4 ; var e = 5 ; var f = 6 ;\n";
    buf_insert(rb, rsrc, strlen(rsrc));
    buf_move(rb, 0);
    var rtb = highlight_buf(rb, "cyrius");
    assert_neq(rtb, 0, "fixture tokenizes");
    var rcap = 120;
    var rout = alloc(rcap + 64);
    store64(&_cyimrc_palette + 1 * 8, 999999999999999);
    store64(&_cyimrc_palette + 5 * 8, 888888888888888);
    store64(&_cyimrc_palette + 3 * 8, 777777777777777);
    assert_eq(render_build_line(rb, 0, 400, rtb, rout, rcap) <= rcap, 1,
      "render_build_line <= out_max");
    assert_eq(render_build_line_naked(rb, 0, 400, rtb, rout, rcap) <= rcap, 1,
      "render_build_line_naked <= out_max");
    # BUG-006 at the pipeline: with `keyword` (and two more kinds) forced past
    # 255 — the slots written directly, below `_cyimrc_palette_valid` — no
    # `ESC[38;5;N` escape in the line carries N > 255, and `var` is drawn
    # uncoloured. 1.10.1 opened the line with `ESC[38;5;999m`.
    var rn = render_build_line_naked(rb, 0, 400, rtb, rout, rcap);
    var max_idx = 0;
    var ri = 0;
    while (ri + 8 <= rn) {
        if (memeq(rout + ri, "\x1b[38;5;", 7) == 1) {
            var v = 0;
            var d = ri + 7;
            var more = 1;
            while (more == 1) {
                more = 0;
                if (d < rn) {
                    var ch = load8(rout + d);
                    if (ch >= 48) {
                        if (ch <= 57) { v = v * 10 + (ch - 48); d = d + 1; more = 1; }
                    }
                }
            }
            if (v > max_idx) { max_idx = v; }
        }
        ri = ri + 1;
    }
    assert_lte(max_idx, 255, "every ESC[38;5;N in the line has N <= 255");
    assert_eq(memeq(rout, "var", 3), 1, "the refused keyword is drawn uncoloured, first bytes plain");
    # Restore the slots so nothing after this group inherits them.
    store64(&_cyimrc_palette + 1 * 8, 0 - 1);
    store64(&_cyimrc_palette + 5 * 8, 0 - 1);
    store64(&_cyimrc_palette + 3 * 8, 0 - 1);

    # ── v1.9.2 / ADR 0005 — home config, local override ──────────────────
    #
    # The decision: `$XDG_CONFIG_HOME/cyim/cyimrc` is the user's config and
    # follows them between directories; `./.cyimrc` overrides it KEY BY KEY.
    # These assert the precedence, not just that each file parses.

    test_group("ADR 0005 — _cyimrc_join builds paths and refuses an empty dir");
    assert_eq(streq(_cyimrc_join("/home/u", "cyim/cyimrc"), "/home/u/cyim/cyimrc"), 1,
      "joins with a separator");
    assert_eq(streq(_cyimrc_join("/home/u/", "cyim/cyimrc"), "/home/u/cyim/cyimrc"), 1,
      "tolerates a trailing slash — no '//'");
    assert_eq(_cyimrc_join(0, "x"),  0, "null dir -> 0");
    assert_eq(_cyimrc_join("", "x"), 0, "empty dir -> 0, NOT '/x'");

    # An unset HOME must not resolve to a bare '/.config/...'; `_cyimrc_join`
    # refusing an empty dir is what prevents that, and this is the assertion
    # that says so out loud.
    test_group("ADR 0005 — home path is skipped, not guessed, when unset");
    assert_eq(_cyimrc_join("", ".config/cyim/cyimrc"), 0,
      "no home -> no path (never '/.config/cyim/cyimrc')");

    test_group("ADR 0005 — local overrides home KEY BY KEY");
    var HOME_FIX  = "build/cyimrc-home.txt";
    var LOCAL_FIX = "build/cyimrc-local.txt";
    # Home sets three colours...
    write_fixture(HOME_FIX,
      "palette.keyword = 10\npalette.string = 20\npalette.number = 30\n");
    # ...local overrides only one of them.
    write_fixture(LOCAL_FIX, "palette.string = 99\n");
    cyimrc_load_path(HOME_FIX);
    cyimrc_load_path(LOCAL_FIX);
    assert_eq(cyimrc_palette(TK_KEYWORD), 10, "untouched home key survives");
    assert_eq(cyimrc_palette(TK_STRING),  99, "local key wins");
    assert_eq(cyimrc_palette(TK_NUMBER),  30, "other untouched home key survives");

    # Order matters: home-after-local would silently invert the precedence,
    # and every assertion above would still pass on a single-file test.
    test_group("ADR 0005 — precedence is ordered, not incidental");
    cyimrc_load_path(LOCAL_FIX);
    cyimrc_load_path(HOME_FIX);
    assert_eq(cyimrc_palette(TK_STRING), 20, "reversed order -> home wins (control)");

    # ── v1.9.3 closeout — the read cap must not fabricate a value ────────
    #
    # `cyimrc_load_path` reads at most CYIMRC_READ_CAP bytes. If the cut lands
    # mid-value, parsing the partial trailing line applies a number the file
    # never contained — and one that can land back INSIDE the valid range, so
    # every validation layer passes it. Measured before the fix:
    # `palette.keyword = 199999` (out of range, correctly rejected when whole)
    # became `19` and was applied.
    #
    # The fixture pads to exactly (cap - 20) so the cut falls inside the digits.
    test_group("v1.9.3 — an over-cap file drops its partial line, not misreads it");
    var TRUNC_FIX = "build/cyimrc-trunc.txt";
    var tbuf = alloc(CYIMRC_READ_CAP + 64);
    var tp = 0;
    while (tp < CYIMRC_READ_CAP - 20) {
        store8(tbuf + tp, 35);              # '#'
        tp = tp + 1;
        if (tp % 40 == 0) { store8(tbuf + tp - 1, 10); }
    }
    store8(tbuf + tp - 1, 10);              # end the padding on a newline
    var tline = "palette.keyword = 199999\n";
    var tq = 0;
    while (tq < strlen(tline)) { store8(tbuf + tp + tq, load8(tline + tq)); tq = tq + 1; }
    file_write_all(TRUNC_FIX, tbuf, tp + strlen(tline));

    write_fixture(FIXTURE_BASIC, "palette.keyword = 141\n");
    cyimrc_load_path(FIXTURE_BASIC);
    cyimrc_load_path(TRUNC_FIX);
    assert_eq(cyimrc_palette(TK_KEYWORD), 141,
      "truncated line dropped — prior value kept, NOT a fabricated 19");
    assert_eq(cyimrc_truncated(), 1, "truncation is reported, not silent");

    # A file that fits must still have its unterminated last line parsed —
    # the guard must key off the CAP, not off "no trailing newline".
    test_group("v1.9.3 — a file that FITS still parses its last line");
    write_fixture(FIXTURE_BASIC, "palette.keyword = 77");   # no trailing \n
    cyimrc_load_path(FIXTURE_BASIC);
    assert_eq(cyimrc_palette(TK_KEYWORD), 77, "unterminated final line still applies");

    # ── v1.9.3 closeout — the precedence accessors have a caller ─────────
    #
    # `cyimrc_home_applied` / `cyimrc_local_applied` were added at 1.9.2 to
    # make the search-path precedence observable, and then nothing asserted on
    # them — the 1.9.3 dead-code sweep found them as the only two symbols in
    # the tree with no caller anywhere. Per architecture note 004 that is a
    # coverage hole rather than dead code, and the fix is the test.
    #
    # Asserted as an INVARIANT rather than against specific paths: this runs
    # against whatever `$HOME` and cwd the harness happens to have, so "did it
    # find a home config" is not knowable here — but "the return value agrees
    # with the flags" is, and that is the actual contract.
    test_group("v1.9.3 — cyimrc_load() return agrees with its precedence flags");
    var lr = cyimrc_load();
    var lh = cyimrc_home_applied();
    var ll = cyimrc_local_applied();
    assert_eq(lh == 0 || lh == 1, 1, "home_applied is a flag");
    assert_eq(ll == 0 || ll == 1, 1, "local_applied is a flag");
    var either = 0;
    if (lh == 1) { either = 1; }
    if (ll == 1) { either = 1; }
    assert_eq(lr, either, "load() returns 1 iff at least one file was applied");

    # And a hermetic check of the flag RESET, which is the part that would rot
    # silently: a second load must not inherit the first one's verdict.
    write_fixture(FIXTURE_BASIC, "palette.keyword = 141\n");
    cyimrc_load_path(FIXTURE_BASIC);
    cyimrc_load();
    assert_eq(cyimrc_home_applied() == 0 || cyimrc_home_applied() == 1, 1,
      "flags reset on each load, not accumulated");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
