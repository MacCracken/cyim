# tests/insert.tcyr — INSERT-mode handlers + headless drive end-to-end
#
# Each group either calls handlers directly (for unit-level invariants) or
# drives a key sequence via `editor_run` (for integration). Buffer contents
# are spot-checked byte-by-byte.

include "src/buffer.cyr"
# marks.cyr must precede mode.cyr: mode's KEY_M / KEY_QUOTE prefix dispatch
# calls marks_set / marks_get / marks_set_global / marks_get_global, and the
# compiler is single-pass. Omitting it was warn-only until cyrius stopped
# emitting binaries with reachable undefined functions.
include "src/marks.cyr"
include "src/mode.cyr"
include "src/buflist.cyr"
include "src/window.cyr"
include "src/motion.cyr"
include "src/insert.cyr"
include "src/edit.cyr"
include "src/plugin.cyr"
include "src/command.cyr"
include "src/search.cyr"
include "src/undo.cyr"
include "src/visual.cyr"
include "src/driver.cyr"

# Helper: copy buffer bytes to `out` (NUL-terminated). Returns logical length.
fn buf_copy(b, out) {
    var len = buf_len(b);
    var i = 0;
    while (i < len) {
        store8(out + i, buf_get(b, i));
        i = i + 1;
    }
    store8(out + len, 0);
    return len;
}

# Helper: byte-compare buffer to expected cstr of length `n`.
fn buf_eq(b, expected, n) {
    if (buf_len(b) != n) { return 0; }
    var i = 0;
    while (i < n) {
        if (buf_get(b, i) != load8(expected + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn main() {
    alloc_init();

    test_group("insert_literal at empty cursor");
    var b1 = buf_new();
    var s1 = editor_new(b1);
    insert_literal(s1, 72);  # 'H'
    insert_literal(s1, 105); # 'i'
    assert_eq(buf_len(b1), 2, "len after 2 literal inserts");
    assert_eq(buf_cursor(b1), 2, "cursor advanced");
    assert_eq(buf_get(b1, 0), 72, "[0] == 'H'");
    assert_eq(buf_get(b1, 1), 105, "[1] == 'i'");

    test_group("insert_delete_left (backspace)");
    insert_delete_left(s1);
    assert_eq(buf_len(b1), 1, "len after backspace");
    assert_eq(buf_cursor(b1), 1, "cursor moved left");
    insert_delete_left(s1);
    assert_eq(buf_len(b1), 0, "buffer emptied");
    assert_eq(buf_cursor(b1), 0, "cursor at 0");
    # Backspace on empty buffer is a safe no-op.
    var ok = insert_delete_left(s1);
    assert_eq(ok, 0, "backspace on empty returns 0");
    assert_eq(buf_len(b1), 0, "still empty");

    test_group("insert_to_after (`a` semantics)");
    var b2 = buf_new();
    buf_insert(b2, "abc", 3);
    buf_move(b2, 0);
    var s2 = editor_new(b2);
    # Position-only: after `a` from 0, cursor is at 1.
    insert_to_after(s2);
    assert_eq(buf_cursor(b2), 1, "a from 0 -> cursor at 1");
    # Now insert 'X' here: buffer becomes "aXbc".
    insert_literal(s2, 88);
    assert_eq(buf_len(b2), 4, "len now 4");
    assert_eq(buf_eq(b2, "aXbc", 4), 1, "buffer is 'aXbc'");
    assert_eq(buf_cursor(b2), 2, "cursor at 2 (on 'b')");

    # `a` at end-of-buffer puts cursor past the last char.
    var b3 = buf_new();
    buf_insert(b3, "ab", 2);
    var s3 = editor_new(b3);
    # buf_cursor is 2 after the insert (at end). `a` should clamp at buf_len.
    insert_to_after(s3);
    assert_eq(buf_cursor(b3), 2, "a at end stays at end (no overshoot)");

    test_group("insert_to_line_end (`A` semantics)");
    var b4 = buf_new();
    buf_insert(b4, "hello\nworld", 11);
    buf_move(b4, 2); # 'l' on line 0
    var s4 = editor_new(b4);
    insert_to_line_end(s4);
    assert_eq(buf_cursor(b4), 5, "A on line 0 -> position of '\\n' (5)");
    # Insert 'X' here: "helloX\nworld".
    insert_literal(s4, 88);
    assert_eq(buf_eq(b4, "helloX\nworld", 12), 1, "buffer is 'helloX\\nworld'");
    assert_eq(buf_cursor(b4), 6, "cursor advanced past 'X'");

    # `A` on the last line (no trailing \n): cursor goes to buf_len.
    var b5 = buf_new();
    buf_insert(b5, "abc", 3);
    buf_move(b5, 1);
    var s5 = editor_new(b5);
    insert_to_line_end(s5);
    assert_eq(buf_cursor(b5), 3, "A on no-trailing-NL line -> buf_len (3)");

    # `A` on an empty line: cursor stays at line_start.
    var b6 = buf_new();
    buf_insert(b6, "abc\n\ndef", 8);
    buf_move(b6, 4); # the empty line at position 4
    var s6 = editor_new(b6);
    insert_to_line_end(s6);
    assert_eq(buf_cursor(b6), 4, "A on empty interior line stays at line_start");

    # `A` on an empty buffer.
    var b7 = buf_new();
    var s7 = editor_new(b7);
    insert_to_line_end(s7);
    assert_eq(buf_cursor(b7), 0, "A on empty buffer stays at 0");

    test_group("insert_to_normal (Esc step-back)");
    var b8 = buf_new();
    buf_insert(b8, "Hi", 2);
    # Cursor at 2 after typing — like the end of an insert sequence.
    var s8 = editor_new(b8);
    insert_to_normal(s8);
    assert_eq(buf_cursor(b8), 1, "Esc from cursor=2 -> 1 (on 'i')");

    # Esc at line_start is a no-op.
    var b9 = buf_new();
    buf_insert(b9, "Hi", 2);
    buf_move(b9, 0);
    var s9 = editor_new(b9);
    insert_to_normal(s9);
    assert_eq(buf_cursor(b9), 0, "Esc at line_start stays at 0");

    # Esc on empty buffer is a no-op.
    var b10 = buf_new();
    var s10 = editor_new(b10);
    insert_to_normal(s10);
    assert_eq(buf_cursor(b10), 0, "Esc on empty buffer stays at 0");

    test_group("insert_apply routes by action id");
    var b11 = buf_new();
    var s11 = editor_new(b11);
    assert_eq(insert_apply(s11, ACT_INSERT_LITERAL, 65), 1, "INSERT_LITERAL consumed");
    assert_eq(buf_get(b11, 0), 65, "'A' inserted");
    # Non-INSERT action is silently passed through.
    assert_eq(insert_apply(s11, ACT_MOVE_LEFT, 0), 0, "MOVE_LEFT not consumed");
    assert_eq(insert_apply(s11, ACT_NONE, 0), 0, "NONE not consumed");

    test_group("editor_step + editor_run: end-to-end 'iHello<Esc>'");
    var b12 = buf_new();
    var s12 = editor_new(b12);
    var seq[7];
    store8(&seq + 0, 105); # i
    store8(&seq + 1, 72);  # H
    store8(&seq + 2, 101); # e
    store8(&seq + 3, 108); # l
    store8(&seq + 4, 108); # l
    store8(&seq + 5, 111); # o
    store8(&seq + 6, 27);  # Esc
    editor_run(s12, &seq, 7);
    assert_eq(buf_len(b12), 5, "buffer has 5 bytes");
    assert_eq(buf_eq(b12, "Hello", 5), 1, "buffer is 'Hello'");
    assert_eq(editor_mode(s12), MODE_NORMAL, "ends in NORMAL");
    assert_eq(buf_cursor(b12), 4, "cursor on 'o' (last char) after Esc step-back");

    test_group("editor_run: 'iHello<Esc>$a World<Esc>' from empty -> 'Hello World'");
    var b13 = buf_new();
    var s13 = editor_new(b13);
    var seq2[14];
    store8(&seq2 + 0,  105);  # i
    store8(&seq2 + 1,  72);   # H
    store8(&seq2 + 2,  101);  # e
    store8(&seq2 + 3,  108);  # l
    store8(&seq2 + 4,  108);  # l
    store8(&seq2 + 5,  111);  # o
    store8(&seq2 + 6,  27);   # Esc      -> NORMAL, cursor steps back to 'o' (4)
    store8(&seq2 + 7,  36);   # $        -> stay on 'o' (already at line_end == 4)
    store8(&seq2 + 8,  97);   # a        -> cursor 5 (past 'o'), INSERT
    store8(&seq2 + 9,  32);   # ' '
    store8(&seq2 + 10, 87);   # W
    store8(&seq2 + 11, 111);  # o
    store8(&seq2 + 12, 114);  # r
    store8(&seq2 + 13, 27);   # Esc
    editor_run(s13, &seq2, 14);
    assert_eq(buf_eq(b13, "Hello Wor", 9), 1, "buffer is 'Hello Wor'");
    assert_eq(editor_mode(s13), MODE_NORMAL, "ends in NORMAL");
    # After 'r' typed cursor was 9; Esc step-back to 8 (on 'r').
    assert_eq(buf_cursor(b13), 8, "cursor on last typed char ('r')");

    test_group("editor_run: backspace inside INSERT");
    var b14 = buf_new();
    var s14 = editor_new(b14);
    var seq3[7];
    store8(&seq3 + 0, 105); # i
    store8(&seq3 + 1, 65);  # A
    store8(&seq3 + 2, 66);  # B
    store8(&seq3 + 3, 67);  # C
    store8(&seq3 + 4, 127); # DEL  (backspace)
    store8(&seq3 + 5, 8);   # ^H   (also backspace)
    store8(&seq3 + 6, 27);  # Esc
    editor_run(s14, &seq3, 7);
    assert_eq(buf_eq(b14, "A", 1), 1, "buffer is 'A' after 2 backspaces");
    assert_eq(buf_cursor(b14), 0, "cursor on 'A' after Esc step-back");

    test_group("editor_run: motion + insert mix");
    var b15 = buf_new();
    buf_insert(b15, "world", 5);
    buf_move(b15, 0);
    var s15 = editor_new(b15);
    # Insert "hello " before "world": navigate to 0, type 'i', "hello ", Esc.
    var seq4[8];
    store8(&seq4 + 0, 105); # i
    store8(&seq4 + 1, 104); # h
    store8(&seq4 + 2, 101); # e
    store8(&seq4 + 3, 108); # l
    store8(&seq4 + 4, 108); # l
    store8(&seq4 + 5, 111); # o
    store8(&seq4 + 6, 32);  # ' '
    store8(&seq4 + 7, 27);  # Esc
    editor_run(s15, &seq4, 8);
    assert_eq(buf_eq(b15, "hello world", 11), 1, "prepended 'hello '");
    assert_eq(editor_mode(s15), MODE_NORMAL, "ends in NORMAL");

    # ── v1.9.0 — `A` on a ONE-CHARACTER line ─────────
    #
    # Regression for a bug that shipped from the day `A` landed:
    # `buf_line_end(b, pos) == line_start` was used as the "empty line" test,
    # and it cannot tell an empty line from a one-character one — for both,
    # line_end IS line_start. So `A` on `a\n` computed an insert position of 0
    # and appended BEFORE the character.
    #
    # Two-character lines always worked, which is why every existing test
    # missed it. Found only when `o` copied the idiom and an end-to-end pty run
    # disagreed with the unit suite.
    test_group("`A` appends after the last byte on lines of EVERY length");
    var ba1 = buf_new();
    buf_insert(ba1, "ab\n", 3);
    buf_move(ba1, 0);
    var sa1 = editor_new(ba1);
    editor_run(sa1, "AX", 2);
    assert_eq(buf_eq(ba1, "abX\n", 4), 1, "2-char line: appends after 'b'");

    var ba2 = buf_new();
    buf_insert(ba2, "a\n", 2);
    buf_move(ba2, 0);
    var sa2 = editor_new(ba2);
    editor_run(sa2, "AX", 2);
    assert_eq(buf_eq(ba2, "aX\n", 3), 1, "1-char line: appends AFTER 'a', not before");

    var ba3 = buf_new();
    buf_insert(ba3, "\n", 1);
    buf_move(ba3, 0);
    var sa3 = editor_new(ba3);
    editor_run(sa3, "AX", 2);
    assert_eq(buf_eq(ba3, "X\n", 2), 1, "empty line: types at the line start");

    var ba4 = buf_new();
    buf_insert(ba4, "q", 1);                 # 1-char, unterminated
    buf_move(ba4, 0);
    var sa4 = editor_new(ba4);
    editor_run(sa4, "AX", 2);
    assert_eq(buf_eq(ba4, "qX", 2), 1, "1-char unterminated line: appends after 'q'");

    test_group("`o` on a ONE-CHARACTER line opens below, not above");
    var bo1 = buf_new();
    buf_insert(bo1, "a\n", 2);
    buf_move(bo1, 0);
    var so1 = editor_new(bo1);
    editor_run(so1, "oX", 2);
    assert_eq(buf_eq(bo1, "a\nX\n", 4), 1, "1-char line: new line lands BELOW 'a'");

    # ── v1.9.0 — `o` / `O` open line below / above ───
    #
    # The handlers claim their edge cases fall out "by construction" rather
    # than by special-casing, so the edges are what these assert: last line
    # with no trailing newline, an empty line, an empty buffer, and the first
    # line (where `O` must land on position 0).

    test_group("`o` opens a line below and enters INSERT");
    var b16 = buf_new();
    buf_insert(b16, "abc\ndef\n", 8);
    buf_move(b16, 0);                        # on 'a', line 0
    var s16 = editor_new(b16);
    editor_run(s16, "oXY", 3);
    assert_eq(buf_eq(b16, "abc\nXY\ndef\n", 11), 1, "new line below line 0 holds XY");
    assert_eq(editor_mode(s16), MODE_INSERT, "still in INSERT");
    assert_eq(editor_modified(s16), 1, "buffer marked modified");

    test_group("`O` opens a line above and enters INSERT");
    var b17 = buf_new();
    buf_insert(b17, "abc\ndef\n", 8);
    buf_move(b17, 4);                        # on 'd', line 1
    var s17 = editor_new(b17);
    editor_run(s17, "OZ", 2);
    assert_eq(buf_eq(b17, "abc\nZ\ndef\n", 10), 1, "new line above line 1 holds Z");
    assert_eq(editor_mode(s17), MODE_INSERT, "still in INSERT");

    test_group("`O` on the FIRST line lands on position 0");
    var b18 = buf_new();
    buf_insert(b18, "abc\n", 4);
    buf_move(b18, 1);                        # on 'b', still line 0
    var s18 = editor_new(b18);
    editor_run(s18, "O!", 2);
    assert_eq(buf_eq(b18, "!\nabc\n", 6), 1, "new first line holds !");

    test_group("`o` on the LAST line with no trailing newline");
    var b19 = buf_new();
    buf_insert(b19, "abc", 3);               # no terminator
    buf_move(b19, 1);
    var s19 = editor_new(b19);
    editor_run(s19, "oQ", 2);
    assert_eq(buf_eq(b19, "abc\nQ", 5), 1, "appended a line after unterminated last line");

    test_group("`o` / `O` on an EMPTY buffer");
    var b20 = buf_new();
    var s20 = editor_new(b20);
    editor_run(s20, "oA", 2);
    assert_eq(buf_eq(b20, "\nA", 2), 1, "`o` on empty buffer opens one line");
    var b21 = buf_new();
    var s21 = editor_new(b21);
    editor_run(s21, "OB", 2);
    assert_eq(buf_eq(b21, "B\n", 2), 1, "`O` on empty buffer opens one line above");

    test_group("`o` from an EMPTY line inserts below it, not inside it");
    var b22 = buf_new();
    buf_insert(b22, "a\n\nb\n", 5);
    buf_move(b22, 2);                        # on the empty line's terminator
    var s22 = editor_new(b22);
    editor_run(s22, "oX", 2);
    assert_eq(buf_eq(b22, "a\n\nX\nb\n", 7), 1, "empty line preserved, new line below it");

    test_group("`o` then Esc leaves the cursor on the new line in NORMAL");
    var b23 = buf_new();
    buf_insert(b23, "abc\n", 4);
    buf_move(b23, 0);
    var s23 = editor_new(b23);
    editor_run(s23, "oQR", 3);
    editor_step(s23, KEY_ESC);
    assert_eq(editor_mode(s23), MODE_NORMAL, "back in NORMAL");
    assert_eq(buf_eq(b23, "abc\nQR\n", 7), 1, "content intact after Esc");
    # Esc steps back one within the line: after typing QR the cursor sat at 6,
    # so NORMAL leaves it on the 'R' at 5.
    assert_eq(buf_cursor(b23), 5, "cursor on the last typed byte of the new line");

    test_group("`u` undoes `o` + typed text as ONE unit");
    var b24 = buf_new();
    buf_insert(b24, "abc\n", 4);
    buf_move(b24, 0);
    var s24 = editor_new(b24);
    bl_init(s24, b24);                       # undo stacks live on the buflist record
    editor_run(s24, "oXYZ", 4);
    editor_step(s24, KEY_ESC);
    assert_eq(buf_eq(b24, "abc\nXYZ\n", 8), 1, "line opened and filled");
    editor_step(s24, 117);                   # u
    assert_eq(buf_eq(b24, "abc\n", 4), 1, "one `u` removes the line AND its text");

    test_group("`.` repeats `o` — opens ANOTHER line with the same text");
    var b25 = buf_new();
    buf_insert(b25, "abc\n", 4);
    buf_move(b25, 0);
    var s25 = editor_new(b25);
    editor_run(s25, "oHI", 3);
    editor_step(s25, KEY_ESC);
    assert_eq(buf_eq(b25, "abc\nHI\n", 7), 1, "first open");
    editor_step(s25, 46);                    # .
    assert_eq(buf_eq(b25, "abc\nHI\nHI\n", 10), 1, "`.` opened a second line with HI");

    test_group("`O` is dot-repeatable too");
    var b26 = buf_new();
    buf_insert(b26, "z\n", 2);
    buf_move(b26, 0);
    var s26 = editor_new(b26);
    editor_run(s26, "Oq", 2);
    editor_step(s26, KEY_ESC);
    editor_step(s26, 46);                    # .
    assert_eq(buf_eq(b26, "q\nq\nz\n", 6), 1, "two lines opened above by o + .");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
