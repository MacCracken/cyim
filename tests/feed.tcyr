# tests/feed.tcyr — `editor_feed`'s key-sequence decoder (v1.11.0, BUG-003)
#
# Through 1.10.1 `editor_feed` assumed every CSI escape was exactly three
# bytes (`ESC [ <final>`) and recognized one only when it arrived whole in a
# single read. Longer sequences leaked their tails as keystrokes — Delete
# (`ESC [ 3 ~`) typed a literal `~` in INSERT — and a sequence a read cut in
# two ran its ESC as a mode exit and its final byte as a command.
#
# These drive `editor_feed` / `editor_feed_cont` / `editor_feed_flush`
# directly, the way src/main.cyr's two loops do. Mutation-tested against the
# 1.10.1 `editor_feed`: every group from "Delete in INSERT" on fails there.

include "src/buffer.cyr"
# marks.cyr must precede mode.cyr (single-pass; see tests/dot.tcyr).
include "src/marks.cyr"
include "src/mode.cyr"
include "src/buflist.cyr"
include "src/window.cyr"
include "src/motion.cyr"
include "src/insert.cyr"
include "src/edit.cyr"
include "src/plugin.cyr"
include "src/command.cyr"
include "src/search.cyr"
include "src/undo.cyr"
include "src/visual.cyr"
include "src/driver.cyr"

# 1 if gap buffer `b` holds exactly the `n` bytes at `expected`, else 0.
fn buf_eq(b, expected, n) {
    if (buf_len(b) != n) { return 0; }
    var i = 0;
    while (i < n) {
        if (buf_get(b, i) != load8(expected + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# A fresh editor over `text`, cursor at `cur`.
fn ed_with(text, cur) {
    var b = buf_new();
    buf_insert(b, text, strlen(text));
    buf_move(b, cur);
    var s = editor_new(b);
    bl_init(s, b);
    return s;
}

# Feed a NUL-terminated byte string as one read that did not fill its buffer.
fn feed(s, str) {
    return editor_feed(s, str, strlen(str));
}

# Feed it as a read that FILLED its buffer (more input is waiting).
fn feed_cont(s, str) {
    return editor_feed_cont(s, str, strlen(str));
}

# Run every group; the exit code is the number of failed assertions.
fn main() {
    alloc_init();

    test_group("Delete in INSERT deletes under the cursor and stays in INSERT");
    var s1 = ed_with("abc", 0);
    editor_step(s1, 105);                       # i
    assert_eq(feed(s1, "\x1b[3~"), 4, "all 4 bytes consumed");
    assert_eq(buf_eq(editor_buf(s1), "bc", 2), 1, "'a' deleted — no literal '~' inserted (1.10.1: '~abc')");
    assert_eq(editor_mode(s1), MODE_INSERT, "still INSERT");
    assert_eq(editor_modified(s1), 1, "buffer marked modified");
    assert_eq(editor_feed_pending(s1), 0, "nothing held");

    test_group("Delete in NORMAL is `x`, and undoes as one step");
    var s2 = ed_with("abc", 1);
    feed(s2, "\x1b[3~");
    assert_eq(buf_eq(editor_buf(s2), "ac", 2), 1, "'b' deleted");
    assert_eq(editor_mode(s2), MODE_NORMAL, "still NORMAL");
    editor_step(s2, 117);                       # u
    assert_eq(buf_eq(editor_buf(s2), "abc", 3), 1, "u restores 'abc'");

    test_group("Delete inside an insert session is part of that session's undo");
    var s3 = ed_with("abc", 0);
    editor_step(s3, 105);                       # i
    feed(s3, "X\x1b[3~Y");
    editor_step(s3, KEY_ESC);
    assert_eq(buf_eq(editor_buf(s3), "XYbc", 4), 1, "iX<Del>Y<Esc> -> 'XYbc'");
    editor_step(s3, 117);                       # u
    assert_eq(buf_eq(editor_buf(s3), "abc", 3), 1, "ONE u restores 'abc' (no second snapshot)");

    test_group("Delete with a modifier (`ESC [ 3 ; 2 ~`) is still Delete");
    var s4 = ed_with("abc", 0);
    feed(s4, "\x1b[3;2~");
    assert_eq(buf_eq(editor_buf(s4), "bc", 2), 1, "Shift-Delete deletes too");

    test_group("Delete in VISUAL deletes the selection");
    var s5 = ed_with("abcdef", 0);
    editor_step(s5, 118);                       # v
    editor_step(s5, 108);                       # l
    feed(s5, "\x1b[3~");
    assert_eq(buf_eq(editor_buf(s5), "cdef", 4), 1, "v l <Del> removes 'ab'");
    assert_eq(editor_mode(s5), MODE_NORMAL, "back to NORMAL");

    test_group("Delete on the command line is swallowed — no NUL appended");
    var s6 = ed_with("abc", 0);
    editor_step(s6, 58);                        # :
    feed(s6, "\x1b[3~");
    assert_eq(editor_mode(s6), MODE_COMMAND, "still COMMAND");
    assert_eq(buf_len(editor_cmdbuf(s6)), 0, "cmdbuf empty");
    assert_eq(buf_eq(editor_buf(s6), "abc", 3), 1, "text untouched");

    test_group("Other multi-byte CSI keys are swallowed whole in INSERT");
    var s7 = ed_with("abc", 1);
    editor_step(s7, 105);                       # i
    # PgUp / PgDn scroll since 1.13.1 (tests/scroll.tcyr), so they are not here.
    feed(s7, "\x1b[2~");                        # Insert
    feed(s7, "\x1b[1~");                        # Home (vt / rxvt)
    feed(s7, "\x1b[4~");                        # End
    feed(s7, "\x1b[15~");                       # F5
    feed(s7, "\x1b[200~");                      # bracketed-paste start marker
    feed(s7, "\x1b[<0;10;5M");                  # SGR mouse report
    assert_eq(buf_eq(editor_buf(s7), "abc", 3), 1, "no tail inserted (1.10.1 typed '~~~~~5~00~0;10;5M')");
    assert_eq(buf_cursor(editor_buf(s7)), 1, "cursor unmoved");
    assert_eq(editor_mode(s7), MODE_INSERT, "still INSERT");

    test_group("The Linux console's F1 (`ESC [ [ A`) is not an arrow and leaks nothing");
    var s8 = ed_with("ab\ncd\n", 3);
    editor_step(s8, 105);                       # i
    feed(s8, "\x1b[[A");
    assert_eq(buf_eq(editor_buf(s8), "ab\ncd\n", 6), 1, "nothing inserted (1.10.1 inserted 'A')");
    assert_eq(buf_cursor(editor_buf(s8)), 3, "cursor did not move up");

    test_group("A modified arrow moves like the plain arrow");
    var s9 = ed_with("abc", 0);
    editor_step(s9, 105);                       # i
    feed(s9, "\x1b[1;5C");                      # Ctrl-Right
    assert_eq(buf_cursor(editor_buf(s9)), 1, "cursor +1");
    assert_eq(buf_eq(editor_buf(s9), "abc", 3), 1, "nothing inserted (1.10.1 typed ';5C')");
    assert_eq(editor_mode(s9), MODE_INSERT, "still INSERT");

    test_group("A CSI split across reads decodes as if it arrived whole");
    var s10 = ed_with("abcd", 0);
    editor_step(s10, 105);                      # i
    feed_cont(s10, "\x1b[");                    # the read stopped after `ESC [`
    assert_eq(editor_feed_pending(s10), 1, "half a sequence held");
    assert_eq(editor_mode(s10), MODE_INSERT, "the ESC did NOT exit INSERT");
    feed(s10, "3~");
    assert_eq(buf_eq(editor_buf(s10), "bcd", 3), 1, "ESC [ | 3 ~ is one Delete");
    assert_eq(editor_feed_pending(s10), 0, "nothing held after the final byte");
    feed(s10, "\x1b[3");                        # split inside the parameters
    feed(s10, "~");
    assert_eq(buf_eq(editor_buf(s10), "cd", 2), 1, "ESC [ 3 | ~ is one Delete");
    feed_cont(s10, "\x1b");                     # split straight after the ESC
    feed(s10, "[C");
    assert_eq(buf_cursor(editor_buf(s10)), 1, "ESC | [ C is one Right");
    assert_eq(editor_mode(s10), MODE_INSERT, "and still INSERT");

    test_group("A held arrow key: three arrows through an 8-byte read");
    var s11 = ed_with("abcdef", 0);
    var arrows = "\x1b[C\x1b[C\x1b[C";          # 9 bytes
    editor_feed_cont(s11, arrows, 8);           # a full 8-byte read
    editor_feed(s11, arrows + 8, 1);            # the 9th byte
    assert_eq(buf_cursor(editor_buf(s11)), 3, "cursor moved exactly 3");
    assert_eq(editor_mode(s11), MODE_NORMAL, "no stray mode change");
    assert_eq(buf_eq(editor_buf(s11), "abcdef", 6), 1, "buffer untouched");

    test_group("Lone ESC: immediate at the end of input, carried only by editor_feed_cont");
    var s12 = ed_with("abc", 0);
    editor_step(s12, 105);                      # i
    feed(s12, "\x1b");
    assert_eq(editor_mode(s12), MODE_NORMAL, "editor_feed: a trailing ESC is the Esc key, now");
    editor_step(s12, 105);                      # i
    feed_cont(s12, "\x1b");
    assert_eq(editor_mode(s12), MODE_INSERT, "editor_feed_cont: carried; the Esc is still to come");
    assert_eq(editor_feed_pending(s12), 1, "reported pending");
    editor_feed_flush(s12);
    assert_eq(editor_mode(s12), MODE_NORMAL, "flush: the carried ESC was the Esc key");
    assert_eq(editor_feed_pending(s12), 0, "nothing held after flush");
    feed_cont(s12, "\x1b");
    feed(s12, ":");
    assert_eq(editor_mode(s12), MODE_COMMAND, "a carried ESC + ':' is Esc then ':'");

    test_group("flush drops an unfinished CSI — its bytes were never keys");
    var s13 = ed_with("abc", 0);
    editor_step(s13, 105);                      # i
    feed(s13, "\x1b[1;");
    assert_eq(editor_feed_pending(s13), 1, "unfinished CSI held");
    editor_feed_flush(s13);
    assert_eq(editor_feed_pending(s13), 0, "released");
    assert_eq(editor_mode(s13), MODE_INSERT, "no Esc dispatched for it");
    assert_eq(buf_eq(editor_buf(s13), "abc", 3), 1, "nothing inserted");
    editor_feed_flush(s13);
    assert_eq(editor_mode(s13), MODE_INSERT, "flush with nothing held is a no-op");

    test_group("A byte that cannot continue a CSI abandons it and is fed normally");
    var s14 = ed_with("abc", 0);
    editor_step(s14, 105);                      # i
    feed(s14, "\x1b[1\r");
    assert_eq(buf_eq(editor_buf(s14), "\nabc", 4), 1, "CR still splits the line");
    assert_eq(editor_mode(s14), MODE_INSERT, "still INSERT");
    # Cursor is now 1 (line 2, on 'a'). An ESC inside a CSI starts over:
    feed(s14, "\x1b[1\x1b[C");
    assert_eq(buf_cursor(editor_buf(s14)), 2, "the restarted ESC [ C moved right once");
    assert_eq(editor_feed_pending(s14), 0, "nothing held");

    test_group("Over-long parameters are consumed to the final byte");
    var s15 = ed_with("abc", 0);
    editor_step(s15, 105);                      # i
    feed(s15, "\x1b[1111111111222222222233333333334~");
    assert_eq(buf_eq(editor_buf(s15), "abc", 3), 1, "nothing leaked");
    assert_eq(editor_feed_pending(s15), 0, "back to ground");
    assert_lte(_editor_feed_plen(s15), FEED_PBUF_MAX, "count reset after dispatch");

    # 1.11.2: arrows go through editor_dispatch like any other key. Through
    # 1.11.1 the decoder called motion_apply directly, which has no mode
    # guard and never sees the pending prefix.
    test_group("An arrow on the command line is swallowed");
    var s16 = ed_with("abcdef", 3);
    editor_step(s16, 58);                       # :
    feed(s16, "\x1b[D");
    assert_eq(buf_cursor(editor_buf(s16)), 3, "buffer cursor stays (1.11.1: moved to 2)");
    assert_eq(editor_mode(s16), MODE_COMMAND, "still COMMAND");
    assert_eq(buf_len(editor_cmdbuf(s16)), 0, "cmdbuf empty");

    test_group("An arrow on the search line is swallowed");
    var s17 = ed_with("abcdef", 3);
    editor_step(s17, 47);                       # /
    feed(s17, "\x1b[C");
    assert_eq(buf_cursor(editor_buf(s17)), 3, "search starts where it was opened (1.11.1: 4)");
    assert_eq(editor_mode(s17), MODE_SEARCH, "still SEARCH");
    assert_eq(buf_len(editor_cmdbuf(s17)), 0, "cmdbuf empty");

    # Like any unmatched follow-up key, the arrow is consumed by the prefix.  #skip-lint: prefix-sequence noun
    test_group("An arrow cancels a pending `g`");
    var s18 = ed_with("aa\nbb\ncc\n", 3);
    editor_step(s18, 103);                      # g
    feed(s18, "\x1b[B");
    assert_eq(editor_prefix(s18), 0, "prefix cleared (1.11.1: still pending)");
    assert_eq(buf_cursor(editor_buf(s18)), 3, "consumed as the prefix's follow-up");  #skip-lint: prefix-sequence noun
    editor_step(s18, 103);                      # g: a new prefix, not `gg`
    assert_eq(buf_cursor(editor_buf(s18)), 3, "g <Down> g does not jump to the top (1.11.1: 0)");
    assert_eq(editor_prefix(s18), KEY_G, "the second g is pending on its own");

    test_group("Ctrl-W then an arrow is window navigation");
    var s19 = ed_with("aa\nbb\ncc\n", 3);
    editor_step(s19, KEY_CTRL_W);
    feed(s19, "\x1b[B");
    assert_eq(editor_prefix(s19), 0, "Ctrl-W consumed (1.11.1: still pending)");
    assert_eq(buf_cursor(editor_buf(s19)), 3, "the buffer cursor did not move");
    editor_step(s19, KEY_CTRL_W);
    assert_eq(editor_step(s19, KEY_LEFT), ACT_WIN_LEFT, "Ctrl-W <Left> dispatches ACT_WIN_LEFT");

    test_group("An arrow in VISUAL extends the selection");
    var s20 = ed_with("abcdef", 0);
    editor_step(s20, 118);                      # v
    feed(s20, "\x1b[C");
    editor_step(s20, 100);                      # d
    assert_eq(buf_eq(editor_buf(s20), "cdef", 4), 1, "v <Right> d removes 'ab'");

    # BUG-008, 1.13.1: rxvt's `ESC [ <digit> $`. Through 1.13.0 the `$` kept
    # the sequence open and the next key was eaten as its final byte.
    test_group("BUG-008: rxvt Shift-Delete (`ESC [ 3 $`) is Delete, and the next key survives");
    var s21 = ed_with("abc", 0);
    editor_step(s21, 105);                      # i
    feed(s21, "\x1b[3$x");
    assert_eq(buf_eq(editor_buf(s21), "xbc", 3), 1, "'a' deleted, 'x' typed (1.13.0: 'abc', x swallowed)");
    assert_eq(editor_feed_pending(s21), 0, "nothing held");
    assert_eq(editor_mode(s21), MODE_INSERT, "still INSERT");

    test_group("BUG-008: the other rxvt `$` keys act as their `~` forms");
    var s22 = ed_with("abc", 1);
    editor_step(s22, 105);                      # i
    feed(s22, "\x1b[2$");                       # Shift-Insert: swallowed
    feed(s22, "\x1b[7$");                       # Shift-Home: swallowed
    feed(s22, "\x1b[8$");                       # Shift-End: swallowed
    feed(s22, "y");
    assert_eq(buf_eq(editor_buf(s22), "aybc", 4), 1, "nothing leaked, 'y' typed after them");
    var s23 = ed_with("abc", 0);
    feed(s23, "\x1b[3$");                       # NORMAL: Shift-Delete is `x`
    assert_eq(buf_eq(editor_buf(s23), "bc", 2), 1, "NORMAL: deletes like `x`");

    test_group("BUG-008: a `$` after anything but digits stays an intermediate byte");
    var s24 = ed_with("abc", 0);
    editor_step(s24, 105);                      # i
    feed(s24, "\x1b[?1;2$y");                   # a DECRPM reply shape: `y` is its final
    assert_eq(buf_eq(editor_buf(s24), "abc", 3), 1, "the whole reply swallowed, nothing typed");
    assert_eq(editor_feed_pending(s24), 0, "nothing held");
    feed(s24, "\x1b[1;2$y");                    # ANSI-mode DECRPM: `;` before the `$`
    assert_eq(buf_eq(editor_buf(s24), "abc", 3), 1, "swallowed too");
    feed(s24, "\x1b[$z");                       # no parameters: not rxvt's shape
    assert_eq(buf_eq(editor_buf(s24), "abc", 3), 1, "`$` with no digits stays open; `z` ends it");

    test_group("BUG-008: decodes the same split across reads");
    var s25 = ed_with("abc", 0);
    editor_step(s25, 105);                      # i
    feed_cont(s25, "\x1b[3");
    assert_eq(editor_feed_pending(s25), 1, "held after `ESC [ 3`");
    feed(s25, "$x");
    assert_eq(buf_eq(editor_buf(s25), "xbc", 3), 1, "same result as one read");

    # BUG-007, 1.13.1: SS3 keys, decoded only when one read is exactly the key.
    test_group("BUG-007: a read of exactly `ESC O P` is F1, swallowed");
    var s26 = ed_with("abc
", 1);
    assert_eq(editor_feed_ss3(s26, "\x1bOP", 3), 1, "consumed");
    assert_eq(buf_eq(editor_buf(s26), "abc\n", 4), 1, "no line opened, nothing typed (1.13.0: 'P\nabc\n')");
    assert_eq(editor_mode(s26), MODE_NORMAL, "still NORMAL");
    assert_eq(editor_feed_ss3(s26, "\x1bOQ", 3), 1, "F2");
    assert_eq(editor_feed_ss3(s26, "\x1bOR", 3), 1, "F3");
    assert_eq(editor_feed_ss3(s26, "\x1bOS", 3), 1, "F4");
    assert_eq(buf_eq(editor_buf(s26), "abc\n", 4), 1, "F2–F4 swallowed too");

    test_group("BUG-007: `ESC O A`..`D` are the arrows");
    var s27 = ed_with("ab\ncd\n", 4);
    assert_eq(editor_feed_ss3(s27, "\x1bOA", 3), 1, "consumed");
    assert_eq(buf_cursor(editor_buf(s27)), 1, "Up: line 0, col 1");
    editor_feed_ss3(s27, "\x1bOB", 3);
    assert_eq(buf_cursor(editor_buf(s27)), 4, "Down: back to line 1");
    editor_feed_ss3(s27, "\x1bOD", 3);
    assert_eq(buf_cursor(editor_buf(s27)), 3, "Left");
    editor_feed_ss3(s27, "\x1bOC", 3);
    assert_eq(buf_cursor(editor_buf(s27)), 4, "Right");
    var s28 = ed_with("abc", 0);
    editor_step(s28, 105);                      # i
    editor_feed_ss3(s28, "\x1bOP", 3);
    assert_eq(editor_mode(s28), MODE_INSERT, "F1 in INSERT: stays INSERT (1.13.0: left it)");
    assert_eq(buf_eq(editor_buf(s28), "abc", 3), 1, "and types nothing");

    test_group("BUG-007: anything else is left to editor_feed, as keystrokes");
    var s29 = ed_with("abc\n", 0);
    assert_eq(editor_feed_ss3(s29, "\x1bOx", 3), 0, "unknown final: not consumed");
    assert_eq(editor_feed_ss3(s29, "\x1bOPx", 4), 0, "four bytes: not consumed");
    assert_eq(editor_feed_ss3(s29, "\x1bO", 2), 0, "two bytes: not consumed");
    assert_eq(editor_feed_ss3(s29, "xOP", 3), 0, "no ESC: not consumed");
    assert_eq(editor_feed_ss3(s29, "\x1b[P", 3), 0, "a CSI is not SS3");
    assert_eq(buf_eq(editor_buf(s29), "abc\n", 4), 1, "none of those did anything");
    feed_cont(s29, "\x1b");
    assert_eq(editor_feed_ss3(s29, "\x1bOP", 3), 0, "a carried ESC first: not consumed");
    editor_feed_flush(s29);
    # The vim gesture itself, as an agent or three separate reads send it.
    var s30 = ed_with("abc\n", 0);
    editor_step(s30, 105);                      # i
    feed(s30, "\x1bOP");
    assert_eq(buf_eq(editor_buf(s30), "P\nabc\n", 6), 1, "editor_feed: <Esc>O then P typed, as ever");
    assert_eq(editor_mode(s30), MODE_INSERT, "in INSERT on the new line");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
