# tests/plugin.tcyr — plugin ABI scaffold (v1.3.4)
#
# Proves the registration → fire-point cycle works without any
# external plugin. Each hook type:
#   1. plugin_register_<hook> appends to its registry
#   2. cyim's core invokes the corresponding _plugin_fire_<hook>
#      at the right point in editor flow
#   3. registered fp gets called with the documented args
#
# Per ADR 0003, only post_save + post_change are wired into cyim's
# dispatch in v1.3.4. The other hooks (status_segment, normal_key,
# ex_command, diagnostic_provider) have register/lookup/collect
# helpers in place but no fire-point yet — those wire up in v1.3.5+
# when a real plugin (cyim-lsp at v1.4.0) surfaces what it needs.
#
# Per-test counter globals are the simplest way to verify a callback
# fired without needing test_state plumbing — Cyrius lets us reach
# globals from fn pointers via direct load64/store64.

include "src/buffer.cyr"
include "src/highlight.cyr"
include "src/lang.cyr"
include "src/cyimrc.cyr"
include "src/mode.cyr"
include "src/buflist.cyr"
include "src/window.cyr"
include "src/motion.cyr"
include "src/insert.cyr"
include "src/edit.cyr"
include "src/plugin.cyr"
include "src/command.cyr"
include "src/search.cyr"
include "src/undo.cyr"
include "src/visual.cyr"
include "src/driver.cyr"

# Per-callback counters. The fp-fired callback bumps a counter so the
# test main() can assert "this hook fired N times".
var _t_post_save_calls   = 0;
var _t_post_change_calls = 0;
var _t_status_calls      = 0;
var _t_diag_calls        = 0;
var _t_normal_key_calls  = 0;
var _t_ex_cmd_calls      = 0;

# Last-args capture for post_save (state ptr + path ptr) — verifies
# fp signature matches plugin_register_post_save_hook's documented
# fp shape `fn(state, path) -> 0`.
var _t_post_save_last_state = 0;
var _t_post_save_last_path  = 0;

# v1.4.2 — prefix-key callback counters.
var _t_prefix_key_calls = 0;
var _t_prefix_key_last_state = 0;

# v1.5.0 — list-display callback state.
var _t_list_select_calls    = 0;
var _t_list_select_last_idx = 0 - 1;
var _t_list_select_last_s   = 0;

fn _t_cb_post_save(s, path) {
    _t_post_save_calls = _t_post_save_calls + 1;
    _t_post_save_last_state = s;
    _t_post_save_last_path = path;
    return 0;
}

fn _t_cb_post_change(s) {
    _t_post_change_calls = _t_post_change_calls + 1;
    return 0;
}

# Returns a NUL-term cstring; cyim's _plugin_collect_status_segments
# appends its bytes to a passed-in gap buffer.
fn _t_cb_status(s) {
    _t_status_calls = _t_status_calls + 1;
    return "TEST";
}

fn _t_cb_diag(s, b, out) {
    _t_diag_calls = _t_diag_calls + 1;
    return 0;
}

fn _t_cb_normal_key(s) {
    _t_normal_key_calls = _t_normal_key_calls + 1;
    return ACT_NONE;
}

fn _t_cb_ex_cmd(s) {
    _t_ex_cmd_calls = _t_ex_cmd_calls + 1;
    return 0;
}

# v1.4.2 — `gd` plugin handler. Returns ACT_NONE so the action
# pipeline stays well-defined; tests that need to observe the
# call use the counter / last-state globals.
fn _t_cb_prefix_gd(s) {
    _t_prefix_key_calls = _t_prefix_key_calls + 1;
    _t_prefix_key_last_state = s;
    return ACT_NONE;
}

# v1.5.0 — list-display on_select callback.
fn _t_cb_list_select(s, idx) {
    _t_list_select_calls = _t_list_select_calls + 1;
    _t_list_select_last_idx = idx;
    _t_list_select_last_s = s;
    return 0;
}

fn main() {
    alloc_init();
    plugin_init();

    test_group("plugin_init initializes empty registries");
    assert_neq(_plugin_post_save_hooks,   0, "post_save vec init");
    assert_neq(_plugin_post_change_hooks, 0, "post_change vec init");
    assert_neq(_plugin_status_segments,   0, "status_segment vec init");
    assert_neq(_plugin_normal_keys,       0, "normal_key vec init");
    assert_neq(_plugin_ex_commands,       0, "ex_command vec init");
    assert_neq(_plugin_diagnostic_provs,  0, "diagnostic_provider vec init");
    assert_eq(vec_len(_plugin_post_save_hooks), 0, "post_save empty");

    test_group("registration appends to vec");
    plugin_register_post_save_hook(&_t_cb_post_save);
    plugin_register_post_change_hook(&_t_cb_post_change);
    plugin_register_status_segment(&_t_cb_status);
    plugin_register_diagnostic_provider(&_t_cb_diag);
    plugin_register_normal_key(90, &_t_cb_normal_key);  # 'Z'
    plugin_register_ex_command("test-ex", &_t_cb_ex_cmd);
    assert_eq(vec_len(_plugin_post_save_hooks),   1, "post_save 1 reg");
    assert_eq(vec_len(_plugin_post_change_hooks), 1, "post_change 1 reg");
    assert_eq(vec_len(_plugin_status_segments),   1, "status 1 reg");
    assert_eq(vec_len(_plugin_normal_keys),       1, "normal_key 1 reg");
    assert_eq(vec_len(_plugin_ex_commands),       1, "ex_cmd 1 reg");
    assert_eq(vec_len(_plugin_diagnostic_provs),  1, "diag 1 reg");

    test_group("post_change fires on buffer mutation via editor_step");
    var b = buf_new();
    var s = editor_new(b);
    bl_init(s, b);
    window_init(s);
    editor_set_mode(s, MODE_INSERT);
    var pre = _t_post_change_calls;
    editor_step(s, 65);    # insert 'A' — bumps buf version
    assert_eq(_t_post_change_calls, pre + 1, "post_change fired on insert");

    test_group("post_change does NOT fire on non-mutating step");
    editor_set_mode(s, MODE_NORMAL);
    var pre2 = _t_post_change_calls;
    editor_step(s, 104);   # NORMAL 'h' motion — no buf mutation
    assert_eq(_t_post_change_calls, pre2, "post_change quiet on motion");

    test_group("_plugin_fire_post_save direct invocation passes args through");
    var path_str = "/tmp/test-plugin.txt";
    _t_post_save_last_state = 0;
    _t_post_save_last_path = 0;
    var pre3 = _t_post_save_calls;
    _plugin_fire_post_save(s, path_str);
    assert_eq(_t_post_save_calls, pre3 + 1, "post_save fired");
    assert_eq(_t_post_save_last_state, s, "state arg threaded");
    assert_eq(_t_post_save_last_path,  path_str, "path arg threaded");

    test_group("lookup helpers find registered keyed hooks");
    var nk_fp = _plugin_lookup_normal_key(90);   # 'Z'
    assert_eq(nk_fp, &_t_cb_normal_key, "normal_key Z resolves to fp");
    var nk_miss = _plugin_lookup_normal_key(81); # 'Q'
    assert_eq(nk_miss, 0, "normal_key Q misses (returns 0)");

    var ex_fp = _plugin_lookup_ex_command("test-ex");
    assert_eq(ex_fp, &_t_cb_ex_cmd, "ex_cmd test-ex resolves to fp");
    var ex_miss = _plugin_lookup_ex_command("unknown");
    assert_eq(ex_miss, 0, "ex_cmd unknown misses");

    test_group("collect helpers walk registries");
    var seg_buf = buf_new();
    var emitted = _plugin_collect_status_segments(s, seg_buf);
    assert_eq(emitted, 1, "1 segment emitted");
    assert_eq(_t_status_calls, 1, "status cb called");
    assert_eq(buf_len(seg_buf), 4, "4 bytes (TEST) appended");

    var diag_vec = vec_new();
    _plugin_collect_diagnostics(s, b, diag_vec);
    assert_eq(_t_diag_calls, 1, "diagnostic provider called");

    test_group("plugin_init is idempotent");
    var len_before = vec_len(_plugin_post_save_hooks);
    plugin_init();
    assert_eq(vec_len(_plugin_post_save_hooks), len_before, "double-init preserves registrations");

    # === v1.3.5 integration: dispatch wire-ups ===

    test_group("editor_dispatch routes unmapped NORMAL keys to plugin");
    # 'Z' (90) is not in cyim's built-in NORMAL keymap. With the
    # plugin registration above, _plugin_lookup_normal_key('Z')
    # returns &_t_cb_normal_key. mode.cyr's NORMAL-mode dispatch
    # falls through to plugin lookup when the built-in keymap
    # returns ACT_NONE.
    var s2 = editor_new(buf_new());
    bl_init(s2, editor_buf(s2));
    window_init(s2);
    var pre_nk = _t_normal_key_calls;
    var act_z = editor_dispatch(s2, 90);   # 'Z'
    assert_eq(act_z, ACT_NONE, "plugin cb returned ACT_NONE");
    assert_eq(_t_normal_key_calls, pre_nk + 1, "plugin normal_key fired via dispatch");

    test_group("built-ins win on conflict — h still moves left");
    var pre_nk2 = _t_normal_key_calls;
    var act_h = editor_dispatch(s2, 104);  # 'h' is built-in MOVE_LEFT
    assert_eq(act_h, ACT_MOVE_LEFT, "built-in h not shadowed by plugin");
    assert_eq(_t_normal_key_calls, pre_nk2, "plugin normal_key NOT fired when built-in matches");

    test_group("ex_command parser routes unknown :foo to plugin");
    # Drive the cmdbuf with "test-ex" then ACT_CMDLINE_EXECUTE.
    var s3 = editor_new(buf_new());
    bl_init(s3, editor_buf(s3));
    window_init(s3);
    editor_set_mode(s3, MODE_COMMAND);
    command_reset(s3);
    var ex_chars = "test-ex";
    var ec_i = 0;
    while (load8(ex_chars + ec_i) != 0) {
        command_append(s3, load8(ex_chars + ec_i));
        ec_i = ec_i + 1;
    }
    var pre_ex = _t_ex_cmd_calls;
    command_execute(s3);
    assert_eq(_t_ex_cmd_calls, pre_ex + 1, "plugin ex_command fired via :test-ex");

    test_group("ex_command built-ins win on conflict");
    # Try registering a colliding :q — built-in :q wins, plugin not
    # invoked. (We don't actually register a colliding name here
    # because it'd dirty global state; we just confirm :q's
    # built-in path is reachable without going through the plugin
    # path.)
    var s4 = editor_new(buf_new());
    bl_init(s4, editor_buf(s4));
    window_init(s4);
    editor_set_mode(s4, MODE_COMMAND);
    command_reset(s4);
    command_append(s4, 113);  # 'q'
    var pre_ex2 = _t_ex_cmd_calls;
    command_execute(s4);
    assert_eq(_t_ex_cmd_calls, pre_ex2, "plugin ex_command NOT called for built-in :q");

    # === v1.4.2 — prefix-key ABI ===

    test_group("prefix-key registration appends to vec");
    var pre_pkn = vec_len(_plugin_normal_prefix_keys);
    plugin_register_normal_prefix_key(KEY_G, 100, &_t_cb_prefix_gd);   # 'd' = 100
    assert_eq(vec_len(_plugin_normal_prefix_keys), pre_pkn + 1,
              "_plugin_normal_prefix_keys grew by 1");

    test_group("_plugin_lookup_normal_prefix_key finds registered combo");
    var hit = _plugin_lookup_normal_prefix_key(KEY_G, 100);
    assert_neq(hit, 0, "lookup returns non-null fp");
    var miss_key = _plugin_lookup_normal_prefix_key(KEY_G, 114);   # 'r' unregistered
    assert_eq(miss_key, 0, "unregistered (KEY_G, 'r') misses");
    var miss_prefix = _plugin_lookup_normal_prefix_key(99, 100);   # ('c', 'd') unreg
    assert_eq(miss_prefix, 0, "unregistered prefix misses");

    test_group("editor_dispatch routes (g, d) through plugin");
    var s5 = editor_new(buf_new());
    bl_init(s5, editor_buf(s5));
    window_init(s5);
    editor_set_mode(s5, MODE_NORMAL);
    var pre_pk = _t_prefix_key_calls;
    # g sets prefix...
    var act_g = editor_dispatch(s5, 103);
    assert_eq(act_g, ACT_NONE, "g returns ACT_NONE (prefix set, awaits next)");
    assert_eq(editor_prefix(s5), KEY_G, "prefix latched to KEY_G");
    # ...then d resolves to plugin
    var act_d = editor_dispatch(s5, 100);
    assert_eq(act_d, ACT_NONE, "(g,d) plugin returned ACT_NONE");
    assert_eq(_t_prefix_key_calls, pre_pk + 1, "plugin gd handler fired exactly once");
    assert_eq(_t_prefix_key_last_state, s5, "handler received correct state ptr");
    assert_eq(editor_prefix(s5), 0, "prefix cleared after resolution");

    test_group("built-in gg wins over plugin (g, g) conflict");
    # Register a colliding (KEY_G, 'g') plugin handler — built-in
    # ACT_MOVE_FILE_START should still take precedence.
    plugin_register_normal_prefix_key(KEY_G, 103, &_t_cb_prefix_gd);   # 'g'
    var pre_pk2 = _t_prefix_key_calls;
    editor_dispatch(s5, 103);                         # g (sets prefix)
    var act_gg = editor_dispatch(s5, 103);            # g (resolves)
    assert_eq(act_gg, ACT_MOVE_FILE_START, "built-in gg returned ACT_MOVE_FILE_START");
    assert_eq(_t_prefix_key_calls, pre_pk2, "plugin gg handler NOT called (built-in won)");

    test_group("unregistered prefix follow-up returns ACT_NONE");
    # (KEY_G, 'r') has no built-in, no plugin in this test → ACT_NONE.
    editor_dispatch(s5, 103);                # g
    var act_gr = editor_dispatch(s5, 114);   # r — neither built-in nor plugin
    assert_eq(act_gr, ACT_NONE, "unregistered (g, r) → ACT_NONE");
    assert_eq(editor_prefix(s5), 0, "prefix still cleared after miss");

    test_group("unrelated NORMAL keys still dispatch normally");
    # h still moves left even after the prefix-dispatch generalization.
    var act_h_after = editor_dispatch(s5, 104);   # h
    assert_eq(act_h_after, ACT_MOVE_LEFT, "h still maps to ACT_MOVE_LEFT");

    # === v1.4.2 — plugin_buf_load_file ABI ===

    test_group("plugin_buf_load_file loads file and switches active");
    # Write a tiny fixture.
    var fix_path = "/tmp/cyim-plugin-buf-load.txt";
    var fix_fd = sys_open(fix_path, 65, 420);   # O_WRONLY|O_CREAT, 0644
    if (fix_fd >= 0) {
        var content = "hello\n";
        sys_write(fix_fd, content, 6);
        sys_close(fix_fd);
    }
    var s6 = editor_new(buf_new());
    bl_init(s6, editor_buf(s6));
    window_init(s6);
    var pre_count = bl_count(s6);
    var loaded = plugin_buf_load_file(s6, fix_path);
    assert_neq(loaded, 0, "plugin_buf_load_file returned non-null buf");
    assert_eq(bl_count(s6), pre_count + 1, "buflist grew by 1");
    assert_eq(editor_buf(s6), loaded, "active buffer == loaded buf");
    assert_eq(buf_len(loaded), 6, "loaded buffer has 6 bytes (hello\\n)");

    test_group("plugin_buf_load_file dedups: second call returns same buf");
    var loaded2 = plugin_buf_load_file(s6, fix_path);
    assert_eq(loaded2, loaded, "second call returned same buf (dedup)");
    assert_eq(bl_count(s6), pre_count + 1, "buflist did not grow on second call");

    test_group("plugin_buf_load_file: missing file returns 0 + sets last_error");
    editor_set_last_error(s6, ERR_NONE);
    var miss = plugin_buf_load_file(s6, "/tmp/cyim-does-not-exist-12345");
    assert_eq(miss, 0, "non-existent path returns 0");
    assert_eq(editor_last_error(s6), ERR_FILE_NOT_FOUND, "ERR_FILE_NOT_FOUND set");

    test_group("plugin_buf_load_file: NULL path returns 0 + ERR_NO_FILE_NAME");
    editor_set_last_error(s6, ERR_NONE);
    var null_load = plugin_buf_load_file(s6, 0);
    assert_eq(null_load, 0, "null path returns 0");
    assert_eq(editor_last_error(s6), ERR_NO_FILE_NAME, "ERR_NO_FILE_NAME set");

    # === v1.5.0 — plugin_list_display ABI ===

    test_group("plugin_list_display: pre-display state is inactive");
    assert_eq(plugin_list_active(), 0, "list inactive before display");
    assert_eq(plugin_list_count(),  0, "count 0");
    assert_eq(plugin_list_index(),  0, "index 0");

    test_group("v1.5.3 F-CO-3: plugin_list_display clears latched prefix");
    # Reproduce the corner case: user types `g`, prefix latches to
    # KEY_G. Before plugin_list_display can complete (e.g. some
    # synthetic test scenario), display gets called. If we don't
    # clear the prefix, the next post-dismiss key resolves against
    # the stale KEY_G.
    var s_pf = editor_new(buf_new());
    bl_init(s_pf, editor_buf(s_pf));
    window_init(s_pf);
    editor_set_prefix(s_pf, KEY_G);
    assert_eq(editor_prefix(s_pf), KEY_G, "prefix latched pre-display");
    var items_pf = vec_new();
    vec_push(items_pf, "x");
    plugin_list_display(s_pf, items_pf, 1, &_t_cb_list_select);
    assert_eq(editor_prefix(s_pf), 0, "prefix cleared by plugin_list_display");
    # Cleanup.
    editor_dispatch(s_pf, KEY_ESC);
    assert_eq(plugin_list_active(), 0, "list dismissed after Esc");

    test_group("plugin_list_display latches state");
    var s7 = editor_new(buf_new());
    bl_init(s7, editor_buf(s7));
    window_init(s7);
    var items = vec_new();
    vec_push(items, "alpha");
    vec_push(items, "beta");
    vec_push(items, "gamma");
    plugin_list_display(s7, items, 3, &_t_cb_list_select);
    assert_eq(plugin_list_active(), 1, "active after display");
    assert_eq(plugin_list_count(),  3, "count 3");
    assert_eq(plugin_list_index(),  0, "index starts at 0");
    assert_eq(plugin_list_items(),  items, "items vec stored");

    test_group("dispatch routes j to list-next");
    editor_set_mode(s7, MODE_NORMAL);
    var act_j = editor_dispatch(s7, 106);   # j
    assert_eq(act_j, ACT_NONE, "j returns ACT_NONE during list mode");
    assert_eq(plugin_list_index(), 1, "j advanced index to 1");
    editor_dispatch(s7, 106);
    assert_eq(plugin_list_index(), 2, "j advanced to 2");

    test_group("list-next clamps at count - 1");
    editor_dispatch(s7, 106);
    assert_eq(plugin_list_index(), 2, "j past end stays at count-1");

    test_group("dispatch routes k to list-prev");
    editor_dispatch(s7, 107);   # k
    assert_eq(plugin_list_index(), 1, "k decremented to 1");
    editor_dispatch(s7, 107);
    assert_eq(plugin_list_index(), 0, "k to 0");

    test_group("list-prev clamps at 0");
    editor_dispatch(s7, 107);
    assert_eq(plugin_list_index(), 0, "k below 0 stays at 0");

    test_group("dispatch swallows other keys without buffer mutation");
    var b7 = editor_buf(s7);
    var pre_v = buf_version(b7);
    var act_x = editor_dispatch(s7, 120);   # x — would normally delete
    assert_eq(act_x, ACT_NONE, "x returns ACT_NONE during list mode");
    assert_eq(buf_version(b7), pre_v, "buffer unchanged during list mode");

    test_group("Enter fires on_select(s, current_index) then dismisses");
    editor_dispatch(s7, 106);   # advance to 1
    var pre_calls = _t_list_select_calls;
    editor_dispatch(s7, KEY_ENTER);
    assert_eq(_t_list_select_calls, pre_calls + 1, "on_select fired exactly once");
    assert_eq(_t_list_select_last_idx, 1, "on_select got index 1");
    assert_eq(_t_list_select_last_s, s7, "on_select got state ptr");
    assert_eq(plugin_list_active(), 0, "list dismissed after select");

    test_group("LF (\\n) also fires select");
    plugin_list_display(s7, items, 3, &_t_cb_list_select);
    var pre_calls_lf = _t_list_select_calls;
    editor_dispatch(s7, KEY_LF);
    assert_eq(_t_list_select_calls, pre_calls_lf + 1, "LF fired on_select");
    assert_eq(plugin_list_active(), 0, "list dismissed");

    test_group("Esc dismisses without firing on_select");
    plugin_list_display(s7, items, 3, &_t_cb_list_select);
    var pre_calls_esc = _t_list_select_calls;
    editor_dispatch(s7, KEY_ESC);
    assert_eq(_t_list_select_calls, pre_calls_esc, "Esc did NOT fire on_select");
    assert_eq(plugin_list_active(), 0, "list dismissed via Esc");

    test_group("q dismisses without firing on_select");
    plugin_list_display(s7, items, 3, &_t_cb_list_select);
    var pre_calls_q = _t_list_select_calls;
    editor_dispatch(s7, 113);   # q
    assert_eq(_t_list_select_calls, pre_calls_q, "q did NOT fire on_select");
    assert_eq(plugin_list_active(), 0, "list dismissed via q");

    test_group("dispatch returns to normal mode behaviour after dismiss");
    # After list dismiss, editor_dispatch should resume routing keys
    # to the regular NORMAL keymap. h still moves left.
    editor_set_mode(s7, MODE_NORMAL);
    var act_h_post = editor_dispatch(s7, 104);
    assert_eq(act_h_post, ACT_MOVE_LEFT, "h moves left again after dismiss");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
