# tests/lang.tcyr — language detection from file path

include "src/lang.cyr"

fn main() {
    alloc_init();

    test_group("lang_index / lang_is_valid");
    assert_eq(lang_index("plain"),       0,  "plain @ 0");
    assert_eq(lang_index("shell"),       1,  "shell @ 1");
    assert_eq(lang_index("cyrius"),      6,  "cyrius @ 6");
    assert_eq(lang_index("yaml"),       10,  "yaml @ 10");
    assert_eq(lang_index("cyml"),       11,  "cyml @ 11 (added 1.6.2)");
    assert_eq(lang_index("markdown"),   12,  "markdown @ 12 (added 1.6.2)");
    assert_eq(lang_index("makefile"),   44,  "makefile @ 44 (added 1.6.2)");
    assert_eq(lang_index("esperanto"), 0 - 1, "unknown -> -1");
    assert_eq(lang_is_valid("rust"), 1, "rust valid");
    assert_eq(lang_is_valid("nope"), 0, "nope invalid");

    test_group("detect_language_from_path: cyim's own files");
    assert_streq(detect_language_from_path("src/main.cyr"),         "cyrius", ".cyr -> cyrius");
    assert_streq(detect_language_from_path("tests/buffer.tcyr"),    "cyrius", ".tcyr -> cyrius");
    assert_streq(detect_language_from_path("tests/cyim.bcyr"),      "cyrius", ".bcyr -> cyrius");
    assert_streq(detect_language_from_path("tests/cyim.fcyr"),      "cyrius", ".fcyr -> cyrius");
    # 1.6.2: `.cyml` moves from "toml" to dedicated "cyml" grammar.
    assert_streq(detect_language_from_path("cyrius.cyml"),          "cyml",   ".cyml -> cyml");

    test_group("detect_language_from_path: common languages");
    assert_streq(detect_language_from_path("foo.sh"),       "shell",      ".sh");
    assert_streq(detect_language_from_path("foo.bash"),     "shell",      ".bash");
    assert_streq(detect_language_from_path("foo.zsh"),      "shell",      ".zsh");
    assert_streq(detect_language_from_path("foo.py"),       "python",     ".py");
    assert_streq(detect_language_from_path("foo.js"),       "javascript", ".js");
    assert_streq(detect_language_from_path("foo.mjs"),      "javascript", ".mjs");
    assert_streq(detect_language_from_path("foo.ts"),       "typescript", ".ts");
    assert_streq(detect_language_from_path("foo.rs"),       "rust",       ".rs");
    assert_streq(detect_language_from_path("foo.c"),        "c",          ".c");
    assert_streq(detect_language_from_path("foo.h"),        "c",          ".h");
    assert_streq(detect_language_from_path("foo.toml"),     "toml",       ".toml");
    assert_streq(detect_language_from_path("foo.json"),     "json",       ".json");
    assert_streq(detect_language_from_path("foo.yaml"),     "yaml",       ".yaml");
    assert_streq(detect_language_from_path("foo.yml"),      "yaml",       ".yml");

    test_group("detect_language_from_path: 1.6.2 grammar catch-up");
    assert_streq(detect_language_from_path("README.md"),     "markdown", ".md");
    assert_streq(detect_language_from_path("notes.markdown"),"markdown", ".markdown");
    assert_streq(detect_language_from_path("main.cpp"),      "cpp",      ".cpp");
    assert_streq(detect_language_from_path("widget.hpp"),    "cpp",      ".hpp");
    assert_streq(detect_language_from_path("Foo.cs"),        "csharp",   ".cs");
    assert_streq(detect_language_from_path("style.css"),     "css",      ".css");
    assert_streq(detect_language_from_path("style.scss"),    "scss",     ".scss");
    assert_streq(detect_language_from_path("page.html"),     "html",     ".html");
    assert_streq(detect_language_from_path("doc.xml"),       "xml",      ".xml");
    assert_streq(detect_language_from_path("icon.svg"),      "xml",      ".svg -> xml");
    assert_streq(detect_language_from_path("server.go"),     "go",       ".go");
    assert_streq(detect_language_from_path("App.java"),      "java",     ".java");
    assert_streq(detect_language_from_path("Main.kt"),       "kotlin",   ".kt");
    assert_streq(detect_language_from_path("View.swift"),    "swift",    ".swift");
    assert_streq(detect_language_from_path("script.rb"),     "ruby",     ".rb");
    assert_streq(detect_language_from_path("index.php"),     "php",      ".php");
    assert_streq(detect_language_from_path("init.lua"),      "lua",      ".lua");
    assert_streq(detect_language_from_path("Main.hs"),       "haskell",  ".hs");
    assert_streq(detect_language_from_path("parser.ml"),     "ocaml",    ".ml");
    assert_streq(detect_language_from_path("app.ex"),        "elixir",   ".ex");
    assert_streq(detect_language_from_path("worker.cr"),     "crystal",  ".cr");
    assert_streq(detect_language_from_path("solver.jl"),     "julia",    ".jl");
    assert_streq(detect_language_from_path("ring.zig"),      "zig",      ".zig");
    assert_streq(detect_language_from_path("default.nix"),   "nix",      ".nix");
    assert_streq(detect_language_from_path("Card.vue"),      "vue",      ".vue");
    assert_streq(detect_language_from_path("Widget.svelte"), "svelte",   ".svelte");
    assert_streq(detect_language_from_path("Deploy.ps1"),    "powershell", ".ps1");
    assert_streq(detect_language_from_path("query.sql"),     "sql",      ".sql");
    assert_streq(detect_language_from_path("smb.conf"),      "ini",      ".conf -> ini");
    assert_streq(detect_language_from_path("schema.graphql"),"graphql",  ".graphql");
    assert_streq(detect_language_from_path("schema.proto"),  "protobuf", ".proto");
    assert_streq(detect_language_from_path("main.tf"),       "terraform",".tf");
    assert_streq(detect_language_from_path("boot.s"),        "asm_x86_64", ".s -> asm_x86_64 (default arch)");
    assert_streq(detect_language_from_path("boot.asm"),      "asm_x86_64", ".asm -> asm_x86_64 (default arch)");
    assert_streq(detect_language_from_path("module.ll"),     "llvm_ir",  ".ll");

    test_group("detect_language_from_path: 1.6.4 basename detection — dockerfile / makefile / shell rc");
    # 1.6.4 added a basename probe that runs before the extension table.
    # Pre-1.6.4 these all returned "plain"; flipping the assertions captures
    # the regression-guard.
    assert_streq(detect_language_from_path("Dockerfile"),     "dockerfile", "Dockerfile (canonical)");
    assert_streq(detect_language_from_path("dockerfile"),     "dockerfile", "dockerfile (lowercase variant)");
    assert_streq(detect_language_from_path("Containerfile"),  "dockerfile", "Containerfile (Podman alias)");
    assert_streq(detect_language_from_path("containerfile"),  "dockerfile", "containerfile (lowercase variant)");
    assert_streq(detect_language_from_path("Makefile"),       "makefile",   "Makefile (canonical)");
    assert_streq(detect_language_from_path("makefile"),       "makefile",   "makefile (lowercase variant)");
    assert_streq(detect_language_from_path("GNUmakefile"),    "makefile",   "GNUmakefile (GNU Make precedence canonical)");
    assert_streq(detect_language_from_path(".bashrc"),        "shell",      ".bashrc (bash rc dotfile)");
    assert_streq(detect_language_from_path(".bash_profile"),  "shell",      ".bash_profile");
    assert_streq(detect_language_from_path(".bash_aliases"),  "shell",      ".bash_aliases");
    assert_streq(detect_language_from_path(".zshrc"),         "shell",      ".zshrc (zsh rc dotfile)");
    assert_streq(detect_language_from_path(".zprofile"),      "shell",      ".zprofile");
    assert_streq(detect_language_from_path(".zshenv"),        "shell",      ".zshenv");
    assert_streq(detect_language_from_path(".profile"),       "shell",      ".profile (POSIX shell init)");
    # Excluded by design (rarely customized; line-length cap on lang_basenames):
    # .bash_logout, .zlogin, .zlogout fall through to "plain" via the basename probe
    # but might still hit `.bash` family extensions — they don't, so verify "plain".
    assert_streq(detect_language_from_path(".bash_logout"),   "plain",      ".bash_logout — excluded from basename list");
    assert_streq(detect_language_from_path(".zlogin"),        "plain",      ".zlogin — excluded from basename list");

    test_group("detect_language_from_path: 1.6.4 basename detection — paths with directory prefix");
    assert_streq(detect_language_from_path("subdir/Dockerfile"),         "dockerfile", "Dockerfile in subdir");
    assert_streq(detect_language_from_path("/etc/Dockerfile"),           "dockerfile", "Dockerfile under absolute path");
    assert_streq(detect_language_from_path("./Makefile"),                "makefile",   "./Makefile");
    assert_streq(detect_language_from_path("/home/user/.bashrc"),        "shell",      "absolute path .bashrc");
    assert_streq(detect_language_from_path("a/b/c/d/GNUmakefile"),       "makefile",   "deep path GNUmakefile");

    test_group("detect_language_from_path: 1.6.4 basename detection — boundaries");
    # Basename probe must respect '/' boundary — non-basename suffixes
    # mustn't match. `_lang_path_basename_eq` checks `path[bstart-1] == '/'`.
    assert_streq(detect_language_from_path("foo.Dockerfile"),    "plain", "foo.Dockerfile (preceded by '.', not '/')");
    assert_streq(detect_language_from_path("xMakefile"),         "plain", "xMakefile (no boundary char)");
    assert_streq(detect_language_from_path("notbashrc"),         "plain", "notbashrc (no boundary, no leading '.')");
    # Case-sensitive: basename probe doesn't lowercase like the extension probe.
    assert_streq(detect_language_from_path("MAKEFILE"),          "plain", "MAKEFILE all-caps not in canonical list");
    assert_streq(detect_language_from_path("DOCKERFILE"),        "plain", "DOCKERFILE all-caps not in canonical list");

    test_group("detect_language_from_path: 1.6.4 basename probe runs before extension probe");
    # Sanity: extension probe still wins when there's no basename hit.
    # `Dockerfile.txt` has extension `.txt` which we don't route; falls through.
    assert_streq(detect_language_from_path("Dockerfile.txt"),    "plain",    "Dockerfile.txt — extension '.txt' unmapped, basename 'Dockerfile.txt' not canonical");
    # And: a `.json` file named `Dockerfile.json` routes via extension probe.
    assert_streq(detect_language_from_path("Dockerfile.json"),   "json",     "Dockerfile.json — extension probe wins via .json");

    test_group("detect_language_from_path: case-insensitive on the extension");
    assert_streq(detect_language_from_path("FOO.PY"), "python", ".PY uppercase");
    assert_streq(detect_language_from_path("Bar.JsOn"), "json", "mixed-case .JsOn");

    test_group("detect_language_from_path: full paths with directories");
    assert_streq(detect_language_from_path("/usr/local/bin/foo.sh"), "shell", "absolute path .sh");
    assert_streq(detect_language_from_path("./src/buffer.cyr"),      "cyrius", "relative path .cyr");
    assert_streq(detect_language_from_path("a/b/c/d/main.rs"),       "rust",   "deep path .rs");

    test_group("detect_language_from_path: misses fall back to plain");
    assert_streq(detect_language_from_path("README"),         "plain", "no extension");
    assert_streq(detect_language_from_path("foo.unknown"),    "plain", "unknown ext");
    assert_streq(detect_language_from_path(""),               "plain", "empty path");

    test_group("detect_language_from_path: NULL path -> plain");
    assert_streq(detect_language_from_path(0), "plain", "null path -> plain");

    test_group("detect_language_from_path: extension is part of name, not prefix");
    # ".rsync" should NOT match ".rs" — we want suffix match, not contains.
    assert_streq(detect_language_from_path("foo.rsync"),       "plain", ".rsync should not match .rs");
    # But the trailing token in a multi-suffix path should still hit.
    assert_streq(detect_language_from_path("backup.foo.json"), "json",  ".foo.json -> json");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
