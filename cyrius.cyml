[package]
name = "cyim"
version = "${file:VERSION}"
description = "Sovereign Cyrius-native text editor — VIM-inspired, zero attack surface"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/cyim"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "cyim"

[deps]
# lib/ is generated output: rebuild it with `rm -rf lib/ && cyrius deps`.
# The unicode/* leaves serve niyama, which src/main.cyr includes explicitly
# (`include "lib/niyama.cyr"`, resolved from the pinned snapshot).
stdlib = [
    "syscalls",
    "alloc",
    "fmt",
    "io",
    "fs",
    "str",
    "string",
    "vec",
    "args",
    "hashmap",
    "assert",
    "bench",
    "regex",
    "unicode/_decode",
    "unicode/categories",
    "unicode/_categories_data",
    "unicode/casefold",
    "unicode/_casefold_data",
    "unicode/normalize",
    "unicode/_normalize_data",
]

# Syntax-highlighting tokenizer. grammars/ is re-synced from this tag.
[deps.vyakarana]
git = "https://github.com/MacCracken/vyakarana.git"
tag = "2.10.0"
modules = ["dist/vyakarana.cyr"]

# LSP client; its hooks are registered in src/plugins/lsp_glue.cyr.
[deps.cyim-lsp]
git = "https://github.com/MacCracken/cyim-lsp.git"
tag = "1.5.4"
modules = ["dist/cyim-lsp.cyr"]

# TTY primitives: termios, alt screen, SGR, winsize, signalfd, sanitizer.
[deps.darshana]
git = "https://github.com/MacCracken/darshana.git"
tag = "1.7.0"
modules = ["dist/darshana.cyr"]
