# fuzz/diff.fcyr — src/diff.cyr's round-trip property (1.12.2)
#
# For random pairs of texts, applying the unified diff to the old text must
# give the new text, byte for byte. The applier below is small and strict:
# every context and deletion line must match the old line it consumes, and
# each hunk must consume and produce exactly the counts its header names. So
# a hunk header, a line number or a final-newline marker that is off fails
# here rather than being absorbed.
#
# Small rounds draw lines from a six-line alphabet (five letters and the empty
# line), so they repeat: the hard case for an alignment. Final newlines are
# random. Every tenth round is large: 1500 lines that are all distinct, about
# half of them edited, so no alignment stays under DIFF_DCAP and the fallback
# runs. Those alternate its two paths: change-only edits (equal line counts,
# line for line) and mixed edits (one replacement region). With a repeating
# alphabet the large rounds stayed under the cap, and a broken line-for-line
# fallback passed: found by mutation at 1.12.2.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/io.cyr"
include "src/buffer.cyr"
include "src/diff.cyr"

var _rng = 0;
# Seed the generator. Returns 0.
fn rng_seed(s)  { _rng = s; return 0; }
# The next 64-bit LCG state (Knuth's MMIX constants).
fn rng_next()   { _rng = _rng * 6364136223846793005 + 1442695040888963407; return _rng; }
# The next state as a non-negative value.
fn rng_pos() {
    var v = rng_next() >> 1;
    if (v < 0) { return 0 - v - 1; }
    return v;
}
# 0 .. n-1, from the generator's high bits: the low bits of a power-of-two
# LCG cycle with short periods (bit 0 alternates), and `% 2` on them edited
# every other line exactly, which kept the large rounds under DIFF_DCAP.
fn rng_below(n) {
    if (n <= 0) { return 0; }
    return (rng_pos() >> 24) % n;
}

# 1 while a large round runs: rand_line then draws distinct lines.
var _big = 0;

# A random line code: 0..4 are the letters a..e, 5 is the empty line, and 6
# and up are `n<code>`: distinct lines, which large rounds use.
fn rand_line() {
    if (_big == 1) { return 1000000 + rng_below(1000000000); }
    return rng_below(6);
}

# Line codes 6 .. 6 + count: `count` distinct lines.
fn distinct_lines(count) {
    var v = vec_new();
    var i = 0;
    while (i < count) {
        vec_push(v, 6 + i);
        i = i + 1;
    }
    return v;
}

# `count` random line codes.
fn rand_lines(count) {
    var v = vec_new();
    var i = 0;
    while (i < count) {
        vec_push(v, rand_line());
        i = i + 1;
    }
    return v;
}

# A copy of `old` with about one line in `rate` edited. `change_only` 1 keeps
# the line count (each edit replaces a line); 0 also deletes, inserts and
# appends.
fn mutate(old, rate, change_only) {
    var nv = vec_new();
    var n = vec_len(old);
    var i = 0;
    while (i < n) {
        var r = rng_below(rate);
        var line = vec_get(old, i);
        if (change_only == 1) {
            if (r == 0) { line = rand_line(); }
            vec_push(nv, line);
        } else {
            if (r == 1) { vec_push(nv, rand_line()); }
            if (r == 2) { vec_push(nv, rand_line()); }
            if (r == 1) { vec_push(nv, line); }
            if (r > 2) { vec_push(nv, line); }
        }
        i = i + 1;
    }
    if (change_only == 0) {
        if (rng_below(4) == 0) { vec_push(nv, rand_line()); }
    }
    return nv;
}

# The bytes of line codes `lines`, ending in a newline unless `eol` is 0.
# Writes the length through `len_slot`.
fn text_bytes(lines, eol, len_slot) {
    var n = vec_len(lines);
    var s = alloc(n * 24 + 1);
    var p = 0;
    var i = 0;
    while (i < n) {
        var c = vec_get(lines, i);
        if (c < 5) {
            store8(s + p, 97 + c);
            p = p + 1;
        }
        if (c > 5) {
            store8(s + p, 110);
            p = _buf_append_dec(s, p + 1, c);
        }
        var nl = 1;
        if (i == n - 1) {
            if (eol == 0) { nl = 0; }
        }
        if (nl == 1) {
            store8(s + p, 10);
            p = p + 1;
        }
        i = i + 1;
    }
    store64(len_slot, p);
    return s;
}

# Line starts of `len` bytes at `t`: a vec of offsets, plus `len` at the end.
fn line_starts(t, len) {
    var v = vec_new();
    var p = 0;
    while (p < len) {
        vec_push(v, p);
        var scanning = 1;
        while (scanning == 1) {
            if (p >= len) {
                scanning = 0;
            } else {
                if (load8(t + p) == 10) { scanning = 0; }
                p = p + 1;
            }
        }
    }
    vec_push(v, len);
    return v;
}

# Parse a decimal at d[*pos_slot], advancing it. Returns the value, or -1.
fn parse_num(d, dl, pos_slot) {
    var p = load64(pos_slot);
    var v = 0;
    var digits = 0;
    var go = 1;
    while (go == 1) {
        go = 0;
        if (p < dl) {
            var c = load8(d + p);
            if (c >= 48) {
                if (c <= 57) {
                    v = v * 10 + (c - 48);
                    p = p + 1;
                    digits = digits + 1;
                    go = 1;
                }
            }
        }
    }
    store64(pos_slot, p);
    if (digits == 0) { return 0 - 1; }
    return v;
}

# 1 if d[p..] starts with the NUL-terminated `lit`, else 0.
fn at(d, dl, p, lit) {
    var n = strlen(lit);
    if (p + n > dl) { return 0; }
    return memeq(d + p, lit, n);
}

# Append old line `i` (its bytes and its newline, if it has one) to `out`.
fn copy_old(out, t, starts, i) {
    var s = vec_get(starts, i);
    var e = vec_get(starts, i + 1);
    buf_insert(out, t + s, e - s);
    return 0;
}

# 1 if body line d[bs .. be) (prefix excluded) is old line `i`, with a newline
# exactly when `has_eol` is 1.
fn same_as_old(t, starts, i, d, bs, be, has_eol) {
    var s = vec_get(starts, i);
    var e = vec_get(starts, i + 1);
    var want = be - bs;
    if (has_eol == 1) { want = want + 1; }
    if (e - s != want) { return 0; }
    if (memeq(t + s, d + bs, be - bs) == 0) { return 0; }
    if (has_eol == 1) {
        if (load8(t + e - 1) != 10) { return 0; }
    }
    return 1;
}

# Apply unified diff `d` (`dl` bytes) to `t` (`tl` bytes). Returns a gap
# buffer with the result, or 0 if the diff is malformed or does not match.
fn apply(t, tl, d, dl) {
    var out = buf_new();
    var starts = line_starts(t, tl);
    var nold = vec_len(starts) - 1;
    var cur = 0;
    var p = 0;
    var ok = 1;
    if (dl > 0) {
        # The two header lines.
        var hl = 0;
        while (hl < 2) {
            if (at(d, dl, p, "--- ") == 0) {
                if (at(d, dl, p, "+++ ") == 0) { ok = 0; }
            }
            var scanning = 1;
            while (scanning == 1) {
                if (p >= dl) {
                    scanning = 0;
                } else {
                    if (load8(d + p) == 10) { scanning = 0; }
                    p = p + 1;
                }
            }
            hl = hl + 1;
        }
    }
    var pos[8];
    while (p < dl) {
        if (ok == 1) {
            if (at(d, dl, p, "@@ -") == 0) { ok = 0; }
        }
        if (ok == 0) {
            p = dl;
        } else {
            store64(&pos, p + 4);
            var a = parse_num(d, dl, &pos);
            var b = 1;
            if (at(d, dl, load64(&pos), ",") == 1) {
                store64(&pos, load64(&pos) + 1);
                b = parse_num(d, dl, &pos);
            }
            if (at(d, dl, load64(&pos), " +") == 0) { ok = 0; }
            store64(&pos, load64(&pos) + 2);
            var c = parse_num(d, dl, &pos);
            var e = 1;
            if (at(d, dl, load64(&pos), ",") == 1) {
                store64(&pos, load64(&pos) + 1);
                e = parse_num(d, dl, &pos);
            }
            if (at(d, dl, load64(&pos), " @@\n") == 0) { ok = 0; }
            p = load64(&pos) + 4;
            if (a < 0) { ok = 0; }
            if (b < 0) { ok = 0; }
            if (c < 0) { ok = 0; }
            if (e < 0) { ok = 0; }
            # Copy the unchanged lines up to the hunk.
            var upto = a - 1;
            if (b == 0) { upto = a; }
            if (upto < cur) { ok = 0; }
            if (upto > nold) { ok = 0; }
            while (ok == 1) {
                if (cur < upto) {
                    copy_old(out, t, starts, cur);
                    cur = cur + 1;
                } else {
                    ok = 2;
                }
            }
            if (ok == 2) { ok = 1; }
            # The body, up to the next hunk or the end.
            var used_old = 0;
            var made_new = 0;
            var body = 1;
            while (body == 1) {
                if (ok == 0) { body = 0; }
                if (p >= dl) { body = 0; }
                if (body == 1) {
                    if (at(d, dl, p, "@@ -") == 1) { body = 0; }
                }
                if (body == 1) {
                    var kind = load8(d + p);
                    var bs = p + 1;
                    var be = bs;
                    var scanning = 1;
                    while (scanning == 1) {
                        if (be >= dl) {
                            scanning = 0;
                        } else {
                            if (load8(d + be) == 10) { scanning = 0; } else { be = be + 1; }
                        }
                    }
                    p = be + 1;
                    var has_eol = 1;
                    if (at(d, dl, p, "\\ No newline at end of file\n") == 1) {
                        has_eol = 0;
                        p = p + 28;
                    }
                    if (kind == 32) {
                        if (cur >= nold) { ok = 0; }
                        if (ok == 1) {
                            if (same_as_old(t, starts, cur, d, bs, be, has_eol) == 0) { ok = 0; }
                        }
                        if (ok == 1) {
                            copy_old(out, t, starts, cur);
                            cur = cur + 1;
                            used_old = used_old + 1;
                            made_new = made_new + 1;
                        }
                    }
                    if (kind == 45) {
                        if (cur >= nold) { ok = 0; }
                        if (ok == 1) {
                            if (same_as_old(t, starts, cur, d, bs, be, has_eol) == 0) { ok = 0; }
                        }
                        cur = cur + 1;
                        used_old = used_old + 1;
                    }
                    if (kind == 43) {
                        buf_insert(out, d + bs, be - bs);
                        if (has_eol == 1) { buf_insert(out, "\n", 1); }
                        made_new = made_new + 1;
                    }
                    if (kind != 32) {
                        if (kind != 45) {
                            if (kind != 43) { ok = 0; }
                        }
                    }
                }
            }
            if (used_old != b) { ok = 0; }
            if (made_new != e) { ok = 0; }
        }
    }
    if (ok == 0) { return 0; }
    while (cur < nold) {
        copy_old(out, t, starts, cur);
        cur = cur + 1;
    }
    return out;
}

# 1 if gap buffer `b` holds exactly `n` bytes at `t`.
fn same_bytes(b, t, n) {
    if (buf_len(b) != n) { return 0; }
    var i = 0;
    while (i < n) {
        if (buf_get(b, i) != load8(t + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# The harness body: 400 rounds, 40 of them past DIFF_DCAP. 0 = pass, 1 = a
# failure (named on stderr).
fn fuzz_main(data, len) {
    rng_seed(0xD1FFD1FF);
    var ol[8];
    var nl[8];
    var dl[8];
    var round = 0;
    while (round < 400) {
        var big = 0;
        if (round % 10 == 9) { big = 1; }
        var old = 0;
        var new = 0;
        _big = big;
        if (big == 1) {
            old = distinct_lines(1500);
            new = mutate(old, 2, (round / 10) % 2);
        } else {
            old = rand_lines(rng_below(40));
            new = mutate(old, 3 + rng_below(10), 0);
        }
        var ot = text_bytes(old, rng_below(2), &ol);
        var nt = text_bytes(new, rng_below(2), &nl);
        var out = buf_new();
        var hunks = diff_unified(out, "f", ot, load64(&ol), nt, load64(&nl));
        var d = _fz_flat(out, &dl);
        var same = 0;
        if (load64(&ol) == load64(&nl)) {
            if (memeq(ot, nt, load64(&ol)) == 1) { same = 1; }
        }
        if (same == 1) {
            if (hunks != 0) { syscall(1, 2, "fuzz/diff: hunks for identical input\n", 37); return 1; }
        } else {
            if (hunks == 0) { syscall(1, 2, "fuzz/diff: no hunks for different input\n", 40); return 1; }
        }
        var res = apply(ot, load64(&ol), d, load64(&dl));
        if (res == 0) {
            syscall(1, 2, "fuzz/diff: the diff did not apply to its own input\n", 51);
            return 1;
        }
        if (same_bytes(res, nt, load64(&nl)) == 0) {
            syscall(1, 2, "fuzz/diff: applying the diff did not give the new text\n", 55);
            return 1;
        }
        round = round + 1;
    }
    return 0;
}

# Gap buffer `b` as contiguous bytes; the length goes through `len_slot`.
fn _fz_flat(b, len_slot) {
    var n = buf_len(b);
    var s = alloc(n + 1);
    var i = 0;
    while (i < n) {
        store8(s + i, buf_get(b, i));
        i = i + 1;
    }
    store64(len_slot, n);
    return s;
}

# Run the harness; the exit code is 0 on a pass, 1 on a failure.
fn main() {
    alloc_init();
    var rc = fuzz_main("seed", 4);
    if (rc == 0) {
        syscall(1, 1, "fuzz/diff: ok (400 pairs, 40 past DIFF_DCAP; every diff applies back to its input)\n", 83);
    }
    return rc;
}

var exit_code = main();
syscall(60, exit_code);
